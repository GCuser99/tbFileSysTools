    Public Sub test()
        Dim tmp As String
        tmp = FileSystemTools.GetSpecialFolder(TemporaryFolder)

        ' two source files to move/copy (MoveFile consumes its source, so use two)
        Dim src As String, src2 As String
        src = FileSystemTools.BuildPath(tmp, "cmsrc1.txt")
        src2 = FileSystemTools.BuildPath(tmp, "cmsrc2.txt")
        FileSystemTools.StringToTextFile "x", src, encUtf8
        FileSystemTools.StringToTextFile "x", src2, encUtf8

        On Error Resume Next
        FileSystemTools.CopyFile src, FileSystemTools.BuildPath(tmp, "con")
        Debug.Print "CopyFile con -> " & Err.Number: Err.Clear
        FileSystemTools.MoveFile src2, FileSystemTools.BuildPath(tmp, "con")
        Debug.Print "MoveFile con -> " & Err.Number: Err.Clear
        On Error GoTo 0

        ' cleanup
        On Error Resume Next
        FileSystemTools.DeleteFile src, True, True
        FileSystemTools.DeleteFile src2, True, True
        FileSystemTools.DeleteFile FileSystemTools.BuildPath(tmp, "con"), True, True   ' in case one succeeded
        On Error GoTo 0
    End Sub
    
    Sub sanity()
        Debug.Print FSTShared.InvariantUpper("café.txt")            ' -> CAFÉ.TXT
        Debug.Print FSTShared.PathEquals("C:\A\b.txt", "c:\a\B.TXT") ' -> True
        Debug.Print FSTShared.PathEquals("C:\proj", "C:\proj2")      ' -> False
        Debug.Print FSTShared.PathIsUnderOrEqual("C:\a\b\c", "C:\a") ' -> True
        Debug.Print FSTShared.PathIsUnderOrEqual("C:\ab", "C:\a")    ' -> False (the trailing-\ guard)
    End Sub
    
    Public Sub diag()
        Dim s As String: s = "café.txt"
        Dim n As Long
        n = LCMapStringEx(LOCALE_NAME_INVARIANT, LCMAP_UPPERCASE, s, Len(s), 0, 0, ByVal vbNullPtr)
        Debug.Print "size n = " & n & "   err = " & Err.LastDllError

        Dim buf As String: buf = Space$(n)
        LCMapStringEx LOCALE_NAME_INVARIANT, LCMAP_UPPERCASE, s, Len(s), StrPtr(buf), n, ByVal vbNullPtr
        Debug.Print "folded = [" & buf & "]   err = " & Err.LastDllError
    End Sub

End Module