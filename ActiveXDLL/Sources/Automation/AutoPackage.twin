'Not offical tests - place to apply various ideas
Private Module AutoPackage

    Sub prep_for_package()
        Dim tbFolderPath As String
        tbFolderPath = BuildPath(GetSpecialFolder(Documents), "GitHub\tbFileSysTools\Package\tbFileSysTools package")
        Dim tbSourcesPath As String
        tbSourcesPath = BuildPath(tbFolderPath, "Sources")
        
        Dim c As New Collection
        c.Add ".\Sources\FileSystemObject.twin"
        c.Add ".\Sources\FileSystemTools.twin"
        c.Add ".\Sources\File.twin"
        c.Add ".\Sources\Files.twin"
        c.Add ".\Sources\Folder.twin"
        c.Add ".\Sources\Folders.twin"
        c.Add ".\Sources\Drive.twin"
        c.Add ".\Sources\Drives.twin"
        c.Add ".\Sources\TextStream.twin"
        c.Add ".\Sources\TextCodec.twin"
        c.Add ".\Sources\FSTShared.twin"
        c.Add ".\Sources\WinAPI.twin"
        
        'determine encoding for first file
        Dim enc As TextEncoding
        Dim le As NewlineType
        Dim p As String
        Dim s() As String, o() As String, i As Long, j As Long
        enc = GetFileEncoding(c(1))
        le = GetFileLineEnding(c(1))

        For Each p In c.Items
            ReDim o(0 To 1000000)
            o(0) = "' This file was automatically generated from the ActiveX DLL version source."
            o(1) = "' COM machinery stripped out for twinBASIC package."
            o(2) = "' --------------------------------------------------------------------------"
            j = 2
            s = TextFileToArray(p)
            For i = LBound(s) To UBound(s)
                If Trim(s(i)) Like "[[]COMCreatable*[]]" Then GoTo skip
                If Trim(s(i)) Like "[[]ClassId*[]]" Then GoTo skip
                If Trim(s(i)) Like "[[]InterfaceId*[]]" Then GoTo skip
                j = j + 1
                o(j) = s(i)
                skip:
            Next
            ReDim Preserve o(0 To j)
            ArrayToTextFile o, BuildPath (tbSourcesPath, GetFileName(p)), encoding:=enc, lineEnding:=le
        Next p

        'modify version
        Dim txt As String
            
        Dim fp As String
        tbFolderPath = BuildPath(GetSpecialFolder(Documents), "GitHub\tbFileSysTools\Package\tbFileSysTools package")
        fp = BuildPath(tbFolderPath, "Settings")
        txt = TextFileToString(fp)
        Dim d As Dictionary
        Set d = LibJSON.Parse(txt).Value
        d("project.versionMajor") = App.Major
        d("project.versionMinor") = App.Minor
        d("project.versionBuild") = App.Build
        d("project.versionRevision") = App.Revision
        
        txt = LibJSON.Serialize(d, indentspaces:=8)
        StringToTextFile txt, BuildPath(tbFolderPath, "Settings")
        
        'modify readme file
        Dim readMePath As String
        readMePath = BuildPath(GetSpecialFolder(Documents), "GitHub\tbFileSysTools\README.md")
        txt = TextFileToString(readMePath)
        txt = VBA.Replace$(txt, "[twinBASIC](https://twinbasic.com)", "twinBASIC")
        txt = VBA.Replace$(txt, "[Tests](https://github.com/GCuser99/tbFileSysTools/tree/main/ActiveXDLL/Sources/Tests) folder", "**Tests** folder")
        txt = VBA.Replace$(txt, "[Verification](#verification)", "**Verification** section below")
        StringToTextFile txt, BuildPath(tbFolderPath, "README.md")
        
        'process the CHANGELOG.md
        
        txt = "# Change Log"
        txt = txt & vbCrLf & "[v1.0.1.0, 28 July 2026]"
        txt = txt & vbCrLf & "- Added automation code for building Package and SFDI twinproj files"
        txt = txt & vbCrLf & "[v1.0.0.0, 27 July 2026]"
        txt = txt & vbCrLf & "- Initial publication"

        StringToTextFile txt, BuildPath(tbFolderPath, "CHANGELOG.md")
        
        'copy license file
        Dim licensePath As String
        licensePath = BuildPath(GetSpecialFolder(Documents), "GitHub\tbFileSysTools\LICENSE")
        tbFolderPath = BuildPath(GetSpecialFolder(Documents), "GitHub\tbFileSysTools\Package\tbFileSysTools package\LICENSE.md")
        CopyFile licensePath, tbFolderPath

        Dim exePath As String, outProjPath As String
        exePath = BuildPath(GetSpecialFolder(Documents), "GitHub\tbImportExport\Build\ImpExp.exe")
            
        tbFolderPath = BuildPath(GetSpecialFolder(Documents), "GitHub\tbFileSysTools\Package\tbFileSysTools package")
        outProjPath = BuildPath(GetSpecialFolder(Documents), "GitHub\tbFileSysTools\Package\tbFileSysTools package.twinproj")
            
        DeleteFile outProjPath, ignoreMissing:=True
            
        tbFolderPath = """" & tbFolderPath & """"
        outProjPath = """" & outProjPath & """"
        exePath = """" & exePath & """"
        Shell exePath & " export " & tbFolderPath & " " & outProjPath, vbNormalFocus
            
    End Sub
    
