    Sub prep_for_dropin()
        Dim c As New Collection
        c.Add ".\Sources\FileSystemObject.twin"
        c.Add ".\Sources\FileSystemTools.twin"
        c.Add ".\Sources\File.twin"
        c.Add ".\Sources\Files.twin"
        c.Add ".\Sources\Folder.twin"
        c.Add ".\Sources\Folders.twin"
        c.Add ".\Sources\Drive.twin"
        c.Add ".\Sources\Drives.twin"
        c.Add ".\Sources\TextStream.twin"
        c.Add ".\Sources\TextCodec.twin"
        c.Add ".\Sources\FSTShared.twin"
        c.Add ".\Sources\WinAPI.twin"
    
        'determine encoding for first file
        Dim enc As TextEncoding
        Dim le As NewlineType
        Dim p As String
        Dim s() As String, o() As String, i As Long, j As Long
        enc = GetFileEncoding(c(1))
        le = GetFileLineEnding(c(1))
        ReDim o(0 To 1000000)
        o(0) = "' ======================================================================================="
        o(1) = "' MIT License - Copyright (c) 2026, GCUser99 (https://github.com/GCUser99/tbFileSysTools)"
        o(2) = "' ======================================================================================="
        o(3) = "' This file was automatically generated from the ActiveX DLL version source."
        o(4) = "' COM machinery stipped out, public class/modules made private, and combined"
        o(5) = "' into one file for easy project drop-in."
        o(6) = "' ======================================================================================="
        j = 6
        For Each p In c.Items
            s = TextFileToArray(p)
            For i = LBound(s) To UBound(s)
                If Trim(s(i)) Like "[[]COMCreatable*[]]" Then GoTo skip
                If Trim(s(i)) Like "[[]ClassId*[]]" Then GoTo skip
                If Trim(s(i)) Like "[[]InterfaceId*[]]" Then GoTo skip
                If Trim(s(i)) Like "Public Class*" Then
                    s(i) = VBA.Replace(s(i), "Public Class", "Private Class")
                End If
                If Trim(s(i)) Like "Public Module*" Then
                    s(i) = VBA.Replace(s(i), "Public Module", "Private Module")
                End If
                j = j + 1
                o(j) = s(i)
                skip:
            Next
            j = j + 1
        Next p
        ReDim Preserve o(0 To j)
        ArrayToTextFile o, "..\Single-File-Drop-in\Sources\tbFileSysTools.twin", encoding:=enc, lineEnding:=le
    End Sub
    
    Sub prep_for_package()
        Dim c As New Collection
        c.Add ".\Sources\FileSystemObject.twin"
        c.Add ".\Sources\FileSystemTools.twin"
        c.Add ".\Sources\File.twin"
        c.Add ".\Sources\Files.twin"
        c.Add ".\Sources\Folder.twin"
        c.Add ".\Sources\Folders.twin"
        c.Add ".\Sources\Drive.twin"
        c.Add ".\Sources\Drives.twin"
        c.Add ".\Sources\TextStream.twin"
        c.Add ".\Sources\TextCodec.twin"
        c.Add ".\Sources\FSTShared.twin"
        c.Add ".\Sources\WinAPI.twin"
    
        'determine encoding for first file
        Dim enc As TextEncoding
        Dim le As NewlineType
        Dim p As String
        Dim s() As String, o() As String, i As Long, j As Long
        enc = GetFileEncoding(c(1))
        le = GetFileLineEnding(c(1))

        For Each p In c.Items
            ReDim o(0 To 1000000)
            o(0) = "' This file was automatically generated from the ActiveX DLL version source."
            o(1) = "' COM machinery stripped out for twinBASIC package."
            o(2) = "' --------------------------------------------------------------------------"
            j = 2
            s = TextFileToArray(p)
            For i = LBound(s) To UBound(s)
                If Trim(s(i)) Like "[[]COMCreatable*[]]" Then GoTo skip
                If Trim(s(i)) Like "[[]ClassId*[]]" Then GoTo skip
                If Trim(s(i)) Like "[[]InterfaceId*[]]" Then GoTo skip
                'If Trim(s(i)) Like "Public Class*" Then
                '    s(i) = VBA.Replace(s(i), "Public Class", "Private Class")
                'End If
                j = j + 1
                o(j) = s(i)
                skip:
            Next
            ReDim Preserve o(0 To j)
            ArrayToTextFile o, "..\Package\Sources\" & GetFileName(p), encoding:=enc, lineEnding:=le
        Next p

    End Sub

    Private Sub Normalize_Eg()
        Dim fso As New tbFileSysTools.FileSystemObject
        Dim folderPath As String
        Dim f As tbFileSysTools.File
    
        folderPath = fso.BuildPath(fso.GetSpecialFolder(Documents), "GitHub\tbFileSysTools\ActiveXDLL\Dev")
        For Each f In fso.GetFolder(folderPath).Files
            f.Normalize toEncoding:=encUtf8, toLineEnding:=nlWindows
        Next f
    End Sub
    
    Private Sub Merge_tests()
        Dim fso As New tbFileSysTools.FileSystemObject
        Dim folderPath As String
        Dim filePath As String
        Dim f As tbFileSysTools.File
    
        folderPath = fso.BuildPath(fso.GetSpecialFolder(Documents), "GitHub\tbFileSysTools\ActiveXDLL\Sources\Tests")
        filePath = fso.BuildPath(folderPath, "all_tests.twin")
        fso.StringToTextFile "' All-in-one Test Files Suite", filePath
        
        For Each f In fso.GetFolder(folderPath).Files
            If f.Path <> filePath Then
                Debug.Print f.Name
                fso.MergeTextFiles filePath, f.Path, insertBlankLineBetween:=True
            End If
        Next f
    End Sub
    
    
End Module