' ==========================================================================
' FileDialogTests
'
' Test suite for FileDialog
'
'   * Uses the twinBASIC "Unit Testing" package (Project -> References -> Available
'     Packages). 
'   * Every test is a Public Sub that constructs its own FileDialog, so any
'     test can be run on its own (cursor inside it, F5 / Run CodeLens) OR via
'     a dispatcher.
'   * The automated/interactive split is preserved, because the interactive
'     tests display real dialogs and need a human; you don't want them firing
'     during an automated run:
'         RunAllAutomatedTests    - no dialogs displayed
'         RunAllInteractiveTests  - walks you through dialog scenarios
'         RunAllTests             - both
'
' Convention (from the Assert package):
'   * Assert.Strict.AreEqual expected, actual   - numbers/enums (value compare)
'   * Assert.Exact.AreEqual  expected, actual   - strings (case-sensitive)
'   * Assert.Exact.IsTrue / Assert.Exact.IsFalse - conditions
' A failing assertion stops at the offending line with expected/actual shown.
'
' Error-expecting tests capture Err.Number into a local and assert it AFTER
' clearing the handler, so a failing assertion is never swallowed by the
' still-active On Error Resume Next.
' ==========================================================================

Private Module FileDialogTests
    Option Explicit

    ' =========================================================================
    ' Dispatchers
    ' =========================================================================
    Public Sub RunAllTests()
        RunAllAutomatedTests
        Debug.Print
        RunAllInteractiveTests
    End Sub

    Public Sub RunAllAutomatedTests()
        Debug.Print String(70, "=")
        Debug.Print "Automated tests (no dialogs displayed)"
        Debug.Print String(70, "=")

        ' --- Construction & dialog type ---
        Test_New_RejectsZero
        Test_New_RejectsNegative
        Test_New_RejectsTooHigh
        Test_New_AcceptsAllValidTypes
        Test_DialogType_ReturnsConstructorValue

        ' --- VBA-style construction (parameterless + DialogType property) ---
        Test_VBA_Style_Construction
        Test_VBA_Style_RequiresDialogTypeBeforeShow
        Test_VBA_Style_AppliesTypeDefaultsOnFirstSet
        Test_VBA_Style_DoesNotOverwriteCallerSetDefaults
        Test_DialogType_Property_RejectsInvalid

        ' --- Defaults ---
        Test_Defaults_Open
        Test_Defaults_SaveAs
        Test_Defaults_FolderPicker
        Test_Defaults_NewOptions

        ' --- Property round-trips ---
        Test_PathMustExist_RoundTrip
        Test_FileMustExist_RoundTrip
        Test_AllowMultiSelect_RoundTrip
        Test_ShowHiddenFiles_RoundTrip
        Test_Title_RoundTrip
        Test_ButtonName_RoundTrip
        Test_InitialFolderPath_RoundTrip
        Test_InitialFileName_RoundTrip
        Test_DefaultExtension_RoundTrip
        Test_FileNameLabel_RoundTrip
        Test_OwnerWinHandle_RoundTrip
        Test_DontAddToRecent_RoundTrip
        Test_StrictFileTypes_RoundTrip
        Test_NoChangeDir_RoundTrip
        Test_UseAsDefaultFolder_RoundTrip
        Test_ClientGuid_RoundTrip

        ' --- Filters ---
        Test_FilterCount_StartsAtZero
        Test_AddFilter_IncrementsCount
        Test_AddFilter_RejectsEmptyDescription
        Test_AddFilter_RejectsEmptyExtensions
        Test_ClearFilters_ResetsCount
        Test_FilterIndex_RoundTrip
        Test_FilterIndex_DefaultsToZero
        Test_SelectedFilterIndex_StartsAtZero
        Test_AddFilters_ParsesSinglePair
        Test_AddFilters_ParsesMultiplePairs
        Test_AddFilters_AppendsToExisting
        Test_AddFilters_RejectsEmpty
        Test_AddFilters_RejectsOddPartCount
        Test_AddFilters_PreservesSemicolonsInPatterns

        ' --- Places ---
        Test_PlaceCount_StartsAtZero
        Test_AddPlace_IncrementsCount
        Test_AddPlace_RejectsEmpty
        Test_AddPlace_DefaultsToTop
        Test_ClearPlaces_ResetsCount

        Test_SelectedItems_BeforeShow_IsEmpty

        Debug.Print String(70, "-")
        Debug.Print "FileDialog automated: all tests passed."
        Debug.Print String(70, "=")
    End Sub

    Public Sub RunAllInteractiveTests()
        Debug.Print String(70, "=")
        Debug.Print "Interactive tests (you will see dialogs)"
        Debug.Print String(70, "=")
        Debug.Print "These tests show real dialogs. Cancel/confirm as instructed."
        Debug.Print

        Test_Interactive_FolderPicker_Cancel
        Test_Interactive_FolderPicker_Select
        Test_Interactive_FileOpen_Cancel
        Test_Interactive_FileOpen_Select
        Test_Interactive_FileOpen_MultiSelect
        Test_Interactive_FileSave_Cancel
        Test_Interactive_FileSave_Confirm
        Test_Interactive_MultipleFilters
        Test_Interactive_FileOk_Veto_KeepsDialogOpen
        Test_Interactive_FilterIndex
        Test_Interactive_AddFiltersDelimited
        Test_Interactive_SelectedFilterIndex
        Test_Interactive_AddPlace
        Test_Interactive_DontAddToRecent
        Test_Interactive_StrictFileTypes
        Test_Interactive_VBA_Style_Works
        Test_Interactive_InvalidInitialFolderRaises
        Test_Interactive_InvalidGuidRaises
        Test_Interactive_EnforceFilterExtensions
        Test_Interactive_NavigationRoot
        
        SanityTest_ResultPlumbing

        Debug.Print String(70, "-")
        Debug.Print "FileDialog interactive: all tests passed."
        Debug.Print String(70, "=")
    End Sub

    ' =========================================================================
    ' Automated - constructor & dialog type
    ' =========================================================================
    Public Sub Test_New_RejectsZero()
        Dim invalidType As FileDialogType: invalidType = 0
        Dim fd As FileDialog, e As Long
        On Error Resume Next
        Set fd = New FileDialog(invalidType)
        e = Err.Number
        On Error GoTo 0
        Assert.Strict.AreEqual vbObjectError + 101&, e          ' New rejects 0
    End Sub

    Public Sub Test_New_RejectsNegative()
        Dim invalidType As FileDialogType: invalidType = -1
        Dim fd As FileDialog, e As Long
        On Error Resume Next
        Set fd = New FileDialog(invalidType)
        e = Err.Number
        On Error GoTo 0
        Assert.Strict.AreEqual vbObjectError + 101&, e            ' New rejects negative
    End Sub

    Public Sub Test_New_RejectsTooHigh()
        Dim invalidType As FileDialogType: invalidType = 99
        Dim fd As FileDialog, e As Long
        On Error Resume Next
        Set fd = New FileDialog(invalidType)
        e = Err.Number
        On Error GoTo 0
        Assert.Strict.AreEqual vbObjectError + 101&, e            ' New rejects out-of-range high value
    End Sub

    Public Sub Test_New_AcceptsAllValidTypes()
        ' Construct each valid type with no error handler: a raise here just fails
        ' the test by propagating, which is the Assert-package idiom.
        Dim a As FileDialog: Set a = New FileDialog(fdOpen)
        Dim b As FileDialog: Set b = New FileDialog(fdSaveAs)
        Dim c As FileDialog: Set c = New FileDialog(fdFolderPicker)
        Assert.Exact.IsTrue ((Not a Is Nothing) And (Not b Is Nothing) And (Not c Is Nothing))
    End Sub

    Public Sub Test_DialogType_ReturnsConstructorValue()
        Dim fd As FileDialog: Set fd = New FileDialog(fdSaveAs)
        Assert.Strict.AreEqual CLng(fdSaveAs), CLng(fd.DialogType)
    End Sub

    ' =========================================================================
    ' Automated - VBA-style usage (parameterless construction)
    ' =========================================================================
    Public Sub Test_VBA_Style_Construction()
        ' VBA users construct without arguments and set DialogType as a property.
        Dim fd As New FileDialog
        fd.DialogType = fdSaveAs
        Assert.Strict.AreEqual CLng(fdSaveAs), CLng(fd.DialogType)
    End Sub

    Public Sub Test_VBA_Style_RequiresDialogTypeBeforeShow()
        ' Calling Show before setting DialogType must raise a helpful error.
        Dim fd As New FileDialog
        Dim e As Long
        On Error Resume Next
        fd.Show
        e = Err.Number
        On Error GoTo 0
        Assert.Strict.AreEqual vbObjectError + 101&, e            ' Show without DialogType raises 101
    End Sub

    Public Sub Test_VBA_Style_AppliesTypeDefaultsOnFirstSet()
        ' The first DialogType assignment applies the type-specific defaults.
        Dim fd As New FileDialog
        Assert.Exact.IsFalse fd.FileMustExist           ' before set: uninitialized
        fd.DialogType = fdOpen
        Assert.Exact.IsTrue fd.FileMustExist            ' after fdOpen: defaults applied
        Assert.Exact.IsTrue fd.PathMustExist
    End Sub

    Public Sub Test_VBA_Style_DoesNotOverwriteCallerSetDefaults()
        ' A second DialogType assignment must NOT overwrite a caller-set value.
        Dim fd As New FileDialog
        fd.DialogType = fdOpen          ' applies defaults: FileMustExist=True
        fd.FileMustExist = False        ' caller overrides
        fd.DialogType = fdSaveAs        ' should NOT reset FileMustExist
        Assert.Exact.IsFalse fd.FileMustExist
    End Sub

    Public Sub Test_DialogType_Property_RejectsInvalid()
        Dim fd As New FileDialog
        Dim bogus As FileDialogType: bogus = 99
        Dim e As Long
        On Error Resume Next
        fd.DialogType = bogus
        e = Err.Number
        On Error GoTo 0
        Assert.Strict.AreEqual vbObjectError + 101&, e           ' DialogType property rejects invalid value
    End Sub

    ' =========================================================================
    ' Automated - defaults
    ' =========================================================================
    Public Sub Test_Defaults_Open()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        Assert.Exact.IsTrue fd.FileMustExist
        Assert.Exact.IsTrue fd.PathMustExist
        Assert.Exact.IsFalse fd.AllowMultiSelect
        Assert.Exact.IsFalse fd.ShowHiddenFiles
        Assert.Strict.AreEqual 0&, fd.FilterCount
        Assert.Strict.AreEqual 0&, fd.FilterIndex
    End Sub

    Public Sub Test_Defaults_SaveAs()
        Dim fd As FileDialog: Set fd = New FileDialog(fdSaveAs)
        Assert.Exact.IsFalse fd.FileMustExist
        Assert.Exact.IsTrue fd.PathMustExist
    End Sub

    Public Sub Test_Defaults_FolderPicker()
        Dim fd As FileDialog: Set fd = New FileDialog(fdFolderPicker)
        Assert.Exact.IsFalse fd.FileMustExist
        Assert.Exact.IsTrue fd.PathMustExist
    End Sub

    Public Sub Test_Defaults_NewOptions()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        Assert.Exact.IsFalse fd.DontAddToRecent
        Assert.Exact.IsFalse fd.StrictFileTypes
        Assert.Exact.IsFalse fd.NoChangeDir
        Assert.Exact.IsTrue fd.UseAsDefaultFolder
        Assert.Exact.IsTrue Len(fd.ClientGuid) = 0      ' default ClientGuid is empty (flavor-agnostic)
        Assert.Strict.AreEqual 0&, fd.PlaceCount
        Assert.Strict.AreEqual 0&, fd.SelectedFilterIndex
    End Sub

    ' =========================================================================
    ' Automated - property round-trips
    ' =========================================================================
    Public Sub Test_PathMustExist_RoundTrip()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.PathMustExist = False
        Assert.Exact.IsFalse fd.PathMustExist
        fd.PathMustExist = True
        Assert.Exact.IsTrue fd.PathMustExist
    End Sub

    Public Sub Test_FileMustExist_RoundTrip()
        Dim fd As FileDialog: Set fd = New FileDialog(fdSaveAs)
        fd.FileMustExist = True
        Assert.Exact.IsTrue fd.FileMustExist
        fd.FileMustExist = False
        Assert.Exact.IsFalse fd.FileMustExist
    End Sub

    Public Sub Test_AllowMultiSelect_RoundTrip()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.AllowMultiSelect = True
        Assert.Exact.IsTrue fd.AllowMultiSelect
    End Sub

    Public Sub Test_ShowHiddenFiles_RoundTrip()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.ShowHiddenFiles = True
        Assert.Exact.IsTrue fd.ShowHiddenFiles
    End Sub

    Public Sub Test_Title_RoundTrip()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.Title = "My Title"
        Assert.Exact.AreEqual "My Title", fd.Title
    End Sub

    Public Sub Test_ButtonName_RoundTrip()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.ButtonName = "Go"
        Assert.Exact.AreEqual "Go", fd.ButtonName
    End Sub

    Public Sub Test_InitialFolderPath_RoundTrip()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.InitialFolderPath = "C:\Temp"
        Assert.Exact.AreEqual "C:\Temp", fd.InitialFolderPath
    End Sub

    Public Sub Test_InitialFileName_RoundTrip()
        Dim fd As FileDialog: Set fd = New FileDialog(fdSaveAs)
        fd.InitialFileName = "report.docx"
        Assert.Exact.AreEqual "report.docx", fd.InitialFileName
    End Sub

    Public Sub Test_DefaultExtension_RoundTrip()
        Dim fd As FileDialog: Set fd = New FileDialog(fdSaveAs)
        fd.DefaultExtension = "txt"
        Assert.Exact.AreEqual "txt", fd.DefaultExtension
    End Sub

    Public Sub Test_FileNameLabel_RoundTrip()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.FileNameLabel = "Name:"
        Assert.Exact.AreEqual "Name:", fd.FileNameLabel
    End Sub

    Public Sub Test_OwnerWinHandle_RoundTrip()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.OwnerWinHandle = 12345
        Assert.Strict.AreEqual 12345&, CLng(fd.OwnerWinHandle)
    End Sub

    Public Sub Test_DontAddToRecent_RoundTrip()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.DontAddToRecent = True
        Assert.Exact.IsTrue fd.DontAddToRecent
        fd.DontAddToRecent = False
        Assert.Exact.IsFalse fd.DontAddToRecent
    End Sub

    Public Sub Test_StrictFileTypes_RoundTrip()
        Dim fd As FileDialog: Set fd = New FileDialog(fdSaveAs)
        fd.StrictFileTypes = True
        Assert.Exact.IsTrue fd.StrictFileTypes
        fd.StrictFileTypes = False
        Assert.Exact.IsFalse fd.StrictFileTypes
    End Sub

    Public Sub Test_NoChangeDir_RoundTrip()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.NoChangeDir = True
        Assert.Exact.IsTrue fd.NoChangeDir
        fd.NoChangeDir = False
        Assert.Exact.IsFalse fd.NoChangeDir
    End Sub

    Public Sub Test_UseAsDefaultFolder_RoundTrip()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.UseAsDefaultFolder = False
        Assert.Exact.IsFalse fd.UseAsDefaultFolder
        fd.UseAsDefaultFolder = True
        Assert.Exact.IsTrue fd.UseAsDefaultFolder
    End Sub

    Public Sub Test_ClientGuid_RoundTrip()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.ClientGuid = "{12345678-1234-1234-1234-123456789012}"
        Assert.Exact.AreEqual "{12345678-1234-1234-1234-123456789012}", fd.ClientGuid
    End Sub

    ' =========================================================================
    ' Automated - filters
    ' =========================================================================
    Public Sub Test_FilterCount_StartsAtZero()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        Assert.Strict.AreEqual 0&, fd.FilterCount
    End Sub

    Public Sub Test_AddFilter_IncrementsCount()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.AddFilter "Text", "*.txt"
        Assert.Strict.AreEqual 1&, fd.FilterCount
        fd.AddFilter "Images", "*.jpg;*.png"
        Assert.Strict.AreEqual 2&, fd.FilterCount
    End Sub

    Public Sub Test_AddFilter_RejectsEmptyDescription()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        Dim e As Long
        On Error Resume Next
        fd.AddFilter "", "*.txt"
        e = Err.Number
        On Error GoTo 0
        Assert.Strict.AreEqual vbObjectError + 103&, e           ' rejects empty description
    End Sub

    Public Sub Test_AddFilter_RejectsEmptyExtensions()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        Dim e As Long
        On Error Resume Next
        fd.AddFilter "Text", ""
        e = Err.Number
        On Error GoTo 0
        Assert.Strict.AreEqual vbObjectError + 103&, e            ' rejects empty extensions
    End Sub

    Public Sub Test_ClearFilters_ResetsCount()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.AddFilter "Text", "*.txt"
        fd.AddFilter "Images", "*.jpg"
        fd.ClearFilters
        Assert.Strict.AreEqual 0&, fd.FilterCount
    End Sub

    Public Sub Test_FilterIndex_RoundTrip()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.FilterIndex = 3
        Assert.Strict.AreEqual 3&, fd.FilterIndex
    End Sub

    Public Sub Test_FilterIndex_DefaultsToZero()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        Assert.Strict.AreEqual 0&, fd.FilterIndex
    End Sub

    Public Sub Test_SelectedFilterIndex_StartsAtZero()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        Assert.Strict.AreEqual 0&, fd.SelectedFilterIndex
    End Sub

    Public Sub Test_AddFilters_ParsesSinglePair()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.AddFilters "Text Files|*.txt"
        Assert.Strict.AreEqual 1&, fd.FilterCount
    End Sub

    Public Sub Test_AddFilters_ParsesMultiplePairs()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.AddFilters "Images|*.jpg;*.png|Documents|*.pdf;*.docx|All Files|*.*"
        Assert.Strict.AreEqual 3&, fd.FilterCount
    End Sub

    Public Sub Test_AddFilters_AppendsToExisting()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.AddFilter "First", "*.1"
        fd.AddFilters "Second|*.2|Third|*.3"
        Assert.Strict.AreEqual 3&, fd.FilterCount       ' appends rather than replacing
    End Sub

    Public Sub Test_AddFilters_RejectsEmpty()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        Dim e As Long
        On Error Resume Next
        fd.AddFilters ""
        e = Err.Number
        On Error GoTo 0
        Assert.Strict.AreEqual vbObjectError + 103&, e            ' rejects empty string
    End Sub

    Public Sub Test_AddFilters_RejectsOddPartCount()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        Dim e As Long
        On Error Resume Next
        fd.AddFilters "Images|*.jpg|Documents"
        e = Err.Number
        On Error GoTo 0
        Assert.Strict.AreEqual vbObjectError + 103&, e             ' rejects odd part count
    End Sub

    Public Sub Test_AddFilters_PreservesSemicolonsInPatterns()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.AddFilters "Images|*.jpg;*.png;*.bmp"
        Assert.Strict.AreEqual 1&, fd.FilterCount       ' semicolons stay inside one pattern
    End Sub

    ' =========================================================================
    ' Automated - places
    ' =========================================================================
    Public Sub Test_PlaceCount_StartsAtZero()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        Assert.Strict.AreEqual 0&, fd.PlaceCount
    End Sub

    Public Sub Test_AddPlace_IncrementsCount()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.AddPlace "C:\Temp"
        Assert.Strict.AreEqual 1&, fd.PlaceCount
        fd.AddPlace "C:\Windows", False
        Assert.Strict.AreEqual 2&, fd.PlaceCount
    End Sub

    Public Sub Test_AddPlace_RejectsEmpty()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        Dim e As Long
        On Error Resume Next
        fd.AddPlace ""
        e = Err.Number
        On Error GoTo 0
        Assert.Strict.AreEqual vbObjectError + 105&, e             ' rejects empty path
    End Sub

    Public Sub Test_AddPlace_DefaultsToTop()
        ' No error handler: the call must succeed with no atTop argument, and the
        ' observable effect (count -> 1) is what we assert.
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.AddPlace "C:\Temp"
        Assert.Strict.AreEqual 1&, fd.PlaceCount
    End Sub

    Public Sub Test_ClearPlaces_ResetsCount()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.AddPlace "C:\Temp"
        fd.AddPlace "C:\Windows"
        fd.ClearPlaces
        Assert.Strict.AreEqual 0&, fd.PlaceCount
    End Sub

    Public Sub Test_SelectedItems_BeforeShow_IsEmpty()
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        Assert.Exact.IsTrue (fd.SelectedItems.Count = 0)
    End Sub

    ' =========================================================================
    ' Interactive tests (display real dialogs)
    ' =========================================================================
    Public Sub Test_Interactive_FolderPicker_Cancel()
        Prompt "FOLDER PICKER (cancel): A folder picker will open. Click Cancel."
        Dim fd As FileDialog: Set fd = New FileDialog(fdFolderPicker)
        fd.Title = "TEST: Cancel this dialog"
        Assert.Exact.IsFalse fd.Show()                  ' returns False on cancel
    End Sub

    Public Sub Test_Interactive_FolderPicker_Select()
        Prompt "FOLDER PICKER (select): Pick any folder and click Select Folder."
        Dim fd As FileDialog: Set fd = New FileDialog(fdFolderPicker)
        fd.Title = "TEST: Select any folder and click Select Folder"
        Assert.Exact.IsTrue fd.Show()                   ' returns True on select
        Assert.Exact.IsTrue (fd.SelectedItems.Count >= 1)
        Debug.Print "    (you selected: " & fd.SelectedItems(1) & ")"
    End Sub

    Public Sub Test_Interactive_FileOpen_Cancel()
        Prompt "FILE OPEN (cancel): Open dialog will appear. Click Cancel."
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.Title = "TEST: Cancel this dialog"
        Assert.Exact.IsFalse fd.Show()                  ' returns False on cancel
    End Sub

    Public Sub Test_Interactive_FileOpen_Select()
        Prompt "FILE OPEN (select): Pick any single file and click Open."
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.Title = "TEST: Select one file and click Open"
        Assert.Exact.IsTrue fd.Show()                   ' returns True on select
        Assert.Strict.AreEqual 1&, fd.SelectedItems.Count   ' single-select = exactly 1
        Debug.Print "    (you selected: " & fd.SelectedItems(1) & ")"
    End Sub

    Public Sub Test_Interactive_FileOpen_MultiSelect()
        Prompt "FILE OPEN (multi): Pick TWO OR MORE files (Ctrl+click), then Open."
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.Title = "TEST: Select 2+ files with Ctrl+click, then Open"
        fd.AllowMultiSelect = True
        Assert.Exact.IsTrue fd.Show()                   ' returns True
        Assert.Exact.IsTrue (fd.SelectedItems.Count >= 2)
        Debug.Print "    (you selected " & fd.SelectedItems.Count & " files)"
    End Sub

    Public Sub Test_Interactive_FileSave_Cancel()
        Prompt "FILE SAVE (cancel): Save dialog will appear. Click Cancel."
        Dim fd As FileDialog: Set fd = New FileDialog(fdSaveAs)
        fd.Title = "TEST: Cancel this dialog"
        fd.InitialFileName = "test.txt"
        Assert.Exact.IsFalse fd.Show()                  ' returns False on cancel
    End Sub

    Public Sub Test_Interactive_FileSave_Confirm()
        Prompt "FILE SAVE (confirm): Save dialog will appear. Type any name and click Save. " & _
               "If prompted to overwrite, click Yes. (No actual file is written by this test.)"
        Dim fd As FileDialog: Set fd = New FileDialog(fdSaveAs)
        fd.Title = "TEST: Type a save name and click Save"
        fd.InitialFileName = "tb_filedialog_test.txt"
        fd.DefaultExtension = "txt"
        Assert.Exact.IsTrue fd.Show()                   ' returns True on confirm
        Assert.Strict.AreEqual 1&, fd.SelectedItems.Count   ' save = exactly 1 item
        Debug.Print "    (chosen path: " & fd.SelectedItems(1) & ")"
    End Sub

    Public Sub Test_Interactive_MultipleFilters()
        Prompt "MULTI-FILTER: Open dialog appears with THREE filter options in the dropdown: " & _
               "Images, Documents, All Files. Verify all three appear, then Cancel."
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.Title = "TEST: Check the filter dropdown has 3 options, then Cancel"
        fd.AddFilter "Images", "*.jpg;*.png;*.bmp"
        fd.AddFilter "Documents", "*.pdf;*.docx;*.txt"
        fd.AddFilter "All Files", "*.*"
        Assert.Strict.AreEqual 3&, fd.FilterCount       ' before Show
        fd.Show
        Debug.Print "    (verify visually that 3 filter options appeared)"
    End Sub

    Public Sub Test_Interactive_FilterIndex()
        Prompt "FILTER INDEX: Open dialog appears with 3 filters. The second filter " & _
               "('Documents') should be SELECTED by default. Verify and Cancel."
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.Title = "TEST: 'Documents' filter should be pre-selected. Click Cancel"
        fd.AddFilter "Images", "*.jpg;*.png;*.bmp"
        fd.AddFilter "Documents", "*.pdf;*.docx;*.txt"
        fd.AddFilter "All Files", "*.*"
        fd.FilterIndex = 2
        fd.Show
        Debug.Print "    (verify visually that 'Documents' was the default filter)"
    End Sub

    Public Sub Test_Interactive_AddFiltersDelimited()
        Prompt "ADDFILTERS (delimited): Open dialog appears with 3 filters set via the " & _
               "delimited string form: Images, Documents, All Files. Verify and Cancel."
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.Title = "TEST: Filters set via AddFilters-> Images, Documents, All Files. Verify and Cancel"
        fd.AddFilters "Images|*.jpg;*.png;*.bmp|Documents|*.pdf;*.docx;*.txt|All Files|*.*"
        Assert.Strict.AreEqual 3&, fd.FilterCount       ' delimited yields 3 filters
        fd.Show
        Debug.Print "    (verify visually that 3 filters appeared, same as AddFilter test)"
    End Sub

    Public Sub Test_Interactive_SelectedFilterIndex()
        Prompt "SELECTED FILTER INDEX: Open dialog appears with 3 filters. " & _
               "PICK the third filter ('All Files') from the dropdown, " & _
               "then select any file and click Open. " & _
               "The test will verify SelectedFilterIndex = 3."
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.Title = "TEST: Pick 'All Files' (third filter), then any file and click Open"
        fd.AddFilter "Images", "*.jpg;*.png;*.bmp"
        fd.AddFilter "Documents", "*.pdf;*.docx;*.txt"
        fd.AddFilter "All Files", "*.*"
        ' Lenient: if the user cancels, skip rather than fail (we can't verify a choice).
        If fd.Show() Then
            Assert.Strict.AreEqual 3&, fd.SelectedFilterIndex
            Debug.Print "    (selected filter index: " & fd.SelectedFilterIndex & ")"
        Else
            Debug.Print "    (skipped - dialog was cancelled)"
        End If
    End Sub

    Public Sub Test_Interactive_AddPlace()
        Prompt "ADD PLACE: A file dialog will open with two custom places added " & _
               "(C:\Windows top, C:\Users bottom). On older Windows versions these " & _
               "appear in the nav pane; on Windows 11 they are silently ignored by " & _
               "the OS. This test confirms no error is raised. Cancel to continue."
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.Title = "TEST: AddPlace (visible only on older Windows). Cancel to continue."
        fd.AddPlace "C:\Windows", True
        fd.AddPlace "C:\Users", False
        Dim e As Long
        On Error Resume Next
        fd.Show
        e = Err.Number
        On Error GoTo 0
        Assert.Strict.AreEqual 0&, CLng(e)              ' AddPlace + Show completes without raising
    End Sub

    Public Sub Test_Interactive_DontAddToRecent()
        Prompt "DON'T ADD TO RECENT: A Save dialog appears. Type any filename and click Save. " & _
               "Then check Windows' jump list or Recent Items -- the file should NOT appear there."
        Dim fd As FileDialog: Set fd = New FileDialog(fdSaveAs)
        fd.Title = "TEST: This save should not appear in Recent Items. Type any filename and click Save. "
        fd.InitialFileName = "tb_no_recent_test.txt"
        fd.DontAddToRecent = True
        fd.Show
        Debug.Print "    (verify in Start menu Recent that the test file is absent)"
    End Sub

    Public Sub Test_Interactive_StrictFileTypes()
        Prompt "STRICT FILE TYPES (auto-checked): A Save dialog appears with .txt and " & _
               ".log filters. Type a filename ending in .xyz and click Save -- the test " & _
               "then verifies the extension was coerced. Click Cancel to skip. " & _
               "No file is written to disk."

        Dim fd As FileDialog: Set fd = New FileDialog(fdSaveAs)
        fd.Title = "TEST: type foo.xyz then click Save"
        fd.AddFilter "Text", "*.txt"
        fd.AddFilter "Log", "*.log"
        fd.StrictFileTypes = True
        ' Deliberately NOT setting DefaultExtension: the class should auto-derive
        ' it from the active filter because StrictFileTypes is on.

        If Not fd.Show() Then
            Debug.Print "    SKIP: dialog cancelled -- coercion not exercised."
            Exit Sub
        End If

        Dim resultPath As String: resultPath = fd.SelectedItems(1)
        Dim ext As String:        ext = LCase$(GetFinalExtension(resultPath))

        Debug.Print "    Returned path : " & resultPath
        Debug.Print "    Final ext     : ." & ext

        If ext = "txt" Or ext = "log" Then
            Debug.Print "    PASS: extension coerced to a registered type (." & ext & ")"
        Else
            Debug.Print "    FAIL: '." & ext & "' is not txt/log -- strict coercion did not fire."
        End If
    End Sub

    Public Sub Test_Interactive_VBA_Style_Works()
        Prompt "VBA-STYLE USAGE: Open dialog appears, constructed VBA-style " & _
               "(parameterless New, then DialogType property). Cancel to continue."
        Dim fd As New FileDialog
        fd.DialogType = fdOpen
        fd.Title = "TEST: Constructed via 'Dim fd As New FileDialog' (VBA-style). Cancel to continue"
        fd.AddFilter "All Files", "*.*"
        Dim e As Long
        On Error Resume Next
        fd.Show
        e = Err.Number
        On Error GoTo 0
        Assert.Strict.AreEqual 0&, CLng(e)              ' VBA-style shows dialog without error
    End Sub

    Public Sub Test_Interactive_InvalidInitialFolderRaises()
        Prompt "INVALID INITIAL FOLDER: No dialog should appear. An error should be raised " & _
               "and caught by the test."
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.InitialFolderPath = "C:\This\Path\Definitely\Does\Not\Exist\xyzqrs"
        Dim e As Long
        On Error Resume Next
        fd.Show
        e = Err.Number
        On Error GoTo 0
        Assert.Strict.AreEqual vbObjectError + 102&, e            ' invalid InitialFolderPath raises 102
    End Sub

    Public Sub Test_Interactive_InvalidGuidRaises()
        Prompt "INVALID GUID: No dialog should appear. An error should be raised " & _
               "and caught by the test."
        Dim fd As FileDialog: Set fd = New FileDialog(fdOpen)
        fd.ClientGuid = "this-is-not-a-guid"
        Dim e As Long
        On Error Resume Next
        fd.Show
        e = Err.Number
        On Error GoTo 0
        Assert.Strict.AreEqual 104&, CLng(e)            ' invalid ClientGuid raises 104
    End Sub
    
    Public Sub Test_Interactive_EnforceFilterExtensions()
        Prompt "ENFORCE FILTER EXTENSIONS: A Save dialog appears with .txt and .log " & _
               "filters and EnforceFilterExtensions turned on." & vbCrLf & vbCrLf & _
               "STEP 1: type 'foo.xyz' and click Save -- the dialog should pop its own " & _
               "message and STAY OPEN. (If it closes here, the feature is broken.)" & vbCrLf & _
               "STEP 2: change it to 'foo.txt' (or 'foo.log') and click Save -- it should " & _
               "close normally." & vbCrLf & vbCrLf & _
               "Click Cancel at any time to skip. No file is written to disk."

        Dim fd As FileDialog: Set fd = New FileDialog(fdSaveAs)
        fd.Title = "TEST: foo.xyz rejected; foo.txt/.log accepted"
        fd.AddFilter "Text", "*.txt"
        fd.AddFilter "Log", "*.log"
        fd.EnforceFilterExtensions = True
        ' Deliberately NO StrictFileTypes / DefaultExtension -- enforcement must see
        ' the raw typed name, not a name Windows already coerced.

        If Not fd.Show() Then
            Debug.Print "    SKIP: dialog cancelled -- enforcement not exercised."
            Exit Sub
        End If

        Dim resultPath As String: resultPath = fd.SelectedItems(1)
        Dim dotPos As Long: dotPos = InStrRev(resultPath, ".")
        Dim sepPos As Long: sepPos = InStrRev(resultPath, "\")
        Dim ext As String
        If dotPos > sepPos Then ext = LCase$(Mid$(resultPath, dotPos + 1))

        Debug.Print "    Returned path : " & resultPath
        Debug.Print "    Final ext     : ." & ext

        If ext = "txt" Or ext = "log" Then
            Debug.Print "    PASS: dialog only closed with a permitted extension (." & ext & ")."
            Debug.Print "          (You should ALSO have seen the rejection message on foo.xyz.)"
        Else
            Debug.Print "    FAIL: closed with '." & ext & "' -- a bad extension got through."
        End If
    End Sub
    
    Public Sub Test_Interactive_NavigationRoot()
        Dim rootPath As String
        rootPath = Environ$("USERPROFILE") & "\Documents"

        If Len(Dir$(rootPath, vbDirectory)) = 0 Then
            Debug.Print "    SKIP: test root folder not found: " & rootPath
            Exit Sub
        End If

        Prompt "NAVIGATION ROOT: A Save dialog opens confined to:" & vbCrLf & _
               rootPath & vbCrLf & vbCrLf & _
               "STEP 1 (look): the nav pane should be rooted here -- you should NOT be " & _
               "able to browse up to its parent (" & Environ$("USERPROFILE") & "). " & _
               "Also note the Cancel button now reads 'Skip Test'." & vbCrLf & _
               "STEP 2 (escape): type a full path OUTSIDE the root, e.g. C:\Windows\foo.txt, " & _
               "and click Save -- it should be REJECTED (Windows refuses it, or you'll see a " & _
               "'Location Not Allowed' message) and the dialog STAYS OPEN." & vbCrLf & _
               "STEP 3: type a name inside the root (e.g. foo.txt) and click Save -- it closes." & _
               vbCrLf & vbCrLf & "Click 'Skip Test' to skip. No file is written."

        Dim fd As FileDialog: Set fd = New FileDialog(fdSaveAs)
        fd.Title = "TEST: confined to Documents; try to escape, then save inside"
        fd.NavigationRoot = rootPath
        fd.StrictNavigationRoot = True       ' also reject typed escapes
        fd.CancelButtonName = "Skip Test"    ' bonus: verify the relabeled Cancel button
        fd.AddFilter "Text", "*.txt"

        If Not fd.Show() Then
            Debug.Print "    SKIP: dialog cancelled -- confinement not fully exercised."
            Exit Sub
        End If

        Dim resultPath As String: resultPath = fd.SelectedItems(1)
        Debug.Print "    Returned path : " & resultPath
        Debug.Print "    Nav root      : " & rootPath

        If TestPathIsUnder(resultPath, rootPath) Then
            Debug.Print "    PASS: result is inside the navigation root."
            Debug.Print "          (Also confirm visually: you couldn't browse above the root,"
            Debug.Print "           the C:\Windows path was rejected, and Cancel read 'Skip Test'.)"
        Else
            Debug.Print "    FAIL: result is OUTSIDE the root -- StrictNavigationRoot did not hold."
        End If
    End Sub
    
    Public Sub Test_Interactive_FileOk_Veto_KeepsDialogOpen()
        ' THE load-bearing test. The whole veto mechanism depends on
        ' ERR_EVENT_CANCELLED propagating UNTRAPPED out of the sink, where tB turns
        ' it into a failed HRESULT that the shell reads as "stay open". Moving the
        ' error constants to vbObjectError could in principle change the HRESULT the
        ' shell sees, so this proves the veto still holds end to end.
        Prompt "FILEOK VETO: A Save dialog appears. A handler REJECTS any name " & _
               "containing a space." & vbCrLf & vbCrLf & _
               "STEP 1: type a name WITH a space (e.g. 'my file.txt') and click Save -- " & _
               "you should see a 'no spaces' message and the dialog MUST STAY OPEN. " & _
               "(If it closes here, the veto is broken.)" & vbCrLf & _
               "STEP 2: change it to a name with NO spaces (e.g. 'myfile.txt') and click " & _
               "Save -- it should close normally." & vbCrLf & vbCrLf & _
               "Click Cancel to skip. No file is written."

        Dim fd As FileDialog: Set fd = New FileDialog(fdSaveAs)
        fd.Title = "TEST: names with spaces are rejected; the dialog stays open"
        fd.AddFilter "Text", "*.txt"

        Dim sink As New VetoCountingSink
        Set sink.fd = fd

        Dim ok As Boolean: ok = fd.Show()

        If Not ok Then
            Debug.Print "    SKIP: dialog cancelled -- veto not exercised."
            Exit Sub
        End If

        Dim resultPath As String: resultPath = fd.SelectedItems(1)
        Debug.Print "    Returned path : " & resultPath
        Debug.Print "    FileOk fired  : " & sink.FileOkCount & " time(s)"
        Debug.Print "    Vetoes raised : " & sink.VetoCount

        ' Two independent things must hold:
        '   1. the returned name has no space  -> the veto actually blocked the bad one
        '   2. FileOk fired at least twice     -> proof the dialog reopened after a veto
        '      rather than the human simply never typing a bad name
        If InStr(resultPath, " ") > 0 Then
            Debug.Print "    FAIL: returned a name WITH a space -- the veto did not hold."
        ElseIf sink.VetoCount = 0 Then
            Debug.Print "    INCONCLUSIVE: no veto ever fired. Re-run and type a spaced"
            Debug.Print "                  name first, or the test proves nothing."
        Else
            Debug.Print "    PASS: a spaced name was vetoed, the dialog stayed open, and"
            Debug.Print "          it closed only once a space-free name was entered."
        End If
    End Sub
    
    Public Sub SanityTest_ResultPlumbing()
        Debug.Print "=== FileDialog result-plumbing sanity (interactive) ==="
        Debug.Print "Confirm ANY item in each dialog (or Cancel to skip a case)."
        CheckPlumbing fdOpen, "OPEN: select any existing file, then click Open."
        CheckPlumbing fdSaveAs, "SAVE: type any new name, then click Save. No file is written."
        CheckPlumbing fdFolderPicker, "FOLDER: select any folder, then click Select Folder."
        Debug.Print "=== Sanity run complete ==="
    End Sub

    Private Sub CheckPlumbing(ByVal dt As FileDialogType, ByVal instruction As String)
        Dim typeName As String
        Select Case dt
            Case fdOpen:         typeName = "fdOpen"
            Case fdSaveAs:       typeName = "fdSaveAs"
            Case fdFolderPicker: typeName = "fdFolderPicker"
        End Select

        Prompt instruction

        Dim fd As FileDialog: Set fd = New FileDialog(dt)
        fd.Title = "PLUMBING TEST (" & typeName & "): confirm any item, or Cancel to skip"

        Dim ok As Boolean: ok = fd.Show()

        If Not ok Then
            ' Disambiguate a real cancel from a plumbing bug that drops the result.
            Dim clicked As VbMsgBoxResult
            clicked = MsgBox("Did you click the action button (Open / Save / Select Folder), " & _
                             "rather than Cancel?", vbYesNo + vbQuestion, typeName)
            If clicked = vbYes Then
                Debug.Print "    FAIL " & typeName & ": action confirmed but Show()=False -- " & _
                            "result plumbing dropped the selection."
            Else
                Debug.Print "    SKIP " & typeName & ": cancelled (plumbing not exercised)."
            End If
            Exit Sub
        End If

        ' A True return MUST come with a populated SelectedItems holding a real path.
        If fd.SelectedItems Is Nothing Then
            Debug.Print "    FAIL " & typeName & ": Show()=True but SelectedItems is Nothing."
        ElseIf fd.SelectedItems.Count < 1 Then
            Debug.Print "    FAIL " & typeName & ": Show()=True but SelectedItems.Count = 0."
        ElseIf Len(fd.SelectedItems(1)) = 0 Then
            Debug.Print "    FAIL " & typeName & ": SelectedItems(1) is empty."
        Else
            Debug.Print "    PASS " & typeName & ": " & fd.SelectedItems(1)
        End If
    End Sub

    ' Local copy of the class's private containment check, used by the assertion.
    Private Function TestPathIsUnder(ByVal path As String, ByVal root As String) As Boolean
        If Len(path) = 0 Or Len(root) = 0 Then Exit Function
        Dim p As String: p = LCase$(Trim$(path))
        Dim r As String: r = LCase$(Trim$(root))
        Do While Len(p) > 0 And Right$(p, 1) = "\": p = Left$(p, Len(p) - 1): Loop
        Do While Len(r) > 0 And Right$(r, 1) = "\": r = Left$(r, Len(r) - 1): Loop
        If p = r Then TestPathIsUnder = True: Exit Function
        TestPathIsUnder = (Left$(p, Len(r) + 1) = r & "\")
    End Function
    

    ' =========================================================================
    ' Interactive prompt helper (not an assertion)
    ' =========================================================================
    Private Sub Prompt(ByVal message As String)
        Debug.Print
        Debug.Print "--> " & message
        MsgBox message, vbInformation, "FileDialog test"
    End Sub
    
    ' Returns the final extension of a path (no leading dot), or "" if none.
    ' Guards against dots that appear in folder names rather than the file name.
    Private Function GetFinalExtension(ByVal path As String) As String
        Dim dotPos As Long:   dotPos = InStrRev(path, ".")
        Dim slashPos As Long: slashPos = InStrRev(path, "\")
        If dotPos > slashPos And dotPos > 0 Then
            GetFinalExtension = Mid$(path, dotPos + 1)
        End If
    End Function

End Module

' Event sink for the veto test. Counts OnFileOk fires and vetoes so the test can
' assert the veto ACTUALLY happened, not just trust the human to have typed a bad
' name. Rejects any name containing a space.

Private Class VetoCountingSink

    Public WithEvents fd As FileDialog
    Public FileOkCount As Long
    Public VetoCount As Long

    Private Sub fd_FileOk(ByVal itemPath As String, ByRef Cancel As Boolean)
        FileOkCount = FileOkCount + 1
        If InStr(itemPath, " ") > 0 Then
            VetoCount = VetoCount + 1
            MsgBox "Spaces aren't allowed in the file name.", vbExclamation
            Cancel = True                 ' the line under test: must keep the dialog open
        End If
    End Sub

End Class
