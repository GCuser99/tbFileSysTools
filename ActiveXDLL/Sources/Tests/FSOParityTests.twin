    Sub test_getparentname()
        Dim fso As New FileSystemObject
        Dim in As String
        Dim out As String
        Dim p As String

        p = "C:\Users\waite\Documents\twin basic\ChibiArc\ChibiArc.cls"
        Debug.Print fso.GetParentFolderName(p)
        Debug.Print fso.GetParentFolderName(fso.GetParentFolderName(p))
        Debug.Print GetParentFolderName(p)
        Debug.Print GetParentFolderName(GetParentFolderName(p))
        Dim c As Drives
        Set c = GetDrives() '<- change to GetDrives
        Debug.Print c(1), c.Count
        Debug.Print fso.GetFile(p).ShortPath
        Debug.Print GetFile(p).ShortPath
        Dim d As Folder, f As File
        Set d = GetFolder(GetParentFolderName(p))
        For Each f In d.Files
            If Not (f.Attributes And Hidden) Then
                Debug.Print f.Path
            End If
        Next f
        'Dim fso2 As New Scripting.FileSystemObject
        'fso uses IFolder and IFile
        'fso2.GetFile(path:="" )
    End Sub
End Module