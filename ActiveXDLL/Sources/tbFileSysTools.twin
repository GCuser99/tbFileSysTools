    ' Copies a COM-allocated LPWSTR into a VB String and (by default) frees the
    ' original with CoTaskMemFree. Only pass fFree:=False for a pointer we do NOT own.
    Public Function LPWSTRtoStr(lPtr As LongPtr, Optional ByVal fFree As Boolean = True) As String
        SysReAllocStringW VarPtr(LPWSTRtoStr), lPtr
        If fFree Then
            Call CoTaskMemFree(lPtr)
            lPtr = 0
        End If
    End Function
    
    '*/

End Module
