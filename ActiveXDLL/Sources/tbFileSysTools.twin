' ==========================================================================
' FileSystemObject
'
' A drop-in replacement for Scripting Runtime's FileSystemObject.
'
' --- Why this class exists ------------------------------------------------
' All the real work lives in the FileSystemTools standard module. This class adds
' nothing but a COM-creatable surface over it, because a standard module cannot be
' one. It is the entry point for:
'   * late binding      - CreateObject("tbFileworks.FileSystemObject")
'   * VBA / VBScript / any COM host that expects an OBJECT, not a module
'   * code being ported from Scripting.FileSystemObject, which can keep its
'     "Set fso = New FileSystemObject" shape unchanged
'
' twinBASIC callers should prefer FileSystemTools directly - it is the same API
' with one less indirection. Nothing here is available that is not there.
'
' It may also compile smaller. Every member of a COM-creatable class is reachable
' by definition - the type library exposes it - so the compiler cannot strip the
' parts never called. Reach the module directly and unused procedures can be
' eliminated.
'
' Argument NAMES do differ with the module version, deliberately: this class uses 
' FSO's names (fileSpec,folderSpec, driveSpec) so that IntelliSense and named 
' arguments match what a porter expects, while the module uses clearer ones
' (filePath, folderPath). That is the only permitted difference.
'
' --- Name collision -------------------------------------------------------
' This class is deliberately called FileSystemObject, the same as Scripting's. In
' a project referencing BOTH, a bare "New FileSystemObject" is ambiguous and
' resolves by reference order. Qualify it (tbFileSysTools.FileSystemObject) or drop
' the Scripting Runtime reference.
'
' --- Where this DEVIATES from Scripting.FileSystemObject ------------------
' Parity is the goal, but not at any price. The deliberate breaks, all verified
' against the real FSO as an oracle:
'
'   Folder.Size   - does NOT follow directory reparse points. FSO does, and will
'                   therefore double-count a junction into its own subtree
'                   and recurse forever on a junction to an ancestor. 
'                   This version reports what physically lives there.
'   Attributes    - FSO's Volume (8) and Alias (1024) are not provided. Volume has
'                   no Win32 equivalent; Alias is FILE_ATTRIBUTE_REPARSE_POINT
'                   under a misleading name (and collides with VBA's vbAlias = 64).
'                   Use ReparsePoint. Added: SetAttribute / HasAttribute, which
'                   flip or test ONE bit rather than replacing the whole set.
'   Enumeration   - an unreadable folder RAISES rather than reporting itself empty.
'
' --- Enhancements over FSO ------------------------------------------------
'   Encodings           - full code-page support on read and write, with BOM handling and
'                           auto-detection. FSO offers ASCII and UTF-16 only.
'   Large files         - streams past 2GB and past 4GB, in both directions, including
'                           append. Windows' own LOF/Seek cannot.
'   Line endings        - detect, preserve on append, and normalize in place.
'   GetSpecialFolder    - Expanded special folder enum.
'   Added members       - GetRelativePath, CleanFileName, GetFilePaths,
'                           GetCurrentDir, SetCurrentDir, GetFileEncoding,
'                           GetFileType, GetFileLineEnding, Rename,
'                           NormalizeTextFile, ReadStream/WriteStream,
'                           and the TextFile<->String/Array helpers.
' ==========================================================================
' MIT License - Copyright (c) 2026, GCUser99 (https://github.com/GCUser99)
' ==========================================================================
[Hidden(False)]
[Description("This class replaces or improves on most functionality of the FileSystemObject, adding reading and writing on non-UTF16 encoded files.")]
Private Class FileSystemObject
    Option Explicit

    [Description("Returns the file's version. By default (fvFixed) returns the binary version as major.minor.build.revision, fvFileString returns the authored StringFileInfo FileVersion string and fvProductString returns the ProductVersion string; both fall back to the fixed version when the file has no string block. Returns an empty string when the file carries no version resource.")]
    Public Function GetFileVersion(ByVal fileName As String, Optional ByVal source As FileVersionSource = fvFixed) As String
        Return FileSystemTools.GetFileVersion(fileName, source)
    End Function
    
    [Description("Returns the shell's type description for a file or folder (e.g. ""Text Document"", ""Application"", ""File Folder""), the same string Explorer and Scripting.FileSystemObject's File.Type show. Falls back to ""<EXT> File"" or ""File"" when the shell is unavailable.")]
    Public Function GetFileType(ByVal filePath As String) As String
        Return FileSystemTools.GetFileType(filePath)
    End Function
    
    [Description("Deletes the specified file (wildcards supported). force clears a read-only attribute first. ignoreMissing (default False) suppresses the file-not-found error when the path or wildcard pattern matches nothing; it does not suppress other failures such as the path being a directory or the file being locked.")]
    Public Sub DeleteFile(ByVal fileSpec As String, Optional ByVal force As Boolean = False, Optional ByVal ignoreMissing As Boolean = False)
        FileSystemTools.DeleteFile fileSpec, force, ignoreMissing
    End Sub

    [Description("Copies a file to the destination path specified. Wildcards are supported in the last component of source.")]
    Public Sub CopyFile(ByVal source As String, ByVal destination As String, Optional ByVal overwrite As Boolean = True)
        FileSystemTools.CopyFile source, destination, overwrite
    End Sub
    
    [Description("Copies a folder to the destination path specified.")]
    Public Sub CopyFolder(ByVal source As String, ByVal destination As String, Optional ByVal overwrite As Boolean = True)
        FileSystemTools.CopyFolder source, destination, overwrite
    End Sub
    
    [Description("Combines a folder path and the name of a folder or file and returns the combination with valid path separators.")]
    Public Function BuildPath(ByVal path As String, ByVal name As String) As String
        Return FileSystemTools.BuildPath(path, name)
    End Function
    
    [Description("Returns True if a specified folder exists; False if it does not.")]
    Public Function FolderExists(ByVal folderSpec As String) As Boolean
        Return FileSystemTools.FolderExists(folderSpec)
    End Function
    
    [Description("Deletes a folder and its contents (wildcards supported). force clears read-only attributes as it goes. ignoreMissing (default False) suppresses the path-not-found error when the folder or wildcard pattern matches nothing; it does not suppress other failures such as the path being a file or the folder being locked or non-empty.")]
    Public Sub DeleteFolder(ByVal folderSpec As String, Optional ByVal force As Boolean = False, Optional ByVal ignoreMissing As Boolean = False)
        FileSystemTools.DeleteFolder(folderSpec, force, ignoreMissing)
    End Sub
    
    [Description("Returns True if a specified file exists; False if it does not.")]
    Public Function FileExists(ByVal fileSpec As String) As Boolean
        Return FileSystemTools.FileExists(fileSpec)
    End Function
    
    [Description("Returns True if a specified drive exists; False if it does not.")]
    Public Function DriveExists(ByVal driveSpec As String) As Boolean
        Return FileSystemTools.DriveExists(driveSpec)
    End Function
    
    [Description("Moves one or more files from one location to another.")]
    Public Sub MoveFile(ByVal source As String, ByVal destination As String)
        FileSystemTools.MoveFile source, destination
    End Sub

    [Description("Moves a folder from one location to another.")]
    Public Sub MoveFolder(ByVal source As String, ByVal destination As String)
        FileSystemTools.MoveFolder source, destination
    End Sub
    
    [Description("Creates a folder and returns the new Folder. Errors if it already exists. By default only the leaf is created; pass createIntermediates:=True to also create any missing intermediate folders.")]
    Public Function CreateFolder(ByVal path As String, Optional ByVal createIntermediates As Boolean = False) As Folder
        Set CreateFolder = FileSystemTools.CreateFolder(path, createIntermediates)
    End Function

    [Description("Returns a randomly generated temporary file or folder name. If inFolder is supplied, the returned name is one that does not already exist in that folder at the time of the call.")]
    Public Function GetTempName(Optional ByVal prefix As String, Optional ByVal extension As String = ".tmp", Optional ByVal inFolder As String = "") As String
        Return FileSystemTools.GetTempName(prefix, extension, inFolder)
    End Function
    
    [Description("Returns a complete and unambiguous path from a provided path specification.")]
    Public Function GetAbsolutePathName(ByVal path As String, Optional ByVal baseDirectory As String = "", Optional ByVal useLongPathPrefix As Boolean = False) As String
        Return FileSystemTools.GetAbsolutePathName(path, baseDirectory, useLongPathPrefix)
    End Function
    
    [Description("Cleans a file name (not a path) of items that are invalid in Windows: the reserved characters \ / : * ? "" < > |, control characters, leading/trailing spaces, trailing dots, and reserved device names such as CON, PRN, NUL, COM0-9 and LPT0-9.")]
    Public Function CleanFileName(ByVal fileName As String, Optional ByVal replaceChar As String = "") As String
        Return FileSystemTools.CleanFileName(fileName, replaceChar)
    End Function
    
    [Description("Returns the last component of a specified path that is not part of the drive specification.")]
    Public Function GetFileName(ByVal path As String) As String
        Return FileSystemTools.GetFileName(path)
    End Function

    [Description("Returns a string containing the name of the parent folder of the last component in a specified path.")]
    Public Function GetParentFolderName(ByVal path As String) As String
        Return FileSystemTools.GetParentFolderName(path)
    End Function
    
    [Description("Returns a string containing the extension name for the last component in a path.")]
    Public Function GetExtensionName(ByVal path As String) As String
        Return FileSystemTools.GetExtensionName(path)
    End Function
    
    [Description("Returns a string containing the base name of the last component, less any file extension, in a path.")]
    Public Function GetBaseName(ByVal path As String) As String
        Return FileSystemTools.GetBaseName(path)
    End Function
    
    [Description("Returns a string containing the name of the drive for a specified path.")]
    Public Function GetDriveName(ByVal path As String) As String
        Return FileSystemTools.GetDriveName(path)
    End Function
    
    [Description("Returns the current directory.")]
    Public Function GetCurrentDir() As String
        Return FileSystemTools.GetCurrentDir()
    End Function
    
    [Description("Sets the current directory.")]
    Public Sub SetCurrentDir(ByVal folderPath As String)
        FileSystemTools.SetCurrentDir folderPath
    End Sub

    [Description("Renames a file or folder in place. The new name must be a bare name, or a path that resolves to the same folder as the source — it cannot move the item to a different folder. Wildcards are not permitted, and the destination must not already exist.")]
    Public Sub Rename(ByVal source As String, ByVal newName As String)
        FileSystemTools.Rename source, newName
    End Sub
    
    [Description("Returns the absolute path to the requested known folder. The returned path does NOT include a trailing backslash.")]
    Public Function GetSpecialFolder(ByVal specialFolder As SpecialFolderConst) As String
        Return FileSystemTools.GetSpecialFolder(specialFolder)
    End Function

    [Description("Returns a relative path from a base path to a target path. The base path is treated as a folder by default. Relative inputs are resolved against the current directory. Returns the absolute target if no relative path exists (e.g. different drives).")]
    Public Function GetRelativePath(ByVal basePath As String, ByVal targetPath As String, _
        Optional ByVal basePathIsFolder As Boolean = True, _
        Optional ByVal trimLeadingDotSlash As Boolean = True) As String
        Return FileSystemTools.GetRelativePath(basePath, targetPath, basePathIsFolder, trimLeadingDotSlash)
    End Function
    
    [Description("Returns a Collection of full file paths in the specified folder. Supports a wildcard pattern, optional recursion into subfolders, inclusion of hidden/system files.")]
    Public Function GetFilePaths(ByVal folderPath As String, _
        Optional ByVal pattern As String = "*", _
        Optional ByVal includeHidden As Boolean = False, _
        Optional ByVal includeSystem As Boolean = False, _
        Optional ByVal recursive As Boolean = False) As Collection
        Set GetFilePaths = FileSystemTools.GetFilePaths(folderPath, pattern, includeHidden, includeSystem, recursive)
    End Function

    [Description("Detects a file's text encoding from a head sample (default 64 KB): BOM sniff first, then UTF-16/32 and UTF-8 heuristics, else system ANSI. Returns a signed TextEncoding (negative = BOM present), or encUnknown if the file is empty or looks binary. Raises if the file cannot be read.")]
    Public Function GetFileEncoding(ByVal filePath As String, Optional ByVal sampleBytes As Long = 65536) As TextEncoding
        Return FileSystemTools.GetFileEncoding(filePath, sampleBytes)
    End Function
    
    [Description("Reads an entire text file to a string. With encAutoDetect (default) the encoding is detected, and a binary file raises; with an explicit encoding that encoding is used as-is (a byte-order mark still overrides it). A leading BOM is stripped. An empty file returns an empty string. Optionally normalizes line endings.")]
    Public Function TextFileToString(ByVal filePath As String, _
        Optional ByVal encoding As TextEncoding = encAutoDetect, _
        Optional ByVal outLineEnding As NewlineType = nlNoChange) As String
        Return FileSystemTools.TextFileToString(filePath, encoding, outLineEnding)
    End Function
    
    [Description("Writes a string to a file in the specified encoding (a BOM is emitted only for BOM-bearing members such as encUtf8Bom). Overwrites any existing file.")]
    Public Sub StringToTextFile(ByVal text As String, ByVal filePath As String, _
        Optional ByVal encoding As TextEncoding = encUtf8, _
        Optional ByVal outLineEnding As NewlineType = nlNoChange)
        FileSystemTools.StringToTextFile text, filePath, encoding, outLineEnding
    End Sub
    
    [Description("Writes an array of lines to a file in the specified encoding (a BOM is emitted only for BOM-bearing members such as encUtf8Bom). Overwrites any existing file.")]
    Public Sub ArrayToTextFile(ByRef lines() As String, ByVal filePath As String, _
        Optional ByVal encoding As TextEncoding = encUtf8, _
        Optional ByVal lineEnding As NewlineType = nlWindows)
        FileSystemTools.ArrayToTextFile lines, filePath, encoding, lineEnding
    End Sub
    
    [Description("Reads a text file into an array of lines (mixed CR/LF/CRLF handled). Encoding auto-detected by default. A trailing newline yields a final empty element. An empty file returns an unallocated array.")]
    Public Function TextFileToArray(ByVal filePath As String, Optional ByVal encoding As TextEncoding = encAutoDetect) As String()
        Return FileSystemTools.TextFileToArray(filePath, encoding)
    End Function
    
    [Description("Reads the file specified into a byte array.")]
    Public Sub ReadStream(ByVal filePath As String, ByRef stream() As Byte, Optional ByVal maxBytesToRead As Long = -1)
        FileSystemTools.ReadStream filePath, stream, maxBytesToRead
    End Sub
    
    [Description("Writes a byte array to the file specified.")]
    Public Sub WriteStream(ByRef stream() As Byte, ByVal filePath As String)
        FileSystemTools.WriteStream stream, filePath
    End Sub
    
    [Description("Opens a text file and returns a streaming TextStream. For reading, omit encoding (encAutoDetect) to detect it from a head sample. For writing/appending, encoding selects the output encoding (default UTF-8, no BOM). Encodings whose chunk boundaries cannot be managed (UTF-7, unclassifiable code pages) transparently fall back to a buffered path.")]
    Public Function OpenTextFile(ByVal fileName As String, _
        Optional ByVal ioMode As IOMode = ForReading, _
        Optional ByVal create As Boolean = False, _
        Optional ByVal encoding As TextEncoding = encAutoDetect, _
        Optional ByVal writeModeLineEnding As NewlineType = nlWindows) As TextStream
        Set OpenTextFile = FileSystemTools.OpenTextFile(fileName, ioMode, create, encoding, writeModeLineEnding)
    End Function

    [Description("Creates (or overwrites) a text file and returns a TextStream open for writing.")]
    Public Function CreateTextFile(ByVal fileName As String, _
        Optional ByVal overwrite As Boolean = True, _
        Optional ByVal encoding As TextEncoding = encUtf8, _
        Optional ByVal lineEnding As NewlineType = nlWindows) As TextStream
        Set CreateTextFile = FileSystemTools.CreateTextFile(fileName, overwrite, encoding, lineEnding)
    End Function

    ' --- public factories -------------------------------------------------
    [Description("Returns a File object for an existing file.")]
    Public Function GetFile(ByVal filePath As String) As File
        Set GetFile = FileSystemTools.GetFile(filePath)
    End Function

    [Description("Returns a Folder object for an existing folder.")]
    Public Function GetFolder(ByVal folderPath As String) As Folder
        Set GetFolder = FileSystemTools.GetFolder(folderPath)
    End Function

    [Description("Returns a Drive object for a drive spec: ""C"", ""C:"", ""C:\"", a UNC share, or any path on the drive.")]
    Public Function GetDrive(ByVal driveSpec As String) As Drive
        Set GetDrive = FileSystemTools.GetDrive(driveSpec)
    End Function
    
    [Description("Returns a Drives collection of all logical drives present on the system.")]
    Public Function Drives() As Drives
        Set Drives = FileSystemTools.GetDrives()
    End Function

    [Description("Returns a TextStream over one of the process's standard streams. unicode:=True gives UTF-16LE (no BOM); default is the system ANSI code page. Raises if no handle is available (e.g. no console).")]
    Public Function GetStandardStream(ByVal standardStreamType As StandardStreamTypes, Optional ByVal unicode As Boolean = False) As TextStream
        Set GetStandardStream = FileSystemTools.GetStandardStream(standardStreamType, unicode)
    End Function
 
    [Description("Rewrites a text file in place in the target encoding and newline style (source auto-detected). toAttributes enforces a target attribute set (settable bits only); NoChange (the default) preserves the file's current attributes. Skips the write when content is already in target form. Refuses binary files. Returns True if the file was modified.")]
    Public Function NormalizeTextFile(ByVal filePath As String, _
        Optional ByVal toEncoding As TextEncoding = encUtf8, _
        Optional ByVal toNewLine As NewlineType = nlWindows, _
        Optional ByVal fromEncoding As TextEncoding = encAutoDetect, _
        Optional ByVal toAttributes As FileAttribute = NoChange, _
        Optional ByVal skipIfUnchanged As Boolean = True) As Boolean
        Return FileSystemTools.NormalizeTextFile(filePath, toEncoding, toNewLine, fromEncoding, toAttributes, skipIfUnchanged)
    End Function
    
    [Description("Reads a text file and reports its line-ending style: nlWindows / nlUnix / nlMacintosh for a consistent file, nlMixed if it contains more than one, or nlUnknown if it has none. Reads the whole file, so the result (including mixed) is exact.")]
    Public Function GetFileLineEnding(ByVal filePath As String, Optional ByVal encoding As TextEncoding = encAutoDetect) As NewlineType
        Return FileSystemTools.GetFileLineEnding(filePath, encoding)
    End Function
    
End Class

' ==========================================================================
' FileSystemTools
'
' A replacement for Scripting Runtime's FileSystemObject.
' Most methods from that library are represented here, either matching
' the functionality or enhancing it. The most notable enhancement is support
' for a full range of code pages for reading and writing text files.
'
' --- Conventions used throughout this module ------------------------------
' * Every public entry point normalizes "/" to "\" on the way in. Private
'   helpers therefore ASSUME slash-normalized input and do not re-normalize.
' * Error numbers follow FSO for compatibility:
'       5  = invalid procedure call / argument (also "not decodable text")
'       52 = bad file name or number
'       53 = file not found
'       58 = file/folder already exists
'       68 = device unavailable (bad drive spec)
'       76 = path not found
'   RaiseFromLastError (in Shared) maps Win32 error codes onto these.
' * Wildcard operations follow a strict two-phase pattern: enumerate matches
'   into a Collection and CLOSE the find handle, then act. Mutating the
'   directory while a FindFirstFile handle is open on it gives undefined
'   enumeration results, so never collapse these into one loop.
' * Text encodings are signed: a negative TextEncoding member means "with BOM".
'   All encode/decode/detect work is delegated to TextCodec.
' ==========================================================================
' MIT License - Copyright (c) 2026, GCUser99 (https://github.com/GCUser99)
' ==========================================================================

Public Module FileSystemTools
    Option Explicit

    Private Const ERR_NOT_TEXT As Long = 5   ' shared "refused: content isn't decodable text"

    '--- GUID string constants (implementation detail) -------------
    ' KNOWNFOLDERID values from <KnownFolders.h>. Parsed on demand by
    ' GuidFromString so the module has no WinDevLib dependency (see the
    ' commented-out FOLDERID_*() alternative in GetSpecialFolder).
    Private Const KFID_Windows_STR          As String = "{F38BF404-1D43-42F2-9305-67DE0B28FC23}"
    Private Const KFID_System_STR           As String = "{1AC14E77-02E7-4E5D-B744-2EB1AE5198B7}"
    Private Const KFID_SystemX86_STR        As String = "{D65231B0-B2F1-4857-A4CE-A8E7C6EA7D27}"
    Private Const KFID_ProgramFiles_STR     As String = "{905E63B6-C1BF-494E-B29C-65B732D3D21A}"
    Private Const KFID_ProgramFilesX86_STR  As String = "{7C5A40EF-A0FB-4BFC-874A-C0F2E0B9FA8E}"
    Private Const KFID_ProgramData_STR      As String = "{62AB5D82-FDC1-4DC3-A9DD-070D1D495D97}"
    Private Const KFID_Profile_STR          As String = "{5E6C858F-0E22-4760-9AFE-EA3317B67173}"
    Private Const KFID_Desktop_STR          As String = "{B4BFCC3A-DB2C-424C-B029-7FE99A87C641}"
    Private Const KFID_Documents_STR        As String = "{FDD39AD0-238F-46AF-ADB4-6C85480369C7}"
    Private Const KFID_Downloads_STR        As String = "{374DE290-123F-4565-9164-39C4925E467B}"
    Private Const KFID_Pictures_STR         As String = "{33E28130-4E1E-4676-835A-98395C3BC3BB}"
    Private Const KFID_Music_STR            As String = "{4BD8D571-6D19-48D3-BE97-422220080E43}"
    Private Const KFID_Videos_STR           As String = "{18989B1D-99B5-455B-841C-AB7C74E4DDFC}"
    Private Const KFID_LocalAppData_STR     As String = "{F1B32785-6FBA-4FCF-9D55-7B8E7F157091}"
    Private Const KFID_RoamingAppData_STR   As String = "{3EB685DB-65F9-4CF6-A03A-E3EF65729F3D}"
    Private Const KFID_PublicDesktop_STR    As String = "{C4AA340D-F20F-4863-AFEF-F87EF2E6BA25}"
    Private Const KFID_PublicDocuments_STR  As String = "{ED4824AF-DCE4-45A8-81E2-FC7965083634}"
    Private Const KFID_PublicDownloads_STR  As String = "{3D644C9B-1FB8-4F30-9B45-F670235F79C0}"
    Private Const KFID_PublicPictures_STR   As String = "{B6EBFB86-6907-413C-9AF7-4FC2ABF07CC5}"
    Private Const KFID_PublicMusic_STR      As String = "{3214FAB5-9757-4298-BB61-92A9DEAA44FF}"
    Private Const KFID_PublicVideos_STR     As String = "{2400183A-6185-49FB-A2D8-4A392A602BA3}"
    Private Const KFID_Fonts_STR            As String = "{FD228CB7-AE11-4AE3-864C-16F3910AB8FE}"
    Private Const KFID_Startup_STR          As String = "{B97D20BB-F46A-4C97-BA10-5E3608430854}"
    Private Const KFID_CommonStartup_STR    As String = "{82A5EA35-D9CD-47C5-9629-E15D2F714E6E}"
        
    '-------------------------------------------------------------------------------------------------
    '--------------------------------------- Public Members ------------------------------------------
    '-------------------------------------------------------------------------------------------------
    
    '=================================================================================================
    ' Enumerations
    '=================================================================================================

    ' https://learn.microsoft.com/en-us/windows/win32/intl/code-page-identifiers

    'The class module versions honor the Scripting FSO argument names for compatibility
    'Note the static module version of these procedures have some renamed input arguments for consistency

    ' TextEncoding is a SIGNED code page:
    '   positive  -> that Windows code page, no BOM emitted on write
    '   negative  -> the same code page, BOM emitted on write / expected on read
    '   -1        -> encAutoDetect on input, encUnknown on output (see below)
    ' The -1 overload is deliberate: a "detect" request and an "undetermined"
    ' result are the same value, so a round-trip through Detect() never loses
    ' the caller's intent. Anything reading this enum must therefore branch on
    ' encUnknown BEFORE treating the value as a code page.
    Public Enum TextEncoding
        encUnknown = -1                 ' result: undetermined (alias of encAutoDetect)
        encAutoDetect = -1              ' read directive: detect heuristically

        ' No-BOM encodings = the Windows code page (also the raw passthrough)
        encSystemAnsi = 0               ' CP_ACP
        encGB2312 = 936                 ' GBK / GB2312
        encBig5 = 950
        encUtf16 = 1200                 ' UTF-16 LE, no BOM
        encUtf16Be = 1201               ' UTF-16 BE, no BOM
        encUtf32 = 12000                ' UTF-32 LE, no BOM
        encUtf32Be = 12001              ' UTF-32 BE, no BOM
        encUsAscii = 20127
        encLatin1 = 28591               ' ISO-8859-1
        encLatin9 = 28605               ' ISO-8859-15
        encGB18030 = 54936
        encUtf7 = 65000
        encUtf8 = 65001
        
        ' BOM-bearing variants = -codePage
        encUtf8Bom = -encUtf8
        encUtf16Bom = -encUtf16         ' UTF-16 LE + BOM
        encUtf16BeBom = -encUtf16Be     ' UTF-16 BE + BOM
        encUtf32Bom = -encUtf32         ' UTF-32 LE + BOM
        encUtf32BeBom = -encUtf32Be     ' UTF-32 BE + BOM
        encUtf7Bom = -encUtf7           ' +/v[8,9,+,/] ascii signature
        encGB18030Bom = -encGB18030     ' 84 31 95 33 hex signature
    End Enum
        
    ' Zero is overloaded three ways on purpose. As a DETECTION result it means
    ' "no line endings found" (nlUnknown) or "more than one style found"
    ' (nlMixed); as a WRITE directive it means "leave the text alone"
    ' (nlNoChange). Hence the "If newline > 0 Then ChangeNewLine..." guards
    ' scattered through the write paths - zero must never reach GetNewLine().
    Public Enum NewlineType
        nlUnknown = 0
        nlMixed = 0
        nlNoChange = 0
        nlWindows = 1
        nlUnix = 2
        nlMacintosh = 3
    End Enum
        
    Public Enum IOMode
        ForReading = 1
        ForWriting = 2
        ForAppending = 8
    End Enum
        
    ' The first three members must keep their FSO values (0/1/2). Everything
    ' from SystemX86Folder on is an extension and maps to a KNOWNFOLDERID.
    Public Enum SpecialFolderConst
        ' --- FSO enums ---
        WindowsFolder = 0       'scripting.fso = 0
        SystemFolder = 1        'scripting.fso = 1
        TemporaryFolder = 2     'scripting.fso = 2
        ' --- Extensions start here ---
        SystemX86Folder = 3
        ProgramFiles = 4
        ProgramFilesX86 = 5
        ProgramData = 6
        UserProfile = 7
        Desktop = 8
        Documents = 9
        Downloads = 10
        Pictures = 11
        Music = 12
        Videos = 13
        LocalAppData = 14
        RoamingAppData = 15
        PublicDesktop = 16
        PublicDocuments = 17
        PublicDownloads = 18
        PublicPictures = 19
        PublicMusic = 20
        PublicVideos = 21
        Fonts = 22
        Startup = 23
        CommonStartup = 24
    End Enum

    ' NOT INCLUDED, deliberately: FSO's Volume (8) and Alias (1024).
    ' This enum's values ARE the raw Win32 FILE_ATTRIBUTE_* bits, so a
    ' FileAttribute can be passed straight to Set/GetFileAttributesW. Those two
    ' break that invariant:
    '   Volume - no Win32 equivalent at all. A DOS-era artefact, where the disk
    '            label was stored as a directory entry. We expose the label
    '            properly, as Drive.VolumeName.
    '   Alias  - FSO's name for a link/shortcut. The bit is FILE_ATTRIBUTE_
    '            REPARSE_POINT, which we already have under its real name.
    ' Both are read-only in FSO anyway, so nothing is lost on the write side.
    Public Enum FileAttribute
        NoChange = -1               ' sentinel: "preserve current attributes"

        ' --- SETTABLE: these are the only bits SetFileAttributesW honors ---
        Normal = &H00000080                 ' "no attributes"; must appear alone - see below
        ReadOnly = &H00000001
        Hidden = &H00000002
        System = &H00000004
        Archive = &H00000020
        Temporary = &H00000100              ' Excluded from Windows Search indexing
        NotContentIndexed = &H00002000

        ' --- READ-ONLY: filesystem-managed. Reported by a stat; silently ignored
        '     on a write. Set them through their own APIs, not through here.
        Directory = &H00000010              ' inherent to the object
        Compressed = &H00000800             ' DeviceIoControl(FSCTL_SET_COMPRESSION)
        Encrypted = &H00004000              ' EncryptFile / DecryptFile
        ' FSO's "Alias" is this same bit as "ReparsePoint" (1024).
        ' see the exclusion note above.
        ReparsePoint = &H00000400           ' CreateSymbolicLink / junction APIs
        SparseFile = &H00000200
        Offline = &H00001000                ' HSM/OneDrive
        IntegrityStream = &H00008000&       ' NTFS integrity stream (checksummed)
        Virtual = &H00010000                ' Obsolete virtualization flag (rare)
        NoScrubData = &H00020000            ' Do not scrub integrity data (ReFS/NTFS)
        EA = &H00040000                     ' Extended attributes present
        RecallOnOpen = &H00040000           ' Cloud/HSM: recall file on open (same bit as EA)
        Pinned = &H00080000                 ' Cloud file pinned locally
        Unpinned = &H00100000               ' Cloud file unpinned (evictable)
        RecallOnDataAccess = &H00400000     ' Recall file when data is accessed
        StrictlySequential = &H20000000     ' Optimize for sequential access
        ' -------------------------
        ' Special cases
        ' -------------------------
        'Device = &H00000040                ' Reserved; never used by NTFS
    End Enum
        
    Public Enum FileVersionSource
        fvFixed = 0             ' binary VS_FIXEDFILEINFO version (FSO-compatible) - the default
        fvFileString = 1        ' authored StringFileInfo\FileVersion string
        fvProductString = 2     ' authored StringFileInfo\ProductVersion string
    End Enum

    Public Enum StandardStreamTypes
        StdIn = 0
        StdOut = 1
        StdErr = 2
    End Enum
        
    '=================================================================================================
    ' File metadata (version, shell type)
    '=================================================================================================

    ' Three-step version-resource read: size the block, load it, then query it.
    ' Any of the three can legitimately fail (no version resource at all), in
    ' which case we return "" rather than raising - matching FSO.
    [Description("Returns the file's version. By default (fvFixed) returns the binary version as major.minor.build.revision, fvFileString returns the authored StringFileInfo FileVersion string and fvProductString returns the ProductVersion string; both fall back to the fixed version when the file has no string block. Returns an empty string when the file carries no version resource.")]
    Public Function GetFileVersion(ByVal filePath As String, Optional ByVal source As FileVersionSource = fvFixed) As String
        Dim size As Long
        filePath = VBA.Replace$(filePath, "/", "\")
        size = GetFileVersionInfoSizeW(StrPtr(filePath), 0&)
        If size = 0 Then Exit Function                      ' no version resource -> ""

        Dim buffer() As Byte
        ReDim buffer(size - 1)
        If GetFileVersionInfoW(StrPtr(filePath), 0&, size, buffer(0)) = 0 Then Exit Function

        ' Opt-in string sources; fall through to the fixed version if not present.
        Select Case source
            Case fvFileString
                GetFileVersion = ReadStringFileInfo(buffer, "FileVersion")
            Case fvProductString
                GetFileVersion = ReadStringFileInfo(buffer, "ProductVersion")
        End Select
        If Len(GetFileVersion) > 0 Then Exit Function

        ' Default / fallback: the binary fixed version (matches FSO).
        ' VerQueryValueW("\") hands back a pointer INTO buffer(), so buffer must
        ' stay alive across the CopyMemory below - do not refactor it away.
        Dim ptr As LongPtr
        Dim lenBuf As Long
        If VerQueryValueW(buffer(0), StrPtr("\"), ptr, lenBuf) = 0 Then Exit Function
        Dim ffi As VS_FIXEDFILEINFO_P
        CopyMemory ffi, ByVal ptr, LenB(ffi)
        ' Each DWORD packs two 16-bit fields: MS = major.minor, LS = build.revision.
        GetFileVersion = _
            ((ffi.dwFileVersionMS \ &H10000) And &HFFFF&) & "." & _
            (ffi.dwFileVersionMS And &HFFFF&) & "." & _
            ((ffi.dwFileVersionLS \ &H10000) And &HFFFF&) & "." & _
            (ffi.dwFileVersionLS And &HFFFF&)
    End Function
        
    [Description("Returns the shell's type description for a file or folder (e.g. ""Text Document"", ""Application"", ""File Folder""), the same string Explorer and Scripting.FileSystemObject's File.Type show. Falls back to ""<EXT> File"" or ""File"" when the shell is unavailable.")]
    Public Function GetFileType(ByVal filePath As String) As String
        Dim shfi As SHFILEINFOW
        filePath = VBA.Replace$(filePath, "/", "\")
        If SHGetFileInfoW(StrPtr(filePath), 0, shfi, Len(shfi), SHGFI_TYPENAME) <> 0 Then
            ' szTypeName is a fixed-length WCHAR buffer, NOT a VB string: walk it
            ' manually to the first NUL and rebuild the string char by char.
            Dim i As Long, ch As Long
            For i = 0 To UBound(shfi.szTypeName)
                ch = shfi.szTypeName(i) And &HFFFF&          ' szTypeName is signed Integer; mask to UTF-16
                If ch = 0 Then Exit For
                GetFileType = GetFileType & ChrW$(ch)
            Next
        End If
        If Len(GetFileType) = 0 Then                          ' shell unavailable/headless -> your fallback
            Dim ext As String
            ext = GetExtensionName(filePath)
            If Len(ext) = 0 Then GetFileType = "File" Else GetFileType = UCase$(ext) & " File"
        End If
    End Function
        
    '=================================================================================================
    ' File / folder operations (delete, copy, move, rename, create)
    '
    ' All five public entry points share one shape: normalize slashes, reject
    ' wildcards in the destination, then dispatch to either a *Wildcard walker
    ' or a *One* single-item core. The cores are the only place that touches the
    ' Win32 API, so that is where to breakpoint when an operation misbehaves.
    '=================================================================================================

    [Description("Deletes the specified file (wildcards supported). force clears a read-only attribute first. ignoreMissing (default False) suppresses the file-not-found error when the path or wildcard pattern matches nothing; it does not suppress other failures such as the path being a directory or the file being locked.")]
    Public Sub DeleteFile(ByVal filePath As String, Optional ByVal force As Boolean = False, Optional ByVal ignoreMissing As Boolean = False)
        filePath = VBA.Replace$(filePath, "/", "\")
        If HasWildcards(filePath) Then
            DeleteFileWildcard filePath, force, ignoreMissing
        Else
            DeleteOneFile filePath, force, ignoreMissing
        End If
    End Sub

    [Description("Copies a file to the destination path specified. Wildcards are supported in the last component of source.")]
    Public Sub CopyFile(ByVal source As String, ByVal destination As String, Optional ByVal overwrite As Boolean = True)
        source = VBA.Replace$(source, "/", "\")
        destination = VBA.Replace$(destination, "/", "\")
        If HasWildcards(destination) Then
            Err.Raise 5, "CopyFile", "Wildcards not permitted in destination: " & destination
        End If
        ' Expand wildcards in source (FSO-like)
        If HasWildcards(source) Then
            CopyFileWildcard source, destination, overwrite
        Else
            CopyOneFile source, destination, overwrite
        End If
    End Sub
        
    [Description("Moves a file to the destination and returns its resolved absolute path. If the destination is an existing folder (or ends in ""\""), the file keeps its name inside that folder; otherwise the destination is the new full path. Wildcards are supported in the last component of source.")]
    Public Function MoveFile(ByVal source As String, ByVal destination As String) As String
        source = VBA.Replace$(source, "/", "\")
        destination = VBA.Replace$(destination, "/", "\")
        If HasWildcards(destination) Then
            Err.Raise 5, "MoveFile", "Wildcards not permitted in destination: " & destination
        End If
        ' NOTE: on the wildcard path the return value is the destination CONTAINER,
        ' not a single moved item - there is no single item to name.
        If HasWildcards(source) Then
            MoveFile = MoveWildcard(source, destination, wantfolders:=False)
        Else
            MoveFile = MoveOneFile(source, destination)
        End If
    End Function

    [Description("Moves a folder to the destination and returns its resolved absolute path. If the destination is an existing folder (or ends in ""\""), the source folder is moved inside it, keeping its own name; otherwise the destination is the new full path. Wildcards are supported in the last component of source.")]
    Public Function MoveFolder(ByVal source As String, ByVal destination As String) As String
        source = VBA.Replace$(source, "/", "\")
        destination = VBA.Replace$(destination, "/", "\")
        If HasWildcards(destination) Then
            Err.Raise 5, "MoveFolder", "Wildcards not permitted in destination: " & destination
        End If
        ' As with MoveFile: the wildcard path returns the destination container.
        If HasWildcards(source) Then
            MoveFolder = MoveWildcard(source, destination, wantfolders:=True)
        Else
            MoveFolder = MoveOneFolder(source, destination)
        End If
    End Function

    [Description("Copies a folder to the destination path specified. Wildcards are supported in the last component of source.")]
    Public Sub CopyFolder(ByVal source As String, ByVal destination As String, Optional ByVal overwrite As Boolean = True)
        source = VBA.Replace$(source, "/", "\")
        destination = VBA.Replace$(destination, "/", "\")
        If HasWildcards(destination) Then
            Err.Raise 5, "CopyFolder", "Wildcards not permitted in destination: " & destination
        End If
        If HasWildcards(source) Then
            CopyFolderWildcard source, destination, overwrite
        Else
            CopyOneFolder source, destination, overwrite
        End If
    End Sub
        
    '=================================================================================================
    ' Path building, parsing and probing
    '=================================================================================================

    [Description("Combines a folder path and the name of a folder or file and returns the combination with valid path separators.")]
    Public Function BuildPath(ByVal path As String, ByVal name As String) As String
        ' --- Separator normalization (DEVIATES from Scripting.FileSystemObject) ---
        path = VBA.Replace$(path, "/", "\")
        name = VBA.Replace$(name, "/", "\")
        If Len(path) = 0 Then
            BuildPath = name
        ElseIf Len(name) = 0 Then
            BuildPath = path                                 ' empty name -> path unchanged
        Else
            ' Purely textual join - nothing here touches the disk. The four cases
            ' below exist so we never double a separator and never insert one after
            ' a bare drive spec ("C:" + "foo" must stay drive-relative "C:foo").
            Dim lastCh As String, firstCh As String
            lastCh = Right$(path, 1)
            firstCh = Left$(name, 1)
            If lastCh = "\" Or lastCh = "/" Then
                If firstCh = "\" Or firstCh = "/" Then
                    BuildPath = path & Mid$(name, 2)         ' don't double the separator
                Else
                    BuildPath = path & name
                End If
            ElseIf lastCh = ":" Then
                BuildPath = path & name                      ' drive-relative: no separator
            ElseIf firstCh = "\" Or firstCh = "/" Then
                BuildPath = path & name                      ' name already carries the separator
            Else
                BuildPath = path & "\" & name
            End If
        End If
    End Function
        
    [Description("Returns True if a specified folder exists; False if it does not.")]
    Public Function FolderExists(ByVal folderPath As String) As Boolean
        ' Must test BOTH: the path resolves AND the directory bit is set. A file at
        ' this path returns a valid attribute mask and would otherwise pass.
        Dim attr As Long
        folderPath = VBA.Replace$(folderPath, "/", "\")
        attr = GetFileAttributesW(StrPtr(folderPath))
        FolderExists = (attr <> INVALID_FILE_ATTRIBUTES) And ((attr And FILE_ATTRIBUTE_DIRECTORY) <> 0)
    End Function
        
    [Description("Deletes a folder and its contents (wildcards supported). force clears read-only attributes as it goes. ignoreMissing (default False) suppresses the path-not-found error when the folder or wildcard pattern matches nothing; it does not suppress other failures such as the path being a file or the folder being locked or non-empty.")]
    Public Sub DeleteFolder(ByVal folderPath As String, Optional ByVal force As Boolean = False, Optional ByVal ignoreMissing As Boolean = False)
        folderPath = VBA.Replace$(folderPath, "/", "\")
        If HasWildcards(folderPath) Then
            DeleteFolderWildcard folderPath, force, ignoreMissing
        Else
            DeleteOneFolder folderPath, force, ignoreMissing
        End If
    End Sub
        
    [Description("Returns True if a specified file exists; False if it does not.")]
    Public Function FileExists(ByVal filePath As String) As Boolean
        ' Uses VBA GetAttr rather than GetFileAttributesW because GetAttr raises on
        ' malformed/inaccessible paths, which the On Error swallows into a clean
        ' False. Same directory-bit exclusion as FolderExists, inverted.
        Dim fAttr As VbFileAttribute
        If Trim$(filePath) = vbNullString Then FileExists = False: Exit Function
        filePath = VBA.Replace$(filePath, "/", "\")
        On Error Resume Next
        fAttr = GetAttr(filePath)
        If Err.Number = 0 Then
            FileExists = Not CBool(fAttr And vbDirectory)
        Else
            FileExists = False
        End If
        On Error GoTo 0
    End Function
        
    [Description("Returns True if a specified drive exists; False if it does not.")]
    Public Function DriveExists(ByVal drivePath As String) As Boolean
        ' Letter drives only - a UNC share is not a logical drive and returns False.
        Dim driveLetter As String
        drivePath = VBA.Replace$(drivePath, "/", "\")

        Select Case Len(drivePath)
            Case 0
                Exit Function
            Case 1
                driveLetter = drivePath                         ' "C"
            Case Else
                If Mid$(drivePath, 2, 1) <> ":" Then Exit Function   ' require "C:" / "C:\" / "C:\..."
                driveLetter = Left$(drivePath, 1)
        End Select

        driveLetter = UCase$(driveLetter)
        If driveLetter < "A" Or driveLetter > "Z" Then Exit Function

        ' GetLogicalDrives returns a bitmask: bit 0 = A:, bit 25 = Z:.
        Dim bit As Long
        bit = 1& << (Asc(driveLetter) - Asc("A"))               ' bit 0..25

        DriveExists = ((GetLogicalDrives() And bit) <> 0)
    End Function
        
    [Description("Renames a file or folder in place and returns the resolved absolute path of the renamed item. The new name may be a bare name or a path resolving to the same folder as the source (case-only changes are permitted); it cannot move the item to a different folder. Wildcards are not permitted, and the destination must not already exist.")]
    Public Function Rename(ByVal source As String, ByVal newName As String) As String
        source = VBA.Replace$(source, "/", "\")
        newName = VBA.Replace$(newName, "/", "\")
        If HasWildcards(source) Or HasWildcards(newName) Then
            Err.Raise 5, "Rename", "Wildcards not permitted in Rename"
        End If
        ' Resolve source to absolute so its parent folder is well-defined
        source = GetAbsolutePathName(source)
        If Not (FileExists(source) Or FolderExists(source)) Then
            Err.Raise 53, "Rename", "Path not found: " & source
        End If
        ' Bare name or relative path -> relative to the SOURCE's folder; absolute -> as-is
        Dim parent As String
        parent = Left$(source, InStrRev(source, "\"))
        Dim destination As String
        destination = GetAbsolutePathName(newName, parent)
        ' In-place only: the destination must live in the same folder as the source
        Dim destParent As String
        destParent = Left$(destination, InStrRev(destination, "\"))
        If StrComp(parent, destParent, vbTextCompare) <> 0 Then
            Err.Raise 5, "Rename", "Rename cannot move items between folders: " & source & " -> " & destination
        End If
        ' A case-only rename "collides" only with the source itself (case-insensitive
        ' match) — allow it. Any other existing item at the destination is a real conflict.
        If StrComp(source, destination, vbTextCompare) <> 0 Then
            If FileExists(destination) Or FolderExists(destination) Then
                Err.Raise 58, "Rename", "Destination already exists: " & destination
            End If
        End If

        ' Pure rename (same folder, no overwrite, no move)
        ' Flags deliberately 0: no REPLACE_EXISTING (guarded above) and no
        ' COPY_ALLOWED (a same-folder rename can never cross volumes).
        If MoveFileExW(StrPtr(source), StrPtr(destination), 0) = 0 Then
            RaiseFromLastError Err.LastDllError, "Rename", source
        End If
        Rename = destination
    End Function
        
    [Description("Creates a folder and returns the new Folder. Errors if it already exists. By default only the leaf is created; pass createIntermediates:=True to also create any missing intermediate folders.")]
    Public Function CreateFolder(ByVal folderPath As String, Optional ByVal createIntermediates As Boolean = False) As Folder
        folderPath = GetAbsolutePathName(VBA.Replace$(folderPath, "/", "\"))
        ' No wildcard guard: in a create/name context FSO treats '*' and '?' as
        ' illegal filename chars -> 52 (via CreateDirectoryW), NOT as 5. Letting
        ' them fall through to the API produces the FSO-matching 52.
        If FolderExists(folderPath) Then Err.Raise 58, "CreateFolder", "Folder already exists: " & folderPath
        If createIntermediates Then EnsureParentExists folderPath
        CreateDir folderPath, "CreateFolder"
        Set CreateFolder = GetFolder(folderPath)
    End Function
        
    [Description("Returns a randomly generated temporary file or folder name. If inFolder is supplied, the returned name is one that does not already exist in that folder at the time of the call.")]
    Public Function GetTempName(Optional ByVal prefix As String, Optional ByVal extension As String = ".tmp", Optional ByVal inFolder As String = "") As String
        ' Seed once per session; re-Randomize-ing on every call would re-derive from
        ' the timer and can hand back the same sequence inside a tight loop.
        Static seeded As Boolean
        If Not seeded Then
            Randomize
            seeded = True
        End If

        Const chars As String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
        Dim i As Long
        Dim namePart As String
        Dim candidate As String

        Do
            namePart = vbNullString
            For i = 1 To 8
                namePart = namePart & Mid$(chars, 1 + Int(Rnd * Len(chars)), 1)
            Next
            candidate = prefix & namePart & extension

            ' No folder specified -> behave like FSO and just return the name
            If Len(inFolder) = 0 Then Exit Do

            ' Otherwise keep trying until the name is free in that folder.
            ' NOTE: this is a probe, not a reservation - the name can still be taken
            ' between here and the caller's create. WriteStream tolerates that
            ' because its temp file is opened exclusively.
        Loop While PathExists(BuildPath(inFolder, candidate))

        GetTempName = candidate
    End Function
        
    [Description("Returns a complete and unambiguous path from a provided path specification.")]
    Public Function GetAbsolutePathName(ByVal path As String, Optional ByVal baseDirectory As String = "", Optional ByVal useLongPathPrefix As Boolean = False) As String
        ' MAX_PATH here is the long-path ceiling (32767+1), not the legacy 260.
        ' Both APIs used below accept it. PathRelativePathToW (in GetRelativePath)
        ' does NOT - see the separate MAX_PATH_API const there.
        Const MAX_PATH As Long = 32768
        Dim combined As String
        Dim buffer As String
        Dim length As Long

        ' If caller gives a base, only combine when Path is genuinely relative
        ' BUT: "C:foo" is special. We keep Windows semantics unless base is on same drive.
        If Len(baseDirectory) > 0 Then
            If IsDriveRelative(path) Then
                ' Base overrides the per-drive current directory only when it's the same drive.
                If UCase$(Left$(baseDirectory, 2)) = UCase$(Left$(path, 2)) Then
                    combined = String$(MAX_PATH, vbNullChar)
                    If PathCombineW(StrPtr(combined), StrPtr(baseDirectory), StrPtr(Mid$(path, 3))) = 0 Then
                        Err.Raise vbObjectError + 1, , "PathCombineW failed."
                    End If
                    path = Left$(combined, InStr(combined, vbNullChar) - 1)
                End If
                ' Else: leave as "C:foo" and let GetFullPathNameW resolve via drive CWD
            Else
                ' For normal relative paths (including "\foo" which is drive-root relative),
                ' PathCombineW matches Windows behavior.
                combined = String$(MAX_PATH, vbNullChar)
                If PathCombineW(StrPtr(combined), StrPtr(baseDirectory), StrPtr(path)) = 0 Then
                    Err.Raise vbObjectError + 2, , "PathCombineW failed."
                End If
                path = Left$(combined, InStr(combined, vbNullChar) - 1)
            End If
        End If

        ' Canonicalize to absolute (resolves "." / ".." and the process CWD).
        ' Purely lexical: the path need not exist.
        buffer = String$(MAX_PATH, vbNullChar)
        length = GetFullPathNameW(StrPtr(path), MAX_PATH, StrPtr(buffer), 0)
        If length = 0 Then
            Err.Raise vbObjectError + 3, , "GetFullPathNameW failed."
        End If

        GetAbsolutePathName = Left$(buffer, length)
            
        ' Normalize path to not end in "\" (a drive root "C:\" is the one exception -
        ' stripping it there would turn it into the drive-relative "C:").
        If Right$(GetAbsolutePathName, 2) <> ":\" Then
            If Right$(GetAbsolutePathName, 1) = "\" Then
                GetAbsolutePathName = Left$(GetAbsolutePathName, length - 1)
            End If
        End If
            
        If useLongPathPrefix Then
            GetAbsolutePathName = AddLongPathPrefix(GetAbsolutePathName)
        End If
    End Function
        
    [Description("Cleans a file name (not a path) of items that are invalid in Windows: the reserved characters \ / : * ? "" < > |, control characters, leading/trailing spaces, trailing dots, and reserved device names such as CON, PRN, NUL, COM0-9 and LPT0-9.")]
    Public Function CleanFileName(ByVal fileName As String, Optional ByVal replaceChar As String = "") As String
        ' Name-only: '\' and '/' are treated as reserved characters here, so passing
        ' a full path in will strip its separators. That is intended.
        Dim result As String
        Dim i As Long
        Dim ch As String
        Dim code As Long

        ' --- Replace reserved characters and control characters (0x00-0x1F) ---
        For i = 1 To Len(fileName)
            ch = Mid$(fileName, i, 1)
            code = AscW(ch)
            If code >= 0 And code <= 31 Then
                result = result & replaceChar
            ElseIf InStr("\/:*?""<>|", ch) > 0 Then
                result = result & replaceChar
            Else
                result = result & ch
            End If
        Next i

        ' --- Trim leading/trailing spaces and trailing dots (Windows silently drops these) ---
        Do While Len(result) > 0
            ch = Right$(result, 1)
            If ch = " " Or ch = "." Then
                result = Left$(result, Len(result) - 1)
            Else
                Exit Do
            End If
        Loop
        Do While Left$(result, 1) = " "
            result = Mid$(result, 2)
        Loop

        ' --- Disambiguate reserved device names (CON, NUL, COM1, ...) ---
        ' A device name is still a device even with an extension ("NUL.txt"), so the
        ' disambiguator goes on the STEM, before the first dot.
        If IsReservedDeviceName(result) Then
            Dim disambig As String
            If Len(replaceChar) > 0 Then disambig = replaceChar Else disambig = "_"

            Dim dotPos As Long
            dotPos = InStr(result, ".")
            If dotPos = 0 Then
                result = result & disambig
            Else
                result = Left$(result, dotPos - 1) & disambig & Mid$(result, dotPos)
            End If
        End If

        CleanFileName = result
    End Function
        
    [Description("Returns the last component of a specified path that is not part of the drive specification.")]
    Public Function GetFileName(ByVal path As String) As String
        ' Lexical only - never touches the disk, so it works on paths that don't exist.
        Dim s As String
        s = VBA.Replace$(path, "/", "\")
        Do While Len(s) > 1 And Right$(s, 1) = "\"
            s = Left$(s, Len(s) - 1)
        Loop
        If IsUncRoot(s) Then Exit Function                  ' "\\server" / "\\server\share" -> no name
        Dim pos As Long
        pos = InStrRev(s, "\")
        If pos > 0 Then
            GetFileName = Mid$(s, pos + 1)
        ElseIf Len(s) >= 2 And Mid$(s, 2, 1) = ":" Then
            GetFileName = Mid$(s, 3)                         ' drop drive spec ("C:foo" -> "foo")
        Else
            GetFileName = s
        End If
    End Function
        
    [Description("Returns a string containing the name of the parent folder of the last component in a specified path.")]
    Public Function GetParentFolderName(ByVal path As String) As String
        ' --- Separator normalization (DEVIATES from Scripting.FileSystemObject) ---
        path = VBA.Replace$(path, "/", "\")
        Dim s As String: s = path
        Do While Len(s) > 1 And (Right$(s, 1) = "\" Or Right$(s, 1) = "/")
            s = Left$(s, Len(s) - 1)
        Loop
        If IsUncRoot(s) Then Exit Function                  ' UNC root has no parent
        Dim pos As Long: pos = LastSep(s)
        If pos = 0 Then Exit Function                       ' no separator -> no parent
        Dim parent As String: parent = Left$(s, pos - 1)
        If Len(parent) = 2 And Mid$(parent, 2, 1) = ":" Then
            GetParentFolderName = parent & "\"              ' bare drive -> drive root "C:\"
        Else
            GetParentFolderName = parent                    ' verbatim (slash/case preserved)
        End If
    End Function
        
    [Description("Returns a string containing the extension name for the last component in a path.")]
    Public Function GetExtensionName(ByVal path As String) As String
        ' Extension excludes the dot. A dotfile leaf (".gitignore") therefore reports
        ' an extension of "gitignore" and an empty base name - same as FSO.
        Dim name As String, dotPos As Long
        name = GetFileName(path)
        dotPos = InStrRev(name, ".")
        If dotPos > 0 Then GetExtensionName = Mid$(name, dotPos + 1)
    End Function
        
    [Description("Returns a string containing the base name of the last component, less any file extension, in a path.")]
    Public Function GetBaseName(ByVal path As String) As String
        Dim name As String, dotPos As Long
        name = GetFileName(path)
        dotPos = InStrRev(name, ".")
        If dotPos > 0 Then GetBaseName = Left$(name, dotPos - 1) Else GetBaseName = name
    End Function
        
    [Description("Returns a string containing the name of the drive for a specified path.")]
    Public Function GetDriveName(ByVal path As String) As String
        ' Returns WITHOUT a trailing backslash: "C:" or "\\server\share".
        path = VBA.Replace$(path, "/", "\")

        ' UNC path: the "drive" is \\server\share, i.e. everything up to the third
        ' separator. A bare "\\server" (no share) has no drive -> "".
        If Left$(path, 2) = "\\" Then
            Dim p As Long
            p = InStr(3, path, "\")                  ' separator after the server name
            If p > 0 Then
                p = InStr(p + 1, path, "\")          ' separator after the share name
                If p > 0 Then
                    GetDriveName = Left$(path, p - 1)
                Else
                    GetDriveName = path              ' path IS exactly \\server\share
                End If
            End If
            Exit Function
        End If

        ' Drive letter path
        If Len(path) >= 2 And Mid$(path, 2, 1) = ":" Then
            GetDriveName = Left$(path, 2)
        Else
            GetDriveName = ""
        End If
    End Function
    
    [Description("Returns the current directory.")]
    Public Function GetCurrentDir() As String
        Const MAX_PATH As Long = 32768
        Dim buffer As String
        Dim length As Long
        buffer = String$(MAX_PATH, vbNullChar)
        length = GetCurrentDirectoryW(MAX_PATH, StrPtr(buffer))
        GetCurrentDir = Left$(buffer, length)
    End Function
        
    [Description("Sets the current directory.")]
    Public Sub SetCurrentDir(ByVal folderPath As String)
        ' Return value intentionally ignored (fire-and-forget, as with VBA's ChDir).
        SetCurrentDirectoryW (StrPtr(folderPath))
    End Sub
        
    ' Note that there are two ways we can go here - one that requires WinDevLib (FOLDERID_*() method)
    ' and the other using GuidFromString which the one that is currently implemented.
    ' Keeping both here with FOLDERID_*() method commented out in case later it is decided
    ' to make this class dependent on WinDevLib which would reduce code significantly.
    [Description("Returns the absolute path to the requested known folder. The returned path does NOT include a trailing backslash.")]
    Public Function GetSpecialFolder(ByVal specialFolder As SpecialFolderConst) As String
        Dim guid As UUID
        'Dim guid As WinDevLib.UUID 'if using guid = FOLDERID_*() method below
        Dim pPath As LongPtr
        Dim hr As Long

        Select Case specialFolder
            Case WindowsFolder:        guid = GuidFromString(KFID_Windows_STR)
            Case SystemFolder:         guid = GuidFromString(KFID_System_STR)
            Case SystemX86Folder:      guid = GuidFromString(KFID_SystemX86_STR)
            Case ProgramFiles:         guid = GuidFromString(KFID_ProgramFiles_STR)
            Case ProgramFilesX86:      guid = GuidFromString(KFID_ProgramFilesX86_STR)
            Case ProgramData:          guid = GuidFromString(KFID_ProgramData_STR)
            Case UserProfile:          guid = GuidFromString(KFID_Profile_STR)
            Case Desktop:              guid = GuidFromString(KFID_Desktop_STR)
            Case Documents:            guid = GuidFromString(KFID_Documents_STR)
            Case Downloads:            guid = GuidFromString(KFID_Downloads_STR)
            Case Pictures:             guid = GuidFromString(KFID_Pictures_STR)
            Case Music:                guid = GuidFromString(KFID_Music_STR)
            Case Videos:               guid = GuidFromString(KFID_Videos_STR)
            Case LocalAppData:         guid = GuidFromString(KFID_LocalAppData_STR)
            Case RoamingAppData:       guid = GuidFromString(KFID_RoamingAppData_STR)
            Case PublicDesktop:        guid = GuidFromString(KFID_PublicDesktop_STR)
            Case PublicDocuments:      guid = GuidFromString(KFID_PublicDocuments_STR)
            Case PublicDownloads:      guid = GuidFromString(KFID_PublicDownloads_STR)
            Case PublicPictures:       guid = GuidFromString(KFID_PublicPictures_STR)
            Case PublicMusic:          guid = GuidFromString(KFID_PublicMusic_STR)
            Case PublicVideos:         guid = GuidFromString(KFID_PublicVideos_STR)
            Case Fonts:                guid = GuidFromString(KFID_Fonts_STR)
            Case Startup:              guid = GuidFromString(KFID_Startup_STR)
            Case CommonStartup:        guid = GuidFromString(KFID_CommonStartup_STR)
            /*
            'this method requires the reference to WinDevLib
            Case WindowsFolder:        guid = FOLDERID_Windows()
            Case SystemFolder:         guid = FOLDERID_System()
            Case SystemX86Folder:      guid = FOLDERID_SystemX86
            Case ProgramFiles:         guid = FOLDERID_ProgramFiles
            Case ProgramFilesX86:      guid = FOLDERID_ProgramFilesX86
            Case ProgramData:          guid = FOLDERID_ProgramData
            Case UserProfile:          guid = FOLDERID_Profile
            Case Desktop:              guid = FOLDERID_Desktop()
            Case Documents:            guid = FOLDERID_Documents()
            Case Downloads:            guid = FOLDERID_Downloads()
            Case Pictures:             guid = FOLDERID_Pictures()
            Case Music:                guid = FOLDERID_Music()
            Case Videos:               guid = FOLDERID_Videos()
            Case LocalAppData:         guid = FOLDERID_LocalAppData()
            Case RoamingAppData:       guid = FOLDERID_RoamingAppData()
            Case PublicDesktop:        guid = FOLDERID_PublicDesktop()
            Case PublicDocuments:      guid = FOLDERID_PublicDocuments()
            Case PublicDownloads:      guid = FOLDERID_PublicDownloads()
            Case PublicPictures:       guid = FOLDERID_PublicPictures()
            Case PublicMusic:          guid = FOLDERID_PublicMusic()
            Case PublicVideos:         guid = FOLDERID_PublicVideos()
            Case Fonts:                guid = FOLDERID_Fonts()
            Case Startup:              guid = FOLDERID_Startup()
            Case CommonStartup:        guid = FOLDERID_CommonStartup()
            */
            ' TEMP is the one folder with no KNOWNFOLDERID - it is per-process and
            ' environment-driven, so it short-circuits out before the shell call.
            Case TemporaryFolder
                GetSpecialFolder = Environ$("TEMP")
                Exit Function
            Case Else
                Err.Raise 5, "GetSpecialFolder", "Unknown SpecialFolder ID"
        End Select

        hr = SHGetKnownFolderPath(guid, KF_FLAG_DEFAULT, 0, pPath)
        If hr < 0 Then
            Err.Raise vbObjectError + (hr And &HFFFF&), _
                    "GetSpecialFolder", _
                    "SHGetKnownFolderPath failed (HRESULT 0x" & Hex$(hr) & ")"
        End If

        ' SHGetKnownFolderPath allocates with CoTaskMemAlloc; LPWSTRtoStr frees it.
        ' Do not add an early exit between the call above and this line or we leak.
        GetSpecialFolder = LPWSTRtoStr(pPath)
    End Function

    [Description("Returns a relative path from a base path to a target path. The base path is treated as a folder by default. Relative inputs are resolved against the current directory. Returns the absolute target if no relative path exists (e.g. different drives).")]
    Public Function GetRelativePath(ByVal basePath As String, ByVal targetPath As String, _
        Optional ByVal basePathIsFolder As Boolean = True, _
        Optional ByVal trimLeadingDotSlash As Boolean = True) As String

        ' HARD LIMIT: unlike the rest of the module, this one API is capped at the
        ' legacy 260 chars. Longer inputs will fail here and fall back to absolute.
        Const MAX_PATH_API As Long = 260   ' PathRelativePathToW is limited to MAX_PATH

        basePath = VBA.Replace$(basePath, "/", "\")
        targetPath = VBA.Replace$(targetPath, "/", "\")

        ' Resolve both to absolute so the comparison is unambiguous
        basePath = GetAbsolutePathName(basePath)
        targetPath = GetAbsolutePathName(targetPath)

        ' The API needs to know whether each end is a file or a folder, since that
        ' changes where the relative walk starts. basePathIsFolder lets the caller
        ' assert it for a path that doesn't exist yet; otherwise we probe the disk.
        Dim attrFrom As FILE_ATTRIBUTES
        Dim attrTo As FILE_ATTRIBUTES

        If basePathIsFolder Then
            attrFrom = FILE_ATTRIBUTE_DIRECTORY
        Else
            attrFrom = ResolveAttrForRelative(basePath)
        End If
        attrTo = ResolveAttrForRelative(targetPath)

        Dim buffer As String
        buffer = String$(MAX_PATH_API, vbNullChar)

        If PathRelativePathToW(StrPtr(buffer), StrPtr(basePath), attrFrom, StrPtr(targetPath), attrTo) = CFALSE Then
            ' No common root (e.g. different drive letters) - fall back to absolute
            GetRelativePath = targetPath
            Exit Function
        End If

        buffer = Left$(buffer, InStr(buffer, vbNullChar) - 1)

        ' The API always prefixes ".\"; strip it unless the caller wants it verbatim.
        If trimLeadingDotSlash Then
            If buffer = ".\" Then
                buffer = "."
            ElseIf Left$(buffer, 2) = ".\" Then
                buffer = Mid$(buffer, 3)
            End If
        End If

        GetRelativePath = buffer
    End Function
        
    [Description("Returns a Collection of full file paths in the specified folder. Supports a wildcard pattern, optional recursion into subfolders, inclusion of hidden/system files.")]
    Public Function GetFilePaths(ByVal folderPath As String, _
        Optional ByVal pattern As String = "*", _
        Optional ByVal includeHidden As Boolean = False, _
        Optional ByVal includeSystem As Boolean = False, _
        Optional ByVal recursive As Boolean = False) As Collection

        ' Returns FULL paths (folder & name), not bare names, and files only -
        ' folders are filtered out by EnumerateLevel.
        ' NOTE: the pattern is applied to files at EVERY level; recursion itself is
        ' driven by a separate unfiltered "*" walk (EnumerateSubFolders), so a
        ' pattern like "*.txt" does not prevent descent into subfolders.
        folderPath = VBA.Replace$(folderPath, "/", "\")
        folderPath = GetAbsolutePathName(folderPath)

        If Not FolderExists(folderPath) Then
            Err.Raise 76, "GetFilePaths", "Path not found: " & folderPath
        End If

        Dim result As New Collection
        CollectFiles folderPath, pattern, includeHidden, includeSystem, recursive, result
        Set GetFilePaths = result
    End Function
    
    '=================================================================================================
    ' Text file I/O
    '
    ' Whole-file helpers (TextFileToString / StringToTextFile / ...) go through
    ' ReadStream / WriteStream and TextCodec. Streaming access goes through
    ' OpenTextFile -> TextStream. Everything binary-vs-text is decided by
    ' TextCodec.Detect; this module only decides what to DO about the verdict.
    '=================================================================================================

    [Description("Detects a file's text encoding from a head sample (default 64 KB): BOM sniff first, then UTF-16/32 and UTF-8 heuristics, else system ANSI. Returns a signed TextEncoding (negative = BOM present), or encUnknown if the file is empty or looks binary. Raises if the file cannot be read.")]
    Public Function GetFileEncoding(ByVal filePath As String, Optional ByVal sampleBytes As Long = 65536) As TextEncoding
        Dim stream() As Byte
        ReadStream filePath, stream, sampleBytes
        If Not IsArrayInitialized(stream) Then
            GetFileEncoding = encUnknown        ' empty file: nothing to detect
            Exit Function
        End If
        ' Sampling caveat: a multi-byte sequence straddling the sample boundary can
        ' skew the UTF-8 heuristic. Raise sampleBytes if a file misdetects.
        GetFileEncoding = TextCodec.Detect(stream)    ' concrete encoding, or encUnknown for binary
    End Function
        
    [Description("Reads an entire text file to a string. With encAutoDetect (default) the encoding is detected, and a binary file raises; with an explicit encoding that encoding is used as-is (a byte-order mark still overrides it). A leading BOM is stripped. An empty file returns an empty string. Optionally normalizes line endings.")]
    Public Function TextFileToString(ByVal filePath As String, _
        Optional ByVal encoding As TextEncoding = encAutoDetect, _
        Optional ByVal outLineEnding As NewlineType = nlNoChange) As String

        Dim stream() As Byte
        ReadStream filePath, stream
        If Not IsArrayInitialized(stream) Then            ' empty file -> "" (never reaches the encUnknown guard)
            TextFileToString = vbNullString
            Exit Function
        End If
        ' Detect(stream, seed): with an explicit seed it only sniffs for a BOM and
        ' otherwise trusts the caller - it cannot return encUnknown in that case.
        Dim enc As TextEncoding
        enc = TextCodec.Detect(stream, encoding)
        If enc = encUnknown Then                           ' only reachable via auto-detect on binary content
            Err.Raise ERR_NOT_TEXT, "TextFileToString", _
                "File appears to be binary; cannot read as text: " & filePath
        End If
        TextFileToString = TextCodec.Decode(stream, enc, outLineEnding)
    End Function
        
    [Description("Writes a string to a file in the specified encoding (a BOM is emitted only for BOM-bearing members such as encUtf8Bom). Overwrites any existing file.")]
    Public Sub StringToTextFile(ByVal text As String, ByVal filePath As String, _
        Optional ByVal encoding As TextEncoding = encUtf8, _
        Optional ByVal outLineEnding As NewlineType = nlNoChange)

        filePath = VBA.Replace$(filePath, "/", "\")
        GuardWriteName filePath, "StringToTextFile"       ' WriteStream uses a temp-swap: see GuardWriteName

        If encoding = encAutoDetect Then encoding = encUtf8    ' auto has no meaning on write
        Dim s As String
        s = text
        If outLineEnding > 0 Then s = TextCodec.ChangeNewLine(s, outLineEnding)   ' 0 = nlNoChange

        Dim bytes() As Byte
        bytes = TextCodec.Encode(s, encoding)                 ' prepends a BOM if BOM-bearing
        WriteStream bytes, filePath                           ' creates/truncates
    End Sub

    ' Behaviour mirrors StringToTextFile except that a line ending is MANDATORY (it is 
    ' the join separator), so nlNoChange/0 is coerced to nlWindows rather than skipped.
    [Description("Writes an array of lines to a file in the specified encoding (a BOM is emitted only for BOM-bearing members such as encUtf8Bom). Overwrites any existing file.")]
    Public Sub ArrayToTextFile(ByRef lines() As String, ByVal filePath As String, _
        Optional ByVal encoding As TextEncoding = encUtf8, _
        Optional ByVal lineEnding As NewlineType = nlWindows)

        filePath = VBA.Replace$(filePath, "/", "\")
        GuardWriteName filePath, "ArrayToTextFile"

        If encoding = encAutoDetect Then encoding = encUtf8
        If lineEnding <= 0 Then lineEnding = nlWindows      ' a separator is mandatory here
        ' Join only puts separators BETWEEN elements, so no trailing newline is
        ' written. Round-tripping through TextFileToArray is therefore lossless.
        Dim bytes() As Byte
        bytes = TextCodec.Encode(Join(lines, TextCodec.GetNewLine(lineEnding)), encoding)
        WriteStream bytes, filePath
    End Sub
        
    [Description("Reads a text file into an array of lines (mixed CR/LF/CRLF handled). Encoding auto-detected by default. A trailing newline yields a final empty element. An empty file returns an unallocated array.")]
    Public Function TextFileToArray(ByVal filePath As String, Optional ByVal encoding As TextEncoding = encAutoDetect) As String()
        Dim stream() As Byte
        ReadStream filePath, stream
        If Not IsArrayInitialized(stream) Then
            TextFileToArray = Empty            ' unallocated; caller guards with IsArrayInitialized
            Exit Function
        End If

        Dim enc As TextEncoding
        enc = TextCodec.Detect(stream, encoding)
        If enc = encUnknown Then                           ' only reachable via auto-detect on binary content
            Err.Raise ERR_NOT_TEXT, "TextFileToArray", _
                "File appears to be binary; cannot read as text: " & filePath
        End If
            
        ' Normalizing to LF first is what makes mixed CR/LF/CRLF files split
        ' correctly off a single delimiter - do not "optimize" this to nlNoChange.
        Dim text As String
        text = TextCodec.Decode(stream, enc, nlUnix)   ' normalize ALL endings to LF
        TextFileToArray = Split(text, vbLf)          ' Split returns a String() - assign directly
    End Function
        
    [Description("Reads the file specified into a byte array.")]
    Public Sub ReadStream(ByVal filePath As String, ByRef stream() As Byte, Optional ByVal maxBytesToRead As Long = -1)
        Dim fn As Long
        Dim size As LongLong                 ' was Long
        Dim n As Long
        filePath = VBA.Replace$(filePath, "/", "\")
        If Not FileExists(filePath) Then Err.Raise(5, , "file not found!")

        ' LOF() is Long and WRAPS past 2GB (verified: 2.4GB reports as -1894907904),
        ' which silently yielded an unallocated array - i.e. a huge file read as empty.
        ' StatPath is the only trustworthy size source.
        Dim attrs As Long, cr As Date, mo As Date, ac As Date, leaf As String
        Shared.StatPath filePath, attrs, size, cr, mo, ac, leaf

        ' A head-sample read (maxBytesToRead >= 0) is always fine, however big the file.
        ' Only a whole-file read is capped, and by the Byte() limit, not by us.
        If maxBytesToRead < 0 And size > 2147483647^ Then
            Err.Raise 7, "ReadStream", _
                "File exceeds the maximum byte-array size (" & size & " bytes): " & filePath
        End If

        fn = FreeFile()
        Open filePath For Binary Access Read As #fn
        If maxBytesToRead >= 0 Then n = CLng(Min(size, CLngLng(maxBytesToRead))) Else n = CLng(size)
        If n > 0 Then ReDim stream(0 To n - 1): Get fn,, stream
        Close #fn
    End Sub
        
    [Description("Writes a byte array to the file specified.")]
    Public Sub WriteStream(ByRef stream() As Byte, ByVal filePath As String)
        ' This is fully Unicode safe (unlike in VBA).
        ' Write to a temp file in the same folder, then atomically replace the
        ' target. This avoids losing the original if the write fails partway.
        '
        ' Consequences of the temp-swap that callers must know about:
        '   * the target's file attributes are RESET (the temp file becomes the
        '     target) - NormalizeTextFile restores them afterwards;
        '   * the leaf name must survive being decorated with ".~XXXX.tmp", which
        '     is why write entry points call GuardWriteName first (no ADS colons);
        '   * the temp lives in the same folder deliberately - a %TEMP% temp could
        '     land on another volume and turn the rename into a non-atomic copy.
        Dim fn As Long
        Dim tempPath As String
        Dim hasBytes As Boolean
        
        filePath = VBA.Replace$(filePath, "/", "\")

        ' Decide whether there is anything to write. This safely covers BOTH an
        ' unallocated array and an allocated zero-length one (e.g. from writing
        ' an empty string) - either would make Put raise.
        On Error Resume Next
        hasBytes = (UBound(stream) >= LBound(stream))
        On Error GoTo 0

        tempPath = filePath & "." & GetTempName("~", ".tmp")

        fn = FreeFile()
        Open tempPath For Binary Access Write As #fn
        If hasBytes Then Put #fn,, stream
        Close #fn

        ' Clear any read-only attribute on an existing target so it can be replaced
        If FileExists(filePath) Then
            SetFileAttributesW StrPtr(filePath), FILE_ATTRIBUTE_NORMAL
        End If

        ' Atomic swap (temp is on the same volume, so this is a true rename)
        If MoveFileExW(StrPtr(tempPath), StrPtr(filePath), MOVEFILE_REPLACE_EXISTING) = 0 Then
            ' Capture LastDllError BEFORE the cleanup call - DeleteFileW would
            ' overwrite it and we would raise the wrong error.
            Dim e As Long
            e = Err.LastDllError
            DeleteFileW StrPtr(tempPath)                  ' don't leave the temp behind
            RaiseFromLastError e, "WriteStream", filePath
        End If
    End Sub
        
    [Description("Opens a text file and returns a streaming TextStream. For reading, omit encoding (encAutoDetect) to detect it from a head sample. For writing/appending, encoding selects the output encoding (default UTF-8, no BOM). Encodings whose chunk boundaries cannot be managed (UTF-7, unclassifiable code pages) transparently fall back to a buffered path.")]
    Public Function OpenTextFile(ByVal filePath As String, _
        Optional ByVal ioMode As IOMode = ForReading, _
        Optional ByVal create As Boolean = False, _
        Optional ByVal encoding As TextEncoding = encAutoDetect, _
        Optional ByVal writeModeLineEnding As NewlineType = nlWindows) As TextStream

        ' Thin factory: all validation, mode handling and encoding fallback live in
        ' TextStream.Init - debug there, not here.
        Dim ts As TextStream
        filePath = VBA.Replace$(filePath, "/", "\")
        Set ts = New TextStream
        ts.Init filePath, ioMode, create, encoding, writeModeLineEnding
        Set OpenTextFile = ts
    End Function

    [Description("Creates (or overwrites) a text file and returns a TextStream open for writing.")]
    Public Function CreateTextFile(ByVal filePath As String, _
        Optional ByVal overwrite As Boolean = True, _
        Optional ByVal encoding As TextEncoding = encUtf8, _
        Optional ByVal lineEnding As NewlineType = nlWindows) As TextStream
        ' No GuardWriteName here: TextStream writes the target directly (no temp
        ' swap), so a ':' leaf is legal and addresses an alternate data stream.
        filePath = VBA.Replace$(filePath, "/", "\")
        If Not overwrite And FileExists(filePath) Then Err.Raise 58, "CreateTextFile", "File already exists: " & filePath
        Set CreateTextFile = OpenTextFile(filePath, ForWriting, True, encoding, lineEnding)
    End Function

    ' --- public factories -------------------------------------------------
    ' Each stats the path ONCE and injects the result into the object, so the
    ' returned File/Folder is a snapshot: it does not re-query the disk on every
    ' property read. Re-fetch the object to see external changes.

    [Description("Returns a File object for an existing file.")]
    Public Function GetFile(ByVal filePath As String) As File
        filePath = GetAbsolutePathName(VBA.Replace$(filePath, "/", "\"))
        If Not FileExists(filePath) Then Err.Raise 53, "GetFile", "File not found: " & filePath

        Dim f As File
        Set f = New File
        Dim attrs As Long, size As LongLong, created As Date, modified As Date, accessed As Date, leaf As String
        Shared.StatPath filePath, attrs, size, created, modified, accessed, leaf
        ' StatPath hands back the leaf as stored on disk; re-attach it so the object
        ' reports the true casing rather than whatever the caller typed.
        If Len(leaf) > 0 Then filePath = BuildPath(GetParentFolderName(filePath), leaf)   ' disk casing
        f.Init filePath, attrs, size, created, modified, accessed

        Set GetFile = f
    End Function

    [Description("Returns a Folder object for an existing folder.")]
    Public Function GetFolder(ByVal folderPath As String) As Folder
        folderPath = GetAbsolutePathName(VBA.Replace$(folderPath, "/", "\"))
        If Not FolderExists(folderPath) Then Err.Raise 76, "GetFolder", "Path not found: " & folderPath

        Dim d As Folder
        Set d = New Folder
        Dim attrs As Long, size As LongLong, created As Date, modified As Date, accessed As Date, leaf As String
        Shared.StatPath folderPath, attrs, size, created, modified, accessed, leaf
        ' A drive root has no leaf to enumerate, so StatPath returns "" and the path
        ' is left as-is. (Note: 'size' is stat'd but unused - Folder computes it.)
        If Len(leaf) > 0 Then folderPath = BuildPath(GetParentFolderName(folderPath), leaf)   ' "" for root -> unchanged
        d.Init folderPath, attrs, created, modified, accessed

        Set GetFolder = d
    End Function

    [Description("Returns a Drive object for a drive spec: ""C"", ""C:"", ""C:\"", a UNC share, or any path on the drive.")]
    Public Function GetDrive(ByVal drivePath As String) As Drive
        drivePath = VBA.Replace$(drivePath, "/", "\")
        Dim root As String

        ' Reduce whatever was passed to a canonical root: "C:" or "\\server\share".
        If Left$(drivePath, 2) = "\\" Then
            root = GetDriveName(drivePath)                        ' UNC: \\server\share
        ElseIf Len(drivePath) >= 2 And Mid$(drivePath, 2, 1) = ":" Then
            root = UCase$(Left$(drivePath, 1)) & ":"
        ElseIf Len(drivePath) = 1 And UCase$(drivePath) >= "A" And UCase$(drivePath) <= "Z" Then
            root = UCase$(drivePath) & ":"
        End If

        ' Only the SHAPE is validated here - Drive.Init decides whether it is ready.
        If Len(root) = 0 Then Err.Raise 68, "GetDrive", "Invalid drive specification: " & drivePath

        Dim dr As Drive
        Set dr = New Drive
        dr.Init root
        Set GetDrive = dr
    End Function

    [Description("Returns a Drives collection of all logical drives present on the system.")]
    Public Function GetDrives() As Drives
        Dim c As New Collection
        Dim mask As Long, i As Long, letter As String
        mask = GetLogicalDrives()                                    ' bit 0 = A:, bit 25 = Z:
        For i = 0 To 25
            If (mask And (1& << i)) <> 0 Then
                letter = Chr$(Asc("A") + i)
                AddKeyed c, GetDrive(letter & ":"), letter            ' keyed so Drives("C") works
            End If
        Next
        Dim out As New Drives
        out.Init c
        Set GetDrives = out
    End Function

    [Description("Returns a TextStream over one of the process's standard streams. unicode:=True gives UTF-16LE (no BOM); default is the system ANSI code page. Raises if no handle is available (e.g. no console).")]
    Public Function GetStandardStream(ByVal standardStreamType As StandardStreamTypes, Optional ByVal unicode As Boolean = False) As TextStream
        Dim nStd As Long
        Select Case standardStreamType
            Case StdIn:  nStd = STD_INPUT_HANDLE
            Case StdOut: nStd = STD_OUTPUT_HANDLE
            Case StdErr: nStd = STD_ERROR_HANDLE
            Case Else
                Err.Raise 5, "GetStandardStream", "Invalid StandardStreamType: " & standardStreamType
        End Select

        Dim h As LongPtr
        h = GetStdHandle(nStd)                       ' read fresh each call (honours redirection)
        If h = 0 Or h = INVALID_HANDLE_VALUE Then
            Err.Raise 5, "GetStandardStream", "No standard stream handle is available."
        End If

        ' The handle is owned by the process, not by the TextStream - InitStdStream
        ' must not close it on teardown.
        Dim ts As TextStream
        Set ts = New TextStream
        ts.InitStdStream h, (standardStreamType = StdIn), unicode
        Set GetStandardStream = ts
    End Function
    
    [Description("Rewrites a text file in place in the target encoding and newline style (source auto-detected). toAttributes enforces a target attribute set (settable bits only); NoChange (the default) preserves the file's current attributes. Skips the write when content is already in target form. Refuses binary files. Returns True if the file was modified.")]
    Public Function NormalizeTextFile(ByVal filePath As String, _
        Optional ByVal toEncoding As TextEncoding = encUtf8, _
        Optional ByVal toNewLine As NewlineType = nlWindows, _
        Optional ByVal fromEncoding As TextEncoding = encAutoDetect, _
        Optional ByVal toAttributes As FileAttribute = NoChange, _
        Optional ByVal skipIfUnchanged As Boolean = True) As Boolean

        ' Flow: read raw -> refuse binary -> decode -> convert newlines -> re-encode
        ' -> byte-compare -> write only if different -> fix up attributes.
        filePath = VBA.Replace$(filePath, "/", "\")
        If toEncoding = encAutoDetect Then toEncoding = encUtf8

        Dim raw() As Byte
        ReadStream filePath, raw

        ' Decode the source to text. An empty file has no content to detect or
        ' decode, so it skips this block with text = "" and normalizes to an empty
        ' file (or a bare target BOM).
        Dim text As String
        If IsArrayInitialized(raw) Then
            Dim srcEnc As TextEncoding
            Dim isBinary As Boolean
            srcEnc = TextCodec.Detect(raw, fromEncoding)

            ' Refuse binary. On auto-detect, Detect already scanned the bytes,
            ' o a binary file comes back as encUnknown. On an
            ' explicit seed, Detect trusts the caller, so scan
            ' here for added safety - except wide seeds, whose NULs are legitimate text.
            isBinary = (srcEnc = encUnknown) _
                        OrElse (Not TextCodec.IsWideText(srcEnc) _
                        AndAlso TextCodec.LooksLikeBinary(raw))
            If isBinary Then
                Err.Raise ERR_NOT_TEXT, "NormalizeTextFile", _
                    "File appears to be binary; refusing to normalize: " & filePath
            End If

            text = TextCodec.Decode(raw, srcEnc, nlNoChange)   ' newline conversion happens below
        End If

        ' Capture settable source attributes before the rewrite resets them
        ' (WriteStream's temp-swap replaces the file, and with it its attributes).
        Dim srcAttr As Long
        srcAttr = GetFileAttributesW(StrPtr(filePath)) And Shared.SETTABLE_ATTRS

        ' Convert newlines, then re-encode to the target
        Dim s As String
        s = text
        If toNewLine > 0 Then s = TextCodec.ChangeNewLine(s, toNewLine)
        Dim outBytes() As Byte
        outBytes = TextCodec.Encode(s, toEncoding)

        ' Idempotency: byte-exact compare, rewrite only if different
        Dim changed As Boolean
        If (Not skipIfUnchanged) OrElse (Not TextCodec.BytesEqual(raw, outBytes)) Then
            WriteStream outBytes, filePath           ' atomic replace (resets attributes)
            changed = True
        End If

        ' Attribute normalization
        If toAttributes <> NoChange Then
            ' Enforce: drive the settable attributes to the sanitized target. Compare
            ' only the settable bits, so filesystem-managed bits (ReparsePoint, etc.)
            ' neither trigger a spurious change nor block idempotency.
            Dim tgt As Long
            tgt = SanitizeAttrs(toAttributes)                 ' what SetPathAttributes will apply
            If (GetFileAttributesW(StrPtr(filePath)) And Shared.SETTABLE_ATTRS) <> tgt Then
                SetPathAttributes filePath, tgt    ' tgt already sanitized; the chokepoint re-sanitizes idempotently
                changed = True                     ' NOTE: an attribute-only change still reports True
            End If
        ElseIf changed And srcAttr <> 0 Then
            SetPathAttributes filePath, srcAttr               ' preserve: restore what the rewrite cleared
        End If

        NormalizeTextFile = changed
    End Function
        
    [Description("Reads a text file and reports its line-ending style: nlWindows / nlUnix / nlMacintosh for a consistent file, nlMixed if it contains more than one, or nlUnknown if it has none. Reads the whole file, so the result (including mixed) is exact.")]
    Public Function GetFileLineEnding(ByVal filePath As String, Optional ByVal encoding As TextEncoding = encAutoDetect) As NewlineType
        ' nlNoChange is implicit in TextFileToString's default - the text MUST reach
        ' DetectNewlineType unnormalized or the answer is always nlWindows/nlUnix.
        ' Inherits TextFileToString's binary refusal (error 5).
        GetFileLineEnding = TextCodec.DetectNewlineType(TextFileToString(filePath, encoding))
    End Function
    
    '-------------------------------------------------------------------------------------------------
    '--------------------------------------- Private Members -----------------------------------------
    '-------------------------------------------------------------------------------------------------
        
    '=================================================================================================
    ' Name validation helpers
    '=================================================================================================

    ' True for CON/PRN/AUX/NUL/COM0-9/LPT0-9, with or without an extension.
    ' Windows resolves these as devices no matter what folder they sit in, so a
    ' file with such a name can never be created.
    Private Function IsReservedDeviceName(ByVal name As String) As Boolean
        Dim stem As String
        Dim dotPos As Long

        ' The device-name check applies to the portion before the first dot
        dotPos = InStr(name, ".")
        If dotPos = 0 Then stem = name Else stem = Left$(name, dotPos - 1)

        ' RTrim: "CON " is still CON to Win32 (trailing spaces are dropped).
        stem = UCase$(RTrim$(stem))

        Select Case True
            Case stem = "CON", stem = "PRN", stem = "AUX", stem = "NUL"
                IsReservedDeviceName = True
            Case stem Like "COM#", stem Like "LPT#"   ' # matches a single 0-9 digit
                IsReservedDeviceName = True
        End Select
    End Function
        
    '=================================================================================================
    ' Directory enumeration
    '
    ' All of these follow the same FindFirstFileW/FindNextFileW loop with an
    ' On Error GoTo CleanUp so the find handle is always closed, then the error is
    ' re-raised. If you add an exit path, it MUST go through CleanUp.
    '=================================================================================================

    ' Recursion driver for GetFilePaths: files at this level, then recurse.
    ' Depth is bounded only by the tree - a reparse-point loop could in principle
    ' recurse forever (junctions are not detected/skipped here).
    Private Sub CollectFiles(ByVal folder As String, ByVal pattern As String, _
        ByVal includeHidden As Boolean, _
        ByVal includeSystem As Boolean, ByVal recursive As Boolean, ByRef result As Collection)

        EnumerateLevel folder, pattern, includeHidden, includeSystem, result

        If Not recursive Then Exit Sub

        ' Subfolders are collected up-front (handle closed) before descending, so we
        ' are never enumerating a folder while a child walk mutates nothing under it.
        Dim subFolders As Collection
        Set subFolders = EnumerateSubFolders(folder, includeHidden, includeSystem)

        Dim f As Variant
        For Each f In subFolders
            CollectFiles CStr(f), pattern, includeHidden, includeSystem, True, result
        Next
    End Sub

    ' Files ONLY (directory bit excluded) in one folder matching 'pattern',
    ' appended to 'result' as full paths.
    Private Sub EnumerateLevel(ByVal folder As String, ByVal pattern As String, _
        ByVal includeHidden As Boolean, _
        ByVal includeSystem As Boolean, ByRef result As Collection)

        Dim ffd As WIN32_FIND_DATAW
        Dim hFind As LongPtr
        Dim name As String

        Dim e As Long
        hFind = FindFirstFileW(StrPtr(Shared.EnsureTrailingBackslash(folder) & pattern), ffd)
        e = Err.LastDllError                          ' capture BEFORE anything else
        If hFind = INVALID_HANDLE_VALUE Then
            Shared.IsEmptySearch e, "GetFilePaths", folder   ' returns True, or raises
            Exit Sub
        End If

        On Error GoTo CleanUp
        Do
            If (ffd.dwFileAttributes And FILE_ATTRIBUTE_DIRECTORY) = 0 Then
                name = Shared.FindDataFileName(ffd)         ' NUL-terminated fixed buffer -> String
                If name <> "." And name <> ".." Then
                    If Shared.IncludeByAttr(ffd.dwFileAttributes, includeHidden, includeSystem) Then
                        result.Add Shared.EnsureTrailingBackslash(folder) & name
                    End If
                End If
            End If
        Loop While FindNextFileW(hFind, ffd) <> 0

    CleanUp:
        If hFind <> 0 And hFind <> INVALID_HANDLE_VALUE Then FindClose hFind
        If Err.Number <> 0 Then Err.Raise Err.Number, Err.Source, Err.Description
    End Sub

    ' Immediate subfolders of 'folder' as full paths. Always uses "*" - the caller's
    ' file pattern must not restrict which folders we are allowed to descend into.
    Private Function EnumerateSubFolders(ByVal folder As String, _
        ByVal includeHidden As Boolean, ByVal includeSystem As Boolean) As Collection

        Dim ffd As WIN32_FIND_DATAW
        Dim hFind As LongPtr
        Dim name As String
        Dim folders As New Collection

        Dim e As Long
        hFind = FindFirstFileW(StrPtr(Shared.EnsureTrailingBackslash(folder) & "*"), ffd)
        e = Err.LastDllError
        If hFind = INVALID_HANDLE_VALUE Then
            Shared.IsEmptySearch e, "GetFilePaths", folder
            Set EnumerateSubFolders = folders          ' empty, and legitimately so
            Exit Function
        End If

        On Error GoTo CleanUp
        Do
            If (ffd.dwFileAttributes And FILE_ATTRIBUTE_DIRECTORY) <> 0 Then
                name = Shared.FindDataFileName(ffd)
                If name <> "." And name <> ".." Then        ' skip the self/parent entries
                    If Shared.IncludeByAttr(ffd.dwFileAttributes, includeHidden, includeSystem) Then
                        folders.Add Shared.EnsureTrailingBackslash(folder) & name
                    End If
                End If
            End If
        Loop While FindNextFileW(hFind, ffd) <> 0

    CleanUp:
        If hFind <> 0 And hFind <> INVALID_HANDLE_VALUE Then FindClose hFind
        Set EnumerateSubFolders = folders                   ' assign before any re-raise
        If Err.Number <> 0 Then Err.Raise Err.Number, Err.Source, Err.Description
    End Function

    '=================================================================================================
    ' Path helpers (lexical + probing)
    '=================================================================================================

    ' PathRelativePathToW only cares about DIRECTORY vs NORMAL. A path that does
    ' not exist reports NORMAL (i.e. "treat it as a file").
    Private Function ResolveAttrForRelative(ByVal path As String) As FILE_ATTRIBUTES
        Dim a As FILE_ATTRIBUTES
        a = GetFileAttributesW(StrPtr(path))
        If a <> INVALID_FILE_ATTRIBUTES And (a And FILE_ATTRIBUTE_DIRECTORY) <> 0 Then
            ResolveAttrForRelative = FILE_ATTRIBUTE_DIRECTORY
        Else
            ResolveAttrForRelative = FILE_ATTRIBUTE_NORMAL
        End If
    End Function
        
    '=================================================================================================
    ' Win32 marshalling helpers
    '=================================================================================================

    ' Copies charLen UTF-16 code units from a raw pointer into a String.
    ' charLen is in CHARACTERS, not bytes - hence the * 2 in the CopyMemory.
    Private Function PtrToStringW(ByVal pStr As LongPtr, ByVal charLen As Long) As String
        If charLen <= 0 Then Exit Function
        PtrToStringW = String$(charLen, vbNullChar)
        CopyMemory ByVal StrPtr(PtrToStringW), ByVal pStr, charLen * 2
    End Function
        
    ' Reads a single 16-bit value at p (used to pull the language/codepage pair out
    ' of the version resource's Translation table).
    Private Function PeekWord(ByVal p As LongPtr) As Integer
        CopyMemory PeekWord, ByVal p, 2
    End Function

    Private Function GuidFromString(ByVal s As String) As UUID
        Dim g As UUID
        Dim hr As Long
        hr = CLSIDFromString(StrPtr(s), g)
        If hr <> 0 Then Err.Raise hr, , "Invalid GUID string: " & s
        GuidFromString = g
    End Function
        
    ' Type-agnostic existence check: True for a file, a folder, or anything else
    ' that has attributes. Used by GetTempName, where "is this name taken?" is the
    ' only question - FileExists/FolderExists would each miss half the answer.
    Private Function PathExists(ByVal path As String) As Boolean
        If Len(path) = 0 Then
            PathExists = False
            Exit Function
        End If
        PathExists = (GetFileAttributesW(StrPtr(path)) <> INVALID_FILE_ATTRIBUTES)
    End Function
        
    '=================================================================================================
    ' Delete cores
    '=================================================================================================

    ' Single-file delete core. Input assumed slash-normalized and wildcard-free.
    ' Raises 53 for missing/wrong-type; anything else comes from RaiseFromLastError.
    Private Sub DeleteOneFile(ByVal filePath As String, ByVal force As Boolean, ByVal ignoreMissing As Boolean)
        Dim attr As Long
        attr = GetFileAttributesW(StrPtr(filePath))
        If attr = -1 Then
            If ignoreMissing Then Exit Sub                 ' nothing to delete - not an error
            Err.Raise 53, "DeleteFile", "File not found: " & filePath
        End If
        If (attr And FILE_ATTRIBUTE_DIRECTORY) <> 0 Then
            ' A directory exists at this path - a wrong-type error, not a missing
            ' file, so ignoreMissing deliberately does not apply here.
            Err.Raise 53, "DeleteFile", "File not found: " & filePath
        End If
        If force Then
            ' Clearing to NORMAL drops read-only/hidden/system in one shot - that is
            ' what lets DeleteFileW succeed on a read-only file.
            SetFileAttributesW StrPtr(filePath), FILE_ATTRIBUTE_NORMAL
        End If
        If DeleteFileW(StrPtr(filePath)) = 0 Then
            RaiseFromLastError Err.LastDllError, "DeleteFile", filePath
        End If
    End Sub

    ' Wildcard delete: two-phase (snapshot names, close handle, then delete).
    ' Deleting inside the enumeration loop would invalidate the find handle.
    Private Sub DeleteFileWildcard(ByVal pattern As String, ByVal force As Boolean, ByVal ignoreMissing As Boolean)
        Dim baseFolder As String
        baseFolder = GetParentFolderName(pattern)          ' the pattern's folder, minus the mask

        ' --- Phase 1: snapshot matching file names, then close the handle ---
        Dim names As New Collection
        Dim ffd As WIN32_FIND_DATAW
        Dim hFind As LongPtr

        hFind = FindFirstFileW(StrPtr(pattern), ffd)
        If hFind = INVALID_HANDLE_VALUE Then
            If ignoreMissing Then Exit Sub                 ' pattern matched nothing
            Err.Raise 53, "DeleteFile", "File not found: " & pattern
        End If

        On Error GoTo CleanUp
        Do
            Dim nm As String
            nm = Shared.FindDataFileName(ffd)
            If nm <> "." And nm <> ".." Then
                If (ffd.dwFileAttributes And FILE_ATTRIBUTE_DIRECTORY) = 0 Then names.Add nm
            End If
        Loop While FindNextFileW(hFind, ffd) <> 0

    CleanUp:
        If hFind <> 0 And hFind <> INVALID_HANDLE_VALUE Then FindClose hFind
        hFind = 0
        If Err.Number <> 0 Then Err.Raise Err.Number, Err.Source, Err.Description

        ' A pattern that only matched folders lands here with an empty collection.
        If names.Count = 0 Then
            If ignoreMissing Then Exit Sub
            Err.Raise 53, "DeleteFile", "File not found: " & pattern
        End If

        ' --- Phase 2: handle closed; now delete ---
        ' Not transactional: a failure part-way leaves earlier deletions done.
        Dim v As Variant
        For Each v In names
            DeleteOneFile BuildPath(baseFolder, CStr(v)), force, ignoreMissing
        Next
    End Sub
    
    ' Single-folder delete core. Input assumed slash-normalized and wildcard-free.
    ' Extracted from DeleteFolder so both the public entry and the wildcard walker
    ' delegate here (parallels DeleteOneFile / MoveOneFolder).
    Private Sub DeleteOneFolder(ByVal folderPath As String, ByVal force As Boolean, ByVal ignoreMissing As Boolean)
        Dim attr As Long
        attr = GetFileAttributesW(StrPtr(folderPath))
        If attr = -1 Then
            If ignoreMissing Then Exit Sub                 ' nothing to delete - not an error
            Err.Raise 76, "DeleteFolder", "Path not found: " & folderPath
        End If
        If (attr And FILE_ATTRIBUTE_DIRECTORY) = 0 Then
            ' A file exists at this path, not a folder - a wrong-type error, not a
            ' missing folder, so ignoreMissing deliberately does not apply here.
            Err.Raise 76, "DeleteFolder", "Path not found: " & folderPath
        End If
        ' Empty the folder first: RemoveDirectoryW only removes an EMPTY directory.
        DeleteFolderRecursive folderPath, force
        If force Then SetFileAttributesW StrPtr(folderPath), FILE_ATTRIBUTE_NORMAL
        If RemoveDirectoryW(StrPtr(folderPath)) = 0 Then
            ' Typically 145 (dir not empty - something was locked or undeletable)
            ' or 5 (access denied). RaiseFromLastError maps it to a VB error.
            RaiseFromLastError Err.LastDllError, "DeleteFolder", folderPath
        End If
    End Sub
        
    ' Depth-first emptying of 'folder' - removes the CONTENTS, never 'folder' itself
    ' (the caller does that). Deliberately best-effort: DeleteFileW/RemoveDirectoryW
    ' return values are ignored here, and any leftover surfaces as a failed
    ' RemoveDirectoryW in DeleteOneFolder.
    Private Sub DeleteFolderRecursive(ByVal folder As String, ByVal force As Boolean)
        Dim ffd As WIN32_FIND_DATAW
        Dim hFind As LongPtr
        Dim searchPath As String

        searchPath = Shared.EnsureTrailingBackslash(folder) & "*"

        hFind = FindFirstFileW(StrPtr(searchPath), ffd)
        If hFind = INVALID_HANDLE_VALUE Then Exit Sub

        On Error GoTo CleanUp

        ' NOTE: this one deletes DURING the walk rather than snapshotting first.
        ' Windows tolerates deleting the just-returned entry, but do not extend this
        ' to any other kind of mutation.
        Do
            Dim name As String
            name = Shared.FindDataFileName(ffd)

            If name <> "." And name <> ".." Then
                Dim fullPath As String
                fullPath = Shared.EnsureTrailingBackslash(folder) & name

                If (ffd.dwFileAttributes And FILE_ATTRIBUTE_DIRECTORY) <> 0 Then
                    ' Recurses into reparse points/junctions as if they were real
                    ' folders - deletes the TARGET's contents, not just the link.
                    DeleteFolderRecursive fullPath, force
                    If force Then SetFileAttributesW StrPtr(fullPath), FILE_ATTRIBUTE_NORMAL
                    RemoveDirectoryW StrPtr(fullPath)
                Else
                    If force Then SetFileAttributesW StrPtr(fullPath), FILE_ATTRIBUTE_NORMAL
                    DeleteFileW StrPtr(fullPath)
                End If
            End If
        Loop While FindNextFileW(hFind, ffd) <> 0

    CleanUp:
        If hFind <> 0 Then FindClose hFind
        If Err.Number <> 0 Then Err.Raise Err.Number, Err.Source, Err.Description
    End Sub
        
    ' Wildcard folder delete: two-phase, like DeleteFileWildcard, but matching
    ' DIRECTORY entries only. Raises 76 (path not found) rather than 53.
    Private Sub DeleteFolderWildcard(ByVal pattern As String, ByVal force As Boolean, ByVal ignoreMissing As Boolean)
        Dim basePath As String
        basePath = Left$(pattern, InStrRev(pattern, "\"))   ' keeps the trailing "\"
        If basePath = "" Then basePath = ".\"               ' bare pattern -> current directory

        ' --- Phase 1: snapshot matching folder names, then close the handle ---
        Dim names As New Collection
        Dim ffd As WIN32_FIND_DATAW
        Dim hFind As LongPtr

        hFind = FindFirstFileW(StrPtr(pattern), ffd)
        If hFind = INVALID_HANDLE_VALUE Then
            If ignoreMissing Then Exit Sub                 ' pattern matched nothing
            Err.Raise 76, "DeleteFolder", "Path not found: " & pattern
        End If

        On Error GoTo CleanUp
        Do
            If (ffd.dwFileAttributes And FILE_ATTRIBUTE_DIRECTORY) <> 0 Then
                Dim nm As String
                nm = Shared.FindDataFileName(ffd)
                If nm <> "." And nm <> ".." Then names.Add nm
            End If
        Loop While FindNextFileW(hFind, ffd) <> 0

    CleanUp:
        If hFind <> 0 And hFind <> INVALID_HANDLE_VALUE Then FindClose hFind
        hFind = 0
        If Err.Number <> 0 Then Err.Raise Err.Number, Err.Source, Err.Description

        If names.Count = 0 Then
            If ignoreMissing Then Exit Sub
            Err.Raise 76, "DeleteFolder", "Path not found: " & pattern
        End If

        ' --- Phase 2: handle closed; now delete (via the private core) ---
        Dim v As Variant
        For Each v In names
            DeleteOneFolder basePath & CStr(v), force, ignoreMissing
        Next
    End Sub
        
    '=================================================================================================
    ' Copy / move cores
    '=================================================================================================

    ' Mirrors 'source' into 'destination', which must ALREADY exist. Subfolders are
    ' created as needed; files go through CopyOneFile so overwrite is honoured.
    ' Copies during the walk (no snapshot) - safe because we only write to the
    ' DESTINATION tree, never to the folder being enumerated.
    Private Sub CopyFolderRecursive(ByVal source As String, ByVal destination As String, ByVal overwriteFiles As Boolean)
        Dim ffd As WIN32_FIND_DATAW
        Dim hFind As LongPtr
        Dim searchPath As String

        searchPath = Shared.EnsureTrailingBackslash(source) & "*"

        hFind = FindFirstFileW(StrPtr(searchPath), ffd)
        If hFind = INVALID_HANDLE_VALUE Then Exit Sub

        On Error GoTo CleanUp
        Do
            Dim name As String
            name = Shared.FindDataFileName(ffd)

            If name <> "." And name <> ".." Then
                Dim srcItem As String
                Dim dstItem As String

                srcItem = Shared.EnsureTrailingBackslash(source) & name
                dstItem = Shared.EnsureTrailingBackslash(destination) & name

                If (ffd.dwFileAttributes And FILE_ATTRIBUTE_DIRECTORY) <> 0 Then
                    ' Subfolder
                    If Not FolderExists(dstItem) Then
                        CreateDir dstItem, "CopyFolder"
                    End If
                    CopyFolderRecursive srcItem, dstItem, overwriteFiles
                Else
                    ' File
                    CopyOneFile srcItem, dstItem, overwriteFiles
                End If
            End If
        Loop While FindNextFileW(hFind, ffd) <> 0

    CleanUp:
        If hFind <> 0 And hFind <> INVALID_HANDLE_VALUE Then FindClose hFind
        If Err.Number <> 0 Then Err.Raise Err.Number, Err.Source, Err.Description
    End Sub
        
    ' True if either wildcard char is present anywhere in the string. Binary compare
    ' so it is locale-independent.
    Private Function HasWildcards(ByVal s As String) As Boolean
        HasWildcards = (InStr(1, s, "*", vbBinaryCompare) > 0) Or (InStr(1, s, "?", vbBinaryCompare) > 0)
    End Function
        
    ' "C:" or "C:foo" - a drive with NO leading backslash. Windows resolves these
    ' against that drive's own current directory, which is per-process state and a
    ' classic source of surprises. Handled explicitly in GetAbsolutePathName.
    Private Function IsDriveRelative(ByVal p As String) As Boolean
        IsDriveRelative = (Len(p) >= 2 And Mid$(p, 2, 1) = ":" And (Len(p) = 2 Or Mid$(p, 3, 1) <> "\"))
    End Function

    ' A UNC path that is not ALREADY long-path-prefixed (\\?\ paths start with "\\"
    ' too, so the second test is required).
    Private Function IsUNC(ByVal p As String) As Boolean
        IsUNC = (Left$(p, 2) = "\\" And Left$(p, 4) <> "\\?\")
    End Function

    ' Adds the \\?\ prefix that lifts the 260-char limit. UNC needs the special
    ' \\?\UNC\server\share form (the leading "\\" is replaced, not kept).
    ' Idempotent. Caution: \\?\ paths bypass normalization, so they must already be
    ' fully canonical - always feed this the output of GetAbsolutePathName.
    Private Function AddLongPathPrefix(ByVal p As String) As String
        If Left$(p, 4) = "\\?\" Then
            AddLongPathPrefix = p
        ElseIf IsUNC(p) Then
            AddLongPathPrefix = "\\?\UNC\" & Mid$(p, 3)
        Else
            AddLongPathPrefix = "\\?\" & p
        End If
    End Function
         
    ' Single-file copy core. Input assumed slash-normalized and wildcard-free.
    Private Sub CopyOneFile(ByVal source As String, _
        ByVal destination As String, _
        ByVal overwriteFiles As Boolean)

        ' FSO treats destination as folder if it exists as a folder OR ends with "\"
        If IsFolderPathOrExistingFolder(destination) Then
            destination = Shared.EnsureTrailingBackslash(destination) & GetFileName(source)
        End If

        Dim flags As Long
        If Not overwriteFiles Then flags = COPY_FILE_FAIL_IF_EXISTS   ' -> 80 -> error 58

        ' pbCancel is passed by reference and never set: no cancellation support,
        ' but the API requires the slot.
        Dim cancel As Long
        cancel = 0

        SetLastError 0                                    ' clear stale error state before the call
        If CopyFileExW(StrPtr(source), StrPtr(destination), 0, 0, cancel, flags) = 0 Then
            RaiseFromLastError Err.LastDllError, "CopyFile", source & " -> " & destination
        End If
    End Sub
        
    ' "Should this destination be treated as a container?" A trailing "\" asserts it
    ' even when nothing exists there yet; otherwise the disk decides.
    Private Function IsFolderPathOrExistingFolder(ByVal path As String) As Boolean
        If Len(path) = 0 Then Exit Function
        If Right$(path, 1) = "\" Then
            IsFolderPathOrExistingFolder = True
            Exit Function
        End If

        Dim attr As Long
        attr = GetFileAttributesW(StrPtr(path))
        If attr = -1 Then Exit Function                    ' doesn't exist -> treat as a file path
        IsFolderPathOrExistingFolder = ((attr And FILE_ATTRIBUTE_DIRECTORY) <> 0)
    End Function
        
    ' Single chokepoint for directory creation, so every failure is reported through
    ' RaiseFromLastError with the caller's name (sourceName) rather than "CreateDir".
    ' Note it creates ONE level: parents must already exist (see EnsureParentExists).
    Private Sub CreateDir(ByVal path As String, ByVal sourceName As String)
        If CreateDirectoryW(StrPtr(path), ByVal vbNullPtr) = CFALSE Then
            RaiseFromLastError Err.LastDllError, sourceName, path
        End If
    End Sub
    
    ' True for "\\server" or "\\server\share" - the two UNC forms that have no
    ' parent and no file name. Anything deeper is a normal path.
    Private Function IsUncRoot(ByVal s As String) As Boolean
        Dim t As String: t = VBA.Replace$(s, "/", "\")
        If Left$(t, 2) <> "\\" Then Exit Function
        Dim afterServer As Long, afterShare As Long
        afterServer = InStr(3, t, "\")
        If afterServer = 0 Then IsUncRoot = True: Exit Function     ' "\\server"
        afterShare = InStr(afterServer + 1, t, "\")
        If afterShare = 0 Then IsUncRoot = True                     ' "\\server\share"
    End Function
    
    ' Reads one field (e.g. "FileVersion" / "ProductVersion") from the StringFileInfo
    ' block under the file's own language/codepage. Returns "" if absent.
    ' The language key is not fixed - it must be read from \VarFileInfo\Translation
    ' first and formatted as 8 hex digits (lang, then codepage), which is what the
    ' two PeekWord calls below are doing.
    Private Function ReadStringFileInfo(ByRef buffer() As Byte, ByVal fieldName As String) As String
        Dim ptr As LongPtr
        Dim lenBuf As Long
        If VerQueryValueW(buffer(0), StrPtr("\VarFileInfo\Translation"), ptr, lenBuf) = 0 Then Exit Function
        Dim langCode As String
        langCode = Right$("0000" & Hex$(PeekWord(ptr)), 4) & _
                Right$("0000" & Hex$(PeekWord(ptr + 2)), 4)
        If VerQueryValueW(buffer(0), StrPtr("\StringFileInfo\" & langCode & "\" & fieldName), ptr, lenBuf) = 0 Then Exit Function
        ReadStringFileInfo = PtrToStringW(ptr, lenBuf - 1)     ' lenBuf includes the trailing null
    End Function
    
    ' Recursively creates any missing ancestors of 'path' (but not 'path' itself).
    ' Recursion unwinds top-down: the deepest existing ancestor terminates it, and
    ' the levels are then materialized on the way back out.
    Private Sub EnsureParentExists(ByVal path As String)
        Dim parent As String
        parent = GetParentFolderName(path)
        If Len(parent) = 0 Then Exit Sub          ' reached a drive/UNC root - nothing above to create
        If FolderExists(parent) Then Exit Sub     ' deepest existing ancestor reached - stop
        EnsureParentExists parent                  ' ensure the grandparent chain first
        CreateDir parent, "CreateFolder"           ' then materialize this level
    End Sub
    
    ' Index of the last separator of EITHER kind. Used only where the input may not
    ' have been slash-normalized (GetParentFolderName preserves the original chars).
    Private Function LastSep(ByVal s As String) As Long
        Dim a As Long, b As Long
        a = InStrRev(s, "\"): b = InStrRev(s, "/")
        LastSep = IIf(a > b, a, b)
    End Function
    
    ' Single-file move core. Input assumed slash-normalized and wildcard-free.
    ' Returns the resolved destination path.
    Private Function MoveOneFile(ByVal source As String, ByVal destination As String) As String
        ' Folder destination -> keep the source's filename inside it
        If FolderExists(destination) Or Right$(destination, 1) = "\" Then
            destination = BuildPath(destination, GetFileName(source))
        End If
        destination = GetAbsolutePathName(destination)

        ' FSO does NOT allow overwrite (checked against the resolved target)
        If FileExists(destination) Then
            Err.Raise 58, "MoveFile", "File already exists: " & destination
        End If

        ' Atomic same-volume rename first. No COPY_ALLOWED: cross-volume falls
        ' through to our CopyFile + DeleteFile (surfaces a failed source delete).
        If MoveFileExW(StrPtr(source), StrPtr(destination), 0) <> 0 Then
            MoveOneFile = destination
            Exit Function
        End If

        Dim e As Long
        e = Err.LastDllError                       ' capture before any further API call

        If e = ERROR_NOT_SAME_DEVICE Then
            ' overwrite:=False mirrors the no-overwrite guard above; if the copy or
            ' the delete raises, the source is left intact (the copy may not be).
            CopyFile source, destination, False
            DeleteFile source
            MoveOneFile = destination
            Exit Function
        End If

        RaiseFromLastError e, "MoveFile", source
    End Function

    ' Single-folder move core. Input assumed slash-normalized and wildcard-free.
    ' Returns the resolved destination path.
    Private Function MoveOneFolder(ByVal source As String, ByVal destination As String) As String
        If Not FolderExists(source) Then
            Err.Raise 76, "MoveFolder", "Path not found: " & source
        End If

        ' Folder destination -> move source INTO it, keeping its leaf name.
        ' Strip any trailing "\" from source first, or GetFileName returns empty.
        If FolderExists(destination) Or Right$(destination, 1) = "\" Then
            Dim leafSrc As String
            leafSrc = source
            If Right$(leafSrc, 1) = "\" Then leafSrc = Left$(leafSrc, Len(leafSrc) - 1)
            destination = BuildPath(destination, GetFileName(leafSrc))
        End If
        destination = GetAbsolutePathName(destination)

        If FolderExists(destination) Then
            Err.Raise 58, "MoveFolder", "Folder already exists: " & destination
        End If

        ' Try atomic rename.
        ' NOTE the asymmetry with MoveOneFile: COPY_ALLOWED is passed here, but it
        ' is a no-op for directories (Win32 will not copy a tree), so a cross-volume
        ' move still lands in the ERROR_NOT_SAME_DEVICE fallback below.
        If MoveFileExW(StrPtr(source), StrPtr(destination), MOVEFILE_COPY_ALLOWED) <> 0 Then
            MoveOneFolder = destination
            Exit Function
        End If

        Dim e As Long
        e = Err.LastDllError

        ' Cross-volume fallback
        If e = ERROR_NOT_SAME_DEVICE Then
            CopyFolder source, destination, True
            DeleteFolder source, True              ' force:=True - the copy is done; clear read-onlys
            MoveOneFolder = destination
            Exit Function
        End If

        RaiseFromLastError e, "MoveFolder", source
    End Function

    ' Single-folder copy core. Input assumed slash-normalized and wildcard-free.
    Private Sub CopyOneFolder(ByVal source As String, ByVal destination As String, ByVal overwrite As Boolean)
        ' Strip trailing backslash from source (except a drive root) so GetFileName resolves
        Do While Len(source) > 1 And Right$(source, 1) = "\" And Right$(source, 2) <> ":\"
            source = Left$(source, Len(source) - 1)
        Loop

        ' Source must exist and be a folder
        If Not FolderExists(source) Then
            Err.Raise 76, "CopyFolder", "Path not found: " & source
        End If

        ' Resolve destination folder: an EXISTING destination means "copy INTO it"
        ' (source keeps its leaf name); otherwise the destination IS the new folder.
        If FolderExists(destination) Then
            destination = Shared.EnsureTrailingBackslash(destination) & GetFileName(source)
        End If

        ' Create destination folder if needed (single level - parents must exist)
        If Not FolderExists(destination) Then
            CreateDir destination, "CopyFolder"
        End If

        CopyFolderRecursive source, destination, overwrite
    End Sub
    
    '=================================================================================================
    ' Wildcard walkers
    '
    ' All three share the same contract: the source's wildcard may only appear in
    ' the LAST component, the destination is a CONTAINER that must already exist
    ' (FSO parity - none of these create it), and each is strictly two-phase.
    ' None is transactional: a mid-loop failure leaves earlier items already moved
    ' or copied.
    '=================================================================================================

    ' Shared by MoveFile and MoveFolder; wantFolders selects which entry type the
    ' pattern is allowed to match, and drives the error code (76 vs 53) and the core
    ' that gets called. Returns the destination container.
    Private Function MoveWildcard(ByVal sourcePattern As String, ByVal destination As String, _
            ByVal wantFolders As Boolean) As String
        Dim baseFolder As String
        baseFolder = GetParentFolderName(sourcePattern)

        ' Wildcard source => destination is a container. Normalize once up front.
        destination = GetAbsolutePathName(destination)

        ' --- Phase 1: enumerate, collecting matching leaf names only ---
        Dim names As New Collection
        Dim ffd As WIN32_FIND_DATAW
        Dim hFind As LongPtr

        SetLastError 0
        hFind = FindFirstFileW(StrPtr(sourcePattern), ffd)
        If hFind = INVALID_HANDLE_VALUE Then
            Err.Raise IIf(wantFolders, 76, 53), IIf(wantFolders, "MoveFolder", "MoveFile"), _
                    "Path not found: " & sourcePattern
        End If

        On Error GoTo CleanUp
        Do
            Dim nm As String
            nm = Shared.FindDataFileName(ffd)
            If nm <> "." And nm <> ".." Then
                Dim isDir As Boolean
                isDir = ((ffd.dwFileAttributes And FILE_ATTRIBUTE_DIRECTORY) <> 0)
                If isDir = wantFolders Then names.Add nm    ' keep only the requested type
            End If
        Loop While FindNextFileW(hFind, ffd) <> 0

    CleanUp:
        If hFind <> 0 And hFind <> INVALID_HANDLE_VALUE Then FindClose hFind
        hFind = 0
        If Err.Number <> 0 Then Err.Raise Err.Number, Err.Source, Err.Description

        ' The pattern matched entries, but none of the requested type.
        If names.Count = 0 Then
            Err.Raise IIf(wantFolders, 76, 53), IIf(wantFolders, "MoveFolder", "MoveFile"), _
                    "Path not found: " & sourcePattern
        End If

        ' Wildcard move treats destination as a container that must ALREADY exist
        ' (FSO parity — FSO does not create the destination directory).
        ' Checked AFTER enumeration so a bad source pattern reports first.
        If Not FolderExists(destination) Then
            Err.Raise 76, IIf(wantFolders, "MoveFolder", "MoveFile"), _
                    "Path not found: " & destination
        End If

        ' --- Phase 2: handle closed; perform the moves via the single-item cores ---
        ' The trailing "\" is what makes the cores treat destination as a container.
        Dim destContainer As String
        destContainer = Shared.EnsureTrailingBackslash(destination)

        Dim v As Variant
        For Each v In names
            If wantFolders Then
                MoveOneFolder BuildPath(baseFolder, CStr(v)), destContainer
            Else
                MoveOneFile BuildPath(baseFolder, CStr(v)), destContainer
            End If
        Next

        MoveWildcard = destination
    End Function

    ' Wildcard folder copy: matches DIRECTORY entries only; raises 76 throughout.
    Private Sub CopyFolderWildcard(ByVal sourcePattern As String, ByVal destination As String, ByVal overwriteFiles As Boolean)
        Dim baseFolder As String
        baseFolder = GetParentFolderName(sourcePattern)

        ' Wildcard source => destination is a container. Normalize once up front.
        destination = GetAbsolutePathName(destination)

        ' --- Phase 1: snapshot matching folder names, then close the handle ---
        Dim names As New Collection
        Dim ffd As WIN32_FIND_DATAW
        Dim hFind As LongPtr

        SetLastError 0
        hFind = FindFirstFileW(StrPtr(sourcePattern), ffd)
        If hFind = INVALID_HANDLE_VALUE Then
            Err.Raise 76, "CopyFolder", "Path not found: " & sourcePattern
        End If

        On Error GoTo CleanUp
        Do
            Dim nm As String
            nm = Shared.FindDataFileName(ffd)
            If nm <> "." And nm <> ".." Then
                If (ffd.dwFileAttributes And FILE_ATTRIBUTE_DIRECTORY) <> 0 Then names.Add nm
            End If
        Loop While FindNextFileW(hFind, ffd) <> 0

    CleanUp:
        If hFind <> 0 And hFind <> INVALID_HANDLE_VALUE Then FindClose hFind
        hFind = 0
        If Err.Number <> 0 Then Err.Raise Err.Number, Err.Source, Err.Description

        If names.Count = 0 Then
            Err.Raise 76, "CopyFolder", "Path not found: " & sourcePattern
        End If

        ' Wildcard folder-copy treats destination as a container that must ALREADY
        ' exist (FSO parity). The per-match subfolders inside it are created by
        ' CopyOneFolder; the container itself is not.
        If Not FolderExists(destination) Then
            Err.Raise 76, "CopyFolder", "Path not found: " & destination
        End If

        ' --- Phase 2: handle closed; now copy ---
        Dim destContainer As String
        destContainer = Shared.EnsureTrailingBackslash(destination)

        Dim v As Variant
        For Each v In names
            CopyOneFolder BuildPath(baseFolder, CStr(v)), destContainer, overwriteFiles
        Next
    End Sub
    
    ' Wildcard file copy: matches FILE entries only. Raises 53 for a source that
    ' matched nothing, 76 for a missing destination container.
    Private Sub CopyFileWildcard(ByVal sourcePattern As String, ByVal destination As String, ByVal overwriteFiles As Boolean)
        Dim baseFolder As String
        baseFolder = GetParentFolderName(sourcePattern)

        ' Wildcard source => destination is a container. Normalize once up front.
        destination = GetAbsolutePathName(destination)

        ' --- Phase 1: snapshot matching file names, then close the handle ---
        Dim names As New Collection
        Dim ffd As WIN32_FIND_DATAW
        Dim hFind As LongPtr

        SetLastError 0
        hFind = FindFirstFileW(StrPtr(sourcePattern), ffd)
        If hFind = INVALID_HANDLE_VALUE Then
            Err.Raise 53, "CopyFile", "File not found: " & sourcePattern
        End If

        On Error GoTo CleanUp
        Do
            Dim nm As String
            nm = Shared.FindDataFileName(ffd)
            If nm <> "." And nm <> ".." Then
                If (ffd.dwFileAttributes And FILE_ATTRIBUTE_DIRECTORY) = 0 Then names.Add nm
            End If
        Loop While FindNextFileW(hFind, ffd) <> 0

    CleanUp:
        If hFind <> 0 And hFind <> INVALID_HANDLE_VALUE Then FindClose hFind
        hFind = 0
        If Err.Number <> 0 Then Err.Raise Err.Number, Err.Source, Err.Description

        ' Pattern matched only folders.
        If names.Count = 0 Then
            Err.Raise 53, "CopyFile", "File not found: " & sourcePattern
        End If

        ' Wildcard copy treats destination as a container that must ALREADY exist
        ' (FSO parity — FSO does not create the destination directory for file ops).
        If Not FolderExists(destination) Then
            Err.Raise 76, "CopyFile", "Path not found: " & destination
        End If

        ' --- Phase 2: handle closed; now copy ---
        Dim destContainer As String
        destContainer = Shared.EnsureTrailingBackslash(destination)

        Dim v As Variant
        For Each v In names
            CopyOneFile BuildPath(baseFolder, CStr(v)), destContainer, overwriteFiles
        Next
    End Sub
    
    '=================================================================================================
    ' Write-path guard
    '=================================================================================================

    ' Raises 52 if the LEAF of a create path contains characters that cannot go
    ' through the atomic temp-file swap (WriteStream). The swap builds a temp name
    ' "<path>.~XXXX.tmp", so ANY reserved char in the leaf — INCLUDING ':' — poisons
    ' the temp name and fails at VB Open with a useless E_FAIL. We reject up front
    ' with 52 (Bad file name or number). Colon is INCLUDED here (unlike the direct-
    ' write CreateTextFile path) because the temp-swap cannot honor an ADS write.
    ' Leaf-only: '\' and the drive ':' in the path portion are legal.
    '
    ' Called by StringToTextFile and ArrayToTextFile - i.e. every public entry that
    ' reaches WriteStream. If a new WriteStream caller is added, it needs this too.
    Private Sub GuardWriteName(ByVal path As String, ByVal opName As String)
        Dim leaf As String
        leaf = GetFileName(path)
        If leaf Like "*[<>:""|?*]*" Then          ' colon INCLUDED for the temp-swap path
            Err.Raise 52, opName, "Bad file name or number: " & path
        End If
        ' Control chars are not expressible in a Like pattern - check them separately.
        Dim i As Long
        For i = 1 To Len(leaf)
            If AscW(Mid$(leaf, i, 1)) < 32 Then
                Err.Raise 52, opName, "Bad file name or number: " & path
            End If
        Next
    End Sub
    
End Module


' ==========================================================================
' File
'
' An FSO-style File object. Obtained from FileSystemTools.GetFile or
' Folder.Files - never New'd directly.
'
' --- LIVE, not a snapshot ------------------------------------------------
' Every public member begins with EnsureCurrent(), which re-stats the path and
' refreshes the cached fields. Same contract as Folder:
'
'   * ACCURACY. Attributes, size and dates never go stale, and mPath always
'     carries the true on-disk casing. A File whose target is deleted out from
'     under it raises 53 on the NEXT access rather than reporting fossils.
'   * COST. Every property read is a FindFirstFileW round-trip. Reading five
'     properties stats the file five times. Hoist values out of loops.
'
' The Init'd fields are a cache, not the source of truth - EnsureCurrent is. They
' exist so Folder.Files can hand over a whole directory's worth of stat data from
' the WIN32_FIND_DATAW it already holds, instead of re-statting every child.
'
' --- Cheap vs expensive members ------------------------------------------
' Most properties are served from that cache and cost one stat. Four are NOT, and
' should never sit in a loop:
'   Encoding    - reads a 64KB head sample on every access
'   LineEnding  - reads the WHOLE FILE on every access (and calls Encoding first,
'                 so it actually touches the disk three times)
'   Version     - loads and parses the file's version resource
'   Type        - a shell round-trip (SHGetFileInfoW)
'
' --- Contrast with Folder ------------------------------------------------
'   File.Size   is a cached stat field - one stat, effectively free.
'   Folder.Size walks the entire subtree on every read.
' Same property name, wildly different cost. Worth knowing before writing a loop
' that touches both.
' ==========================================================================
' MIT License - Copyright (c) 2026, GCUser99 (https://github.com/GCUser99)
' ==========================================================================
[Hidden(False)]
[Description("An FSO-style File object. Obtain via FileSystem.GetFile or Folder.Files; Not New-able directly.")]
Private Class File
    Option Explicit

    ' Cached stat fields. Refreshed by EnsureCurrent on every public access - see
    ' the header. A write-through cache of the disk, never independent state.
    Private mPath As String
    Private mAttrs As Long
    Private mSize As LongLong
    Private mCreated As Date
    Private mModified As Date
    Private mAccessed As Date

    ' Friend, not Public: only FileSystemTools.GetFile and Folder's enumerator may
    ' construct one. The caller injects stat data it already holds, so building a
    ' Files collection costs one directory walk rather than N stats.
    Friend Sub Init(ByVal path As String, ByVal attrs As Long, ByVal size As LongLong, ByVal created As Date, ByVal modified As Date, ByVal accessed As Date)
        mPath = path
        mAttrs = attrs
        mSize = size
        mCreated = created
        mModified = modified
        mAccessed = accessed
    End Sub

    '======================================================================
    ' Identity / location
    '======================================================================

    [Description("Re-reads attributes, size and dates from disk. Raises error 53 if the file no longer exists.")]
    Public Sub Refresh()
        EnsureCurrent
    End Sub

    ' The Get re-stats (so it reports true on-disk casing); the Let does NOT call
    ' EnsureCurrent - Rename resolves and validates the path itself and raises 53 if
    ' the file is gone. Shares its implementation with the Rename method below.
    [Description("Gets/Sets the name of the file. If setting, The new name must be a bare name, or a path that resolves to the same folder as the source — it cannot move the item to a different folder. Wildcards are not permitted, and the destination must not already exist.")]
    Public Property Get Name() As String
        EnsureCurrent
        Name = FileSystemTools.GetFileName(mPath)
    End Property
    Public Property Let Name(ByVal newName As String)
        ' No EnsureCurrent: FileSystemTools.Rename resolves and re-stats mPath itself,
        ' raising 53 if it's gone.
        mPath = FileSystemTools.Rename(mPath, newName)
    End Property

    ' DefaultMember: a bare File reference in a string context yields its path.
    [DefaultMember]
    [Description("Returns the path for a specified file.")]
    Public Property Get Path() As String
        EnsureCurrent
        Path = mPath
    End Property
    
    ' No root guard, unlike Folder.ParentFolder: a file always has a parent, so
    ' GetParentFolderName can never come back empty here.
    [Description("Returns the folder object for the parent of the specified file.")]
    Public Property Get ParentFolder() As Folder
        EnsureCurrent
        Set ParentFolder = FileSystemTools.GetFolder(FileSystemTools.GetParentFolderName(mPath))
    End Property

    [Description("Returns the drive letter of the drive where a specified file or folder resides.")]
    Public Property Get Drive() As Drive
        EnsureCurrent
        Set Drive = FileSystemTools.GetDrive(FileSystemTools.GetDriveName(mPath))
    End Property

    '======================================================================
    ' Stat fields (cheap - served from the cache EnsureCurrent just refreshed)
    '======================================================================

    [Description("Returns the date and time when a specified file was created.")]
    Public Property Get DateCreated() As Date
        EnsureCurrent
        DateCreated = mCreated
    End Property

    [Description("Returns the date and time when a specified file was last modified.")]
    Public Property Get DateLastModified() As Date
        EnsureCurrent
        DateLastModified = mModified
    End Property

    [Description("Returns the date and time when a specified file was last accessed.")]
    Public Property Get DateLastAccessed() As Date
        EnsureCurrent
        DateLastAccessed = mAccessed
    End Property

    ' A true stat field, unlike Folder.Size (which walks a subtree). Exact past 4GB:
    ' the value comes from Shared.SizeFromHL, which reassembles both DWORDs.
    [Description("Returns the size, in bytes, of a specified file.")]
    Public Property Get Size() As LongLong
        EnsureCurrent
        Size = mSize
    End Property

    [Description("Returns a string containing the extension name.")]
    Public Property Get ExtensionName() As String
        EnsureCurrent
        ExtensionName = FileSystemTools.GetExtensionName(mPath)
    End Property

    '======================================================================
    ' Content-derived properties - EXPENSIVE
    '
    ' None of these is a cached field: each one goes back to the disk (or the
    ' shell) on every single read. See the header.
    '======================================================================

    ' Loads and parses the PE version resource each time. Returns "" for a file
    ' that carries none - which is most files.
    [Description("Returns the file's version. By default (fvFixed) returns the binary version as major.minor.build.revision, fvFileString returns the authored StringFileInfo FileVersion string and fvProductString returns the ProductVersion string; both fall back to the fixed version when the file has no string block. Returns an empty string when the file carries no version resource.")]
    Public Property Get Version(Optional ByVal source As FileVersionSource = fvFixed) As String
        EnsureCurrent
        Version = FileSystemTools.GetFileVersion(mPath, source)
    End Property

    ' THE MOST EXPENSIVE MEMBER ON THE CLASS. Three disk touches per read:
    '   1. EnsureCurrent            - a stat
    '   2. Encoding                 - another stat + a 64KB head sample
    '   3. GetFileLineEnding        - decodes the ENTIRE FILE
    ' The whole-file read is unavoidable: "mixed" can only be proven by looking at
    ' every terminator, so this cannot be sampled. Consequences: it inherits
    ' TextFileToString's limits - it raises 5 on a binary file, and raises 7 on a
    ' file too large to hold in one String (>2GB). Assign it once; never poll it.
    [Description("The file's line-ending style on disk (nlWindows / nlUnix / nlMacintosh / nlMixed / nlUnknown). Reads file content on each access.")]
    Public Property Get LineEnding() As NewlineType
        EnsureCurrent
        LineEnding = FileSystemTools.GetFileLineEnding(mPath, Encoding)   ' Encoding = a 2nd stat + 64KB read
    End Property

    ' Reads a head sample every call (64KB by default) - not cached. Signed: a
    ' negative result means the file carries a BOM. Raise sampleBytes if a file with
    ' a long ASCII preamble misdetects.
    [Description("Detects a file's text encoding from a head sample: BOM sniff, then UTF-16/32 and UTF-8 heuristics. Returns a signed TextEncoding (negative = BOM present); encUnknown for an empty/unreadable file.")]
    Public Property Get Encoding(Optional ByVal sampleBytes As Long = 65536&) As TextEncoding
        EnsureCurrent
        Encoding = FileSystemTools.GetFileEncoding(mPath, sampleBytes)
    End Property

    ' A shell round-trip (SHGetFileInfoW), and the string is LOCALISED - it is
    ' whatever Explorer would show. Contrast Folder.Type, which is hard-coded.
    [Description("The shell type description of the file (e.g. ""Text Document""), as shown in Explorer.")]
    Public Property Get Type() As String
        EnsureCurrent
        Type = FileSystemTools.GetFileType(mPath)
    End Property

    [Description("Returns the short path of a specified file.")]
    Public Property Get ShortPath() As String
        EnsureCurrent
        ShortPath = Shared.GetShortPath(mPath)
    End Property

    [Description("Returns the short name of a specified file.")]
    Public Property Get ShortName() As String
        EnsureCurrent
        ShortName = FileSystemTools.GetFileName(Shared.GetShortPath(mPath))
    End Property

    '======================================================================
    ' Attributes
    '
    ' Three ways in, deliberately:
    '   Attributes   - REPLACES the whole settable set. Reading it back and writing
    '                  it unchanged IS a no-op, but writing a bare value CLEARS
    '                  everything you did not include. This is the FSO-parity door.
    '   SetAttribute - flips ONE bit, leaving the rest alone. What callers usually
    '                  actually want.
    '   HasAttribute - tests one bit, including bits that cannot be written.
    '
    ' The Get returns the file system's FULL attribute set, including bits Windows
    ' manages and will not let you write (Directory, ReparsePoint, Compressed,
    ' Encrypted...). The Let applies only the settable subset - SanitizeAttrs masks
    ' the rest away. That mask changes nothing on disk, because SetFileAttributesW
    ' ignores the unsettable bits anyway; the round trip is safe.
    '
    ' Watch for Normal DOMINANCE: passing Normal (alone or OR'd with anything else)
    ' clears every settable attribute. It means "no attributes", not "an attribute".
    '======================================================================

    [Description("Gets or sets the file's attributes on disk (ReadOnly/Hidden/System/Archive); combine with Or. NoChange is ignored — use Normal to clear all attributes.")]
    Public Property Get Attributes() As FileAttribute
        EnsureCurrent
        Attributes = mAttrs
    End Property
    Public Property Let Attributes(ByVal value As FileAttribute)
        If value = NoChange Then Exit Property
        EnsureCurrent                      ' fail-fast with 53 if gone, before attempting the set
        Shared.SetPathAttributes mPath, value
        Refresh                            ' re-stat: mAttrs now mirrors actual disk state
    End Property
    
    ' Read-modify-write against the SETTABLE bits only, so the filesystem-managed
    ' ones are never carried into the value being written.
    [Description("Sets or clears a single attribute, leaving the others untouched. Only settable attributes have any effect (ReadOnly, Hidden, System, Archive, Temporary, NotContentIndexed).")]
    Public Sub SetAttribute(ByVal attr As FileAttribute, ByVal state As Boolean)
        EnsureCurrent
        Dim v As Long
        v = mAttrs And Shared.SETTABLE_ATTRS          ' current settable set
        If state Then v = v Or attr Else v = v And Not attr
        Shared.SetPathAttributes mPath, v             ' re-sanitizes; Normal-dominance applies
        Refresh
    End Sub

    ' NB: this is an ANY test, not an ALL test. Passing a combined mask
    ' (Hidden Or System) returns True if EITHER bit is set. Test one bit at a time
    ' if you mean "and".
    [Description("True if the specified attribute is set.")]
    Public Property Get HasAttribute(ByVal attr As FileAttribute) As Boolean
        EnsureCurrent
        HasAttribute = ((mAttrs And attr) <> 0)
    End Property
    
    '======================================================================
    ' Operations
    '
    ' Note what each leaves behind:
    '   Move / Rename / Name Let -> mPath is updated; the object stays valid.
    '   Copy                     -> this object is unaffected; the COPY is not
    '                               returned (call GetFile on the destination).
    '   Normalize                -> content is rewritten; Refresh re-stats, since
    '                               size/dates/attributes will all have moved.
    '   Delete                   -> the object is now stale. Every subsequent read
    '                               raises 53 via EnsureCurrent. By design.
    '======================================================================

    [Description("Copies the file to the destination (overwrites by default).")]
    Public Sub Copy(ByVal destination As String, Optional ByVal overwrite As Boolean = True)
        EnsureCurrent
        FileSystemTools.CopyFile mPath, destination, overwrite
    End Sub

    [Description("Moves the file, then re-points this object at the new location.")]
    Public Sub Move(ByVal destination As String)
        EnsureCurrent
        mPath = FileSystemTools.MoveFile(mPath, destination)   ' returns the RESOLVED new path
        Refresh
    End Sub

    [Description("Renames the file. The new name must be a bare name, or a path that resolves to the same folder as the source — it cannot move the item to a different folder. Wildcards are not permitted, and the destination must not already exist.")]
    Public Sub Rename(ByVal newName As String)
        ' No EnsureCurrent: FileSystemTools.Rename resolves and re-stats mPath itself,
        ' raising 53 if it's gone.
        mPath = FileSystemTools.Rename(mPath, newName)
    End Sub

    [Description("Deletes the file.")]
    Public Sub Delete(Optional ByVal force As Boolean = False)
        EnsureCurrent
        FileSystemTools.DeleteFile mPath, force
    End Sub

    '======================================================================
    ' Content access
    '======================================================================

    ' create:=False is deliberate - EnsureCurrent has already proven the file
    ' exists, so there is nothing to create.
    ' CAUTION: ioMode:=ForWriting TRUNCATES the file on open. Use ForAppending to
    ' add to it. The default (ForReading) is safe.
    [Description("Opens the file and returns a streaming TextStream.")]
    Public Function OpenAsTextStream(Optional ByVal ioMode As IOMode = ForReading, _
        Optional ByVal encoding As TextEncoding = encAutoDetect, _
        Optional ByVal writeModeLineEnding As NewlineType = nlWindows) As TextStream
        EnsureCurrent
        Set OpenAsTextStream = FileSystemTools.OpenTextFile(mPath, ioMode, False, encoding, writeModeLineEnding)
    End Function

    ' Rewrites the file in place (atomic temp-swap inside WriteStream), so the
    ' Refresh afterwards is mandatory, not cosmetic: size, dates and attributes have
    ' all changed. Returns False when the file was already in target form and
    ' skipIfUnchanged left it alone.
    [Description("Rewrites this file in place: target encoding + newline style (source auto-detected), attributes preserved by default. Returns True if modified.")]
    Public Function Normalize(Optional ByVal toEncoding As TextEncoding = encUtf8, _
        Optional ByVal toLineEnding As NewlineType = nlWindows, _
        Optional ByVal fromEncoding As TextEncoding = encAutoDetect, _
        Optional ByVal toAttributes As FileAttribute = NoChange, _
        Optional ByVal skipIfUnchanged As Boolean = True) As Boolean
        EnsureCurrent
        Normalize = FileSystemTools.NormalizeTextFile(mPath, toEncoding, toLineEnding, fromEncoding, toAttributes, skipIfUnchanged)
        Refresh
    End Function

    ' Whole-file read: the entire content lands in one String. Raises 5 on a binary
    ' file and 7 on anything too large to hold (>2GB). For a large file use
    ' OpenAsTextStream and read it line by line.
    [Description("Reads the entire text file to a string. With encAutoDetect (default) the encoding is detected; otherwise the given encoding is used (a byte-order mark still overrides it). A leading BOM is stripped either way.")]
    Public Function ToString(Optional ByVal encoding As TextEncoding = encAutoDetect, Optional ByVal lineEnding As NewlineType = nlNoChange) As String
        EnsureCurrent
        ToString = FileSystemTools.TextFileToString(mPath, encoding, lineEnding)
    End Function

    ' The function's own return value is handed to ReadStream's ByRef array
    ' parameter and filled in place - hence no explicit assignment.
    ' Returns an UNALLOCATED array for an empty file (or maxBytesToRead = 0), so
    ' callers must guard with IsArrayInitialized before indexing.
    ' A whole-file read (maxBytesToRead = -1) is capped by the Byte() limit and
    ' raises 7 past 2GB; a head sample of any size is always fine.
    [Description("Reads the file specified into a byte array.")]
    Public Function ToStream(Optional ByVal maxBytesToRead As Long = -1) As Byte()
        EnsureCurrent
        FileSystemTools.ReadStream mPath, ToStream, maxBytesToRead
    End Function
    
    ' Re-stat, refresh cached fields, adopt true on-disk leaf casing; raise 53 if gone.
    ' Every public read routes through here so a deleted file fails uniformly and
    ' the reported name always matches the disk (matching live FSO on both axes).
    '
    ' This is the class's single point of truth - see the header. The two exceptions
    ' (Rename and the Name Let) skip it only because FileSystemTools.Rename does the
    ' same validation itself and would raise 53 anyway.
    ' Note the error number differs from Folder's: 53 (file not found) vs 76 (path
    ' not found), matching FSO.
    Private Sub EnsureCurrent()
        Dim leaf As String
        If Not Shared.StatPath(mPath, mAttrs, mSize, mCreated, mModified, mAccessed, leaf) Then
            Err.Raise 53, "File", "File not found: " & mPath
        End If
        ' leaf can only differ from mPath's leaf by CASE — any real name change would
        ' have made mPath fail to resolve above. A file is never a root, so leaf is set.
        If Len(leaf) > 0 Then
            mPath = FileSystemTools.BuildPath(FileSystemTools.GetParentFolderName(mPath), leaf)
        End If
    End Sub

End Class


' ==========================================================================
' Files
'
' A read-only wrapper around a Collection of File objects.
'
' Thin by design: it exists so that callers get an FSO-shaped Count / Item /
' For Each surface instead of a raw VBA Collection, and so the collection cannot
' be added to or removed from after construction.
'
' Built by Folder.Files, which enumerates one directory level and keys each entry
' by FILE NAME including extension ("readme.txt"), so both Files("readme.txt") and
' Files(1) work. Never New'd directly - Init is Friend.
'
' SNAPSHOT. The membership is fixed at the moment Folder.Files was called: files
' created or deleted afterwards are not reflected. Read the property again to
' re-enumerate. The File objects inside are individually live (each re-stats itself
' on every property read), so a file deleted after enumeration will not vanish from
' the collection - it will raise 53 when you touch it.
'
' Includes hidden and system files, matching FSO. Note this differs from
' FileSystemTools.GetFilePaths, whose defaults EXCLUDE both.
' ==========================================================================
' MIT License - Copyright (c) 2026, GCUser99 (https://github.com/GCUser99)
' ==========================================================================

[Hidden(False)]
[Description("A read-only collection of File objects, enumerable with For Each.")]
Private Class Files
    Option Explicit
    
    Private mItems As Collection                       ' File objects, keyed by name

    Friend Sub Init(ByVal items As Collection)
        Set mItems = items
    End Sub
    
     [Description("Returns the number of File objects available.")]
    Public Property Get Count() As Long
        Count = mItems.Count
    End Property

    [DefaultMember]
    [Description("Returns a specific File object by name or index.")]
    Public Property Get Item(ByVal nameOrIndex As Variant) As File
        Set Item = mItems(nameOrIndex)
    End Property

    [Enumerator]
    [Hidden(True)]
    Public Function NewEnum() As IUnknown
        Set NewEnum = mItems.[_NewEnum]
    End Function
End Class


' ==========================================================================
' Folder
'
' An FSO-style Folder object. Obtained from FileSystemTools.GetFolder,
' Folder.SubFolders or Folder.ParentFolder - never New'd directly.
'
' --- The one thing to understand: this object is LIVE, not a snapshot -----
' Every public member begins with EnsureCurrent(), which re-stats the path and
' refreshes the cached fields. Two consequences that explain almost everything
' about this class:
'
'   * ACCURACY. mAttrs/mCreated/mModified/mAccessed never go stale, and mPath
'     always carries the true on-disk casing. A Folder whose directory is deleted
'     out from under it raises 76 on the NEXT property read, rather than quietly
'     reporting fossilised values.
'
'   * COST. Every property read is a FindFirstFileW round-trip. Reading five
'     properties in a row stats the folder five times. In a tight loop, hoist the
'     value out rather than re-reading the property.
'
' The Init'd fields are therefore a cache, not the source of truth - EnsureCurrent
' is. The only reason they exist at all is so a stat's worth of data can be
' handed over in one call by the enumerators, which already have it in hand from
' WIN32_FIND_DATAW and would otherwise re-stat every child they construct.
'
' --- Snapshot vs live, at the collection level ---------------------------
' Files and SubFolders return a COLLECTION BUILT AT THE MOMENT OF THE CALL. The
' collection does not track the directory afterwards. The Folder objects inside it
' are individually live (each re-stats itself), but the membership is frozen. Call
' the property again to see additions or removals.
' ==========================================================================
' MIT License - Copyright (c) 2026, GCUser99 (https://github.com/GCUser99)
' ==========================================================================
[Hidden(False)]
[Description("An FSO-style Folder object. Obtain via FileSystem.GetFolder or Folder.SubFolders; Not New-able directly.")]
Private Class Folder
    Option Explicit

    ' Cached stat fields. Refreshed by EnsureCurrent on every public access - see
    ' the header. Treat these as a write-through cache of the disk, never as state.
    Private mPath As String
    Private mAttrs As Long
    Private mCreated As Date
    Private mModified As Date
    Private mAccessed As Date

    ' Friend, not Public: only FileSystemTools.GetFolder and this class's own
    ' MakeFolderObject may construct one. The caller supplies stat data it already
    ' holds, so building a subfolder list does not re-stat every child.
    Friend Sub Init(ByVal path As String, ByVal attrs As Long, ByVal created As Date, ByVal modified As Date, ByVal accessed As Date)
        mPath = path
        mAttrs = attrs
        mCreated = created
        mModified = modified
        mAccessed = accessed
    End Sub

    '======================================================================
    ' Identity / location
    '======================================================================

    [Description("Re-reads attributes and dates from disk. Raises error 76 if the folder no longer exists.")]
    Public Sub Refresh()
        EnsureCurrent
    End Sub

    ' NOTE the asymmetry: the Get re-stats (so it reports true on-disk casing),
    ' but the Let does NOT call EnsureCurrent - Rename resolves and validates the
    ' path itself, and raises 53 if the folder is gone. The cached fields are left
    ' stale by the rename; the next Get refreshes them.
    [Description("Sets or returns the name of a specified folder.")]
    Public Property Get Name() As String
        EnsureCurrent
        Name = FileSystemTools.GetFileName(mPath)
    End Property
    Public Property Let Name(ByVal newName As String)
        mPath = FileSystemTools.Rename(mPath, newName)
    End Property

    ' DefaultMember: a bare Folder reference in a string context yields its path.
    [DefaultMember]
    [Description("Returns the path for a specified folder.")]
    Public Property Get Path() As String
        EnsureCurrent
        Path = mPath
    End Property

    ' Nothing (not an error) at a root - GetParentFolderName returns "" for both
    ' "C:\" and a UNC root, and that empty string is the signal.
    [Description("The parent Folder, or Nothing for a root folder.")]
    Public Property Get ParentFolder() As Folder
        EnsureCurrent
        Dim p As String
        p = FileSystemTools.GetParentFolderName(mPath)
        If Len(p) = 0 Then Exit Property              ' root has no parent
        Set ParentFolder = FileSystemTools.GetFolder(p)
    End Property

    [Description("Returns the drive letter of the drive where the specified folder resides.")]
    Public Property Get Drive() As Drive
        EnsureCurrent
        Set Drive = FileSystemTools.GetDrive(FileSystemTools.GetDriveName(mPath))
    End Property

    ' Compares this path against its own drive spec. Both forms are accepted
    ' because GetDriveName returns no trailing separator ("C:", "\\server\share")
    ' while an absolute root path carries one ("C:\").
    ' The Len > 3 guard on the trim is what stops "C:\" being shortened to "C:";
    ' a UNC root is longer than 3, so its trailing "\" is trimmed and it matches
    ' the first comparison instead.
    [Description("True if this folder is the root of its drive.")]
    Public Property Get IsRootFolder() As Boolean
        EnsureCurrent
        Dim root As String, me_ As String
        root = FileSystemTools.GetDriveName(mPath)               ' "C:" or "\\server\share"
        me_ = mPath
        Do While Len(me_) > 3 And Right$(me_, 1) = "\"
            me_ = Left$(me_, Len(me_) - 1)
        Loop
        IsRootFolder = (StrComp(me_, root, vbTextCompare) = 0) Or _
                       (StrComp(me_, root & "\", vbTextCompare) = 0)
    End Property

    '======================================================================
    ' Stat fields
    '
    ' All four are served from the cache that EnsureCurrent has just refreshed -
    ' i.e. they are one stat old at most, which is to say current.
    '======================================================================

    [Description("Returns the date and time when a specified folder was created.")]
    Public Property Get DateCreated() As Date
        EnsureCurrent
        DateCreated = mCreated
    End Property

    [Description("Returns the date and time when a specified folder was last modified.")]
    Public Property Get DateLastModified() As Date
        EnsureCurrent
        DateLastModified = mModified
    End Property

    [Description("Returns the date and time when a specified folder was last accessed.")]
    Public Property Get DateLastAccessed() As Date
        EnsureCurrent
        DateLastAccessed = mAccessed
    End Property

    ' THE EXPENSIVE ONE: walks the entire subtree on EVERY read, not a cached
    ' field. On a large tree that is seconds. Assign it once; never re-read it in
    ' a loop.
    '
    ' DELIBERATE DEVIATION FROM FSO. Scripting.FileSystemObject FOLLOWS directory
    ' reparse points; we skip them. Measured against the FSO oracle: a folder
    ' holding 1500 bytes plus a junction to one of its own subfolders reports
    ' 1500 here and 2500 under FSO - it counted the target twice.
    '
    ' We deviate because FSO's behaviour is unsafe, not merely different:
    '   * a junction pointing at an ancestor makes FSO recurse until it dies;
    '   * a size that changes with the number of junctions pointing into the tree
    '     is not measuring anything;
    '   * Explorer and dir skip reparse points too - FSO is the outlier (it
    '     predates them: FSO shipped in 1996, NTFS junctions in Windows 2000).
    '
    ' Consequence to be aware of: this reports what physically LIVES here, not what
    ' is REACHABLE from here. Two sibling folders' sizes therefore need not sum to
    ' their parent's if a junction spans them.
    [Description("Total size in bytes of all files in this folder and its subfolders. Directory reparse points (junctions, symlinks) are NOT followed - this deviates from Scripting.FileSystemObject, which follows them and can therefore double-count or recurse infinitely. Computed on demand: it walks the whole subtree on every read.")]
    Public Property Get Size() As LongLong
        EnsureCurrent
        Size = FolderSize(mPath)
    End Property
    
    ' Get returns the file system's full attribute set, including bits Windows
    ' manages and will not let you write (Directory, ReparsePoint, Compressed,
    ' Encrypted...). Let applies only the settable subset - Shared.SanitizeAttrs
    ' masks the rest away.
    '
    ' The round trip IS a no-op, despite that mask: SetFileAttributesW ignores the
    ' unsettable bits anyway, so dropping them changes nothing on disk. Reading
    ' Attributes, flipping one bit and writing it back is therefore safe.
    '
    ' Two behaviours worth knowing before writing:
    '   * Normal DOMINATES. Passing Normal (alone or OR'd with anything) clears
    '     every settable attribute - it means "no attributes", not "an attribute".
    '   * The write REPLACES the settable set; it does not merge. To flip one bit,
    '     read-modify-write, or use SetAttribute below.
    [Description("Sets or returns the attributes of a specified folder.")]
    Public Property Get Attributes() As FileAttribute
        EnsureCurrent
        Attributes = mAttrs
    End Property
    Public Property Let Attributes(ByVal value As FileAttribute)
        If value = NoChange Then Exit Property
        EnsureCurrent                      ' fail-fast with 76 if gone, before attempting the set
        Shared.SetPathAttributes mPath, value
        Refresh                            ' re-stat: mAttrs mirrors disk
    End Property
    
    [Description("Sets or clears a single attribute, leaving the others untouched. Only settable attributes have any effect (ReadOnly, Hidden, System, Archive, Temporary, NotContentIndexed).")]
    Public Sub SetAttribute(ByVal attr As FileAttribute, ByVal state As Boolean)
        EnsureCurrent
        Dim v As Long
        v = mAttrs And Shared.SETTABLE_ATTRS          ' current settable set
        If state Then v = v Or attr Else v = v And Not attr
        Shared.SetPathAttributes mPath, v             ' re-sanitizes; Normal-dominance applies
        Refresh
    End Sub

    [Description("True if the specified attribute is set.")]
    Public Property Get HasAttribute(ByVal attr As FileAttribute) As Boolean
        EnsureCurrent
        HasAttribute = ((mAttrs And attr) <> 0)
    End Property
    
    [Description("Returns the short path of a specified folder.")]
    Public Property Get ShortPath() As String
        EnsureCurrent
        ShortPath = Shared.GetShortPath(mPath)
    End Property

    [Description("Returns the short name of a specified folder.")]
    Public Property Get ShortName() As String
        EnsureCurrent
        ShortName = FileSystemTools.GetFileName(Shared.GetShortPath(mPath))
    End Property

    [Description("Returns the type of a specified folder.")]
    Public Property Get Type() As String
        EnsureCurrent
        Type = FileSystemTools.GetFileType(mPath)
    End Property

    '======================================================================
    ' Children
    '
    ' Both enumerate with includeHidden:=True, includeSystem:=True - FSO shows
    ' everything, and so do we. That is a deliberate deviation from
    ' FileSystemTools.GetFilePaths, whose defaults EXCLUDE both.
    ' Both build the whole collection eagerly. A directory with a very large number
    ' of entries costs one object per entry, up front.
    '======================================================================

    [Description("A Files collection of every file in this folder (including hidden/system, FSO-style).")]
    Public Property Get Files() As Files
        EnsureCurrent
        Dim out As New Files
        out.Init EnumChildren(mPath, wantFolders:=False, includeHidden:=True, includeSystem:=True)     ' wantFolders:=False
        Set Files = out
    End Property

    [Description("A Folders collection of every immediate subfolder.")]
    Public Property Get SubFolders() As Folders
        EnsureCurrent
        Dim out As New Folders
        out.Init EnumChildren(mPath, wantFolders:=True, includeHidden:=True, includeSystem:=True)      ' wantFolders:=True
        Set SubFolders = out
    End Property
    
    '======================================================================
    ' Operations
    '
    ' Note which ones re-point this object and which leave it dangling:
    '   Move / Rename / Name Let -> mPath is updated; the object stays valid.
    '   Copy                     -> this object is unaffected (the COPY is not
    '                               returned; call GetFolder on the destination).
    '   Delete                   -> the object is now stale. Every subsequent
    '                               property read raises 76 via EnsureCurrent.
    '                               That is by design, not an oversight.
    '======================================================================

    [Description("Copies this folder (and contents) to the destination.")]
    Public Sub Copy(ByVal destination As String, Optional ByVal overwrite As Boolean = True)
        EnsureCurrent
        FileSystemTools.CopyFolder mPath, destination, overwrite
    End Sub

    [Description("Moves this folder, then re-points this object at the new location.")]
    Public Sub Move(ByVal destination As String)
        EnsureCurrent
        mPath = FileSystemTools.MoveFolder(mPath, destination)   ' returns the RESOLVED new path
        Refresh
    End Sub

    ' No EnsureCurrent: FileSystemTools.Rename resolves the path and raises 53 itself
    ' if the folder is gone, so the pre-check would be redundant. Same reasoning as
    ' the Name Let, which this shares an implementation with.
    [Description("Renames the folder. The new name must be a bare name, or a path that resolves to the same folder as the source — it cannot move the item to a different folder. Wildcards are not permitted, and the destination must not already exist.")]
    Public Sub Rename(ByVal newName As String)
        mPath = FileSystemTools.Rename(mPath, newName)
    End Sub

    [Description("Deletes this folder and its contents.")]
    Public Sub Delete(Optional ByVal force As Boolean = False)
        EnsureCurrent
        FileSystemTools.DeleteFolder mPath, force
    End Sub

    [Description("Creates (or overwrites) a text file in this folder and returns a TextStream open for writing.")]
    Public Function CreateTextFile(ByVal fileName As String, _
        Optional ByVal overwrite As Boolean = True, _
        Optional ByVal encoding As TextEncoding = encUtf8, _
        Optional ByVal lineEnding As NewlineType = nlWindows) As TextStream
        EnsureCurrent
        Set CreateTextFile = FileSystemTools.CreateTextFile(FileSystemTools.BuildPath(mPath, fileName), overwrite, encoding, lineEnding)
    End Function

    '======================================================================
    ' Enumeration + size helpers
    '
    
    ' Single directory walk for both Files and SubFolders. wantFolders selects
    ' which entry type is kept and, with it, which kind of object is built - the
    ' only two things that ever differed between the old EnumFileObjects and
    ' EnumFolderObjects, which is why they are now one function.
    '
    ' Returns a name-keyed Collection of File or Folder objects (immediate children
    ' only - no recursion). An unreadable or empty directory yields an empty
    ' collection, not an error.
    '
    ' Error discipline: On Error GoTo CleanUp, close the handle, THEN re-raise. Any
    ' new exit path must go through CleanUp or the find handle leaks.
    '
    ' The efficiency that matters: WIN32_FIND_DATAW already carries the attributes,
    ' size and all three timestamps, so N children cost ONE directory walk rather
    ' than N stats.
    Private Function EnumChildren(ByVal folderPath As String, ByVal wantFolders As Boolean, _
                                  ByVal includeHidden As Boolean, ByVal includeSystem As Boolean) As Collection
        Dim out As New Collection
        Dim ffd As WIN32_FIND_DATAW
        Dim hFind As LongPtr
        Dim nm As String, full As String
        Dim isDir As Boolean

        Dim e As Long
        hFind = FindFirstFileW(StrPtr(Shared.EnsureTrailingBackslash(folderPath) & "*"), ffd)
        e = Err.LastDllError
        If hFind = INVALID_HANDLE_VALUE Then
            Shared.IsEmptySearch e, IIf(wantFolders, "Folder.SubFolders", "Folder.Files"), folderPath
            Set EnumChildren = out
            Exit Function
        End If

        On Error GoTo CleanUp
        Do
            isDir = ((ffd.dwFileAttributes And FILE_ATTRIBUTE_DIRECTORY) <> 0)
            If isDir = wantFolders Then               ' keep only the requested type
                nm = Shared.FindDataFileName(ffd)
                If nm <> "." And nm <> ".." Then      ' skip the self/parent entries
                    If Shared.IncludeByAttr(ffd.dwFileAttributes, includeHidden, includeSystem) Then
                        full = Shared.EnsureTrailingBackslash(folderPath) & nm
                        ' Keyed by name so Files("readme.txt") / SubFolders("bin")
                        ' work. AddKeyed falls back to an unkeyed add on a clash
                        ' rather than aborting the walk.
                        If wantFolders Then
                            Shared.AddKeyed out, MakeFolderObject(full, ffd.dwFileAttributes, _
                                Shared.FileTimeToDate(ffd.ftCreationTime), _
                                Shared.FileTimeToDate(ffd.ftLastWriteTime), _
                                Shared.FileTimeToDate(ffd.ftLastAccessTime)), nm
                        Else
                            Shared.AddKeyed out, MakeFileObject(full, ffd.dwFileAttributes, _
                                Shared.SizeFromHL(ffd.nFileSizeHigh, ffd.nFileSizeLow), _
                                Shared.FileTimeToDate(ffd.ftCreationTime), _
                                Shared.FileTimeToDate(ffd.ftLastWriteTime), _
                                Shared.FileTimeToDate(ffd.ftLastAccessTime)), nm
                        End If
                    End If
                End If
            End If
        Loop While FindNextFileW(hFind, ffd) <> 0

    CleanUp:
        If hFind <> 0 And hFind <> INVALID_HANDLE_VALUE Then FindClose hFind
        Set EnumChildren = out                        ' assign BEFORE any re-raise
        If Err.Number <> 0 Then Err.Raise Err.Number, Err.Source, Err.Description
    End Function

    ' Thin factories. They exist so the enumerators can inject stat data they
    ' already hold, since Init is Friend and cannot be reached from outside.
    Private Function MakeFileObject(ByVal path As String, ByVal attrs As Long, ByVal size As LongLong, ByVal created As Date, ByVal modified As Date, ByVal accessed As Date) As File
        Dim f As File
        Set f = New File
        f.Init path, attrs, size, created, modified, accessed
        Set MakeFileObject = f
    End Function

    Private Function MakeFolderObject(ByVal path As String, ByVal attrs As Long, ByVal created As Date, ByVal modified As Date, ByVal accessed As Date) As Folder
        Dim d As Folder
        Set d = New Folder
        d.Init path, attrs, created, modified, accessed
        Set MakeFolderObject = d
    End Function

    ' Recursive subtree total, in bytes.
    '
    ' REPARSE POINTS ARE SKIPPED for directories, and that is load-bearing: a
    ' junction or symlink pointing at an ancestor would otherwise recurse forever.
    ' It also means the total is the size of what physically lives here, not of
    ' everything reachable from here - two folders can therefore report sizes that
    ' do not sum to their parent's.
    '
    ' Note the asymmetry: a reparse-point FILE (a cloud placeholder, say) still has
    ' its LOGICAL size counted, even though its bytes may not be on this disk.
    ' That matches Explorer, and there is no cheap way to do better from FIND_DATA.
    '
    ' No depth limit and no cycle detection beyond the reparse check - a genuinely
    ' pathological tree could exhaust the stack.
    Private Function FolderSize(ByVal folderPath As String) As LongLong
        Dim total As LongLong
        Dim ffd As WIN32_FIND_DATAW
        Dim hFind As LongPtr
        Dim nm As String, full As String

        Dim e As Long
        hFind = FindFirstFileW(StrPtr(Shared.EnsureTrailingBackslash(folderPath) & "*"), ffd)
        e = Err.LastDllError
        If hFind = INVALID_HANDLE_VALUE Then
            Shared.IsEmptySearch e, "Folder.Size", folderPath   ' raises 70 on a denied subtree
            Exit Function                                       ' truly empty -> contributes 0
        End If

        On Error GoTo CleanUp
        Do
            nm = Shared.FindDataFileName(ffd)
            If nm <> "." And nm <> ".." Then
                full = Shared.EnsureTrailingBackslash(folderPath) & nm
                If (ffd.dwFileAttributes And FILE_ATTRIBUTE_DIRECTORY) <> 0 Then
                    If (ffd.dwFileAttributes And FILE_ATTRIBUTE_REPARSE_POINT) = 0 Then
                        total = total + FolderSize(full)        ' recurse into real dirs only
                    End If
                Else
                    ' Unlike Files/SubFolders, hidden and system files are counted
                    ' unconditionally here - no IncludeByAttr filter. A total that
                    ' omitted them would not be a size.
                    total = total + Shared.SizeFromHL(ffd.nFileSizeHigh, ffd.nFileSizeLow)
                End If
            End If
        Loop While FindNextFileW(hFind, ffd) <> 0

    CleanUp:
        If hFind <> 0 And hFind <> INVALID_HANDLE_VALUE Then FindClose hFind
        FolderSize = total                            ' assign BEFORE any re-raise
        If Err.Number <> 0 Then Err.Raise Err.Number, Err.Source, Err.Description
    End Function
    
    ' Re-stat, refresh cached fields, adopt true on-disk leaf casing; raise 76 if gone.
    ' Root-safe: StatPath returns leaf="" for a drive root (fallback path), so the
    ' Len(leaf) guard leaves mPath (e.g. "C:\") untouched.
    '
    ' This is the class's single point of truth - see the header. It is called by
    ' EVERY public member (bar Rename and the Name Let, which validate for
    ' themselves), which is what makes a Folder object live rather than a snapshot,
    ' and what makes a deleted folder raise 76 on next use rather than lie.
    ' The size out-param is discarded: a folder's size is not a stat field, it is a
    ' subtree walk (see FolderSize).
    Private Sub EnsureCurrent()
        Dim ignoreSize As LongLong
        Dim leaf As String
        If Not Shared.StatPath(mPath, mAttrs, ignoreSize, mCreated, mModified, mAccessed, leaf) Then
            Err.Raise 76, "Folder", "Path not found: " & mPath
        End If
        If Len(leaf) > 0 Then
            mPath = FileSystemTools.BuildPath(FileSystemTools.GetParentFolderName(mPath), leaf)
        End If
    End Sub

End Class


' ==========================================================================
' Folders
'
' A read-only wrapper around a Collection of Folder objects.
'
' Thin by design: it exists so that callers get an FSO-shaped Count / Item /
' For Each surface instead of a raw VBA Collection, and so the collection cannot
' be added to or removed from after construction.
'
' Built by Folder.SubFolders, which enumerates IMMEDIATE children only (no
' recursion) and keys each entry by FOLDER NAME ("bin"), so both SubFolders("bin")
' and SubFolders(1) work. Never New'd directly - Init is Friend.
'
' SNAPSHOT. The membership is fixed at the moment Folder.SubFolders was called.
' Read the property again to re-enumerate. The Folder objects inside are
' individually live (each re-stats itself on every property read), so a folder
' deleted after enumeration will not vanish from the collection - it will raise 76
' when you touch it.
'
' Includes hidden and system folders, matching FSO.
'
' A deep walk is the caller's job: recurse through SubFolders yourself.
' ==========================================================================
' MIT License - Copyright (c) 2026, GCUser99 (https://github.com/GCUser99)
' ==========================================================================
[Hidden(False)]
[Description("A read-only collection of Folder objects, enumerable with For Each.")]
Private Class Folders
    Option Explicit
    
    Private mItems As Collection

    Friend Sub Init(ByVal items As Collection)
        Set mItems = items
    End Sub
    
    [Description("Returns the number of Folder objects available.")]
    Public Property Get Count() As Long
        Count = mItems.Count
    End Property

    [DefaultMember]
    [Description("Returns a specific Folder object by name or index.")]
    Public Property Get Item(ByVal nameOrIndex As Variant) As Folder
        Set Item = mItems(nameOrIndex)
    End Property

    [Enumerator]
    [Hidden(True)]
    Public Function NewEnum() As IUnknown
        Set NewEnum = mItems.[_NewEnum]
    End Function
End Class


' ==========================================================================
' Drive
'
' An FSO-style Drive object. Obtained from FileSystemTools.GetDrive,
' FileSystemTools.GetDrives, File.Drive or Folder.Drive - never New'd directly.
'
' --- A different object model from File / Folder -------------------------
' File and Folder cache a stat and refresh it through EnsureCurrent. Drive has
' NOTHING to cache: its only state is mRoot, and every property queries Windows
' live, on every read. That is deliberate - free space, readiness and media
' presence change under you, so a cached snapshot would be worse than useless.
'
' Two consequences:
'   * Always fresh. No Refresh method exists because none is needed.
'   * Every property read is an API round-trip. QueryVolumeInfo unified the CODE
'     behind VolumeName / FileSystem / SerialNumber, but not the CALLS: reading all
'     three still hits GetVolumeInformationW three times. Same for the three size
'     properties and QueryDiskSpace.
'
' --- Not-ready drives RAISE ----------------------------------------------
' The size, label and serial properties raise error 71 ("Disk not ready") when the
' drive cannot be queried - an empty optical bay, a disconnected share, a card
' reader with no card. Other failures (permissions, bad net path) map through
' Shared.RaiseFromLastError as usual.
'
' Members that NEVER raise, and are safe to call on any Drive object:
'   IsReady     - THE GATE. Call it first if a not-ready drive is a possibility
'                 rather than an error.
'   DriveType   - the TYPE is known even with no media (an empty bay still says
'                 CDRom).
'   ShareName   - pure string work, or a network query whose failure IS the answer.
'   DriveLetter, Path - they only inspect mRoot.
'
' RootFolder is the odd one out: it raises 76, not 71, because the failure comes
' from GetFolder rather than from this class's own mapper.
'
' This raise-rather-than-return-zero behaviour is FSO parity, and it is
' deliberate.
'
' --- Two kinds of root ---------------------------------------------------
' mRoot is either "C:" (a lettered drive) or "\\server\share" (a UNC share), never
' with a trailing separator - GetDrive normalizes both forms. RootPath() adds the
' backslash the Win32 calls demand.
'
' DriveLetter and ShareName are NOT complementary, despite appearances:
'   local  "C:"              -> DriveLetter "C",  ShareName ""
'   mapped "Z:"              -> DriveLetter "Z",  ShareName "\\server\share"
'   UNC    "\\server\share"  -> DriveLetter "",   ShareName "\\server\share"
' A mapped drive has BOTH. Only a LOCAL lettered drive has an empty ShareName.
' ==========================================================================
' MIT License - Copyright (c) 2026, GCUser99 (https://github.com/GCUser99)
' ==========================================================================
[Hidden(False)]
[Description("Provides access to the properties of a particular disk drive or network share")]
Private Class Drive
    Option Explicit

    ' FSO's values, NOT Win32's - the two disagree by one. GetDriveTypeW returns
    ' DRIVE_UNKNOWN=0, NO_ROOT_DIR=1, REMOVABLE=2, FIXED=3, REMOTE=4, CDROM=5,
    ' RAMDISK=6; the Select Case in DriveType translates. Keep these values as they
    ' are - callers written against Scripting.FileSystemObject depend on them.
    Public Enum DriveTypeConst
        UnknownType = 0
        Removable = 1
        Fixed = 2
        Remote = 3
        CDRom = 4
        RamDisk = 5
    End Enum
    
    ' MAX_PATH + 1. Generous: a volume label maxes out at 32 chars and a file-system
    ' name is shorter still, so the buffer can never fill - which is what lets
    ' QueryVolumeInfo assume a NUL terminator is always present.
    Private Const VOL_BUF As Long = 261

    ' The class's ONLY state. Everything else is queried live.
    Private mRoot As String                            ' "C:" or "\\server\share"

    ' Friend: only FileSystemTools.GetDrive/GetDrives and the File/Folder .Drive
    ' properties may construct one.
    '
    ' Validates that the DEVICE exists (FSO parity - fso.GetDrive("D:") raises 68 on
    ' a machine with no D:). It does NOT validate readiness: an empty optical bay has
    ' a letter and constructs fine, and IsReady is the live question.
    Friend Sub Init(ByVal root As String)
        mRoot = root
        If Not DeviceExists() Then
            Err.Raise 68, "Drive", "Device unavailable: " & mRoot
        End If
    End Sub

    ' Does this device exist at all? (Not "is it ready" - see IsReady.)
    '
    ' Lettered drives: the GetLogicalDrives bitmask, via FileSystemTools.DriveExists.
    ' Authoritative and cheap, and it INCLUDES drives that are present but not ready -
    ' an empty CD bay still owns its letter, which is exactly the distinction we want.
    '
    ' UNC: not validated here. There is no cheap, reliable "does this share exist"
    ' probe that does not also hit the network, and a share that is merely offline
    ' should still yield a usable Drive object. An unreachable share therefore fails
    ' later, at the first live query, where RaiseDriveError maps it to 68 anyway.
    Private Function DeviceExists() As Boolean
        If Left$(mRoot, 2) = "\\" Then
            DeviceExists = True                      ' UNC: shape is all we check
        Else
            DeviceExists = FileSystemTools.DriveExists(mRoot)
        End If
    End Function

    ' The Win32 calls want a trailing backslash on the root.
    ' Not cosmetic: GetVolumeInformationW, GetDiskFreeSpaceExW and GetDriveTypeW all
    ' FAIL on a bare "C:" or "\\server\share".
    '
    ' ONE EXCEPTION: WNetGetConnectionW (in ShareName) demands the opposite - a bare
    ' device name with NO trailing backslash - so it uses mRoot directly and is the
    ' only API call in this class that does not come through here.
    Private Function RootPath() As String
        If Right$(mRoot, 1) = "\" Then RootPath = mRoot Else RootPath = mRoot & "\"
    End Function
    
    ' Win32 codes that mean "there is no such device" in a Drive context.
    Private Const ERROR_FILE_NOT_FOUND As Long = 2
    Private Const ERROR_PATH_NOT_FOUND As Long = 3
    Private Const ERROR_INVALID_DRIVE  As Long = 15
    Private Const ERROR_BAD_NETPATH    As Long = 53
    Private Const ERROR_NOT_READY      As Long = 21

    '======================================================================
    ' Identity
    '
    ' None of these raises. DriveLetter and Path are pure string inspection of
    ' mRoot; ShareName may hit the network, but its failure IS the answer, not an
    ' error. All three work on a drive that is not ready.
    '======================================================================

    ' "" for a UNC-built Drive. NOT the inverse of ShareName: a mapped drive Z: has
    ' BOTH a DriveLetter ("Z") and a ShareName (its UNC). See the header.
    [Description("Returns one uppercase letter that identifies the local drive or a network share.")]
    Public Property Get DriveLetter() As String
        If Mid$(mRoot, 2, 1) = ":" Then DriveLetter = Left$(mRoot, 1)   ' "" for UNC
    End Property
    
    ' DefaultMember: a bare Drive reference in a string context yields its root.
    ' No trailing backslash ("C:", not "C:\") - FSO parity.
    [DefaultMember]
    [Description("Returns an uppercase letter followed by a colon that indicates the path name for a specified drive.")]
    Public Property Get Path() As String
        Path = mRoot
    End Property
    
    ' The UNC behind this drive, or "" if there isn't one.
    '
    ' Three cases, and the middle one is the whole reason this is not a one-liner:
    '   \\server\share  -> the object was BUILT from a UNC; mRoot already is it.
    '   Z: (mapped)     -> mRoot is just "Z:", so the UNC has to be resolved from
    '                      the OS via WNetGetConnectionW. FSO does this; we did not,
    '                      which was the deviation this fixes.
    '   C: (local)      -> no network mapping. WNetGetConnectionW reports
    '                      ERROR_NOT_CONNECTED (2250), which is an ANSWER, not a
    '                      failure - hence "" rather than a raise.
    '
    ' WNetGetConnectionW wants the device name WITHOUT a trailing backslash ("Z:",
    ' not "Z:\") - the opposite of every other API in this class, which is why this
    ' uses mRoot directly rather than RootPath().
    '
    ' Deliberately does NOT raise on a disconnected mapping (1201): the drive letter
    ' still HAS a UNC associated with it, and reporting that name is more useful than
    ' throwing. The API fills the buffer in that case too. Use IsReady to find out
    ' whether the mapping currently works.
    [Description("The UNC path for this drive: the share itself if the object was built from a UNC, the resolved target if it is a mapped network drive, or an empty string for a local drive.")]
    Public Property Get ShareName() As String
        ' Built from a UNC: mRoot IS the share name.
        If Left$(mRoot, 2) = "\\" Then
            ShareName = mRoot
            Exit Property
        End If

        ' Lettered drive: ask the OS whether it is a network mapping.
        Dim buf As String, cch As Long, rc As Long
        cch = 261                                   ' MAX_PATH + 1; grown below if short
        buf = String$(cch, vbNullChar)
        rc = WNetGetConnectionW(StrPtr(mRoot), StrPtr(buf), cch)

        ' Long UNC (deep DFS paths do exist): retry once with the size it asked for.
        ' cch comes back as the REQUIRED length, so this second call cannot be short.
        If rc = ERROR_MORE_DATA Then
            buf = String$(cch, vbNullChar)
            rc = WNetGetConnectionW(StrPtr(mRoot), StrPtr(buf), cch)
        End If

        Select Case rc
            Case 0, ERROR_CONNECTION_UNAVAIL        ' connected, or mapped-but-offline
                ShareName = Left$(buf, InStr(buf, vbNullChar) - 1)
            Case Else                               ' ERROR_NOT_CONNECTED and friends
                ShareName = vbNullString            ' not a mapped drive: "" is the answer
        End Select
    End Property
    
    '======================================================================
    ' Live queries
    '======================================================================

    ' Translates Win32's DRIVE_* codes to FSO's. Note the two that collapse into
    ' UnknownType: DRIVE_UNKNOWN (0) and DRIVE_NO_ROOT_DIR (1), the latter meaning
    ' "that root does not exist". FSO makes the same conflation.
    ' Never raises, and works on a not-ready drive - the drive TYPE is known even
    ' when the media is absent (an empty CD bay still reports CDRom).
    [Description("Returns the type of a specified drive.")]
    Public Property Get DriveType() As DriveTypeConst
        Select Case GetDriveTypeW(StrPtr(RootPath()))
            Case 2: DriveType = Removable
            Case 3: DriveType = Fixed
            Case 4: DriveType = Remote
            Case 5: DriveType = CDRom
            Case 6: DriveType = RamDisk
            Case Else: DriveType = UnknownType
        End Select
    End Property

    ' THE GATE. It deliberately calls GetDiskFreeSpaceExW directly rather than
    ' through QueryDiskSpace: its whole job is to ANSWER the question the size
    ' properties throw on. Never route this through RaiseDriveError, or callers lose
    ' the ability to ask "is this safe to read?" without an error handler.
    [Description("True if the drive is ready (media present, queryable). Never raises — check this before reading any size or volume property.")]
    Public Property Get IsReady() As Boolean
        Dim a As LongLong, t As LongLong, f As LongLong
        IsReady = (GetDiskFreeSpaceExW(StrPtr(RootPath()), a, t, f) <> 0)
    End Property
    
    ' The single GetDiskFreeSpaceExW chokepoint. Raises rather than returning zeros.
    ' All three out-params are always filled, so a caller wanting more than one value
    ' should call this directly rather than reading two properties and paying for two
    ' round-trips. 'member' is threaded through purely so the raised error names the
    ' property the caller actually touched.
    Private Sub QueryDiskSpace(ByRef availToUser As LongLong, ByRef total As LongLong, _
                               ByRef free As LongLong, ByVal member As String)
        Dim e As Long
        If GetDiskFreeSpaceExW(StrPtr(RootPath()), availToUser, total, free) = 0 Then
            e = Err.LastDllError                      ' capture BEFORE anything else
            Shared.RaiseFromLastError e, "Drive." & member, mRoot, pathIsDrive:=True
        End If
    End Sub

    [Description("Returns the total size of a specified drive or network share. Raises error 71 if the drive is not ready — check IsReady first.")]
    Public Property Get TotalSize() As LongLong
        Dim a As LongLong, t As LongLong, f As LongLong
        QueryDiskSpace a, t, f, "TotalSize"
        TotalSize = t
    End Property

    ' Free bytes on the VOLUME - ignores per-user quotas. Compare AvailableSpace.
    [Description("Free bytes on the volume. Raises error 71 if the drive is not ready — check IsReady first.")]
    Public Property Get FreeSpace() As LongLong
        Dim a As LongLong, t As LongLong, f As LongLong
        QueryDiskSpace a, t, f, "FreeSpace"
        FreeSpace = f
    End Property

    ' Free bytes THIS USER may actually consume. On a quota'd volume this is less
    ' than FreeSpace; with no quota in force the two are equal. This is the one to
    ' check before writing - it is the number that governs whether the write fits.
    [Description("Free bytes available to the calling user (honours quotas). Raises error 71 if the drive is not ready — check IsReady first.")]
    Public Property Get AvailableSpace() As LongLong
        Dim a As LongLong, t As LongLong, f As LongLong
        QueryDiskSpace a, t, f, "AvailableSpace"
        AvailableSpace = a
    End Property
    
    '======================================================================
    ' Volume information
    '
    ' VolumeName, FileSystem and SerialNumber are three fields of ONE
    ' GetVolumeInformationW call - but each property makes its own, so reading all
    ' three costs three identical round-trips. QueryVolumeInfo unified the code, not
    ' the calls. Call it directly if you need more than one field.
    '======================================================================

    ' The single GetVolumeInformationW chokepoint. Raises rather than returning ""/0.
    ' Both string buffers must be supplied even when only one is wanted; the API
    ' fills both regardless. They are pre-filled with NULs and are far larger than
    ' either field can be (VOL_BUF = 261; a label maxes at 32 chars), so InStr is
    ' guaranteed to find a terminator and the "- 1" can never underflow. Shrink
    ' VOL_BUF and that guarantee goes with it.
    Private Sub QueryVolumeInfo(ByRef label As String, ByRef fsName As String, _
                                ByRef serial As Long, ByVal member As String)
        Dim maxComp As Long, flags As Long, e As Long
        Dim volBuf As String, fsBuf As String
        volBuf = String$(VOL_BUF, vbNullChar)
        fsBuf = String$(VOL_BUF, vbNullChar)
        If GetVolumeInformationW(StrPtr(RootPath()), StrPtr(volBuf), VOL_BUF, serial, maxComp, flags, StrPtr(fsBuf), VOL_BUF) = 0 Then
            e = Err.LastDllError
            Shared.RaiseFromLastError e, "Drive." & member, mRoot, pathIsDrive:=True
        End If
        label = Left$(volBuf, InStr(volBuf, vbNullChar) - 1)
        fsName = Left$(fsBuf, InStr(fsBuf, vbNullChar) - 1)
    End Sub

    ' The Let is the only mutating member on this class. Note SetVolumeLabelW cannot
    ' relabel a remote volume through a share - that fails regardless of permissions.
    [Description("Sets/Gets the volume label. The setter raises on failure — 71 if the drive is not ready, 70 if you lack permission (labelling requires write access to the volume root).")]
    Public Property Get VolumeName() As String
        Dim label As String, fsName As String, serial As Long
        QueryVolumeInfo label, fsName, serial, "VolumeName"
        VolumeName = label
    End Property
    Public Property Let VolumeName(ByVal value As String)
        Dim e As Long
        If SetVolumeLabelW(StrPtr(RootPath()), StrPtr(value)) = 0 Then
            e = Err.LastDllError
            Shared.RaiseFromLastError e, "Drive.VolumeName", mRoot, pathIsDrive:=True
        End If
    End Property

    [Description("The file system name, e.g. NTFS, FAT32, exFAT. Raises error 71 if the drive is not ready.")]
    Public Property Get FileSystem() As String
        Dim label As String, fsName As String, serial As Long
        QueryVolumeInfo label, fsName, serial, "FileSystem"
        FileSystem = fsName
    End Property

    ' The volume serial is a 32-bit UNSIGNED value, but FSO reports it through a
    ' SIGNED Long - so any serial with its high bit set comes back NEGATIVE
    ' (e.g. 0xD4A1B2C3 -> -728,239,933). That is FSO parity, not a defect: callers
    ' written against Scripting.FileSystemObject expect exactly this, and widening
    ' the return type would break them.
    '
    ' Use SerialNumberHex for display, or UnsignedSerialNumber if the numeric
    ' unsigned value is what you need.
    [Description("Returns the serial number of a specified drive, as a signed Long (FSO parity — a serial with its high bit set reports as a negative number). See SerialNumberHex for the conventional display form.")]
    Public Property Get SerialNumber() As Long
        Dim label As String, fsName As String, serial As Long
        QueryVolumeInfo label, fsName, serial, "SerialNumber"
        SerialNumber = serial
    End Property
    
    ' The unsigned value. Same bits, correctly interpreted: the +2^32 correction is
    ' the same one Shared.SizeFromHL applies to a file size's low DWORD, and for the
    ' same reason - a DWORD arriving in a signed Long.
    [Description("The drive's serial number as an unsigned 32-bit value (0 to 4294967295).")]
    Public Property Get UnsignedSerialNumber() As LongLong
        Dim v As LongLong
        v = CLngLng(SerialNumber)                    ' one GetVolumeInformationW call, via SerialNumber
        If v < 0 Then v = v + 4294967296^
        UnsignedSerialNumber = v
    End Property

    ' The form everyone actually recognises - what `vol` and Explorer show.
    ' Always 8 hex digits, dash-separated in the middle: "D4A1-B2C3".
    ' Built from the unsigned value so a negative serial formats correctly (Hex$ on a
    ' negative Long would give the right digits by accident, but only because of
    ' two's complement - going through the unsigned value says what it means).
    [Description("The drive's serial number in the conventional Explorer/`vol` display form, e.g. ""D4A1-B2C3"".")]
    Public Property Get SerialNumberHex() As String
        Dim h As String
        h = Right$("00000000" & Hex$(UnsignedSerialNumber), 8)
        SerialNumberHex = Left$(h, 4) & "-" & Mid$(h, 5)
    End Property
    
    ' The bridge into the File/Folder object graph. Raises 76 (not 71) on a not-ready
    ' drive, because the failure surfaces from GetFolder rather than from
    ' RaiseDriveError - the one member whose error number does not follow this
    ' class's convention.
    [Description("Returns a Folder object that represents the root folder of a specified drive.")]
    Public Property Get RootFolder() As Folder
        Set RootFolder = FileSystemTools.GetFolder(RootPath())
    End Property
    
End Class



' ==========================================================================
' Drives
'
' A read-only wrapper around a Collection of Drive objects.
'
' Thin by design: it exists so that callers get an FSO-shaped Count / Item /
' For Each surface instead of a raw VBA Collection, and so the collection cannot
' be added to or removed from after construction.
'
' Built by FileSystemTools.GetDrives, which walks the GetLogicalDrives bitmask and
' keys each entry by DRIVE LETTER ("C", not "C:"), so both Drives("C") and
' Drives(1) work. Never New'd directly - Init is Friend.
'
' SNAPSHOT. The membership is fixed at the moment GetDrives was called: a USB stick
' plugged in afterwards will not appear. Call GetDrives again to re-enumerate.
' The Drive objects inside are individually live (each queries Windows on every
' property read), so their contents are always current even though the list is not.
'
' Includes drives that are not ready - an empty optical bay still has a letter.
' See Drive.IsReady before reading sizes off anything in here.
' ==========================================================================
' MIT License - Copyright (c) 2026, GCUser99 (https://github.com/GCUser99)
' ==========================================================================

[Hidden(False)]
[Description("A read-only collection of Drive objects, enumerable with For Each.")]
Private Class Drives
    Option Explicit
    Private mItems As Collection                       ' Drive objects, keyed by letter

    Friend Sub Init(ByVal items As Collection)
        Set mItems = items
    End Sub
    
    [Description("Returns the number of Drive objects available.")]
    Public Property Get Count() As Long
        Count = mItems.Count
    End Property

    [DefaultMember]
    [Description("Returns a specific Drive object by name or index.")]
    Public Property Get Item(ByVal letterOrIndex As Variant) As [Drive]
        Set Item = mItems(letterOrIndex)
    End Property

    [Enumerator]
    [Hidden(True)]
    Public Function NewEnum() As IUnknown
        Set NewEnum = mItems.[_NewEnum]
    End Function
End Class


' ==========================================================================
' TextStream
'
' An FSO-style TextStream for the FileSystemTools module, built for very large files.
'
' It streams text by READING raw bytes through twinBASIC's Binary Get and WRITING
' raw bytes through Win32 WriteFile, doing all transcoding through the shared
' TextCodec module (the same converters used by
' FileSystemTools.TextFileToString/StringToTextFile). It deliberately does NOT use
' tB's "Open ... Encoding ..." clause: that clause does not reliably transcode
' multi-byte UTF-8 on read (a valid C3 A9 decodes to U+FFFD), so relying on it
' would silently corrupt any non-ASCII text.
'
' On read, a small carry buffer holds any partial multi-byte sequence that
' straddles a chunk boundary, so chunked decoding is exact. On write, the
' output buffer is flushed in chunks without ever splitting a surrogate pair.
'
' Encoding is chosen by FileSystemTools.OpenTextFile, either explicitly or via
' TextCodec.Detect over a 64 KB head sample. Classify decides whether
' the encoding can be byte-streamed (UTF-8/16/32, single-byte, DBCS, GB18030) and
' supplies the boundary strategy; only stateful UTF-7 and code pages GetCPInfo
' cannot classify fall back to a buffered whole-file path. All encoding logic lives
' in TextCodec. The public surface is identical in both modes.
'
' Created via:  Set ts = FileSystemTools.OpenTextFile(path, ForReading)
'               (or CreateTextFile - do not New this class directly)
'
' --- Why reads and writes use different plumbing -------------------------
'   * tB's positionless Get/Put IS 64-bit safe - a 2.4GB file streams correctly.
'   * But LOF() is Long and WRAPS negative past 2^31, and Seek() takes a Long and
'     cannot express an offset beyond it (a >2GB append failed with a bare E_FAIL).
' Reads only ever move forward, and the one Seek they need is the tiny BOM skip -
' so the read path stays on VB Binary I/O.
' Writes are different: appending REQUIRES positioning at EOF first, which a
' 32-bit Seek cannot do. So the write path uses a Win32 handle opened with
' FILE_APPEND_DATA, where every WriteFile lands at EOF atomically - no seek, no
' size query, no 2GB ceiling. Fresh writes use a handle too, purely so there is
' ONE write path rather than a size-dependent fork.
'
' --- THREE MODES, one public surface -------------------------------------
' Every public member has to work in all three. When debugging, first establish
' which one you are in, because they share almost no state:
'
'   1. STREAMING  (mStreaming = True, mIsStd = False)
'      The intended path.
'      READS:  a tB Binary file number (mFile) + chunked Get.
'              State: mBytesRemaining / mCarry / mDecoded / mDecPos.
'      WRITES: a Win32 handle (mHandle) + WriteFile.
'              State: mWriteBuf, flushed at STREAM_CHUNK.
'      Exactly one of mFile / mHandle is ever non-zero on a given instance.
'
'   2. BUFFERED   (mStreaming = False, mIsStd = False)
'      Fallback when Classify() cannot find a chunk-boundary rule for the code
'      page (UTF-7, exotic MBCS). Whole file lives in mBuffer; mPos is the
'      cursor; writes are committed once, on Close, via FileSystemTools.WriteStream.
'      NO handle of either kind is held open in this mode.
'
'   3. STANDARD   (mIsStd = True)
'      stdin/stdout/stderr via a Win32 handle (mStdHandle) we do NOT own.
'      Entirely separate state (mStd*), and every public member that supports it
'      short-circuits to a Std* helper on its FIRST line, before the Ensure*
'      guards. See the caveats in the OpenStandardStream helpers region.
'
' --- Invariants ----------------------------------------------------------
' * The BOM is dealt with exactly once, at open: skipped by a Seek on read
'   (OpenReadStream), written by OpenWriteFresh, never re-emitted on append.
'   Everything after that uses BARE code pages (mCp) via TextCodec.*Bytes, so no
'   chunk ever grows a spurious BOM. The buffered path is the exception - it uses
'   the sign-carrying TextCodec.Encode/Decode, which handle the BOM themselves.
' * mDecPos / mPos are 1-BASED string cursors; the byte arrays are 0-based.
' * mFile = 0 means "no read handle" - FreeFile never returns 0.
'   mHandle = 0 means "no write handle" - INVALID_HANDLE_VALUE is normalized to 0.
' ==========================================================================
' MIT License - Copyright (c) 2026, GCUser99 (https://github.com/GCUser99)
' ==========================================================================
[Hidden(False)]
[Description("A streaming text reader/writer returned by FileSystem.OpenTextFile, supporting auto-detected and explicit encodings with large-file streaming.")]
Private Class TextStream
    Option Explicit
    
    Private Const ERR_NOT_TEXT As Long = 5   ' shared "refused: content isn't decodable text"
    
    ' Serves double duty: the read chunk size, the write flush threshold, AND the
    ' head-sample size used for encoding detection in the Init* routines.
    Private Const STREAM_CHUNK As Long = 65536    ' raw bytes per read; flush threshold for writes

    ' --- Win32 write-path constants ---
    ' FILE_APPEND_DATA must be passed ALONE. OR-ing it with GENERIC_WRITE grants
    ' FILE_WRITE_DATA, which restores normal pointer-relative writes and would make
    ' an append start at position 0 - i.e. silently overwrite the file from the top.
    Private Const GENERIC_WRITE    As Long = &H40000000
    Private Const FILE_APPEND_DATA As Long = &H4
    Private Const FILE_SHARE_READ  As Long = &H1
    Private Const CREATE_ALWAYS    As Long = 2      ' create, truncating any existing file
    Private Const OPEN_EXISTING    As Long = 3

    '--- resolved at Init, then read-only -------------------------------
    Private mPath As String
    Private mMode As IOMode
    Private mEnc As TextEncoding              ' resolved encoding, signed (serves the Encoding property + BOM)
    Private mCp As Long                       ' bare code page = CodePageOf(mEnc) (chunk decode/encode, Classify)
    Private mLineEnding As String             ' newline emitted by WriteLine

    Private mStreaming As Boolean             ' True: byte-streaming; False: buffered whole-file
    Private mFile As Long                     ' tB file number - STREAMING READS ONLY (Binary mode)
    Private mHandle As LongPtr                ' Win32 handle - STREAMING WRITES ONLY (0 = none)

    ' --- streaming READ state ---
    ' The chunk pipeline is: disk -> mCarry+chunk -> [complete prefix | new mCarry]
    '                              -> decode -> append to mDecoded -> serve from mDecPos.
    Private mKind As DecodeKind               ' boundary strategy (from Classify)
    Private mLeadRanges() As Byte             ' DBCS lead-byte ranges (used when mKind = dkDBCS)
    Private mBytesRemaining As LongLong       ' undelivered source bytes (after any BOM)
    Private mCarry() As Byte                  ' partial multi-byte sequence carried across chunks
    Private mDecoded As String                ' decoded text window not yet consumed (+ lookahead)
    Private mDecPos As Long                   ' 1-based cursor into mDecoded

    ' --- streaming WRITE state ---
    Private mWriteBuf As String               ' pending text not yet encoded to disk

    ' --- buffered (fallback) state ---
    Private mBuffer As String                 ' whole-file content
    Private mPos As Long                      ' 1-based read cursor
    Private mDirty As Boolean                 ' buffered write pending

    ' --- shared ---
    Private mLine As Long                     ' 1-based current line
    Private mColumn As Long                   ' 1-based current column
    Private mClosed As Boolean

    ' --- fields (standard-stream mode) ---
    ' Parallel state to the streaming read fields above; mStdRaw/mStdInBuf play the
    ' roles of mCarry/mDecoded. Kept separate because the source is a handle we do
    ' not own and cannot Seek or size in advance.
    Private mIsStd As Boolean
    Private mStdHandle As LongPtr
    Private mStdInput As Boolean
    Private mStdCp As Long                      ' bare code page: encUtf16 (wide) or encSystemAnsi (ANSI)
    Private mStdKind As DecodeKind              ' boundary kind for reads
    Private mStdLead() As Byte                  ' DBCS lead ranges, if any
    Private mStdRaw() As Byte                   ' undecoded bytes carried across reads
    Private mStdInBuf As String                 ' decoded-but-unconsumed text
    Private mStdEof As Boolean
    
    ' How the streaming reader finds character boundaries within a raw chunk.
    ' Set once by Classify(); consumed only by CompletePrefixLen() and its helpers.
    ' Adding a member here means adding a *PrefixLen partner down in the
    ' classification region - the two must stay in step.
    Private Enum DecodeKind
        dkSingle          ' 1 byte = 1 char
        dkUtf8            ' self-synchronizing, 1-4 bytes
        dkUtf16LE
        dkUtf16BE
        dkUtf32           ' LE or BE; fixed 4-byte units
        dkDBCS            ' lead/trail double-byte (Big5, GB2312/GBK, DBCS ANSI)
        dkGB18030         ' 1/2/4-byte
    End Enum

    '======================================================================
    ' Initialization (called only by FileSystemTools.OpenTextFile)
    '
    ' All three Init* routines follow the same shape:
    '   resolve the encoding -> mEnc/mCp -> Classify() -> streaming or buffered.
    ' Classify() is the fork in the road: it decides which of the two file modes
    ' this instance will live in, and nothing changes that afterwards.
    '======================================================================
    Friend Sub Init(ByVal filePath As String, ByVal ioMode As IOMode, ByVal create As Boolean, ByVal format As TextEncoding, ByVal lineEnding As NewlineType)
        mPath = filePath
        ' Bad-name guard: only creation can hit an illegal name. Validating up front
        ' keeps the error identical (FSO's 52) regardless of which open path is taken.
        If create Then GuardCreateName filePath, "CreateTextFile"
        mMode = ioMode
        mPos = 1
        mLine = 1
        mColumn = 1
        mClosed = False
        mDirty = False
        ReDim mLeadRanges(0 To 11)          ' CPINFO.LeadByte is 12 bytes: 6 lo/hi pairs

        ' nlNoChange/nlUnknown/nlMixed (all 0) land in Else -> CRLF. A stream always
        ' needs a concrete newline to emit, so there is no "leave it alone" option.
        Select Case lineEnding
            Case nlUnix:      mLineEnding = vbLf
            Case nlMacintosh: mLineEnding = vbCr
            Case Else:        mLineEnding = vbCrLf
        End Select

        Select Case ioMode
            Case ForReading:   InitReading format
            Case ForWriting:   InitWriting format, create
            Case ForAppending: InitAppending format, create
            Case Else:         Err.Raise 5, "TextStream", "Invalid IOMode"
        End Select
    End Sub

    ' Reads a head sample to resolve the encoding, then either opens a byte stream
    ' (skipping the BOM) or slurps the whole file into mBuffer.
    ' NOTE: on the buffered path the file is read TWICE - once for the sample, once
    ' in full. Acceptable only because that path is the rare fallback.
    Private Sub InitReading(ByVal format As TextEncoding)
        If Not FileSystemTools.FileExists(mPath) Then Err.Raise 53, "TextStream", "File not found: " & mPath

        Dim sample() As Byte
        FileSystemTools.ReadStream mPath, sample, STREAM_CHUNK

        If Not IsArrayInitialized(sample) Then
            ' Empty file - pick an encoding for reporting; reads yield EOF
            If format = encAutoDetect Then mEnc = encUtf8 Else mEnc = TextCodec.CodePageOf(format)
        Else
            mEnc = TextCodec.Detect(sample, format)        ' BOM wins; else seed; else heuristics
            ' encUnknown is only reachable on the auto-detect path (Detect trusts a
            ' concrete seed), so an explicit encoding will never raise here.
            If mEnc = encUnknown Then Err.Raise ERR_NOT_TEXT, "TextStream", _
                "File appears to be binary; cannot open as text: " & mPath
        End If

        mCp = TextCodec.CodePageOf(mEnc)

        If Classify(mCp, mKind, mLeadRanges) Then
            mStreaming = True
            OpenReadStream TextCodec.BomLen(mEnc)         ' Seek past the BOM once, here
        Else
            mStreaming = False
            Dim full() As Byte
            FileSystemTools.ReadStream mPath, full
            If IsArrayInitialized(full) Then
                mBuffer = TextCodec.Decode(full, mEnc, nlNoChange)   ' strips a leading BOM
            Else
                mBuffer = vbNullString
            End If
            mPos = 1
        End If
    End Sub
    
    ' Append has two quite different jobs depending on whether the file exists:
    '   * missing  -> identical to a fresh write (BOM emitted, caller's newline used)
    '   * existing -> adopt the file's OWN encoding, BOM and newline style, so we
    '                 never turn a consistent file into a mixed one.
    Private Sub InitAppending(ByVal format As TextEncoding, ByVal create As Boolean)
        If Not FileSystemTools.FileExists(mPath) Then
            ' New file: an "append" to nothing is just a fresh write
            If Not create Then Err.Raise 53, "TextStream", "File not found: " & mPath
            If format = encAutoDetect Then format = encUtf8    ' auto has no meaning with no bytes to detect
            mEnc = format
            mCp = TextCodec.CodePageOf(mEnc)

            If Classify(mCp, mKind, mLeadRanges) Then
                mStreaming = True
                OpenWriteFresh                    ' fresh file -> may emit a BOM
            Else
                mStreaming = False
                mBuffer = vbNullString
                mDirty = True
            End If
            Exit Sub
        End If

        ' Existing file: preserve its encoding/BOM (auto), or use the given one
        Dim sample() As Byte
        FileSystemTools.ReadStream mPath, sample, STREAM_CHUNK

        If Not IsArrayInitialized(sample) Then
            ' Empty existing file = fresh write: keep the caller's lineEnding
            If format = encAutoDetect Then mEnc = encUtf8 Else mEnc = format
        Else
            mEnc = TextCodec.Detect(sample, format)        ' BOM wins; else seed; else heuristics
            If mEnc = encUnknown Then Err.Raise ERR_NOT_TEXT, "TextStream", _
                "File appears to be binary; cannot open as text: " & mPath

            ' Non-empty existing file: append in the file's OWN newline style, so we
            ' never turn a clean file mixed. The caller's lineEnding is ignored here -
            ' it governs only fresh writes (ForWriting, or append to an empty file).
            ' A mixed or newline-less file has no single style to match, so we keep
            ' the caller's value (already in mLineEnding).
            ' Sampled, not exact: the style is judged from the 64 KB HEAD only, so a
            ' file that changes style later on is matched to whatever its head used.
            Dim existingNl As String
            existingNl = TextCodec.GetNewLine( _
                TextCodec.DetectNewlineType(TextCodec.Decode(sample, mEnc, nlNoChange)))
            If Len(existingNl) > 0 Then mLineEnding = existingNl   ' 0-length = nlMixed/nlUnknown -> keep caller's
        End If

        mCp = TextCodec.CodePageOf(mEnc)

        If Classify(mCp, mKind, mLeadRanges) Then
            mStreaming = True
            OpenWriteAppend                        ' never re-emits a BOM
        Else
            ' Buffered append: load the existing content, park the cursor at the end,
            ' and let Write() concatenate onto it. mDirty stays False so that closing
            ' without writing anything does not needlessly rewrite the file.
            mStreaming = False
            Dim full() As Byte
            FileSystemTools.ReadStream mPath, full
            If IsArrayInitialized(full) Then mBuffer = TextCodec.Decode(full, mEnc, nlNoChange) Else mBuffer = vbNullString
            AdvancePosition mBuffer                ' Line/Column start at the end of the existing text
            mPos = Len(mBuffer) + 1
            mDirty = False
        End If
    End Sub

    ' Fresh write: truncate/create now (not lazily at Close), so an empty write still
    ' leaves a zero-length file behind.
    Private Sub InitWriting(ByVal format As TextEncoding, ByVal create As Boolean)
        If Not FileSystemTools.FileExists(mPath) And Not create Then Err.Raise 53, "TextStream", "File not found: " & mPath
        If format = encAutoDetect Then format = encUtf8     ' nothing to detect on a write

        mEnc = format
        mCp = TextCodec.CodePageOf(mEnc)

        If Classify(mCp, mKind, mLeadRanges) Then
            mStreaming = True
            OpenWriteFresh                        ' truncates/creates now; emits BOM if mEnc has one
        Else
            mStreaming = False
            mBuffer = vbNullString
            mDirty = True                         ' commit (truncate) on Close even with no writes
        End If
    End Sub

    '======================================================================
    ' Handle setup
    '
    ' Streaming mode only - the buffered path opens nothing.
    ' READS use a tB Binary file number: Binary (rather than Input/Output) so that
    ' tB does no transcoding of its own; every byte that crosses is raw.
    ' WRITES use a Win32 handle: see the header for why.
    '======================================================================

    ' Opens for read and consumes the BOM immediately, so mBytesRemaining counts
    ' only real content and no downstream code ever has to think about it again.
    Private Sub OpenReadStream(ByVal bomLen As Long)
        mFile = FreeFile()
        Open mPath For Binary Access Read As #mFile
        ' LOF() is Long and WRAPS past 2GB (verified: 2.4GB reports as -1894907904).
        ' StatPath is the only trustworthy size source.
        Dim total As LongLong
        Dim attrs As Long, cr As Date, mo As Date, ac As Date, leaf As String
        Shared.StatPath mPath, attrs, total, cr, mo, ac, leaf
        If bomLen > 0 And total >= bomLen Then
            Seek #mFile, bomLen + 1                  ' tiny offset: safe on a 32-bit Seek
            mBytesRemaining = total - bomLen
        Else
            mBytesRemaining = total
        End If
        Erase mCarry
        mDecoded = vbNullString
        mDecPos = 1
    End Sub

    ' Fresh write. CREATE_ALWAYS truncates any existing file
    Private Sub OpenWriteFresh()
        mHandle = CreateFileW(StrPtr(mPath), GENERIC_WRITE, FILE_SHARE_READ, ByVal vbNullPtr, _
                              CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, 0)
        If mHandle = INVALID_HANDLE_VALUE Then
            mHandle = 0                              ' normalize: 0 is our "no handle" sentinel
            RaiseFromLastError Err.LastDllError, "TextStream", mPath
        End If
        mWriteBuf = vbNullString

        ' The one and only place a BOM is emitted. Every later write goes through
        ' EncodeBytes (bare code page), which never adds one.
        Dim bom() As Byte
        bom = TextCodec.BomBytes(mEnc)               ' empty unless mEnc is BOM-bearing
        If TextCodec.SafeCountB(bom) > 0 Then WriteBytes bom
    End Sub

    ' Append. FILE_APPEND_DATA *alone* is what makes every WriteFile land at EOF
    ' atomically - see the constant's declaration for why it must not be OR'd with
    ' GENERIC_WRITE.
    '
    ' No LOF, no Seek, no size guard: unbounded by construction. This is the whole
    ' reason the write path moved off VB file I/O, whose 32-bit Seek could not
    ' position at the end of a >2GB file (it failed with a bare E_FAIL).
    ' No BOM either - the file already has one or was never meant to.
    Private Sub OpenWriteAppend()
        mHandle = CreateFileW(StrPtr(mPath), FILE_APPEND_DATA, FILE_SHARE_READ, ByVal vbNullPtr, _
                              OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0)
        If mHandle = INVALID_HANDLE_VALUE Then
            mHandle = 0
            RaiseFromLastError Err.LastDllError, "TextStream", mPath
        End If
        mWriteBuf = vbNullString
    End Sub

    '======================================================================
    ' Reading
    '
    ' Each public reader is the same three-part shape: std short-circuit, guard,
    ' then a streaming/buffered fork. The buffered arms are trivial Mid$ slicing;
    ' the interesting work is all in the streaming arms and in FillSome().
    '======================================================================
    [Description("Reads the specified number of characters and returns the resulting string.")]
    Public Function Read(ByVal characters As Long) As String
        If mIsStd Then Read = StdReadChars(characters): Exit Function
        EnsureReadable
        If characters < 0 Then Err.Raise 5, "TextStream.Read", "Invalid character count"
        If characters = 0 Then Exit Function
        If AtEndOfStream Then Err.Raise 62, "TextStream.Read", "Input past end of file"

        Dim s As String
        If mStreaming Then
            EnsureChars characters                        ' pull chunks until we have enough (or EOS)
            Dim avail As Long
            avail = Available()
            If characters > avail Then characters = avail  ' short read at EOF is not an error
            s = Mid$(mDecoded, mDecPos, characters)
            mDecPos = mDecPos + characters
        Else
            Dim availB As Long
            availB = Len(mBuffer) - mPos + 1
            If characters > availB Then characters = availB
            s = Mid$(mBuffer, mPos, characters)
            mPos = mPos + characters
        End If
        AdvancePosition s                                 ' keep Line/Column in step
        Read = s
    End Function

    ' The streaming arm's fill loop is subtler than it looks. Two distinct reasons
    ' to keep filling:
    '   (a) no break found at all yet -> need more text;
    '   (b) a break WAS found, but it is a CR sitting at the very end of the decoded
    '       window with source still unread - the next byte could be an LF, making it
    '       a CRLF. Consuming it now would report a spurious extra line.
    ' Once the loop settles, the break is re-located (the window may have grown) and
    ' the line is taken.
    [Description("Reads an entire line (up to, but not including, the newline) and returns the resulting string.")]
    Public Function ReadLine() As String
        If mIsStd Then ReadLine = StdReadLine(): Exit Function
        EnsureReadable
        If AtEndOfStream Then Err.Raise 62, "TextStream.ReadLine", "Input past end of file"

        Dim s As String
        If mStreaming Then
            Dim brk As Long, brkLen As Long
            Do
                brk = NextLineBreakIn(mDecoded, mDecPos, brkLen)
                If brk = 0 Then
                    If Not FillSome() Then Exit Do                 ' EOS: whole remainder is the line
                ElseIf IsCharCR(mDecoded, brk) And brk = Len(mDecoded) And Not SourceExhausted() Then
                    If Not FillSome() Then Exit Do                 ' trailing CR may be start of CRLF
                Else
                    Exit Do                                        ' definitive break in buffer
                End If
            Loop
            brk = NextLineBreakIn(mDecoded, mDecPos, brkLen)       ' re-locate: FillSome may have moved mDecPos
            If brk = 0 Then
                ' No terminator (last line, hit EOF): advance the column over the
                ' content; the line number does not change.
                s = Mid$(mDecoded, mDecPos)
                AdvancePosition s
                mDecPos = Len(mDecoded) + 1
            Else
                ' Crossed a terminator: AdvancePosition counts it as one line
                ' break, bumping the line and resetting the column to 1.
                ' The returned string EXCLUDES the terminator; only the position
                ' bookkeeping sees it.
                s = Mid$(mDecoded, mDecPos, brk - mDecPos)
                AdvancePosition s & Mid$(mDecoded, brk, brkLen)
                mDecPos = brk + brkLen
            End If
        Else
            Dim b2 As Long, bl2 As Long
            b2 = NextLineBreakIn(mBuffer, mPos, bl2)
            If b2 = 0 Then
                s = Mid$(mBuffer, mPos)
                AdvancePosition Mid$(mBuffer, mPos)
                mPos = Len(mBuffer) + 1
            Else
                s = Mid$(mBuffer, mPos, b2 - mPos)
                AdvancePosition Mid$(mBuffer, mPos, (b2 - mPos) + bl2)
                mPos = b2 + bl2
            End If
        End If
        ReadLine = s
    End Function

    [Description("Reads the entire remaining stream and returns the resulting string. In streaming mode this reads and decodes the remainder in a single pass, but still holds the whole remainder in memory; prefer ReadLine for very large files.")]
    Public Function ReadAll() As String
        If mIsStd Then ReadAll = StdReadAll(): Exit Function
        EnsureReadable
        Dim s As String
        If mStreaming Then
            ' Guard BEFORE consuming anything: the remainder has to fit in one Byte()
            ' and one String. Raising here leaves the stream fully usable, so the
            ' caller can switch to ReadLine.
            If mBytesRemaining > 2147483647^ Then
                Err.Raise 7, "TextStream.ReadAll", _
                    "Remaining content (" & mBytesRemaining & " bytes) exceeds the maximum " & _
                    "string size; use ReadLine or Read for a file this large."
            End If

            Dim head As String
            If mDecPos <= Len(mDecoded) Then head = Mid$(mDecoded, mDecPos)

            Dim tailBytes() As Byte
            If mBytesRemaining > 0 Then
                ' Safe narrowing: the > 2147483647^ guard above has already run.
                ReDim tailBytes(0 To CLng(mBytesRemaining) - 1)
                Get #mFile,, tailBytes
                mBytesRemaining = 0
            End If

            ' No CompletePrefixLen call needed: this IS the final block, so any
            ' trailing partial sequence is genuinely truncated input, not a boundary
            ' artifact - decode it best-effort along with everything else.
            Dim tail As String
            If TextCodec.SafeCountB(mCarry) > 0 Then
                Dim combined() As Byte
                combined = TextCodec.ConcatBytes(mCarry, tailBytes)   ' carry MUST lead
                Erase mCarry
                If TextCodec.SafeCountB(combined) > 0 Then tail = TextCodec.DecodeBytes(combined, mCp, nlNoChange)
            ElseIf TextCodec.SafeCountB(tailBytes) > 0 Then
                tail = TextCodec.DecodeBytes(tailBytes, mCp, nlNoChange)
            End If

            s = head & tail
            mDecoded = vbNullString
            mDecPos = 1
        Else
            s = Mid$(mBuffer, mPos)
            mPos = Len(mBuffer) + 1
        End If
        AdvancePosition s
        ReadAll = s
    End Function

    ' Skip/SkipLine are deliberately thin wrappers - all the boundary and position
    ' bookkeeping stays in one place (Read/ReadLine, or the Std* helpers) rather than
    ' being duplicated. Note the asymmetry, which is FSO's: Skip at EOS is a silent
    ' no-op, SkipLine at EOS raises 62.
    [Description("Skips the specified number of characters when reading.")]
    Public Sub Skip(ByVal characters As Long)
        Dim discard As String
        If mIsStd Then
            If characters > 0 Then discard = StdReadChars(characters)   ' read and throw away
            Exit Sub
        End If
        EnsureReadable
        If characters <= 0 Then Exit Sub
        If AtEndOfStream Then Exit Sub
        discard = Read(characters)
    End Sub

    [Description("Skips the next line when reading.")]
    Public Sub SkipLine()
        Dim discard As String
        If mIsStd Then
            If StdAtEnd() Then Err.Raise 62, "TextStream.SkipLine", "Input past end of file"
            discard = StdReadLine()
            Exit Sub
        End If
        EnsureReadable
        If AtEndOfStream Then Err.Raise 62, "TextStream.SkipLine", "Input past end of file"
        discard = ReadLine()
    End Sub

    '----------------------------------------------------------------------
    ' Streaming read engine: pull raw bytes, decode complete prefix, carry
    ' any partial trailing multi-byte sequence to the next fill.
    '
    ' This is the heart of the class. The contract of FillSome():
    '   returns True  -> it made progress (bytes consumed and/or text decoded);
    '                    that does NOT guarantee mDecoded grew (see the "not even
    '                    one whole character yet" branch).
    '   returns False -> the source is exhausted AND the carry is empty. This is
    '                    the one and only definition of end-of-stream.
    ' Callers must therefore always loop on a CONDITION, never on a single call.
    '----------------------------------------------------------------------
    Private Function FillSome() As Boolean
        ' Drop already-consumed text so mDecoded stays bounded to the live window.
        ' Without this, mDecoded would grow to the size of the whole file and the
        ' "streaming" reader would quietly become a buffered one.
        If mDecPos > 1 Then
            If mDecPos > Len(mDecoded) Then
                mDecoded = vbNullString
            Else
                mDecoded = Mid$(mDecoded, mDecPos)
            End If
            mDecPos = 1
        End If

        ' End of stream: nothing left on disk and nothing held back.
        If mBytesRemaining <= 0 And TextCodec.SafeCountB(mCarry) = 0 Then
            FillSome = False
            Exit Function
        End If

        Dim chunk() As Byte
        Dim toRead As Long
        toRead = STREAM_CHUNK
        ' Only fires when mBytesRemaining < STREAM_CHUNK, so the narrowing cannot overflow.
        If toRead > mBytesRemaining Then toRead = CLng(mBytesRemaining)
        If toRead > 0 Then
            ReDim chunk(0 To toRead - 1)
            Get #mFile,, chunk               ' sequential: no Seek, the handle tracks position
            mBytesRemaining = mBytesRemaining - toRead
        End If

        ' Re-attach the partial sequence held back last time. Order matters: the
        ' carry bytes are the HEAD of the character that straddled the boundary.
        Dim combined() As Byte
        combined = TextCodec.ConcatBytes(mCarry, chunk)
        Erase mCarry

        Dim total As Long
        total = TextCodec.SafeCountB(combined)
        If total = 0 Then
            FillSome = False
            Exit Function
        End If

        Dim prefixLen As Long
        If mBytesRemaining <= 0 Then
            prefixLen = total                          ' final block: decode everything (best effort)
        Else
            prefixLen = CompletePrefixLen(combined, total, mKind, mLeadRanges)
            If prefixLen <= 0 Then
                ' Pathological but possible: the whole chunk is one incomplete
                ' character (or a stream of continuation bytes). Carry it all and
                ' report progress - the next call reads more. This is the case that
                ' makes "True" not imply "mDecoded grew".
                mCarry = combined                      ' not even one full char yet; need more bytes
                FillSome = True
                Exit Function
            End If
        End If

        Dim prefix() As Byte
        prefix = TextCodec.SliceBytes(combined, 0, prefixLen - 1)
        If prefixLen < total Then mCarry = TextCodec.SliceBytes(combined, prefixLen, total - 1)

        mDecoded = mDecoded & TextCodec.DecodeBytes(prefix, mCp, nlNoChange)   ' bare cp: never re-strips a BOM
        FillSome = True
    End Function

    ' Fill until at least n characters are buffered, or the source runs dry.
    ' Deliberately does NOT raise on a short fill - the caller clamps.
    Private Sub EnsureChars(ByVal n As Long)
        Do While Available() < n
            If Not FillSome() Then Exit Do
        Loop
    End Sub

    ' Decoded characters not yet handed to the caller.
    Private Function Available() As Long
        Available = Len(mDecoded) - mDecPos + 1
    End Function

    ' True when no more bytes can arrive - both the file and the carry are empty.
    ' Used by ReadLine to decide whether a trailing CR could still become a CRLF.
    Private Function SourceExhausted() As Boolean
        SourceExhausted = (mBytesRemaining <= 0 And TextCodec.SafeCountB(mCarry) = 0)
    End Function

    '======================================================================
    ' Writing
    '
    ' Streaming: accumulate text in mWriteBuf, encode + WriteFile once it reaches
    ' STREAM_CHUNK. Buffered: accumulate everything in mBuffer and commit once, on
    ' Close. Either way the caller sees the same API and the same Line/Column.
    '======================================================================
    [Description("Writes the specified string to the stream (no trailing newline).")]
    Public Sub Write(ByVal text As String)
        If mIsStd Then StdWriteString text: Exit Sub
        EnsureWritable
        If mStreaming Then
            mWriteBuf = mWriteBuf & text
            If Len(mWriteBuf) >= STREAM_CHUNK Then FlushWriteChunk False   ' False: hold back a lone surrogate
        Else
            mBuffer = mBuffer & text          ' O(n^2) over many small writes - the fallback path's cost
            mDirty = True
        End If
        AdvancePosition text
    End Sub

    ' Note the std short-circuit: it bypasses Me.Write (and therefore mStreaming and
    ' mDirty) entirely - StdWriteString does its own AdvancePosition.
    [Description("Writes the specified string followed by the stream's newline.")]
    Public Sub WriteLine(Optional ByVal text As String = "")
        If mIsStd Then StdWriteString text & mLineEnding: Exit Sub
        Me.Write text & mLineEnding
    End Sub

    [Description("Writes the specified number of blank lines to the stream.")]
    Public Sub WriteBlankLines(ByVal lines As Long)
        Dim i As Long
        If mIsStd Then For i = 1 To lines: StdWriteString mLineEnding: Next i: Exit Sub
        For i = 1 To lines
            Me.Write mLineEnding
        Next i
    End Sub

    ' NB: deliberately does NOT call FlushFileBuffers. This means "handed to the OS",
    ' not "durable on the platter" - which is FSO's meaning too. Add
    ' "FlushFileBuffers mHandle" below if durability is ever required (it is not free).
    [Description("Commits pending writes to disk. In streaming mode this encodes and writes the buffered text now; the file stays open.")]
    Public Sub Flush()
        EnsureOpen
        If mStreaming Then
            If mMode <> ForReading Then FlushWriteChunk True     ' True: flush even a trailing lone surrogate
        Else
            FlushBuffered
        End If
    End Sub

    ' Encodes and writes pending text. When flushAll is False, holds back a
    ' trailing lone high surrogate so a surrogate pair is never split mid-encode.
    '
    ' Why it matters: a high surrogate encoded on its own is not a valid character,
    ' so the encoder would substitute (or, for UTF-8/GB18030 with
    ' WC_ERR_INVALID_CHARS, fail outright) and the pair's low half would then be
    ' orphaned in the next chunk. Holding one code unit back costs nothing and makes
    ' the chunk boundary invisible in the output.
    Private Sub FlushWriteChunk(ByVal flushAll As Boolean)
        If mHandle = 0 Then Exit Sub                     ' buffered mode / read mode / already closed
        Dim cut As Long
        cut = Len(mWriteBuf)
        If cut = 0 Then Exit Sub

        If Not flushAll Then
            Dim c As Long
            c = AscW(Mid$(mWriteBuf, cut, 1)) And &HFFFF&
            If c >= &HD800& And c <= &HDBFF& Then cut = cut - 1   ' trailing high surrogate: keep it back
            If cut <= 0 Then Exit Sub                             ' buffer was JUST that surrogate
        End If

        Dim part As String
        part = Left$(mWriteBuf, cut)
        Dim bytes() As Byte
        bytes = TextCodec.EncodeBytes(part, mCp)         ' bare cp; the BOM (if any) was written at open
        If TextCodec.SafeCountB(bytes) > 0 Then WriteBytes bytes
        mWriteBuf = Mid$(mWriteBuf, cut + 1)             ' keep whatever was held back
    End Sub

    ' The single write chokepoint for the streaming path.
    ' Loops because WriteFile is PERMITTED to write fewer bytes than asked (rare on
    ' a local disk, routine on a pipe) - a bare single call would silently truncate.
    ' The written = 0 test prevents an infinite spin if the OS reports success but
    ' makes no progress.
    Private Sub WriteBytes(ByRef bytes() As Byte)
        Dim total As Long, sent As Long, written As Long
        total = TextCodec.SafeCountB(bytes)
        If total = 0 Then Exit Sub

        Do While sent < total
            written = 0
            If WriteFile(mHandle, bytes(LBound(bytes) + sent), total - sent, written, ByVal vbNullPtr) = 0 Then
                RaiseFromLastError Err.LastDllError, "TextStream", mPath
            End If
            If written = 0 Then
                Err.Raise 75, "TextStream", "Write made no progress: " & mPath
            End If
            sent = sent + written
        Loop
    End Sub

    ' Buffered commit: the whole file, rewritten in one atomic swap. Unlike the
    ' streaming path this uses the sign-carrying Encode (BOM included) because it is
    ' producing the entire file, not a chunk of one.
    Private Sub FlushBuffered()
        If mStreaming Then Exit Sub
        If Not mDirty Then Exit Sub                      ' nothing pending: don't rewrite for nothing
        Dim bytes() As Byte
        bytes = TextCodec.Encode(mBuffer, mEnc)          ' prepends the BOM when mEnc is BOM-bearing
        FileSystemTools.WriteStream bytes, mPath         ' creates/truncates
        mDirty = False
    End Sub

    '======================================================================
    ' Close
    '======================================================================
    ' Idempotent. After this, EnsureOpen makes every operation raise 52.
    ' Two handle kinds to consider now: mFile (reads) and mHandle (writes). Only one
    ' is ever non-zero on a given instance, but both are handled defensively.
    [Description("Flushes pending writes and closes the stream. Further operations raise an error.")]
    Public Sub Close()
        If mClosed Then Exit Sub
        If mIsStd Then          ' never CloseHandle a std handle - the process owns it
            mClosed = True      ' but the OBJECT is done: further use raises 52.
            Exit Sub
        End If
        If mStreaming Then
            If mMode <> ForReading Then
                FlushWriteChunk True                     ' write out the tail, surrogate and all
                If mHandle <> 0 Then
                    CloseHandle mHandle
                    mHandle = 0
                End If
            Else
                If mFile <> 0 Then
                    Close #mFile
                    mFile = 0
                End If
            End If
        Else
            FlushBuffered                                ' the buffered path's ONLY disk write
        End If
        mClosed = True
    End Sub

    ' Safety net for a caller who drops the reference without calling Close - without
    ' it, a streamed write would lose its unflushed tail and a buffered write would
    ' never reach disk at all. Mirrors Close's body deliberately rather than calling
    ' it, since raising out of a Terminate is not an option (hence the blanket
    ' On Error Resume Next).
    Private Sub Class_Terminate()
        On Error Resume Next
        If Not mClosed And Not mIsStd Then
            If mStreaming Then
                If mMode <> ForReading Then
                    FlushWriteChunk True
                    If mHandle <> 0 Then CloseHandle mHandle
                Else
                    If mFile <> 0 Then Close #mFile
                End If
            Else
                FlushBuffered
            End If
        End If
    End Sub

    '======================================================================
    ' Properties
    '======================================================================
    ' NOT a pure query in streaming mode: it has to pull a chunk to find out whether
    ' anything is left, so it can advance the file position and grow mDecoded. That
    ' is harmless (nothing is consumed - mDecPos does not move), but it does mean
    ' this property can raise the same I/O errors a read can.
    [Description("True when the read cursor is at end of stream.")]
    Public Property Get AtEndOfStream() As Boolean
        If mIsStd Then AtEndOfStream = StdAtEnd(): Exit Property
        EnsureReadable
        If mStreaming Then
            If Available() > 0 Then Exit Property        ' fast path: text in hand, definitely not EOS
            Do While Available() = 0
                If Not FillSome() Then Exit Do           ' loop: FillSome can progress without decoding
            Loop
            AtEndOfStream = (Available() = 0)
        Else
            AtEndOfStream = (mPos > Len(mBuffer))
        End If
    End Property

    ' Peeks one character without consuming it. Same fill caveat as AtEndOfStream.
    ' False at end of stream (there is no character there to be a terminator).
    [Description("True when the next character to read is a line terminator (CR or LF).")]
    Public Property Get AtEndOfLine() As Boolean
        If mIsStd Then AtEndOfLine = StdAtEndOfLine(): Exit Property
        EnsureReadable
        If mStreaming Then
            Do While Available() = 0
                If Not FillSome() Then Exit Do
            Loop
            If Available() = 0 Then Exit Property         ' end of stream
            Dim c As Long
            c = AscW(Mid$(mDecoded, mDecPos, 1)) And &HFFFF&
            AtEndOfLine = (c = 13 Or c = 10)
        Else
            If mPos > Len(mBuffer) Then Exit Property
            Dim c2 As Long
            c2 = AscW(Mid$(mBuffer, mPos, 1)) And &HFFFF&
            AtEndOfLine = (c2 = 13 Or c2 = 10)
        End If
    End Property

    ' Line/Column track everything that has passed through AdvancePosition - which
    ' includes WRITES, not just reads (FSO parity).
    [Description("Current 1-based line number.")]
    Public Property Get Line() As Long
        Line = mLine
    End Property

    [Description("Current 1-based column number.")]
    Public Property Get Column() As Long
        Column = mColumn
    End Property

    ' Signed: negative means the file carries a BOM (see the TextCodec sign
    ' convention). For a read this is the DETECTED encoding, so it is the value to
    ' inspect when a file decodes to garbage.
    [Description("The resolved encoding of the stream (auto-detected for reads when not specified). BOM-bearing encodings report as their negative (e.g. encUtf8Bom).")]
    Public Property Get Encoding() As TextEncoding
        Encoding = mEnc
    End Property
    
    ' Diagnostic: False means Classify() found no chunk-boundary rule for this code
    ' page and the whole file is sitting in memory. Expect it only for UTF-7 and
    ' exotic MBCS pages.
    [Description("True if the stream uses byte-streaming; False if it fell back to a buffered (whole-file) path.")]
    Public Property Get IsStreaming() As Boolean
        IsStreaming = mStreaming
    End Property

    '======================================================================
    ' Helpers
    '======================================================================
    ' The three guards. Error numbers follow FSO: 52 for a closed stream, 54 for a
    ' mode mismatch. Note EnsureWritable accepts anything that is not ForReading,
    ' i.e. both ForWriting and ForAppending.
    Private Sub EnsureOpen()
        If mClosed Then Err.Raise 52, "TextStream", "Operation on a closed stream"
    End Sub

    Private Sub EnsureReadable()
        EnsureOpen
        If mMode <> ForReading Then Err.Raise 54, "TextStream", "Stream is not open for reading"
    End Sub

    Private Sub EnsureWritable()
        EnsureOpen
        If mMode = ForReading Then Err.Raise 54, "TextStream", "Stream is not open for writing"
    End Sub

    Private Function IsCharCR(ByRef text As String, ByVal pos As Long) As Boolean
        IsCharCR = ((AscW(Mid$(text, pos, 1)) And &HFFFF&) = 13)
    End Function

    ' Finds the next CR/LF at or after startPos in text. Returns its 1-based
    ' position and sets breakLen to 1 (CR or LF) or 2 (CRLF).
    '
    ' Handles all three conventions in one pass, which is why a mixed-newline file
    ' reads correctly line by line. The only case it cannot resolve alone is a CR at
    ' the very end of the buffer - it reports breakLen 1, and ReadLine is responsible
    ' for pulling more bytes before trusting that (see its fill loop).
    Private Function NextLineBreakIn(ByRef text As String, ByVal startPos As Long, ByRef breakLen As Long) As Long
        Dim pCR As Long, pLF As Long, p As Long
        pCR = InStr(startPos, text, vbCr)
        pLF = InStr(startPos, text, vbLf)

        If pCR = 0 And pLF = 0 Then
            breakLen = 0
            NextLineBreakIn = 0
            Exit Function
        End If

        If pCR = 0 Then
            p = pLF: breakLen = 1
        ElseIf pLF = 0 Then
            p = pCR: breakLen = 1
        ElseIf pCR < pLF Then
            p = pCR
            If pLF = pCR + 1 Then breakLen = 2 Else breakLen = 1   ' CRLF vs lone CR
        Else
            p = pLF: breakLen = 1                                 ' LF before any CR
        End If
        NextLineBreakIn = p
    End Function

    ' Advances mLine/mColumn over the consumed/written text. CRLF counts as ONE break.
    '
    ' Uses native InStr/InStrRev scans rather than walking code units: a few passes of
    ' compiled string search beat a per-unit VB loop by orders of magnitude (measured:
    ' 3.1x faster on a 2.4GB write), and it avoids copying the string to a Byte() just
    ' to count. Len() counts UTF-16 code units, which is the same unit the old loop
    ' used - so a surrogate pair still counts as two columns, exactly as before.
    '
    ' KNOWN QUIRK (pre-existing, pinned by AdvancePositionTests): a CRLF split across
    ' two calls counts as TWO breaks, since there is no state between calls. The read
    ' path cannot hit this - ReadLine always hands over a complete terminator.
    Private Sub AdvancePosition(ByRef consumed As String)
        Dim n As Long
        n = Len(consumed)
        If n = 0 Then Exit Sub

        ' lines = every CR + every LF that isn't part of a CRLF.
        ' (nCR + nLF - nCRLF: the CRLF pair is counted once, not twice.)
        Dim lines As Long
        lines = CountOf(consumed, vbCr) + CountOf(consumed, vbLf) - CountOf(consumed, vbCrLf)

        If lines = 0 Then
            mColumn = mColumn + n
            Exit Sub
        End If

        ' Column = whatever follows the LAST break. For a CRLF the LF is the later of
        ' the two, so taking the max of the two InStrRev results lands correctly on the
        ' end of the pair.
        Dim pCR As Long, pLF As Long, lastBreakEnd As Long
        pCR = InStrRev(consumed, vbCr)
        pLF = InStrRev(consumed, vbLf)
        If pLF > pCR Then lastBreakEnd = pLF Else lastBreakEnd = pCR

        mLine = mLine + lines
        mColumn = (n - lastBreakEnd) + 1
    End Sub

    ' Non-overlapping occurrence count. Binary compare: locale-independent and faster.
    Private Function CountOf(ByRef s As String, ByVal find As String) As Long
        Dim p As Long, fl As Long, n As Long
        fl = Len(find)
        p = InStr(1, s, find, vbBinaryCompare)
        Do While p > 0
            n = n + 1
            p = InStr(p + fl, s, find, vbBinaryCompare)
        Loop
        CountOf = n
    End Function
    
    '======================================================================
    ' OpenStandardStream helpers
    '
    ' Mode 3. The source is a Win32 handle we do NOT own, so: no Seek, no size, no
    ' Close, and reads block until the OS hands something back. The decode pipeline
    ' is the same shape as the file one (raw carry -> complete prefix -> decode ->
    ' text buffer), just driven by ReadFile instead of Get.
    '
    ' CAVEATS worth knowing before debugging something odd here:
    '   * mMode is never set (stays 0), so the Ensure* guards are effectively
    '     bypassed - each Std* helper does its own direction check instead.
    '   * Only the members with an "If mIsStd Then ..." first line support this
    '     mode; the rest are file-only.
    '   * Close does not close the handle (the process owns it) but DOES mark the
    '     object closed, so further use raises 52 like any other stream.
    '======================================================================
    Friend Sub InitStdStream(ByVal handle As LongPtr, ByVal isInput As Boolean, ByVal wide As Boolean)
        mIsStd = True
        mStdHandle = handle
        mStdInput = isInput
        If wide Then mStdCp = encUtf16 Else mStdCp = encSystemAnsi   ' both are non-negative => usable as a CP
        mLineEnding = vbCrLf  ' console convention; not caller-configurable
        mLine = 1             ' Init() never runs on this path - seed them here
        mColumn = 1
        mStdInBuf = vbNullString
        mStdEof = False
        Erase mStdRaw
        If isInput Then Classify mStdCp, mStdKind, mStdLead   ' only reads need boundary math
    End Sub

    Private Sub StdEnsureInput()
        If Not mStdInput Then Err.Raise 54, "TextStream", "Stream is not open for reading."
    End Sub

    ' No BOM, ever - a console/pipe consumer does not want one mid-stream. Wide mode
    ' emits raw UTF-16LE units, which is what the W console APIs expect.
    Private Sub StdWriteString(ByVal text As String)
        If mStdInput Then Err.Raise 54, "TextStream", "Stream is not open for writing."
        If Len(text) = 0 Then Exit Sub
        Dim bytes() As Byte
        bytes = TextCodec.EncodeBytes(text, mStdCp)
        If Not IsArrayInitialized(bytes) Then Exit Sub
        Dim written As Long
        WriteFile mStdHandle, bytes(0), UBound(bytes) - LBound(bytes) + 1, written, ByVal vbNullPtr
        AdvancePosition text          ' writes move Line/Column too (FSO parity)
    End Sub

    ' Pull one OS read, decode only the complete-character prefix, carry the remainder.
    '
    ' The file reader knows how many bytes are left; here we do not, so EOF is
    ' inferred from ReadFile (a zero-byte or failed read) and latched in mStdEof.
    ' A short read is normal on a pipe/console and is NOT end of input.
    ' NOTE this can return having decoded nothing (partial character, or a read that
    ' returned only continuation bytes) - the callers all loop on a condition.
    Private Sub StdFill(ByVal wantBytes As Long)
        If Not mStdEof Then
            Dim raw() As Byte, got As Long, ok As Long
            ReDim raw(wantBytes - 1)
            ok = ReadFile(mStdHandle, raw(0), wantBytes, got, ByVal vbNullPtr)
            If ok = 0 Or got = 0 Then
                mStdEof = True                       ' failed or zero-length read: latch EOF
            Else
                ReDim Preserve raw(got - 1)          ' shrink to what actually arrived
                mStdRaw = TextCodec.ConcatBytes(mStdRaw, raw)
            End If
        End If

        Dim total As Long, n As Long
        total = TextCodec.SafeCountB(mStdRaw)
        If total = 0 Then Exit Sub
        ' At EOF, decode whatever is left (a partial tail is truncated input, not a
        ' boundary artifact) - same reasoning as ReadAll's final block.
        If mStdEof Then n = total Else n = CompletePrefixLen(mStdRaw, total, mStdKind, mStdLead)
        If n <= 0 Then Exit Sub                      ' not one whole character yet; carry it all

        Dim head() As Byte
        head = TextCodec.SliceBytes(mStdRaw, 0, n - 1)
        mStdInBuf = mStdInBuf & TextCodec.DecodeBytes(head, mStdCp, nlNoChange)
        If n < total Then mStdRaw = TextCodec.SliceBytes(mStdRaw, n, total - 1) Else Erase mStdRaw
    End Sub

    ' Blocks until the source closes (Ctrl+Z / EOF on a pipe).
    Private Function StdReadAll() As String
        StdEnsureInput
        Do
            StdFill 65536
        Loop While Not mStdEof
        StdReadAll = mStdInBuf: mStdInBuf = vbNullString
        AdvancePosition StdReadAll
    End Function

    ' Splits on LF and strips a preceding CR, so it handles both CRLF and bare-LF
    ' input. Simpler than the file reader's ReadLine because the CR can never be
    ' orphaned at a chunk boundary here - we only ever look for the LF.
    ' At EOF with no trailing LF, the remainder is returned as the final line.
    Private Function StdReadLine() As String
        StdEnsureInput
        Dim p As Long
        Do
            p = InStr(mStdInBuf, vbLf)
            If p > 0 Then Exit Do
            If mStdEof Then Exit Do
            StdFill 4096
        Loop
        If p > 0 Then
            Dim ln As String
            ln = Left$(mStdInBuf, p - 1)
            mStdInBuf = Mid$(mStdInBuf, p + 1)
            If Len(ln) > 0 AndAlso Right$(ln, 1) = vbCr Then ln = Left$(ln, Len(ln) - 1)
            StdReadLine = ln
            ' The terminator was consumed but is not in the return value - AdvancePosition
            ' must still see one, or the line counter never moves. A bare LF is enough:
            ' CRLF and LF both count as exactly one break.
            AdvancePosition ln & vbLf
        Else
            StdReadLine = mStdInBuf: mStdInBuf = vbNullString
            AdvancePosition StdReadLine        ' EOF, unterminated final line: no break
        End If
    End Function

    ' Short read at EOF rather than an error (unlike the file Read, which raises 62).
    Private Function StdReadChars(ByVal n As Long) As String
        StdEnsureInput
        Do While Len(mStdInBuf) < n And Not mStdEof
            StdFill 4096
        Loop
        If n >= Len(mStdInBuf) Then
            StdReadChars = mStdInBuf: mStdInBuf = vbNullString
        Else
            StdReadChars = Left$(mStdInBuf, n)
            mStdInBuf = Mid$(mStdInBuf, n + 1)
        End If
        AdvancePosition StdReadChars
    End Function

    ' Blocking: on an interactive console this waits for input before it can say
    ' "no more input". Both conditions are required - buffer empty AND EOF latched.
    Private Function StdAtEnd() As Boolean
        StdEnsureInput
        If Len(mStdInBuf) > 0 Then Exit Function
        If Not mStdEof Then StdFill 4096
        StdAtEnd = (Len(mStdInBuf) = 0) And mStdEof
    End Function

    ' Peeks the next decoded character without consuming it. Blocks if nothing is
    ' buffered yet, for the same reason StdAtEnd does. False at end of input - there
    ' is no character there to be a terminator.
    Private Function StdAtEndOfLine() As Boolean
        StdEnsureInput
        If Len(mStdInBuf) = 0 And Not mStdEof Then StdFill 4096
        If Len(mStdInBuf) = 0 Then Exit Function
        Dim c As Long
        c = AscW(Left$(mStdInBuf, 1)) And &HFFFF&
        StdAtEndOfLine = (c = 13 Or c = 10)
    End Function
    
    '======================================================================
    ' Streamability classification + chunk-boundary math
    '
    ' Classify() answers "can this code page be chunked at all?" once, at open.
    ' CompletePrefixLen() then answers "where does the last WHOLE character end in
    ' this chunk?" on every fill. Everything the *PrefixLen helpers return is a byte
    ' count from the START of the buffer; the remainder becomes the carry.
    '
    ' The universal rule for these helpers: when in doubt, return LESS. Under-
    ' reporting merely defers bytes to the next chunk; over-reporting splits a
    ' character and corrupts the text.
    '======================================================================
    ' Classifies a code page for chunked streaming. Returns True and sets kind (and DBCS lead-byte ranges) when streamable; False when it must be buffered. cpANSI is resolved to the real ACP via GetACP/GetCPInfo.
    Private Function Classify(ByVal codePage As Long, ByRef kind As DecodeKind, ByRef leadRanges() As Byte) As Boolean
        Select Case codePage
            ' --- Known-shape encodings: decided by inspection, no API needed ---
            Case encUtf8
                kind = dkUtf8: Classify = True
            Case encUtf16
                kind = dkUtf16LE: Classify = True
            Case encUtf16Be
                kind = dkUtf16BE: Classify = True
            Case encUtf32, encUtf32Be
                kind = dkUtf32: Classify = True      ' endianness is irrelevant to a fixed 4-byte unit
            Case encUsAscii, encLatin1, encLatin9
                kind = dkSingle: Classify = True
            Case encGB18030
                kind = dkGB18030: Classify = True
            Case encUtf7
                Classify = False                      ' stateful - not chunk-safe
            Case Else
                ' --- Anything else: ask Windows about it ---
                ' encSystemAnsi (0) is a placeholder, not a real page - resolve it to
                ' the machine's actual ACP first, which may itself be UTF-8 or DBCS.
                Dim realCp As Long
                If codePage = encSystemAnsi Then realCp = GetACP() Else realCp = codePage
                Select Case realCp
                    Case encUtf8
                        kind = dkUtf8: Classify = True
                    Case encGB18030
                        kind = dkGB18030: Classify = True
                    Case Else
                        Dim info As CPINFO
                        If GetCPInfo(realCp, info) = 0 Then
                            Classify = False          ' unknown page: cannot reason about boundaries
                        ElseIf info.MaxCharSize = 1 Then
                            kind = dkSingle: Classify = True
                        ElseIf info.MaxCharSize = 2 Then
                            ' DBCS: the lead-byte ranges are the only thing that tells
                            ' us whether a given byte starts a 2-byte character, so
                            ' copy them out of CPINFO for IsDbcsLead to consult.
                            Dim k As Long
                            ReDim leadRanges(0 To 11)
                            For k = 0 To 11
                                leadRanges(k) = info.LeadByte(k)
                            Next
                            kind = dkDBCS: Classify = True
                        Else
                            Classify = False          ' >2 bytes and not a shape we know: buffer it
                        End If
                End Select
        End Select
    End Function

    ' Number of bytes from the start of b() that form whole characters for the given kind. The remainder (an incomplete trailing sequence) must be carried to the next chunk.
    ' Pure dispatch - one arm per DecodeKind. dkSingle needs no work (every byte is a
    ' complete character), which is why it is the Else.
    Private Function CompletePrefixLen(ByRef b() As Byte, ByVal total As Long, ByVal kind As DecodeKind, ByRef leadRanges() As Byte) As Long
        Select Case kind
            Case dkUtf8:     CompletePrefixLen = Utf8PrefixLen(b, total)
            Case dkUtf16LE:  CompletePrefixLen = Utf16PrefixLen(b, total, True)
            Case dkUtf16BE:  CompletePrefixLen = Utf16PrefixLen(b, total, False)
            Case dkUtf32:    CompletePrefixLen = total - (total Mod 4)   ' fixed width: just round down
            Case dkDBCS:     CompletePrefixLen = DbcsPrefixLen(b, total, leadRanges)
            Case dkGB18030:  CompletePrefixLen = Gb18030PrefixLen(b, total)
            Case Else:       CompletePrefixLen = total            ' dkSingle
        End Select
    End Function

    ' UTF-8 is self-synchronizing, so we only need to inspect the TAIL: walk back
    ' over continuation bytes (10xxxxxx) to the last lead byte, ask how many bytes
    ' that lead needs, and cut the sequence off if the buffer cannot supply them.
    ' O(1)-ish rather than a full scan - the walk-back is at most 3 bytes in valid
    ' input. An invalid lead is treated as need=1 so garbage cannot stall the reader.
    Private Function Utf8PrefixLen(ByRef b() As Byte, ByVal total As Long) As Long
        Dim i As Long
        i = total - 1
        Do While i >= 0
            If (b(i) And &HC0) = &H80 Then i = i - 1 Else Exit Do    ' 10xxxxxx = continuation
        Loop
        If i < 0 Then
            Utf8PrefixLen = total                ' all continuation bytes (garbage): don't stall, take it
            Exit Function
        End If

        Dim lead As Long, need As Long
        lead = b(i)
        If (lead And &H80) = 0 Then
            need = 1                             ' 0xxxxxxx
        ElseIf (lead And &HE0) = &HC0 Then
            need = 2                             ' 110xxxxx
        ElseIf (lead And &HF0) = &HE0 Then
            need = 3                             ' 1110xxxx
        ElseIf (lead And &HF8) = &HF0 Then
            need = 4                             ' 11110xxx
        Else
            need = 1                             ' invalid lead: treat as a 1-byte unit
        End If

        ' (total - i) is how many bytes we actually HAVE for that final sequence.
        If (total - i) < need Then Utf8PrefixLen = i Else Utf8PrefixLen = total
    End Function

    ' Two things can straddle a UTF-16 chunk boundary: half a code unit (odd byte
    ' count) and half a surrogate pair. Round down to whole units, then drop a
    ' trailing HIGH surrogate so its low half stays with it in the next chunk.
    Private Function Utf16PrefixLen(ByRef b() As Byte, ByVal total As Long, ByVal isLE As Boolean) As Long
        Dim complete As Long
        complete = total - (total Mod 2)         ' whole code units only
        If complete >= 2 Then
            Dim hi As Long, lo As Long, unit As Long
            If isLE Then
                lo = b(complete - 2): hi = b(complete - 1)
            Else
                hi = b(complete - 2): lo = b(complete - 1)
            End If
            unit = (hi * &H100&) Or lo
            If unit >= &HD800& And unit <= &HDBFF& Then complete = complete - 2   ' lone high surrogate
        End If
        Utf16PrefixLen = complete
    End Function

    ' DBCS has no self-synchronization: a trail byte is indistinguishable from a lead
    ' byte out of context, so the ONLY way to know whether the last byte starts a
    ' character is to walk the whole buffer from the front. Hence the full scan (and
    ' why this is the slowest of the boundary helpers).
    Private Function DbcsPrefixLen(ByRef b() As Byte, ByVal total As Long, ByRef leadRanges() As Byte) As Long
        Dim i As Long
        i = 0
        Do While i < total
            If IsDbcsLead(b(i), leadRanges) Then
                If i = total - 1 Then
                    DbcsPrefixLen = i        ' trailing lead byte awaits its trail
                    Exit Function
                End If
                i = i + 2                    ' lead + trail
            Else
                i = i + 1                    ' single byte
            End If
        Loop
        DbcsPrefixLen = total
    End Function

    ' CPINFO.LeadByte is 6 lo/hi pairs, terminated early by a 0,0 pair. Unused pairs
    ' are zeroed, so the 0,0 test is the list terminator, not a valid range.
    Private Function IsDbcsLead(ByVal bb As Long, ByRef leadRanges() As Byte) As Boolean
        Dim k As Long, lo As Long, hi As Long
        For k = 0 To 10 Step 2
            lo = leadRanges(k)
            hi = leadRanges(k + 1)
            If lo = 0 And hi = 0 Then Exit Function      ' end of the range list
            If bb >= lo And bb <= hi Then
                IsDbcsLead = True
                Exit Function
            End If
        Next
    End Function

    ' GB18030 is 1, 2 or 4 bytes, and the width is only decidable from the SECOND
    ' byte: a lead of 81-FE followed by a digit (30-39) means a 4-byte sequence,
    ' otherwise 2. So, like DBCS, this needs a full forward scan - and it has two
    ' distinct "ran out of bytes" exits, one per width.
    Private Function Gb18030PrefixLen(ByRef b() As Byte, ByVal total As Long) As Long
        Dim i As Long, b1 As Long, b2 As Long
        i = 0
        Do While i < total
            b1 = b(i)
            If b1 <= &H7F Then
                i = i + 1                            ' ASCII
            ElseIf b1 >= &H81 And b1 <= &HFE Then
                If i + 1 >= total Then
                    Gb18030PrefixLen = i             ' lead byte, no second byte yet: carry it
                    Exit Function
                End If
                b2 = b(i + 1)
                If b2 >= &H30 And b2 <= &H39 Then    ' digit second byte => 4-byte form
                    If i + 3 >= total Then
                        Gb18030PrefixLen = i         ' 4-byte sequence is incomplete: carry it
                        Exit Function
                    End If
                    i = i + 4
                Else
                    i = i + 2                        ' 2-byte form
                End If
            Else
                i = i + 1                            ' &H80 / &HFF: not a valid lead; skip one
            End If
        Loop
        Gb18030PrefixLen = total
    End Function
    
    ' Raises 52 if the LEAF of a create path has illegal filename chars. Used only
    ' for CREATE (an existing file can't have an illegal name). Validating up front
    ' keeps the error identical (FSO's 52) regardless of which open path is taken.
    ' Colon is EXCLUDED: a direct write to "<file>:<stream>" is a valid ADS write
    ' that FSO (and we) succeed on (oracle: bad:colon -> 0). Leaf-only.
    '
    ' Contrast FileSystemTools.GuardWriteName, which DOES reject the colon: that path
    ' goes through WriteStream's temp-file swap, which cannot express an ADS write.
    ' The two guards differ by exactly that one character, on purpose.
    Private Sub GuardCreateName(ByVal path As String, ByVal opName As String)
        Dim leaf As String
        leaf = FileSystemTools.GetFileName(path)
        If leaf Like "*[<>""|?*]*" Then           ' NO colon: ':' in a leaf is a valid ADS write
            Err.Raise 52, opName, "Bad file name or number: " & path
        End If
        ' Control chars aren't expressible in a Like pattern - check them separately.
        Dim i As Long
        For i = 1 To Len(leaf)
            If AscW(Mid$(leaf, i, 1)) < 32 Then
                Err.Raise 52, opName, "Bad file name or number: " & path
            End If
        Next
    End Sub
    
End Class


' ==========================================================================
' TextCodec
'
' Stateless text-encoding machinery shared by FileSystemTools (whole-file
' TextFileToString/StringToTextFile) and TextStream (chunked streaming). It holds the
' one definition of "bytes <-> text in encoding X": detection, decode/encode,
' and BOM handling. Neither caller duplicates any of it; both depend only on this module.
'
' The single public encoding type is TextEncoding. Its sign carries the BOM:
'   * >= 0 : a Windows code page, no BOM (named members below double as the
'            code-page constants; any other positive code page passes through).
'   * < 0  : the same code page WITH a BOM, expressed as -codePage.
'   * -1   : encAutoDetect / encUnknown (reserved; no real code page is 1).
' Three helpers (CodePageOf / HasBom / EncodingFor) are the only places that
' interpret the sign; everything else routes through them.
'
' --- Conventions used throughout this module ------------------------------
' * VB Strings ARE UTF-16LE. That is why the UTF-16LE cases in DecodeBytes /
'   EncodeBytes are bare assignments (Byte() <-> String) with no conversion:
'   UTF-16LE is the pivot every other encoding is converted through.
' * Byte arrays arriving from ReadStream are 0-based and may be UNALLOCATED
'   (empty file). Anything that indexes stream(0) directly assumes the caller
'   already checked - see the ByRef/allocation notes on each function.
' * MUTATION WARNING: the byte-swap paths (SwapByteOrder16/32) modify their
'   argument IN PLACE, so DecodeBytes/Decode can mutate the caller's buffer for
'   the big-endian encodings. See the note on DecodeBytes.
' * "Scan window" heuristics (DetectUTF1632, IsValidUTF8, LooksLikeBinary) all
'   examine a bounded prefix, so their verdicts are probabilistic by design.
'   A misdetection is almost always a window-size problem - the caps are the
'   first thing to raise when debugging one.
' ==========================================================================
' MIT License - Copyright (c) 2026, GCUser99 (https://github.com/GCUser99)
' ==========================================================================

Private Module TextCodec
    Option Explicit

    ' UTF surrogate pair constants (https://llvm.org/doxygen/ConvertUTF_8cpp_source.html)
    Private Const UNI_SUR_HIGH_START As Long = &HD800&
    Private Const UNI_SUR_HIGH_END As Long = &HDBFF&
    Private Const UNI_SUR_LOW_START As Long = &HDC00&
    Private Const UNI_SUR_LOW_END As Long = &HDFFF&
    Private Const HALF_BASE As Long = &H10000
    Private Const UNI_MAX_BMP As Long = &HFFFF&
    
    '======================================================================
    ' Sign convention - the only three functions that read/write the sign
    '
    ' Nothing else in the codebase should test "enc < 0" or negate an encoding
    ' directly. If a new BOM-bearing encoding is added, these three plus
    ' BomBytes/BomLen are the complete set of places that need to know.
    '======================================================================
    ' The bare Windows code page for an encoding (magnitude of the sign-encoded value). encUnknown/encAutoDetect -> 0 (system ANSI).
    Public Function CodePageOf(ByVal enc As TextEncoding) As Long
        If enc = encUnknown Then
            CodePageOf = 0                  ' CP_ACP fallback for undetermined
        ElseIf enc < 0 Then
            CodePageOf = -CLng(enc)         ' BOM-bearing: magnitude is the code page
        Else
            CodePageOf = CLng(enc)
        End If
    End Function

    ' True if the encoding carries a byte-order mark (negative, excluding the reserved -1).
    ' The encUnknown exclusion is what keeps -1 from being read as "code page 1 + BOM".
    Private Function HasBom(ByVal enc As TextEncoding) As Boolean
        HasBom = (enc < 0) And (enc <> encUnknown)
    End Function
    
    ' True for the fixed-width UTF-16/32 encodings, whichever endianness and with or
    ' without a BOM (the CodePageOf call folds the sign away first).
    ' Used to exempt wide text from the NUL-based binary sniff, whose NULs are
    ' legitimate padding rather than binary junk.
    Public Function IsWideText(ByVal enc As TextEncoding) As Boolean
        Select Case CodePageOf(enc)
            Case encUtf16, encUtf16Be, encUtf32, encUtf32Be
                IsWideText = True
            Case Else
                IsWideText = False
        End Select
    End Function

    '======================================================================
    ' Detection - returns a single signed TextEncoding (BOM folded into sign)
    '======================================================================
    ' Detects the encoding of a byte sample. A real BOM wins if found; otherwise a concrete seed (if given) wins over the heuristics; otherwise UTF-16/32 and UTF-8 heuristics run, falling back to system ANSI.
    '
    ' Precedence is deliberate and load-bearing:
    '   BOM > caller seed > heuristics > ANSI
    ' encUnknown can ONLY come back from the auto-detect path (step 3, binary
    ' content). With a seed, step 2 always returns something concrete - which is
    ' why the callers' binary guards have to re-scan explicitly on the seeded path.
    Public Function Detect(ByRef stream() As Byte, Optional ByVal seed As TextEncoding = encAutoDetect) As TextEncoding
        ' 1) BOM sniff overrides everything
        Dim bomEnc As TextEncoding
        bomEnc = SniffBom(stream)
        If bomEnc <> encUnknown Then
            Detect = bomEnc
            Exit Function
        End If

        ' 2) a concrete caller seed wins; but with no BOM found in file, then honor its code
        ' page without the BOM flag (a BOM-bearing seed degrades to no-BOM here)
        ' - i.e. passing encUtf8Bom for a file that has no BOM yields encUtf8, so the
        ' decoder does not try to strip bytes that aren't there.
        If seed <> encAutoDetect Then
            Detect = CodePageOf(seed)
            Exit Function
        End If

        ' 3) heuristics: UTF-16/32 by null pattern, then UTF-8 validity, else ANSI
        Dim enc As TextEncoding
        enc = encUnknown
        ' Odd-length buffers can't be UTF-16/32, so skip straight to the 8-bit tests.
        If ((UBound(stream) + 1) Mod 2) = 0 Then enc = DetectUTF1632(stream)
        If enc = encUnknown Then
            ' Order matters: pure ASCII is valid UTF-8, so UTF-8 is tested first and
            ' ANSI is only the last resort for byte soup that is still plausibly text.
            If IsValidUTF8(stream) Then
                enc = encUtf8
            ElseIf LooksLikeBinary(stream) Then
                enc = encUnknown          ' binary: don't pass it off as ANSI; let the caller decide
            Else
                enc = encSystemAnsi
            End If
        End If
        Detect = enc
    End Function

    ' Returns the matching *Bom encoding, or encUnknown if no BOM is present.
    ' Works on a hex string of the first <=4 bytes, so short buffers just produce a
    ' short string and fall through the prefix patterns harmlessly.
    ' ORDER IS CRITICAL: "FFFE0000" (UTF-32LE) also matches the "FFFE*" (UTF-16LE)
    ' pattern, so the 4-byte forms MUST be tested before the 2-byte ones. The extra
    ' "Mod 4 = 0" length test guards against a UTF-16LE file that merely begins with
    ' a BOM followed by U+0000.
    Private Function SniffBom(ByRef stream() As Byte) As TextEncoding
        Dim bom As String
        bom = BytesToHexString(MidB(stream, 1, Min(4, UBound(stream) + 1)))
        SniffBom = encUnknown

        If bom Like "EFBBBF*" Then
            SniffBom = encUtf8Bom
        ElseIf bom Like "FFFE0000" And ((UBound(stream) + 1) Mod 4 = 0) Then
            SniffBom = encUtf32Bom
        ElseIf bom Like "0000FEFF" And ((UBound(stream) + 1) Mod 4 = 0) Then
            SniffBom = encUtf32BeBom
        ElseIf bom Like "FFFE*" Then
            SniffBom = encUtf16Bom
        ElseIf bom Like "FEFF*" Then
            SniffBom = encUtf16BeBom
        ElseIf bom Like "84319533" Then
            SniffBom = encGB18030Bom
        ElseIf bom Like "2B2F76*" Then
            ' UTF-7's signature is "+/v" plus ONE of four possible 4th bytes
            ' (8/9/+//), because the mark is base64-packed and the run can start on
            ' any of four bit boundaries.
            If InStr("38 39 2B 2F", Mid$(bom, 7, 2)) > 0 Then SniffBom = encUtf7Bom
        End If
    End Function

    '======================================================================
    ' Decode - bytes -> UTF-16 String
    '   DecodeBytes: bare code page, NO BOM handling (streaming chunks).
    '   Decode:      full encoding; strips a leading BOM when the sign says so.
    '======================================================================
    ' Decodes raw bytes using a bare Windows code page. Does not strip a BOM; the streaming reader seeks past the BOM itself.
    '
    ' Does NOT mutate 'stream'. The big-endian cases byte-swap a private copy,
    ' because SwapByteOrder16/32 work in place and the caller's buffer may still be
    ' needed afterwards (e.g. NormalizeTextFile byte-compares the original bytes
    ' against the re-encoded output to decide whether a rewrite is needed).
    ' Mirrors the copy-then-swap the BE cases in EncodeBytes already use.
    '
    ' The UTF-16LE case is a bare assignment because a VB String already IS UTF-16LE
    ' - no conversion, just a reinterpretation of the same bytes.
    Public Function DecodeBytes(ByRef stream() As Byte, ByVal codePage As Long, Optional ByVal outLineEnding As NewlineType = nlNoChange) As String
        Dim t() As Byte
        Select Case codePage
            Case encUtf16:    DecodeBytes = stream                                            ' Byte() -> String: already UTF-16LE
            Case encUtf16Be:  t = stream: SwapByteOrder16 t: DecodeBytes = t                  ' swap a COPY, then as above
            Case encUtf32:    DecodeBytes = ConvertUTF32toUTF16(stream)
            Case encUtf32Be:  t = stream: SwapByteOrder32 t: DecodeBytes = ConvertUTF32toUTF16(t)
            Case Else:        DecodeBytes = ConvertToUTF16(stream, codePage)                  ' every 8-bit/MBCS page (incl. UTF-8)
        End Select
        If outLineEnding > 0 Then DecodeBytes = ChangeNewLine(DecodeBytes, outLineEnding)     ' 0 = nlNoChange
    End Function

    ' Decodes a whole byte buffer in the given encoding, stripping a leading BOM when the encoding is BOM-bearing.
    '
    ' The BOM is stripped AFTER decoding, not before: whatever the source encoding,
    ' its BOM decodes to exactly one U+FEFF character, so a single 2-byte MidB$ from
    ' position 3 removes it. That is why this works uniformly for a 3-byte UTF-8 BOM,
    ' a 4-byte UTF-32 BOM and a 5-byte UTF-7 signature alike.
    ' (Note it also inherits DecodeBytes' in-place mutation of 'stream' for BE input.)
    Public Function Decode(ByRef stream() As Byte, ByVal enc As TextEncoding, Optional ByVal outLineEnding As NewlineType = nlNoChange) As String
        Decode = DecodeBytes(stream, CodePageOf(enc), nlNoChange)  ' newline pass deferred to below
        If HasBom(enc) Then Decode = MidB$(Decode, 3)              ' drop the UTF-16le BOM unit
        If outLineEnding > 0 Then Decode = ChangeNewLine(Decode, outLineEnding)
    End Function

    '======================================================================
    ' Encode - UTF-16 String -> bytes
    '   EncodeBytes: bare code page, NO BOM (streaming chunks / appends).
    '   Encode:      full encoding; prepends the BOM when the sign says so.
    '======================================================================
    ' Encodes a string to bytes in a bare Windows code page (no BOM).
    ' Exact mirror of DecodeBytes; the UTF-16LE case is again a bare assignment.
    ' Returns an UNALLOCATED array for empty input (via ConvertFromUTF16) - callers
    ' must not assume a valid LBound. WriteStream handles this deliberately.
    Public Function EncodeBytes(ByVal text As String, ByVal codePage As Long) As Byte()
        Dim t() As Byte
        Select Case codePage
            Case encUtf16:    EncodeBytes = text                                      ' String -> Byte(): already UTF-16LE
            Case encUtf16Be:  t = text: SwapByteOrder16 t: EncodeBytes = t            ' swap a COPY, not the caller's data
            Case encUtf32:    EncodeBytes = ConvertUTF16toUTF32(text)
            Case encUtf32Be:  t = ConvertUTF16toUTF32(text): SwapByteOrder32 t: EncodeBytes = t
            Case Else:        EncodeBytes = ConvertFromUTF16(text, codePage)
        End Select
    End Function

    ' Encodes a string to bytes in the given encoding, prepending a BOM when the encoding is BOM-bearing.
    '
    ' Rather than splicing in raw BOM bytes, we prepend the CHARACTER U+FEFF and let
    ' the encoder emit whatever byte form that takes in the target encoding. This is
    ' what makes the odd cases (GB18030's 84 31 95 33, UTF-7's base64 "+/v8-") come
    ' out right for free. BomBytes() must stay in agreement with what the encoder
    ' actually produces here.
    Public Function Encode(ByVal text As String, ByVal enc As TextEncoding) As Byte()
        If HasBom(enc) Then
            ' add the utf-16le bom - API encoder will convert to the desired output bom
            text = ChrW$(&HFEFF&) & text        ' ByVal - the caller's string is untouched
        End If
        Encode = EncodeBytes(text, CodePageOf(enc))
    End Function

    '======================================================================
    ' BOM helpers
    '
    ' These describe the BOM WITHOUT encoding anything, for callers that need the
    ' bytes or just their length (e.g. seeking past a BOM on a streaming read, where
    ' decoding the head just to throw it away would be wasteful).
    ' Keep both tables in sync with each other and with what Encode() emits.
    '======================================================================
    ' The BOM byte sequence for a BOM-bearing encoding (empty otherwise).
    Public Function BomBytes(ByVal enc As TextEncoding) As Byte()
        Dim b() As Byte
        If Not HasBom(enc) Then
            BomBytes = b                       ' unallocated = no BOM
            Exit Function
        End If
        Select Case CodePageOf(enc)
            Case encUtf8:    ReDim b(0 To 2): b(0) = &HEF: b(1) = &HBB: b(2) = &HBF
            Case encUtf16:   ReDim b(0 To 1): b(0) = &HFF: b(1) = &HFE
            Case encUtf16Be: ReDim b(0 To 1): b(0) = &HFE: b(1) = &HFF
            Case encUtf32:   ReDim b(0 To 3): b(0) = &HFF: b(1) = &HFE: b(2) = 0: b(3) = 0
            Case encUtf32Be: ReDim b(0 To 3): b(0) = 0: b(1) = 0: b(2) = &HFE: b(3) = &HFF
            Case encGB18030: ReDim b(0 To 3): b(0) = &H84: b(1) = &H31: b(2) = &H95: b(3) = &H33
            Case encUtf7:    ReDim b(0 To 4): b(0) = &H2B: b(1) = &H2F: b(2) = &H76: b(3) = &H38: b(4) = &H2D  ' "+/v8-" (shift-out closes the run)
        End Select
        BomBytes = b
    End Function

    ' Byte length of the BOM for a BOM-bearing encoding (0 otherwise). Used to seek past the BOM on a streaming read.
    ' Must equal UBound(BomBytes(enc)) + 1 for every case above - including the
    ' 5-byte UTF-7 form, whose trailing "-" is part of what SniffBom will have
    ' matched and therefore part of what has to be skipped.
    Public Function BomLen(ByVal enc As TextEncoding) As Long
        If Not HasBom(enc) Then Exit Function
        Select Case CodePageOf(enc)
            Case encUtf8:               BomLen = 3
            Case encUtf16, encUtf16Be:  BomLen = 2
            Case encUtf32, encUtf32Be:  BomLen = 4
            Case encGB18030:            BomLen = 4
            Case encUtf7:               BomLen = 5
        End Select
    End Function

    '======================================================================
    ' Byte-array utilities (shared; all results 0-based)
    '
    ' Every one of these tolerates an UNALLOCATED input - that is the whole point
    ' of routing through SafeCountB rather than touching UBound directly. Results
    ' are always freshly ReDim'd 0-based arrays regardless of the inputs' bases,
    ' so an empty result is likewise unallocated, not zero-length.
    '======================================================================

    ' Byte-exact comparison, base-agnostic (indexes off each array's own LBound).
    ' Two unallocated arrays compare equal (both count 0).
    ' CAUTION: if either buffer went through Decode/DecodeBytes with a big-endian
    ' encoding, it has already been swapped in place - compare copies, not originals.
    Public Function BytesEqual(ByRef a() As Byte, ByRef b() As Byte) As Boolean
        Dim na As Long, nb As Long, i As Long
        na = TextCodec.SafeCountB(a): nb = TextCodec.SafeCountB(b)
        If na <> nb Then Exit Function
        For i = 1 To na
            If a(LBound(a) + i - 1) <> b(LBound(b) + i - 1) Then Exit Function
        Next
        BytesEqual = True
    End Function
    
    ' Element count that returns 0 (rather than raising) for an unallocated array.
    ' The guard used by every other routine here before it indexes anything.
    Public Function SafeCountB(ByRef b() As Byte) As Long
        If IsArrayInitialized(b) Then SafeCountB = UBound(b) - LBound(b) + 1
    End Function

    ' a & b. Either side may be unallocated; if both are, the result is too.
    ' Used by the streaming reader to re-join a carry-over partial sequence from the
    ' previous chunk with the new one.
    Public Function ConcatBytes(ByRef a() As Byte, ByRef b() As Byte) As Byte()
        Dim na As Long, nb As Long
        na = SafeCountB(a)
        nb = SafeCountB(b)
        If na = 0 Then
            If nb > 0 Then ConcatBytes = b     ' NB: returns b as-is; its original base is preserved
            Exit Function
        End If
        If nb = 0 Then
            ConcatBytes = a
            Exit Function
        End If
        Dim r() As Byte, i As Long, baseA As Long, baseB As Long
        ReDim r(0 To na + nb - 1)
        baseA = LBound(a): baseB = LBound(b)
        For i = 0 To na - 1
            r(i) = a(baseA + i)
        Next
        For i = 0 To nb - 1
            r(na + i) = b(baseB + i)
        Next
        ConcatBytes = r
    End Function

    ' Inclusive slice. startIdx/endIdx are OFFSETS FROM LBound(b), not raw indices -
    ' so they are 0-based even when b is not. An empty range (endIdx < startIdx)
    ' returns an unallocated array; the range is otherwise NOT bounds-checked.
    Public Function SliceBytes(ByRef b() As Byte, ByVal startIdx As Long, ByVal endIdx As Long) As Byte()
        If endIdx < startIdx Then Exit Function
        Dim r() As Byte, i As Long, base As Long
        ReDim r(0 To endIdx - startIdx)
        base = LBound(b)
        For i = startIdx To endIdx
            r(i - startIdx) = b(base + i)
        Next
        SliceBytes = r
    End Function

    '======================================================================
    ' Code-page conversion (Win32 MultiByteToWideChar / WideCharToMultiByte)
    '
    ' Both directions use the standard two-pass idiom: call once with a null
    ' output buffer to size it, ReDim, then call again to fill it. If a conversion
    ' ever comes back short, the sizing pass and the filling pass have disagreed -
    ' which in practice means their FLAGS differ, so keep them identical.
    '======================================================================

    ' String -> bytes for any 8-bit/MBCS code page (everything except the UTF-16/32
    ' cases, which EncodeBytes handles itself). Raises 5 on failure.
    Private Function ConvertFromUTF16(ByRef text As String, ByVal toCodePage As Long) As Byte()
        Dim byteCount As Long
        Dim dwFlags As WCMB_Flags
        Dim outErrDesc As String
        Dim result() As Byte

        If text = vbNullString Then
            ' Empty input -> leave the return value as an unallocated (zero-byte)
            ' array. WriteStream treats that as "nothing to write" and produces a
            ' 0-byte file.
            Exit Function
        End If

        ' WC_ERR_INVALID_CHARS is accepted ONLY for lossless UTF-8/GB18030 (where a
        ' failed conversion can only mean a malformed source). Every other code page
        ' rejects it, so they pass 0 and let any unrepresentable character fall back
        ' to the code page's default substitute rather than fail the whole conversion.
        ' Consequence: writing text to a narrow code page is LOSSY AND SILENT.
        Select Case toCodePage
            Case encUtf8, encGB18030
                dwFlags = WC_ERR_INVALID_CHARS
            Case Else
                dwFlags = 0
        End Select

        ' Pass 1: size the output buffer (null target, count 0)
        byteCount = WideCharToMultiByte(toCodePage, dwFlags, StrPtr(text), Len(text), 0&, 0&, 0&, ByVal CFALSE)

        If byteCount = 0 Then
            ' Zero here is always a failure (empty input was short-circuited above).
            Select Case Err.LastDllError
                Case ERROR_NO_UNICODE_TRANSLATION
                    outErrDesc = "Invalid CP" & toCodePage & " byte sequence"
                Case ERROR_INVALID_PARAMETER
                    ' Usually an unknown/uninstalled code page - or WC_ERR_INVALID_CHARS
                    ' passed to a page that rejects it (see the flag selection above).
                    outErrDesc = "Code Page: " & toCodePage & " not supported"
                Case Else
                    outErrDesc = "Unicode conversion failed"
            End Select
            Err.Raise 5, , outErrDesc
            Exit Function
        End If

        ReDim result(0 To byteCount - 1)

        ' Pass 2: perform conversion - same flags as the sizing pass for consistency
        WideCharToMultiByte toCodePage, dwFlags, StrPtr(text), Len(text), VarPtr(result(0)), byteCount, 0&, ByVal CFALSE

        ConvertFromUTF16 = result
    End Function
    
    ' Bytes -> String for any 8-bit/MBCS code page. No flags: invalid sequences are
    ' replaced rather than rejected, because by the time we get here Detect() has
    ' already decided this is text and refusing to decode would be worse than
    ' substituting. A 0 char count (malformed/unsupported) yields "" - silently.
    ' ASSUMES 'stream' is allocated: it indexes stream(0) directly.
    Private Function ConvertToUTF16(ByRef stream() As Byte, ByVal fromCodePage As Long) As String
        Dim charCount As Long
        charCount = MultiByteToWideChar(fromCodePage, 0&, VarPtr(stream(0)), UBound(stream) + 1, 0&, 0&)  ' pass 1: size
        If charCount = 0 Then Exit Function

        ConvertToUTF16 = Space$(charCount)                                                                ' allocate
        MultiByteToWideChar fromCodePage, 0&, VarPtr(stream(0)), UBound(stream) + 1, StrPtr(ConvertToUTF16), charCount  ' pass 2: fill
    End Function
    
    '======================================================================
    ' UTF-16 <-> UTF-32 (hand-rolled; Windows has no UTF-32 code page)
    '
    ' Both directions are two-pass like the API conversions: a Count* helper walks
    ' the input to size the output exactly, then the converter fills it. The two
    ' MUST agree on surrogate handling or the output array will be mis-sized - so
    ' any change to one has to be mirrored in its Count* partner.
    ' All arithmetic is little-endian; the BE variants are handled by byte-swapping
    ' around these functions, never inside them.
    '======================================================================

    ' Converts a UTF-16LE string to a UTF-32LE byte array
    Private Function ConvertUTF16toUTF32(utf16str As String) As Byte()
        Dim utf16Bytes() As Byte
        Dim utf32Bytes() As Byte
        Dim sourcePos As Long, targetPos As Long
        Dim byteCount As Long
        Dim ch As Long, ch2 As Long
        Dim codePoint As Long
        Dim unitCount As Long

        utf16Bytes = utf16str                  ' String -> Byte(): raw UTF-16LE units
        unitCount = CountUTF32UnitsFromUTF16(utf16Bytes)
        If unitCount = 0 Then
            ConvertUTF16toUTF32 = utf16Bytes   ' empty / nothing to convert
            Exit Function
        End If

        ReDim utf32Bytes(0 To unitCount * 4 - 1)

        byteCount = UBound(utf16Bytes) + 1
        sourcePos = 0
        targetPos = 0

        ' A trailing odd byte (byteCount not even) is dropped by the "+ 1 <" bound.
        Do While sourcePos + 1 < byteCount
            ch = utf16Bytes(sourcePos) Or (utf16Bytes(sourcePos + 1) * &H100&)   ' LE assemble
            sourcePos = sourcePos + 2

            If ch >= UNI_SUR_HIGH_START And ch <= UNI_SUR_HIGH_END Then
                ' Combine only when a valid low surrogate actually follows.
                ' Lone surrogates are passed through as-is rather than raising - the
                ' conversion is deliberately lenient, matching the reference impl.
                If sourcePos + 1 < byteCount Then
                    ch2 = utf16Bytes(sourcePos) Or (utf16Bytes(sourcePos + 1) * &H100&)
                    If ch2 >= UNI_SUR_LOW_START And ch2 <= UNI_SUR_LOW_END Then
                        sourcePos = sourcePos + 2
                        codePoint = ((ch - UNI_SUR_HIGH_START) * 1024) + _
                                    (ch2 - UNI_SUR_LOW_START) + HALF_BASE
                    Else
                        codePoint = ch        ' unpaired high surrogate
                    End If
                Else
                    codePoint = ch            ' trailing high surrogate, no following unit
                End If
            Else
                codePoint = ch
            End If

            ' Emit the code point as 4 little-endian bytes
            utf32Bytes(targetPos) = codePoint And &HFF
            utf32Bytes(targetPos + 1) = (codePoint \ &H100) And &HFF
            utf32Bytes(targetPos + 2) = (codePoint \ &H10000) And &HFF
            utf32Bytes(targetPos + 3) = (codePoint \ &H1000000) And &HFF
            targetPos = targetPos + 4
        Loop

        ConvertUTF16toUTF32 = utf32Bytes
    End Function

    ' Sizing pass for ConvertUTF16toUTF32: one UTF-32 unit per code point, i.e. a
    ' valid surrogate PAIR counts once. Must mirror the loop above exactly.
    Private Function CountUTF32UnitsFromUTF16(utf16Bytes() As Byte) As Long
        Dim pos As Long
        Dim byteCount As Long
        Dim ch As Long, ch2 As Long

        If Not IsArrayInitialized(utf16Bytes) Then Exit Function   ' empty string -> 0 units
        byteCount = UBound(utf16Bytes) + 1

        pos = 0
        Do While pos + 1 < byteCount
            ch = utf16Bytes(pos) Or (utf16Bytes(pos + 1) * &H100&)
            pos = pos + 2
            If ch >= UNI_SUR_HIGH_START And ch <= UNI_SUR_HIGH_END Then
                If pos + 1 < byteCount Then
                    ch2 = utf16Bytes(pos) Or (utf16Bytes(pos + 1) * &H100&)
                    If ch2 >= UNI_SUR_LOW_START And ch2 <= UNI_SUR_LOW_END Then
                        pos = pos + 2         ' consume the low surrogate too
                    End If
                End If
            End If
            CountUTF32UnitsFromUTF16 = CountUTF32UnitsFromUTF16 + 1
        Loop
    End Function
    
    ' Converts a UTF-32LE byte array to UTF-16LE byte array
    ' (declared As String - the Byte() return value is implicitly reinterpreted,
    ' which is free because a VB String already IS UTF-16LE.)
    Private Function ConvertUTF32toUTF16(utf32Bytes() As Byte) As String
        Dim utf16Bytes() As Byte
        Dim sourcePos As Long, targetPos As Long
        Dim codePoint As Long
        Dim ch1 As Long, ch2 As Long
        Dim unitCount As Long

        unitCount = CountUTF16UnitsFromUTF32(utf32Bytes)
        If unitCount = 0 Then Exit Function          ' empty / truncated input -> "" 
        ReDim utf16Bytes(0 To unitCount * 2 - 1)

        sourcePos = 0
        targetPos = 0

        ' Trailing bytes that don't complete a 4-byte unit are dropped by the bound.
        Do While sourcePos + 3 < UBound(utf32Bytes) + 1
            codePoint = _
                CLng(utf32Bytes(sourcePos)) Or _
                (CLng(utf32Bytes(sourcePos + 1)) * &H100&) Or _
                (CLng(utf32Bytes(sourcePos + 2)) * &H10000) Or _
                (CLng(utf32Bytes(sourcePos + 3)) * &H1000000)
            sourcePos = sourcePos + 4

            If codePoint <= UNI_MAX_BMP Then
                ' BMP: one UTF-16 unit
                utf16Bytes(targetPos) = codePoint And &HFF
                utf16Bytes(targetPos + 1) = (codePoint \ &H100) And &HFF
                targetPos = targetPos + 2
            Else
                ' Supplementary: split into a high + low surrogate pair (two units)
                codePoint = codePoint - HALF_BASE
                ch1 = (codePoint \ 1024) + UNI_SUR_HIGH_START
                ch2 = (codePoint Mod 1024) + UNI_SUR_LOW_START

                utf16Bytes(targetPos) = ch1 And &HFF
                utf16Bytes(targetPos + 1) = (ch1 \ &H100) And &HFF
                utf16Bytes(targetPos + 2) = ch2 And &HFF
                utf16Bytes(targetPos + 3) = (ch2 \ &H100) And &HFF
                targetPos = targetPos + 4
            End If
        Loop

        ConvertUTF32toUTF16 = utf16Bytes
    End Function
    
    ' Sizing pass for ConvertUTF32toUTF16: BMP code points cost 1 unit, supplementary
    ' ones cost 2 (a surrogate pair). Must mirror the loop above exactly.
    ' NOTE: unlike its counterpart there is no IsArrayInitialized guard here - it
    ' relies on the callers only reaching this with an allocated array.
    Private Function CountUTF16UnitsFromUTF32(utf32Bytes() As Byte) As Long
        Dim pos As Long
        Dim codePoint As Long
        
        If Not IsArrayInitialized(utf32Bytes) Then Exit Function   ' empty string -> 0 units

        pos = 0
        Do While pos + 3 < UBound(utf32Bytes) + 1
            codePoint = _
                CLng(utf32Bytes(pos)) Or _
                (CLng(utf32Bytes(pos + 1)) * &H100&) Or _
                (CLng(utf32Bytes(pos + 2)) * &H10000) Or _
                (CLng(utf32Bytes(pos + 3)) * &H1000000)

            If codePoint <= UNI_MAX_BMP Then
                CountUTF16UnitsFromUTF32 = CountUTF16UnitsFromUTF32 + 1
            Else
                CountUTF16UnitsFromUTF32 = CountUTF16UnitsFromUTF32 + 2
            End If

            pos = pos + 4
        Loop
    End Function
    
    '======================================================================
    ' Endianness
    '
    ' In-place byte reversal within each code unit. BOTH MUTATE THEIR ARGUMENT -
    ' that is the source of the caller-visible side effect documented on
    ' DecodeBytes. Any trailing bytes that don't fill a whole unit are left alone
    ' (the Step bound stops short of them).
    '======================================================================
    Private Sub SwapByteOrder32(ByRef stream() As Byte)
        Dim i As Long, b1 As Byte, b2 As Byte, b3 As Byte, b4 As Byte
        For i = 0 To UBound(stream) - 3 Step 4
            'switch byte pattern endian-ess
            b1 = stream(i)
            b2 = stream(i + 1)
            b3 = stream(i + 2)
            b4 = stream(i + 3)
            stream (i) = b4
            stream (i + 1) = b3
            stream (i + 2) = b2
            stream (i + 3) = b1
        Next i
    End Sub
    
    Private Sub SwapByteOrder16(ByRef stream() As Byte)
        Dim i As Long, b As Byte
        For i = 0 To UBound(stream) - 1 Step 2
            'switch byte pattern endian-ess
            b = stream(i)
            stream (i) = stream(i + 1)
            stream (i + 1) = b
        Next i
    End Sub
    
    '======================================================================
    ' Heuristics (no BOM available)
    '
    ' All three are bounded-window scans and therefore probabilistic. The knobs are
    ' the maxBytesToScan / density-threshold constants; a file that misdetects is
    ' nearly always one whose distinguishing evidence lies past the window.
    '======================================================================

    ' UTF-16/32 detection by NUL-padding pattern: Latin-ish text in a wide encoding
    ' produces a strong, positionally regular run of zero bytes. Returns encUnknown
    ' when the evidence is too thin - which is the signal for Detect() to fall
    ' through to the 8-bit tests.
    '
    ' Three thresholds guard against false positives:
    '   MIN_NULL_DENSITY      - too few NULs overall => not wide text at all
    '   UTF32_SCAN_LIMIT      - UTF-32's 00 00 pairs are only counted in the early
    '                           window (they are far rarer and cheap to confirm)
    '   UTF32_DOMINANCE_RATIO - UTF-32LE text ALSO looks like UTF-16LE with lots of
    '                           NULs, so UTF-32 only wins if it wins decisively
    Private Function DetectUTF1632(stream() As Byte, Optional ByVal maxBytesToScan As Long = 2000, Optional ByVal maxNullsToFind As Long = 100) As TextEncoding
        Const MIN_NULL_DENSITY As Double = 0.005   ' 0.5%
        Const UTF32_DOMINANCE_RATIO As Long = 2
        Const UTF32_SCAN_LIMIT As Long = 256

        Dim windowEnd As Long
        Dim utf32WindowEnd As Long
        Dim i As Long
        Dim b1 As Byte, b2 As Byte, b3 As Byte, b4 As Byte

        Dim nulls16le As Long, nulls16be As Long
        Dim nulls32le As Long, nulls32be As Long
        Dim examinedBytes As Long

        ' --- Edge case: exactly 2 bytes ---
        ' Too short for the 4-byte block loop below, but a single NUL still tells us
        ' the endianness of a one-character UTF-16 file.
        If UBound(stream) = 1 Then
            If stream(0) = 0 And stream(1) <> 0 Then
                DetectUTF1632 = encUtf16Be
            ElseIf stream(1) = 0 And stream(0) <> 0 Then
                DetectUTF1632 = encUtf16
            Else
                DetectUTF1632 = encUnknown
            End If
            Exit Function
        End If

        ' -4 keeps i+3 in bounds. A short buffer makes this negative, the loop is
        ' skipped entirely, and the density test below then returns encUnknown.
        windowEnd = Min(UBound(stream) - 4, maxBytesToScan)
        utf32WindowEnd = Min(windowEnd, UTF32_SCAN_LIMIT)

        ' --- Scan window: one 4-byte block per iteration ---
        For i = 0 To windowEnd Step 4
            b1 = stream(i)
            b2 = stream(i + 1)
            b3 = stream(i + 2)
            b4 = stream(i + 3)

            ' UTF‑32 detection (only early window).
            ' A block that scores as UTF-32 skips the UTF-16 test - counting it as
            ' both would inflate the UTF-16 score and defeat the dominance ratio.
            If i <= utf32WindowEnd Then
                If (b1 = 0 And b2 = 0) And (b3 <> 0 Or b4 <> 0) Then
                    nulls32be = nulls32be + 1
                    GoTo NextBlock
                ElseIf (b3 = 0 And b4 = 0) And (b1 <> 0 Or b2 <> 0) Then
                    nulls32le = nulls32le + 1
                    GoTo NextBlock
                End If
            End If

            ' UTF‑16 detection: two independent 2-byte units per block.
            ' A NUL in the HIGH byte means big-endian; in the LOW byte, little-endian.
            If b1 = 0 And b2 <> 0 Then
                nulls16be = nulls16be + 1
            ElseIf b2 = 0 And b1 <> 0 Then
                nulls16le = nulls16le + 1
            End If

            If b3 = 0 And b4 <> 0 Then
                nulls16be = nulls16be + 1
            ElseIf b4 = 0 And b3 <> 0 Then
                nulls16le = nulls16le + 1
            End If

    NextBlock:
            ' Early out: enough evidence gathered, stop burning cycles on a big file.
            If nulls16le + nulls16be + nulls32le + nulls32be >= maxNullsToFind Then Exit For
        Next i

        ' Approximate - i has already been advanced past the last block (or Exit For'd).
        ' Only feeds the density ratio, so the slop is tolerable.
        examinedBytes = i + 4

        ' --- Minimum null density check ---
        ' Ordinary 8-bit text has essentially no NULs; a handful in a large window is
        ' noise, not wide text.
        If examinedBytes > 0 Then
            If (nulls16le + nulls16be + nulls32le + nulls32be) / examinedBytes < MIN_NULL_DENSITY Then
                DetectUTF1632 = encUnknown
                Exit Function
            End If
        End If

        ' --- Determine UTF‑16 winner ---
        ' A tie leaves utf16Winner/utf16Score at 0 - deliberately no winner.
        Dim utf16Winner As TextEncoding
        Dim utf16Score As Long

        If nulls16le > nulls16be Then
            utf16Winner = encUtf16
            utf16Score = nulls16le
        ElseIf nulls16be > nulls16le Then
            utf16Winner = encUtf16Be
            utf16Score = nulls16be
        End If

        ' --- Determine UTF‑32 winner ---
        ' Only considered when the buffer length is a multiple of 4 - it cannot be
        ' UTF-32 otherwise.
        Dim utf32Winner As TextEncoding
        Dim utf32Score As Long

        If (UBound(stream) + 1) Mod 4 = 0 Then
            If nulls32le > nulls32be Then
                utf32Winner = encUtf32
                utf32Score = nulls32le
            ElseIf nulls32be > nulls32le Then
                utf32Winner = encUtf32Be
                utf32Score = nulls32be
            End If
        End If

        ' --- Final decision: UTF-32 must dominate; otherwise UTF-16 if it scored ---
        If utf32Score > utf16Score * UTF32_DOMINANCE_RATIO Then
            DetectUTF1632 = utf32Winner
        ElseIf utf16Score > 0 Then
            DetectUTF1632 = utf16Winner
        Else
            DetectUTF1632 = encUnknown
        End If
    End Function
    
    ' Is the head of this buffer valid UTF-8? Delegates the real work to
    ' MultiByteToWideChar with MB_ERR_INVALID_CHARS (fail-on-invalid), so the only
    ' job here is trimming the scan window so it does NOT end mid-sequence - a
    ' truncated multi-byte character would be reported as invalid and cost us the
    ' detection.
    '
    ' Trimming logic: walk back over trailing continuation bytes (10xxxxxx) to the
    ' last lead byte, work out how many bytes that lead requires, and if the window
    ' can't supply them, cut the sequence off entirely.
    '
    ' Note that pure ASCII is valid UTF-8 and returns True - which is why Detect()
    ' must test UTF-16/32 first and treat ANSI as the last resort.
    ' On using MB_ERR_INVALID_CHARS for validation: https://devblogs.microsoft.com/oldnewthing/20120504-00/?p=7703
    Private Function IsValidUTF8(stream() As Byte, Optional ByVal maxBytesToScan As Long = 8192) As Boolean
        Dim byteCount As Long
        Dim testCount As Long
        Dim endPos As Long
        Dim startPos As Long
        Dim lead As Long
        Dim need As Long
        Dim have As Long

        byteCount = UBound(stream) + 1
        If byteCount = 0 Then
            IsValidUTF8 = True                 ' vacuously valid
            Exit Function
        End If

        testCount = Min(byteCount, maxBytesToScan)

        ' Ensure we don't end on an incomplete UTF‑8 sequence.
        ' endPos is the last included index
        endPos = testCount - 1
        ' Move startPos back across trailing continuation bytes
        startPos = endPos
        Do While startPos >= 0 And (stream(startPos) And &HC0) = &H80    ' 10xxxxxx = continuation
            startPos = startPos - 1
        Loop

        If startPos < 0 Then
            ' Window is all continuation bytes (pathological), treat as valid/unknown
            IsValidUTF8 = True
            Exit Function
        End If

        lead = stream(startPos)

        ' Determine expected length from the lead byte
        If (lead And &H80) = 0 Then
            need = 1                           ' 0xxxxxxx - ASCII
        ElseIf (lead And &HE0) = &HC0 Then
            need = 2                           ' 110xxxxx
        ElseIf (lead And &HF0) = &HE0 Then
            need = 3                           ' 1110xxxx
        ElseIf (lead And &HF8) = &HF0 Then
            need = 4                           ' 11110xxx
        Else
            ' Invalid lead byte (a stray continuation or a 5+ byte form) - this alone
            ' disqualifies the buffer without even calling the API.
            IsValidUTF8 = False
            Exit Function
        End If

        have = endPos - startPos + 1

        ' If the last sequence is incomplete, drop it entirely
        If have < need Then
            testCount = startPos               ' exclude the partial lead + its continuations
            If testCount <= 0 Then
                IsValidUTF8 = True             ' nothing left to test
                Exit Function
            End If
        Else
            ' Ensure we don't include extra continuation bytes beyond the expected sequence
            testCount = endPos + 1
        End If

        ' Validate the trimmed window. A nonzero char count = every byte was legal
        ' UTF-8; MB_ERR_INVALID_CHARS is what turns a substitution into a failure.
        IsValidUTF8 = (MultiByteToWideChar(encUtf8, MB_ERR_INVALID_CHARS, VarPtr(stream(0)), testCount, 0&, 0&) <> 0)
    End Function
    
    ' Uppercase hex, two chars per byte, no separators - the form SniffBom's Like
    ' patterns are written against.
    Private Function BytesToHexString(bytes() As Byte) As String
        Dim i As Long, hexString() As String
        ReDim hexString(0 To UBound(bytes))
        For i = 0 To UBound(bytes)
            hexString(i) = Right$("00" & Hex$(bytes(i)), 2)
        Next i
        BytesToHexString = Join(hexString, "")
    End Function
    
    '======================================================================
    ' Newlines
    '======================================================================

    ' Rewrites every line ending to a single target style, whatever mix went in.
    ' Two-stage by necessity: everything is first collapsed to LF (which is why the
    ' CRLF pass MUST run before the lone-CR pass - reversed, CRLF would become LFLF),
    ' then LF is expanded to the target. Passing a target of nlNoChange/nlUnknown/
    ' nlMixed (all zero) is a no-op, so mixed content survives unmolested when the
    ' caller isn't asking for a change.
    Public Function ChangeNewLine(ByRef text As String, ByVal outLineEnding As NewlineType) As String
        Dim target As String
        target = GetNewLine(outLineEnding)
        If Len(target) = 0 Then                       ' nlNoChange / nlUnknown / unrecognized: leave as-is
            ChangeNewLine = text
            Exit Function
        End If
        Dim s As String
        s = VBA.Replace(text, vbCrLf, vbLf, compare:=vbBinaryCompare)   ' CRLF -> LF  (MUST precede the lone-CR pass)
        s = VBA.Replace(s, vbCr, vbLf, compare:=vbBinaryCompare)        ' lone CR -> LF
        If target <> vbLf Then s = VBA.Replace(s, vbLf, target, compare:=vbBinaryCompare)
        ChangeNewLine = s
    End Function
    
    ' Exact (not sampled) classification of a string's line endings.
    ' The subtraction trick is the crux: a CRLF contains both a CR and an LF, so the
    ' raw counts double-count it. Subtracting nCRLF from each leaves the LONE
    ' occurrences, and the number of distinct kinds present decides the verdict.
    ' Beware the enum overload: nlUnknown and nlMixed are BOTH 0, so a caller cannot
    ' tell "no line endings" from "several kinds" by value alone.
    Public Function DetectNewlineType(ByVal text As String) As NewlineType
        Dim nCRLF As Long, nLF As Long, nCR As Long
        nCRLF = CountSub(text, vbCrLf)
        nLF = CountSub(text, vbLf) - nCRLF      ' lone LF (every CRLF contains one LF)
        nCR = CountSub(text, vbCr) - nCRLF      ' lone CR (every CRLF contains one CR)

        Dim kinds As Long
        If nCRLF > 0 Then kinds = kinds + 1
        If nLF > 0 Then kinds = kinds + 1
        If nCR > 0 Then kinds = kinds + 1

        Select Case kinds
            Case 0:    DetectNewlineType = nlUnknown    ' single-line / no terminators
            Case 1
                If nCRLF > 0 Then
                    DetectNewlineType = nlWindows
                ElseIf nLF > 0 Then
                    DetectNewlineType = nlUnix
                Else
                    DetectNewlineType = nlMacintosh
                End If
            Case Else: DetectNewlineType = nlMixed
        End Select
    End Function

    ' Non-overlapping occurrence count. Binary compare so it is locale-independent,
    ' and it steps past the whole needle each time (irrelevant for CR/LF, but keeps
    ' the helper generally correct).
    Private Function CountSub(ByVal s As String, ByVal find As String) As Long
        Dim p As Long, fl As Long, n As Long
        fl = Len(find)
        If fl = 0 Then Exit Function            ' guard: an empty needle would loop forever
        p = InStr(1, s, find, vbBinaryCompare)
        Do While p > 0
            n = n + 1
            p = InStr(p + fl, s, find, vbBinaryCompare)
        Loop
        CountSub = n
    End Function
    
    ' The sole mapping from NewlineType to actual characters.
    ' Returns "" for anything zero-valued (nlNoChange / nlUnknown / nlMixed) - the
    ' empty return IS the "don't touch it" signal that ChangeNewLine keys off.
    Public Function GetNewLine(ByVal nlType As NewlineType) As String
        Select Case nlType
            Case nlWindows
                GetNewLine = vbCrLf
            Case nlUnix
                GetNewLine = vbLf
            Case nlMacintosh
                GetNewLine = vbCr
        End Select
    End Function
    
    ' Pure byte-level "does this look like binary?" - avoid using for wide-text encodings
    '
    ' (UTF-16/32 are full of legitimate NUL padding and would trip the first test
    ' immediately - hence IsWideText() guarding the call sites.)
    '
    ' Two independent tests:
    '   1. ANY NUL byte => binary, immediately. Real 8-bit text never contains one.
    '   2. >2% stray C0 control bytes => binary. Tab/LF/CR/FF are whitelisted as
    '      legitimate text formatting and don't count toward the ratio.
    ' Buffers under 64 bytes skip test 2 (the ratio is meaningless on a tiny sample)
    ' and are reported as text - false negatives are the safer failure here, since
    ' the caller will simply try to decode and produce garbage rather than refuse a
    ' legitimate file.
    Public Function LooksLikeBinary(ByRef raw() As Byte, Optional ByVal maxBytesToScan As Long = 8192) As Boolean
        Dim i As Long, cap As Long, ctrl As Long
        If Not IsArrayInitialized(raw) Then Exit Function    ' empty -> not binary
        
        cap = Min(UBound(raw) + 1, maxBytesToScan)

        '--- Scan for NULs and count C0 controls
        For i = 0 To cap - 1
            Select Case raw(i)
                Case 0
                    LooksLikeBinary = True ' any NUL -> binary
                    Exit Function
                Case 9, 10, 13, 12
                    ' allowed whitespace; tab/LF/CR/FF: legitimate
                Case Is < 32 ' stray C0 control
                    ctrl = ctrl + 1
            End Select
        Next i

        '--- Too small to classify reliably
        If cap < 64 Then
            LooksLikeBinary = False
            Exit Function
        End If

        '--- Binary if >2% control bytes
        LooksLikeBinary = (ctrl * 100 > cap * 2)
    End Function

End Module



' ==========================================================================
' Shared
'
' Internal plumbing shared by FileSystemTools, TextStream and the File / Folder /
' Drive classes. Nothing here is part of the public surface: the module is
' Private (project-internal, not exposed via COM), and its members are Public
' only so the other modules can reach them as Shared.<Member>.
'
' The things worth knowing before changing anything in here:
'
' * StatPath is the single stat chokepoint. Every File/Folder property that
'   reports size, dates, attributes or true on-disk casing traces back to it.
' * RaiseFromLastError is the single error chokepoint. It is the only place that
'   maps Win32 error codes onto the VB/FSO error numbers (52/53/58/61/70/75/76),
'   so error-number parity with Scripting.FileSystemObject lives or dies here.
'   It ALWAYS raises - it never returns to its caller.
' * SanitizeAttrs / SETTABLE_ATTRS are the single attribute chokepoint. Any bit
'   not in that mask is filesystem-managed and cannot be written, so it is
'   silently dropped rather than raising.
'
' Everything else (FindDataFileName, SizeFromHL, FileTimeToDate) exists to turn
' raw Win32 struct fields into VB types, and is used only by the above.
' ==========================================================================
' MIT License - Copyright (c) 2026, GCUser99 (https://github.com/GCUser99)
' ==========================================================================

Private Module Shared
    Option Explicit
    
    '======================================================================
    ' Attributes
    '======================================================================

    ' the bits SetFileAttributesW actually honors (Offline is technically settable
    ' but HSM-managed, so left out deliberately)
    ' Normal is IN the mask on purpose: SanitizeAttrs needs it to survive the AND so
    ' its "Normal dominates" rule can fire (see below).
    Public Const SETTABLE_ATTRS As Long = _
        FileAttribute.ReadOnly Or _
        FileAttribute.Hidden Or _
        FileAttribute.System Or _
        FileAttribute.Archive Or _
        FileAttribute.Temporary Or _
        FileAttribute.NotContentIndexed Or _
        FileAttribute.Normal

    '======================================================================
    ' Stat
    '======================================================================

    ' Central stat: one call returns the stat fields + the true on-disk leaf name.
    ' FindFirstFileW is primary — it yields real casing via cFileName — but it CANNOT
    ' stat a drive root, so GetFileAttributesExW is the fallback for roots (leaf = "").
    '
    ' The two paths fill the SAME fields from two different structs (WIN32_FIND_DATAW
    ' vs WIN32_FILE_ATTRIBUTE_DATA), which happen to share their first several
    ' members - hence the near-duplicate bodies. Keep them in step.
    '
    ' Returns False when neither API can stat the path, leaving the ByRef outputs
    ' untouched (i.e. at whatever the caller initialized them to). Current callers -
    ' GetFile / GetFolder - have already proven the path exists, so they invoke it as
    ' a statement and ignore the result; a new caller that hasn't should check it.
    Public Function StatPath(ByVal path As String, ByRef attrs As Long, ByRef size As LongLong, _
                             ByRef created As Date, ByRef modified As Date, ByRef accessed As Date, _
                             ByRef leafName As String) As Boolean
        Dim fd As WIN32_FIND_DATAW
        Dim h As LongPtr
        h = FindFirstFileW(StrPtr(path), fd)
        If h <> INVALID_HANDLE_VALUE Then
            FindClose h                              ' one-shot stat: close immediately, never enumerate
            attrs = fd.dwFileAttributes
            size = SizeFromHL(fd.nFileSizeHigh, fd.nFileSizeLow)
            created = FileTimeToDate(fd.ftCreationTime)
            modified = FileTimeToDate(fd.ftLastWriteTime)
            accessed = FileTimeToDate(fd.ftLastAccessTime)
            leafName = FindDataFileName(fd)          ' true on-disk casing
            StatPath = True
            Exit Function
        End If

        ' Fallback: drive roots (and anything FindFirstFile won't stat but that exists).
        Dim fad As WIN32_FILE_ATTRIBUTE_DATA
        If GetFileAttributesExW(StrPtr(path), GetFileExInfoStandard, fad) = 0 Then Exit Function
        attrs = fad.dwFileAttributes
        size = SizeFromHL(fad.nFileSizeHigh, fad.nFileSizeLow)
        created = FileTimeToDate(fad.ftCreationTime)
        modified = FileTimeToDate(fad.ftLastWriteTime)
        accessed = FileTimeToDate(fad.ftLastAccessTime)
        leafName = ""                                ' root has no leaf (FSO Folder.Name = "" for roots)
        StatPath = True
    End Function
    
    '======================================================================
    ' Win32 struct field -> VB type
    '======================================================================

    ' FILETIME (100ns ticks since 1601, UTC) -> a VB Date in LOCAL time.
    ' Two lossy conversions worth remembering when a timestamp looks "wrong":
    '   * local time, so it shifts with the machine's TZ/DST rules;
    '   * VB Date resolution is one second - the sub-second part is discarded.
    ' A zero FILETIME means "the filesystem has no value for this" (common for
    ' ftLastAccessTime when last-access tracking is disabled) and maps to Date 0,
    ' which VB displays as 1899-12-30. Any failure in the two API calls returns the
    ' same 0 rather than raising.
    Public Function FileTimeToDate(ByRef ft As FILETIME) As Date
        Dim lft As FILETIME
        Dim st As SYSTEMTIME
        If ft.dwLowDateTime = 0 And ft.dwHighDateTime = 0 Then Exit Function   ' "no value" -> 0
        If FileTimeToLocalFileTime(ft, lft) = 0 Then Exit Function
        If FileTimeToSystemTime(lft, st) = 0 Then Exit Function
        FileTimeToDate = DateSerial(st.wYear, st.wMonth, st.wDay) + _
                         TimeSerial(st.wHour, st.wMinute, st.wSecond)
    End Function

    ' Reassembles Win32's split 64-bit file size from its high/low DWORDs.
    ' The correction is the crux: 'low' arrives in a SIGNED Long, so any size whose
    ' low dword has bit 31 set comes through negative. Adding 2^32 restores the
    ' unsigned value before it is combined with the shifted high word.
    ' (The '^' suffix is a LongLong literal - without it the constant would overflow.)
    Public Function SizeFromHL(ByVal high As Long, ByVal low As Long) As LongLong
        Dim lo As LongLong
        lo = CLngLng(low)
        If lo < 0 Then lo = lo + 4294967296^                  ' low dword is unsigned
        SizeFromHL = (CLngLng(high) << 32) + lo
    End Function
    
    ' Extracts the file name from a WIN32_FIND_DATAW. cFileName is a fixed-length
    ' WCHAR buffer, NOT a VB string, so the terminating null has to be found by hand
    ' and the characters block-copied out. This is also the ONLY source of a name's
    ' true on-disk casing - the path the caller passed in tells us nothing about it.
    Public Function FindDataFileName(ByRef ffd As WIN32_FIND_DATAW) As String
        Dim i As Long
        Dim length As Long
        ' Find null terminator
        For i = 0 To UBound(ffd.cFileName)
            If ffd.cFileName(i) = 0 Then Exit For
            length = length + 1
        Next
        If length = 0 Then Exit Function
        ' Allocate string and copy UTF‑16 chars
        FindDataFileName = String$(length, vbNullChar)
        CopyMemory ByVal StrPtr(FindDataFileName), ffd.cFileName(0), length * 2   ' *2: chars -> bytes
    End Function
    
    '======================================================================
    ' Path / enumeration helpers
    '======================================================================

    ' The one filter applied by every directory walk. Note the asymmetry with the
    ' rest of the codebase: this EXCLUDES by default, so a caller that forgets to
    ' pass includeHidden simply won't see hidden files - it won't error.
    ' A file that is both hidden AND system needs both flags to be included.
    Public Function IncludeByAttr(ByVal attr As FILE_ATTRIBUTES, _
        ByVal includeHidden As Boolean, ByVal includeSystem As Boolean) As Boolean
        If (attr And FILE_ATTRIBUTE_HIDDEN) <> 0 And Not includeHidden Then Exit Function
        If (attr And FILE_ATTRIBUTE_SYSTEM) <> 0 And Not includeSystem Then Exit Function
        IncludeByAttr = True
    End Function
    
    ' Used to build "<folder>\<name>" and "<folder>\<pattern>" strings for the
    ' FindFirstFileW walkers.
    ' NOTE the empty-string case: "" -> "\", i.e. the drive root of the current
    ' drive, NOT "". Passing an empty folder in silently rebases the search at the
    ' root rather than the current directory.
    Public Function EnsureTrailingBackslash(ByVal s As String) As String
        If Len(s) = 0 Then
            EnsureTrailingBackslash = "\"
        ElseIf Right$(s, 1) = "\" Then
            EnsureTrailingBackslash = s
        Else
            EnsureTrailingBackslash = s & "\"
        End If
    End Function
    
    ' 8.3 short path. Two-pass sizing idiom; the first call's count INCLUDES the
    ' terminating null, the second's return does not.
    ' Falls back to the original path (never raises) when the API fails - which it
    ' legitimately does on volumes with 8.3 name generation disabled, so a caller
    ' cannot read the result as "this is definitely a short path".
    Public Function GetShortPath(ByVal path As String) As String
        Dim n As Long, buf As String
        n = GetShortPathNameW(StrPtr(path), 0, 0)
        If n = 0 Then GetShortPath = path: Exit Function
        buf = String$(n, vbNullChar)
        n = GetShortPathNameW(StrPtr(path), StrPtr(buf), n)
        If n = 0 Then GetShortPath = path Else GetShortPath = Left$(buf, n)
    End Function

    '======================================================================
    ' Attribute chokepoint
    '
    ' Every attribute write in the codebase goes through SetPathAttributes, which
    ' sanitizes first. That is what makes "set the attributes to X" idempotent:
    ' sanitizing an already-sanitized value is a no-op, so a caller can compare its
    ' target against SanitizeAttrs(target) and skip the write.
    '======================================================================

    ' Applies an attribute mask (non-settable bits stripped; 
    ' Normal/empty clears all settable bits) and returns the sanitized SETTABLE attributes actually written. 
    ' The return is the settable subset only and does NOT include filesystem-managed bits the file may carry - 
    ' re-stat the file if its full attribute set is needed.
    '
    ' Raises via RaiseFromLastError (source "Attributes") if the write fails - most
    ' often 70 (permission denied) or 53 (the path went away).
    Public Function SetPathAttributes(ByVal path As String, ByVal attrs As Long) As Long
        attrs = SanitizeAttrs(attrs)
        If SetFileAttributesW(StrPtr(path), attrs) = 0 Then
            RaiseFromLastError Err.LastDllError, "Attributes", path
        End If
        SetPathAttributes = attrs
    End Function
    
    ' Two rules, in order:
    '   1. Drop everything Windows won't let us write (ReparsePoint, Compressed,
    '      Encrypted, Directory, ...). Silently - an unsettable bit is not an error.
    '   2. FILE_ATTRIBUTE_NORMAL means "no attributes at all" and is only valid ALONE,
    '      so if it survived step 1 - or if step 1 left nothing behind - the whole
    '      mask collapses to Normal. Hence "Normal dominates": passing
    '      Normal Or ReadOnly clears the read-only bit rather than setting it.
    ' Idempotent: SanitizeAttrs(SanitizeAttrs(x)) = SanitizeAttrs(x).
    Public Function SanitizeAttrs(ByVal value As FileAttribute) As FileAttribute
        value = value And SETTABLE_ATTRS                      ' drop FS-managed bits
        If value = 0 Or (value And FileAttribute.Normal) <> 0 Then
            value = FileAttribute.Normal                     ' Normal dominates -> clear to none
        End If
        SanitizeAttrs = value
    End Function
    
    '======================================================================
    ' Error chokepoint
    '======================================================================

    ' Maps a Win32 error code onto the VB/FSO error number the caller expects, and
    ' RAISES - this never returns. Callers therefore need no "Exit Sub" after it.
    '
    ' --- Why pathIsDrive exists ------------------------------------------------
    ' The SAME Win32 code means different things depending on what the caller was
    ' asking about, and FSO reports it differently. ERROR_PATH_NOT_FOUND on a file
    ' path is "path not found" (76); on a drive it means the DEVICE is not there,
    ' which FSO reports as "device unavailable" (68). Verified against the oracle:
    '
    '     fso.GetDrive("D:").SerialNumber   -> 68, not 76      (no D: on the machine)
    '
    ' So the drive-context codes are remapped rather than given a second mapper in
    ' the Drive class - error-number parity stays in exactly ONE place, which is the
    ' whole point of this module.
    '
    ' If a third context ever needs its own mappings, turn pathIsDrive into an enum
    ' rather than adding a second Boolean.
    '
    ' --- Things to keep in mind when a caller reports a surprising number --------
    '   * Context is otherwise lost: 58's message always says "File already exists"
    '     even when a FOLDER collided (callers that care, like CreateFolder,
    '     pre-check and raise their own 58 with a better message).
    '   * Anything unmapped becomes 75 with the raw Win32 code embedded in the text.
    '     A 75 is the signal to come back here and add a Case.
    '   * Err.LastDllError must be captured by the caller BEFORE any intervening API
    '     call (see WriteStream / MoveOneFile), or the code passed in here is wrong.
    Public Sub RaiseFromLastError(ByVal errCode As Long, ByVal sourceName As String, _
                                  ByVal context As String, _
                                  Optional ByVal pathIsDrive As Boolean = False)

        ' --- Drive-context remappings (FSO parity) ---
        ' Checked FIRST, because these codes mean something else below.
        If pathIsDrive Then
            Select Case errCode
                Case ERROR_NOT_READY
                    ' Media absent: empty optical bay, no card in the reader. The
                    ' device exists; it just has nothing in it. Not handled at all in
                    ' the file-path table below, where it would fall through to 75.
                    Err.Raise 71, sourceName, "Disk not ready: " & context
                Case ERROR_FILE_NOT_FOUND, ERROR_PATH_NOT_FOUND, ERROR_INVALID_DRIVE, ERROR_BAD_NETPATH
                    ' The device itself is gone. For a FILE path these would be 53/76;
                    ' for a drive, a missing path IS a missing device.
                    ' Catches a drive removed AFTER construction (a USB stick pulled
                    ' mid-session), which Drive.Init's up-front check cannot.
                    Err.Raise 68, sourceName, "Device unavailable: " & context
            End Select
            ' Anything else (permissions, in particular) falls through to the general
            ' table below - a denied volume is a 70 whether or not it is a drive.
        End If

        ' --- General (file-path) mappings ---
        Select Case errCode
            Case ERROR_FILE_NOT_FOUND
                Err.Raise 53, sourceName, "File not found: " & context
            Case ERROR_PATH_NOT_FOUND
                Err.Raise 76, sourceName, "Path not found: " & context
            Case ERROR_FILE_EXISTS, ERROR_ALREADY_EXISTS
                Err.Raise 58, sourceName, "File already exists: " & context
            Case ERROR_ACCESS_DENIED, ERROR_SHARING_VIOLATION, ERROR_LOCK_VIOLATION
                Err.Raise 70, sourceName, "Permission denied: " & context   ' incl. "file is open elsewhere"
            Case ERROR_DISK_FULL, ERROR_HANDLE_DISK_FULL
                Err.Raise 61, sourceName, "Disk full: " & context
            Case ERROR_INVALID_NAME              ' 123: reserved chars | < > " ? *  -> FSO's 52
                Err.Raise 52, sourceName, "Bad file name or number: " & context
            Case ERROR_DIRECTORY                 ' 267: bad directory name (e.g. stray ':') -> FSO's 76
                Err.Raise 76, sourceName, "Path not found: " & context
            Case Else
                Err.Raise 75, sourceName, "Path/File access error (Win32=" & CStr(errCode) & "): " & context
        End Select
    End Sub
    

    '======================================================================
    ' Misc
    '======================================================================

    ' Add an object under its name; on a duplicate/invalid key, add unkeyed so a
    ' pathological case-only name clash never aborts the enumeration.
    ' The item is still IN the collection either way - only lookup-by-name is lost
    ' for the loser of the clash. Used by GetDrives (keyed by drive letter).
    Public Sub AddKeyed(ByRef c As Collection, ByVal item As Variant, ByVal key As String)
        On Error Resume Next
        c.Add item, key
        If Err.Number <> 0 Then
            Err.Clear                          ' Clear, or the stale Err leaks to the caller
            c.Add item
        End If
        On Error GoTo 0
    End Sub
    
    ' Variant ParamArray min/max. Deliberately untyped so they work on Long, LongLong
    ' and Date alike, at the cost of Variant boxing - fine at the call sites here
    ' (each runs once per operation, never per byte), but do NOT reach for these
    ' inside a scan loop.
    ' No arguments = subscript error on the first line; that is an accepted crash.
    Public Function Max(ParamArray numberList() As Variant) As Variant
        Dim i As Long
        Max = numberList(LBound(numberList))
        For i = LBound(numberList) + 1 To UBound(numberList)
            If numberList(i) > Max Then Max = numberList(i)
        Next i
    End Function
    
    Public Function Min(ParamArray numberList() As Variant) As Variant
        Dim i As Long
        Min = numberList(LBound(numberList))
        For i = LBound(numberList) + 1 To UBound(numberList)
            If numberList(i) < Min Then Min = numberList(i)
        Next i
    End Function
    
    ' What a failed FindFirstFileW actually means.
    '
    ' INVALID_HANDLE_VALUE is overloaded: it is returned both for "the search
    ' matched nothing" (perfectly normal) and for "I could not read this directory"
    ' (an error). Only the Win32 code tells them apart, and every enumerator in this
    ' codebase used to treat both as "empty" - which meant an unreadable folder was
    ' silently reported as containing nothing. Measured against FSO: FSO raises 70
    ' there; we returned 0.
    '
    ' Returns True  -> genuinely nothing to enumerate; the caller may exit quietly.
    ' Raises        -> anything else (ACCESS_DENIED, PATH_NOT_FOUND, ...). Never
    '                  returns False.
    '
    ' errCode MUST be Err.LastDllError captured by the caller IMMEDIATELY after the
    ' FindFirstFileW call - any intervening API call overwrites it.
    Public Function IsEmptySearch(ByVal errCode As Long, ByVal sourceName As String, ByVal context As String) As Boolean
        Select Case errCode
            Case ERROR_FILE_NOT_FOUND, ERROR_NO_MORE_FILES
                ' 2 / 18: the wildcard matched nothing. A real, empty result.
                IsEmptySearch = True
            Case Else
                ' 5 = access denied, 3 = path not found, etc. We could not look, and
                ' "could not look" must never be reported as "nothing there".
                RaiseFromLastError errCode, sourceName, context
        End Select
    End Function
    
End Module


Private Module WinAPI
    
