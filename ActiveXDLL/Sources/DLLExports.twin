Public Module DLLExports
    ' these are for use if calling the DLL without registration
    ' use following format to declare and use in VBA:
    '
    ' Public Declare PtrSafe Function New_FileSystem Lib "[path to dll folder]\tbFileWorks_win64.dll" () As Object
    ' Dim fso As Object  
    ' Set fso = New_FileSystem()
    Public Function New_FileSystem() As Object
        Set New_FileSystem = New FileSystemObject
    End Function
    
    Public Function New_FileDialog() As Object
        Set New_FileDialog = New FileDialog
    End Function

End Module