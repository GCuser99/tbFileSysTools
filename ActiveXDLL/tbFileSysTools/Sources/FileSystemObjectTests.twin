Private Module TestRenameCase

    ' Best-effort delete; never throws.
    Private Sub QuietKill(ByVal path As String)
        On Error Resume Next
        Kill path
        On Error GoTo 0
    End Sub
    Private Sub CaseOnlyRename_ChangesDiskCasing()
        Dim dir As String
        dir = FileSystemTools.GetAbsolutePathName(Environ$("TEMP"))

        Dim lowerPath As String
        lowerPath = FileSystemTools.BuildPath(dir, "caserename.tmp")
        Const upperName As String = "CASERENAME.TMP"

        ' Arrange: start from a clean, known-lowercase file
        QuietKill lowerPath
        QuietKill FileSystemTools.BuildPath(dir, upperName)
        Dim fn As Integer
        fn = FreeFile
        Open lowerPath For Output As #fn
        Close #fn

        Dim newPath As String
        On Error GoTo CleanFail
        ' Act: bare-name, case-only rename
        newPath = FileSystemTools.Rename(lowerPath, upperName)
        
        Debug.Assert StrComp(FileSystemTools.GetFileName(newPath), upperName, vbBinaryCompare) = 0

        ' Assert 1: returned path carries the new casing (binary compare!)
        Assert.Strict.IsTrue StrComp(FileSystemTools.GetFileName(newPath), upperName, vbBinaryCompare) = 0, _
            "Returned leaf name should be '" & upperName & "', got '" & FileSystemTools.GetFileName(newPath) & "'"

        ' Assert 2: on-disk name reflects the new casing
        Dim onDisk As String
        onDisk = VBA.Dir$(newPath)
        Assert.Strict.IsTrue StrComp(onDisk, upperName, vbBinaryCompare) = 0, _
            "On-disk name should be '" & upperName & "', got '" & onDisk & "'"

        QuietKill newPath
        Exit Sub
CleanFail:
        Dim savedErr As Long, savedDesc As String
        savedErr = Err.Number: savedDesc = Err.Description
        QuietKill lowerPath
        QuietKill FileSystemTools.BuildPath(dir, upperName)
        Assert.Strict.Fail "Rename raised " & savedErr & ": " & savedDesc
    End Sub


    Private Sub RealCollision_StillRaises58()
        ' Guards the change we made: a genuine collision must still raise,
        ' i.e. skipping the exists-check for the source didn't disable it.
        Dim dir As String
        dir = FileSystemTools.GetAbsolutePathName(Environ$("TEMP"))
        Dim aPath As String, bPath As String
        aPath = FileSystemTools.BuildPath(dir, "collide_a.tmp")
        bPath = FileSystemTools.BuildPath(dir, "collide_b.tmp")

        QuietKill aPath: QuietKill bPath
        Dim fn As Integer
        fn = FreeFile: Open aPath For Output As #fn: Close #fn
        fn = FreeFile: Open bPath For Output As #fn: Close #fn

        Dim errNo As Long
        On Error Resume Next
        FileSystemTools.Rename aPath, "collide_b.tmp"   ' target already exists
        errNo = Err.Number
        On Error GoTo 0

        QuietKill aPath: QuietKill bPath
        Assert.Permissive.AreEqual 58, errNo, "A real name collision should raise error 58"
    End Sub
    
    Public Sub Probe_CaseOnlyMove()
        Dim d As String
        d = Environ$("TEMP")
        Dim lo As String, up As String
        lo = d & "\probe_case.tmp"
        up = d & "\PROBE_CASE.TMP"

        On Error Resume Next
        Kill lo: Kill up
        On Error GoTo 0

        Dim fn As Integer
        fn = FreeFile
        Open lo For Output As #fn
        Close #fn

        Debug.Print "before: " ; MoveFileExW(StrPtr(lo), StrPtr(up), 0), Err.LastDllError
    End Sub
    
    Public Sub Test_FSO_NameCaching()
        Dim fso As New FileSystemObject
        Dim wf As String: wf = fso.BuildPath(Environ$("TEMP"), "fsocache")
        On Error Resume Next: fso.DeleteFolder wf, True: On Error GoTo 0
        fso.CreateFolder wf

        Dim p As String: p = fso.BuildPath(wf, "cachetest.txt")
        fso.CreateTextFile(p).Close

        ' Grab a File object, read .Name once to force any lazy load
        Dim f As File
        Set f = fso.GetFile(p)
        Dim before As String: before = f.Name          ' "cachetest.txt"

        ' Rename on disk, OUT-OF-BAND (via a different call, not through f)
        Name p As fso.BuildPath(wf, "CACHETEST.TXT")   ' case-only, same file

        ' Re-read .Name on the SAME object. Does it see the new casing?
        Dim after As String: after = f.Name

        Debug.Print "before      : " ; before
        Debug.Print "after       : " ; after
        Debug.Print "Dir (truth) : " ; Dir$(fso.BuildPath(wf, "cachetest.txt"))
        Debug.Print "-> " ; IIf(StrComp(after, "CACHETEST.TXT", vbBinaryCompare) = 0, _
                              "LIVE (re-reads disk)", "CACHED (snapshot at GetFile)")
        fso.DeleteFile p

        fso.DeleteFolder wf, True
    End Sub
    
    Sub test_illegal()
