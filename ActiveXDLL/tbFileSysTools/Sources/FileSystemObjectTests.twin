        fso.StringToTextFile "hi", ".\test_illegal\legal.txt"
        'fso1.MoveFile ".\test_illegal\legal.txt", ".\test_illegal\illegal|.txt" '<-throws error 52 - Bad file name or number
        fso.MoveFile ".\test_illegal\legal.txt", ".\test_illegal\illegal.txt" '<-throws error 52 - Bad file name or number
        Debug.Print fso.FileExists(".\test_illegal\illegal|.txt")
        'Debug.Print fso1.FileExists(".\test_illegal\h<.txt")
        fso.DeleteFolder ".\test_illegal"
    End Sub
    
    '----------------------------------------------------------------------
    ' Oracle: do our "bad name" error numbers match Scripting.FSO's?
    ' Real FSO is the oracle. Each probe runs the SAME op on both implementations
    ' and compares Err.Number (0 = the op unexpectedly SUCCEEDED). Because some
    ' inputs may succeed in one impl, every probe cleans up any artifact it made.
    '----------------------------------------------------------------------
    Public Sub Test_BadNameErrorsVsScriptingFSO()
        Dim ours As New FileSystemObject
        Dim ref As New Scripting.FileSystemObject
        Dim wf As String: wf = CleanFolder("badname_oracle")

        ' Each case: a leaf name to attempt under wf. We compare CreateFolder
        ' behavior (a create-only op that surfaces name validation directly).
        ' Add/remove cases freely; the pipe char is the canonical "52" trigger.
        Dim cases() As String
        cases = Array( _
            "bad|pipe", _
            "bad<lt", _
            "bad>gt", _
            "bad" & Chr$(34) & "quote", _
            "bad:colon", _
            "bad?q", _
            "bad*star", _
            "CON", _
            "PRN", _
            "trailingdot.", _
            "trailingspace ")

        Dim i As Long
        For i = LBound(cases) To UBound(cases)
            Dim leaf As String: leaf = cases(i)
            Dim eOurs As Long, eRef As Long

            eOurs = ErrOf_CreateFolder(ours, ours.BuildPath(wf, leaf))
            CleanupFolderQuiet ours, ours.BuildPath(wf, leaf)     ' remove if it got made

            eRef = ErrOf_CreateFolder(ref, JoinPathRef(wf, leaf))
            CleanupFolderQuiet ours, ours.BuildPath(wf, leaf)     ' ref may have made it too

            Debug.Print "CreateFolder [" ; leaf ; "]  ours=" ; eOurs ; " scripting=" ; eRef

            ' The real assertion: we match FSO's number (including 0 == both succeed).
            Assert.Strict.AreEqual eRef, eOurs
        Next

        ours.DeleteFolder wf, True
    End Sub

    ' Run CreateFolder, capture Err.Number (0 if it succeeded). Late-bound so the
    ' SAME wrapper drives both your FSO and Scripting.FSO.
    'Private Function ErrOf_CreateFolder(ByVal fso As Object, ByVal path As String) As Long
    '    On Error Resume Next
    '    fso.CreateFolder path
    '    ErrOf_CreateFolder = Err.Number
    '    On Error GoTo 0
    'End Function

    ' Best-effort remove; never throws, never asserts. Uses OUR fso for both,
    ' since a real path made by either impl is the same path on disk.
    Private Sub CleanupFolderQuiet(ByVal fso As Object, ByVal path As String)
        On Error Resume Next
        fso.DeleteFolder path, True
        On Error GoTo 0
    End Sub

    ' Scripting.FSO's BuildPath is available too, but to keep the compared INPUT
    ' identical we build the ref path the same way our BuildPath would, by hand.
    Private Function JoinPathRef(ByVal folder As String, ByVal leaf As String) As String
        If Right$(folder, 1) = "\" Then
            JoinPathRef = folder & leaf
        Else
            JoinPathRef = folder & "\" & leaf
        End If
    End Function
    
    ' Returns a fresh, empty working folder under TEMP for a test to use as its
    ' sandbox. Removes any leftover from a previous run so tests are repeatable.
    ' Takes no fso dependency (standalone), building its own.
    Private Function CleanFolder(ByVal label As String) As String
        Dim fso As New FileSystemObject
        Dim base As String
        base = fso.BuildPath(fso.GetSpecialFolder(TemporaryFolder), "tbFileworks_tests")
        Dim path As String
        path = fso.BuildPath(base, label)

        On Error Resume Next
        fso.DeleteFolder path, True          ' wipe any prior run (ignore if absent)
        On Error GoTo 0

        If Not fso.FolderExists(base) Then fso.CreateFolder base, createIntermediates:=True   ' ensure the parent exists
        On Error Resume Next
        fso.CreateFolder base                ' harmless if it already existed
        On Error GoTo 0
        fso.CreateFolder path                ' fresh empty sandbox
        CleanFolder = fso.GetAbsolutePathName(path)
    End Function
    
    Public Sub Probe_BadNameWin32Error()
        Dim base As String
        base = Environ$("TEMP")

        ' Build the paths by hand — do NOT route through GetAbsolutePathName,
        ' so we see the API's own error, not your resolver's transformation.
        Dim pipePath As String:  pipePath = base & "\bad|pipe"
        Dim colonPath As String: colonPath = base & "\bad:colon"
        Dim starPath As String:  starPath = base & "\bad*star"
        Dim goodPath As String:  goodPath = base & "\probe_ok_delete_me"

        Dim rc As Long

        ' --- pipe ---
        SetLastError 0
        rc = CreateDirectoryW(StrPtr(pipePath), ByVal vbNullPtr)
        Debug.Print "pipe   rc=" ; rc ; " LastDllError=" ; Err.LastDllError

        ' --- colon ---
        SetLastError 0
        rc = CreateDirectoryW(StrPtr(colonPath), ByVal vbNullPtr)
        Debug.Print "colon  rc=" ; rc ; " LastDllError=" ; Err.LastDllError

        ' --- star ---
        SetLastError 0
        rc = CreateDirectoryW(StrPtr(starPath), ByVal vbNullPtr)
        Debug.Print "star   rc=" ; rc ; " LastDllError=" ; Err.LastDllError

        ' --- control: a VALID name, should succeed (rc<>0, LastDllError=0) ---
        SetLastError 0
        rc = CreateDirectoryW(StrPtr(goodPath), ByVal vbNullPtr)
        Debug.Print "good   rc=" ; rc ; " LastDllError=" ; Err.LastDllError
        If rc <> 0 Then RemoveDirectoryW StrPtr(goodPath)   ' clean up the one that worked
    End Sub
    
    '----------------------------------------------------------------------
    ' Oracle: bad-NAME target parity across Move/Copy ops (not just CreateFolder).
    ' Each op needs a valid source, so we build one, attempt the op to a
    ' bad-named destination, compare Err.Number vs Scripting.FSO, then clean up.
    ' Reserved chars (| < > " ? *) should map to 52; ':' to 76 (per CreateFolder run).
    '----------------------------------------------------------------------
    Public Sub Test_BadNameTargetErrorsVsScriptingFSO()
        Dim ours As New FileSystemObject
        Dim ref As New Scripting.FileSystemObject
        Dim wf As String: wf = CleanFolder("badname_target_oracle")
        Dim bad() As String
        bad = Array("bad|pipe", "bad<lt", "bad>gt", "bad" & Chr$(34) & "q", _
                    "bad:colon", "bad?q", "bad*star")
        Dim i As Long, uid As Long
        For i = LBound(bad) To UBound(bad)
            Dim leaf As String: leaf = bad(i)
            uid = uid + 1: CompareOp ours, ref, wf, "MoveFile", leaf, uid
            uid = uid + 1: CompareOp ours, ref, wf, "CopyFile", leaf, uid
            uid = uid + 1: CompareOp ours, ref, wf, "MoveFolder", leaf, uid
            uid = uid + 1: CompareOp ours, ref, wf, "CopyFolder", leaf, uid
        Next
        ours.DeleteFolder wf, True
    End Sub

    ' Runs one op on both implementations with a freshly-built valid source and a
    ' bad-named destination, prints both error numbers, asserts they match.
    Private Sub CompareOp(ByVal ours As Object, ByVal ref As Object, ByVal wf As String, _
                          ByVal op As String, ByVal badLeaf As String, ByVal uid As Long)
        ' Unique per call — uid guarantees no collision even when SafeTag collapses
        ' two different bad leaves to the same stripped string.
        Dim tag As String: tag = op & "_" & CStr(uid)
        Dim cell As String: cell = ours.BuildPath(wf, tag)
        ours.CreateFolder cell

        Dim badDest As String: badDest = ours.BuildPath(cell, badLeaf)

        Dim eOurs As Long, eRef As Long
        eOurs = RunOp(ours, op, cell, badDest)
        CleanupQuiet ours, badDest            ' remove artifact if the op somehow created one
        eRef = RunOp(ref, op, cell, badDest)
        CleanupQuiet ours, badDest

        Debug.Print PadRight(op, 11) ; " [" ; badLeaf ; "]  ours=" ; eOurs ; " scripting=" ; eRef
        Assert.Strict.AreEqual eRef, eOurs
    End Sub

    ' Builds a valid source inside 'cell', then runs op source -> badDest.
    ' Returns Err.Number (0 = op unexpectedly succeeded). Late-bound so ONE
    ' function drives both your FSO and Scripting.FSO.
    Private Function RunOp(ByVal fso As Object, ByVal op As String, _
                           ByVal cell As String, ByVal badDest As String) As Long
        On Error Resume Next
        Select Case op
            Case "MoveFile", "CopyFile"
                Dim fSrc As String: fSrc = fso.BuildPath(cell, "src.txt")
                If Not fso.FileExists(fSrc) Then fso.CreateTextFile(fSrc).Close
                If op = "MoveFile" Then
                    fso.MoveFile fSrc, badDest
                Else
                    fso.CopyFile fSrc, badDest
                End If

            Case "MoveFolder", "CopyFolder"
                Dim dSrc As String: dSrc = fso.BuildPath(cell, "srcdir")
                If Not fso.FolderExists(dSrc) Then fso.CreateFolder dSrc
                If op = "MoveFolder" Then
                    fso.MoveFolder dSrc, badDest
                Else
                    fso.CopyFolder dSrc, badDest
                End If
        End Select
        RunOp = Err.Number
        On Error GoTo 0
    End Function

    Private Sub CleanupQuiet(ByVal fso As Object, ByVal path As String)
        On Error Resume Next
        fso.DeleteFile path, True
        fso.DeleteFolder path, True
        On Error GoTo 0
    End Sub

    ' Turn a bad leaf into something usable as a folder name for the sandbox tag
    ' (strip the very illegal chars we're testing so the sandbox itself is valid).
    Private Function SafeTag(ByVal s As String) As String
        Dim r As String, i As Long, ch As String
        For i = 1 To Len(s)
            ch = Mid$(s, i, 1)
            If InStr("|<>""" & ":?*", ch) = 0 Then r = r & ch
        Next
        SafeTag = r
    End Function

    Private Function PadRight(ByVal s As String, ByVal n As Long) As String
        If Len(s) >= n Then PadRight = s Else PadRight = s & Space$(n - Len(s))
    End Function
    
    '----------------------------------------------------------------------
    ' Destination wildcards are rejected with error 5 (FSO parity), independent
    ' of whether the source has wildcards. Does not depend on Scripting.FSO.
    '----------------------------------------------------------------------
    Public Sub Test_DestWildcardRejected()
        Dim fso As New FileSystemObject
        Dim wf As String: wf = CleanFolder("destwild")
        Dim e As Long

        ' Valid sources to attempt moving/copying to a wildcard destination.
        Dim fSrc As String: fSrc = fso.BuildPath(wf, "src.txt")
        fso.CreateTextFile(fSrc).Close
        Dim dSrc As String: dSrc = fso.BuildPath(wf, "srcdir")
        fso.CreateFolder dSrc

        Dim starDest As String: starDest = fso.BuildPath(wf, "out*")
        Dim qDest As String: qDest = fso.BuildPath(wf, "out?")

        ' --- MoveFile ---
        On Error Resume Next
        fso.MoveFile fSrc, starDest
        e = Err.Number
        On Error GoTo 0
        Assert.Strict.AreEqual 5&, CLng(e)
        Assert.Exact.IsTrue fso.FileExists(fSrc)          ' source untouched

        ' --- CopyFile ---
        On Error Resume Next
        fso.CopyFile fSrc, qDest
        e = Err.Number
        On Error GoTo 0
        Assert.Strict.AreEqual 5&, CLng(e)

        ' --- MoveFolder ---
        On Error Resume Next
        fso.MoveFolder dSrc, starDest
        e = Err.Number
        On Error GoTo 0
        Assert.Strict.AreEqual 5&, CLng(e)
        Assert.Exact.IsTrue fso.FolderExists(dSrc)        ' source untouched

        ' --- CopyFolder ---
        On Error Resume Next
        fso.CopyFolder dSrc, qDest
        e = Err.Number
        On Error GoTo 0
        Assert.Strict.AreEqual 5&, CLng(e)

        ' --- Wildcards in BOTH source and dest -> still the DEST error (5), not
        '     source-walker processing. Guard order matters. ---
        On Error Resume Next
        fso.CopyFile fso.BuildPath(wf, "*.txt"), starDest
        e = Err.Number
        On Error GoTo 0
        Assert.Strict.AreEqual 5&, CLng(e)

        fso.DeleteFolder wf, True
    End Sub
    
    '----------------------------------------------------------------------
    ' Oracle/measurement: CreateFolder + text-file creators vs Scripting.FSO,
    ' for bad-char and wildcard NAMES. Prints both error numbers per case.
    ' Asserts parity for CreateFolder (already guarded). For the text creators
    ' it PRINTS but does not assert — run it to discover FSO's behavior, then
    ' decide whether to guard.
    '----------------------------------------------------------------------
    '----------------------------------------------------------------------
    ' Oracle/measurement: CreateFolder + all text writers vs Scripting.FSO,
    ' for bad-char and wildcard NAMES. CreateFolder is ASSERTED (guarded).
    ' The text writers are MEASURED (printed with MATCH/DIFFERS) — run to
    ' discover behavior before deciding whether each needs a guard.
    '
    ' NOTE: Scripting.FSO has no StringToTextFile/ArrayToTextFile. For those
    ' rows the "oracle" is the KNOWN-GOOD target: bad chars should be 52,
    ' ':' should succeed (0) as an ADS write. We compare against those
    ' constants, not against ref. Rows are labeled so it's unambiguous.
    '----------------------------------------------------------------------
    '----------------------------------------------------------------------
    ' Oracle/measurement: CreateFolder + text creators/writers vs Scripting.FSO,
    ' for bad-char and wildcard NAMES.
    '
    ' Parity contract (all ASSERTED now):
    '   CreateFolder    : bad chars -> 52 ; ':' -> 76 ; wildcards -> 52 (name context)
    '   CreateTextFile  : bad chars -> 52 ; ':' -> 0  (direct write = valid ADS, matches FSO)
    '   StringToTextFile: bad chars -> 52 ; ':' -> 52 (temp-swap can't do ADS; Option A)
    '   ArrayToTextFile : same as StringToTextFile
    '----------------------------------------------------------------------
    Public Sub Test_CreateNameErrorsVsScriptingFSO()
        Dim ours As New FileSystemObject
        Dim ref As New Scripting.FileSystemObject
        Dim wf As String: wf = CleanFolder("createname_oracle")

        Dim bad() As String
        bad = Array("bad|pipe", "bad<lt", "bad*star", "bad?q", "bad:colon")

        Dim i As Long, uid As Long
        For i = LBound(bad) To UBound(bad)
            Dim leaf As String: leaf = bad(i)
            Dim isColon As Boolean: isColon = (InStr(leaf, ":") > 0)

            ' Direct-write path (CreateTextFile): colon is a valid ADS write -> 0.
            Dim expectDirect As Long: expectDirect = IIf(isColon, 0&, 52&)
            ' Temp-swap writers (String/ArrayToTextFile): colon rejected -> 52 (Option A).
            Dim expectWriter As Long: expectWriter = 52&

            ' --- CreateFolder: ASSERTED against real FSO ---
            uid = uid + 1
            Dim cfOurs As Long, cfRef As Long
            Dim cO As String: cO = ours.BuildPath(wf, "cf_o_" & uid)
            Dim cR As String: cR = ours.BuildPath(wf, "cf_r_" & uid)
            ours.CreateFolder cO: ours.CreateFolder cR
            cfOurs = ErrOf_CreateFolder(ours, ours.BuildPath(cO, leaf))
            CleanupQuiet ours, ours.BuildPath(cO, leaf)
            cfRef = ErrOf_CreateFolder(ref, ours.BuildPath(cR, leaf))
            CleanupQuiet ours, ours.BuildPath(cR, leaf)
            Debug.Print "CreateFolder    [" ; leaf ; "]  ours=" ; cfOurs ; " scripting=" ; cfRef ; _
                        IIf(cfOurs = cfRef, "   MATCH", "   <-- DIFFERS")
            Assert.Strict.AreEqual cfRef, cfOurs

            ' --- CreateTextFile: ASSERTED against real FSO (direct write) ---
            uid = uid + 1
            Dim ctOurs As Long, ctRef As Long
            Dim tO As String: tO = ours.BuildPath(wf, "ct_o_" & uid)
            Dim tR As String: tR = ours.BuildPath(wf, "ct_r_" & uid)
            ours.CreateFolder tO: ours.CreateFolder tR
            ctOurs = ErrOf_CreateTextFile(ours, ours.BuildPath(tO, leaf))
            CleanupQuiet ours, ours.BuildPath(tO, leaf)
            ctRef = ErrOf_CreateTextFile(ref, ours.BuildPath(tR, leaf))
            CleanupQuiet ours, ours.BuildPath(tR, leaf)
            Debug.Print "CreateTextFile  [" ; leaf ; "]  ours=" ; ctOurs ; " scripting=" ; ctRef ; _
                        IIf(ctOurs = ctRef, "   MATCH", "   <-- DIFFERS")
            Assert.Strict.AreEqual ctRef, ctOurs
            ' Also confirm it matches the intended direct-write contract.
            Assert.Strict.AreEqual expectDirect, ctOurs

            ' --- StringToTextFile: ASSERTED against Option A contract (no ref equiv) ---
            uid = uid + 1
            Dim stOurs As Long
            Dim sO As String: sO = ours.BuildPath(wf, "st_o_" & uid)
            ours.CreateFolder sO
            stOurs = ErrOf_StringToTextFile(ours, ours.BuildPath(sO, leaf))
            CleanupQuiet ours, ours.BuildPath(sO, leaf)
            Debug.Print "StringToTextFile[" ; leaf ; "]  ours=" ; stOurs ; " expect=" ; expectWriter ; _
                        IIf(stOurs = expectWriter, "   MATCH", "   <-- DIFFERS")
            Assert.Strict.AreEqual expectWriter, stOurs

            ' --- ArrayToTextFile: ASSERTED against Option A contract ---
            uid = uid + 1
            Dim atOurs As Long
            Dim aO As String: aO = ours.BuildPath(wf, "at_o_" & uid)
            ours.CreateFolder aO
            atOurs = ErrOf_ArrayToTextFile(ours, ours.BuildPath(aO, leaf))
            CleanupQuiet ours, ours.BuildPath(aO, leaf)
            Debug.Print "ArrayToTextFile [" ; leaf ; "]  ours=" ; atOurs ; " expect=" ; expectWriter ; _
                        IIf(atOurs = expectWriter, "   MATCH", "   <-- DIFFERS")
            Assert.Strict.AreEqual expectWriter, atOurs

            Debug.Print "----"
        Next

        ours.DeleteFolder wf, True
    End Sub

    Private Function ErrOf_CreateFolder(ByVal fso As Object, ByVal path As String) As Long
        On Error Resume Next
        fso.CreateFolder path
        ErrOf_CreateFolder = Err.Number
        On Error GoTo 0
    End Function

    Private Function ErrOf_CreateTextFile(ByVal fso As Object, ByVal path As String) As Long
        Dim ts As Object
        On Error Resume Next
        Set ts = fso.CreateTextFile(path)
        ErrOf_CreateTextFile = Err.Number
        If Not ts Is Nothing Then ts.Close
        On Error GoTo 0
    End Function

    ' Ours-only (Scripting.FSO has no equivalent): typed FileSystemObject.
    Private Function ErrOf_StringToTextFile(ByVal fso As FileSystemObject, ByVal path As String) As Long
        On Error Resume Next
        fso.StringToTextFile "probe", path, encUtf8
        ErrOf_StringToTextFile = Err.Number
        On Error GoTo 0
    End Function

    Private Function ErrOf_ArrayToTextFile(ByVal fso As FileSystemObject, ByVal path As String) As Long
        Dim lines(0 To 1) As String
        lines(0) = "a": lines(1) = "b"
        On Error Resume Next
        fso.ArrayToTextFile lines, path, encUtf8, nlWindows
        ErrOf_ArrayToTextFile = Err.Number
        On Error GoTo 0
    End Function
    
End Module

' ==========================================================================
' LargeFileProbe
'
' Answers one question: does tB's INTERNAL file position for a positionless
' Binary Put/Get run past 2^31 bytes, even though LOF() and Seek() surface as
' Long?
'
' Why it matters: both TextStream's fresh-write path (FlushWriteChunk -> Put with
' no position arg) and its read path (FillSome -> Get with no position arg) are
' purely sequential. Neither ever seeks after the initial BOM skip. So if the
' underlying position counter is 64-bit, both are already unbounded and only the
' SIZING calls (LOF) need fixing. If it is 32-bit, no amount of widening our own
' types helps and the file I/O has to move to raw Win32 handles.
'
' Phase A tests raw VB Binary I/O with no TextStream involved - that is the real
' experiment. Phase B then confirms TextStream inherits the answer.
'
' Verification uses FileSystemTools.GetFile().Size (LongLong, via StatPath ->
' GetFileAttributesExW), NOT LOF - the whole point is that LOF cannot be trusted
' here. Comparing the two is itself informative, so both are reported.
'
' NOTE: Seek() is Long in tB, so we CANNOT random-access past 2GB to spot-check
' content. Verification is therefore (1) exact on-disk size, and (2) a sequential
' read-back in Phase C. That limitation is itself a finding: nothing in the
' library may rely on a large Seek.
'
' Run RunAll. Needs ~5 GB free (Phase A file + Phase B file).
' ==========================================================================

Module LargeFileProbe
    Option Explicit

    ' Target just over 2 GB. 2^31 = 2,147,483,648. We overshoot by ~250 MB so a
    ' wrap/truncation at the boundary is unmistakable rather than borderline.
    Private Const TARGET_BYTES As LongLong = 2400000000^
    'Private Const TARGET_BYTES As LongLong = 4500000000^   ' > 2^32 (4,294,967,296)

    Private Const BLOCK_SIZE As Long = 65536          ' matches TextStream.STREAM_CHUNK
    Private Const LINE_LEN As Long = 64               ' bytes per line INCLUDING CRLF
    Private Const LINES_PER_BLOCK As Long = BLOCK_SIZE \ LINE_LEN    ' 1024

    ' Set these to a volume with room to spare.
    Private Const RAW_PATH As String = "C:\Users\waite\AppData\Local\Temp\_probe_raw.bin"
    Private Const TS_PATH  As String = "C:\Users\waite\AppData\Local\Temp\_probe_textstream.txt"

    '======================================================================
    Public Sub RunAll()
        Debug.Print "=== LargeFileProbe ==="
        Debug.Print "Target: " & TARGET_BYTES & " bytes (2^31 = 2147483648)"

        If Not CheckFreeSpace(RAW_PATH, TARGET_BYTES * 2) Then Exit Sub

        PhaseA_RawBinaryPut
        PhaseB_TextStreamWrite
        PhaseC_SequentialReadBack
    End Sub
    
    Public Sub TestSizeFromHL()
        ' high/low are the two halves of a Win32 file size. 'low' arrives in a SIGNED
        ' Long, so any value with bit 31 set comes through negative - that is what the
        ' +2^32 correction fixes. These four cases cover both branches, both signs.
        CheckSize 0, 0, 0^, "empty"
        CheckSize 0, 1000, 1000^, "tiny"
        CheckSize 0, &H7FFFFFFF, 2147483647^, "2^31-1 (low dword, positive)"
        CheckSize 0, &H80000000, 2147483648^, "2^31   (low dword goes NEGATIVE)"
        CheckSize 0, &HFFFFFFFF, 4294967295^, "2^32-1 (max low dword)"
        CheckSize 1, 0, 4294967296^, "2^32   (high dword = 1) <-- NEVER RUN"
        CheckSize 1, &H2FAF080, 4344967296^, "~4.34GB (high=1, low=50,000,000)"
        CheckSize64 4500000000^, "4.5GB"
        CheckSize 2, 0, 8589934592^, "8GB"
    End Sub
    
    Private Sub CheckSize64(ByVal want As LongLong, ByVal name As String)
        ' Split the target the way Win32 does, then reassemble it. Round-trip test:
        ' no hand-computed hex to get wrong.
        Dim hi As Long, lo As Long
        hi = CLng(want >> 32)
        lo = CLng(want And 4294967295^)      ' may come out negative - that IS the point
        Dim got As LongLong
        got = Shared.SizeFromHL(hi, lo)
        If got = want Then
            Debug.Print "  PASS  " & name & "  = " & got
        Else
            Debug.Print "  FAIL  " & name & "  want " & want & "  got " & got
        End If
    End Sub

    Private Sub CheckSize(ByVal hi As Long, ByVal lo As Long, _
                          ByVal want As LongLong, ByVal name As String)
        Dim got As LongLong
        got = Shared.SizeFromHL(hi, lo)
        If got = want Then
            Debug.Print "  PASS  " & name & "  = " & got
        Else
            Debug.Print "  FAIL  " & name & "  want " & want & "  got " & got
        End If
    End Sub
    

    '======================================================================
    ' Phase A - the actual experiment: raw Binary Put, positionless, past 2GB.
    '======================================================================
    Public Sub PhaseA_RawBinaryPut()
        Debug.Print vbCrLf & "--- Phase A: raw Binary Put ---"

        Dim block() As Byte
        Dim fn As Long
        Dim written As LongLong
        Dim blockNo As Long
        Dim t0 As Double
        Dim lineNo As LongLong

        On Error GoTo Failed
        FileSystemTools.DeleteFile RAW_PATH, True, True     ' force, ignoreMissing

        t0 = Timer
        fn = FreeFile()
        Open RAW_PATH For Binary Access Write As #fn

        lineNo = 1
        Do While written < TARGET_BYTES
            block = BuildBlock(lineNo)                      ' advances lineNo by LINES_PER_BLOCK
            lineNo = lineNo + LINES_PER_BLOCK

            Put #fn,, block                                ' POSITIONLESS - the thing under test
            written = written + BLOCK_SIZE
            blockNo = blockNo + 1

            ' Progress + an early warning right at the boundary, so a failure is
            ' obvious in seconds rather than after the whole run.
            If (blockNo Mod 4096) = 0 Then
                Debug.Print "  " & Format$(written / 1073741824#, "0.00") & " GB written" & _
                            "   (LOF says " & LOF(fn) & ")"
            End If
        Loop

        Close #fn
        fn = 0

        Report "Phase A", RAW_PATH, written, Timer - t0
        Exit Sub

    Failed:
        Debug.Print "  *** FAILED at block " & blockNo & _
                    " (~" & Format$(written / 1073741824#, "0.00") & " GB): " & _
                    Err.Number & " - " & Err.Description
        Debug.Print "  => Positionless Put is 32-bit bound. Raw Win32 handles required."
        If fn <> 0 Then Close #fn
    End Sub

    '======================================================================
    ' Phase B - does TextStream's fresh-write path inherit the answer?
    ' Uses Write (not WriteLine) with pre-built 64KB blocks: WriteLine per 64-byte
    ' line would call AdvancePosition ~37M times, which allocates a Byte() per call.
    '======================================================================
    Public Sub PhaseB_TextStreamWrite()
        Debug.Print vbCrLf & "--- Phase B: TextStream fresh write (UTF-8, no BOM) ---"

        Dim ts As TextStream
        Dim written As LongLong
        Dim blockNo As Long
        Dim lineNo As LongLong
        Dim t0 As Double

        On Error GoTo Failed
        FileSystemTools.DeleteFile TS_PATH, True, True

        t0 = Timer
        Set ts = FileSystemTools.CreateTextFile(TS_PATH, True, encUtf8, nlWindows)
        Debug.Print "  IsStreaming = " & ts.IsStreaming & _
                    "   (must be True, or this is testing the buffered path instead)"

        lineNo = 1
        Do While written < TARGET_BYTES
            ' ASCII only, so 1 char = 1 UTF-8 byte and the arithmetic stays exact.
            ts.Write BuildBlockText(lineNo)
            lineNo = lineNo + LINES_PER_BLOCK
            written = written + BLOCK_SIZE
            blockNo = blockNo + 1
            If (blockNo Mod 4096) = 0 Then _
                Debug.Print "  " & Format$(written / 1073741824#, "0.00") & " GB written"
        Loop

        ts.Close
        Set ts = Nothing

        Report "Phase B", TS_PATH, written, Timer - t0
        Exit Sub

    Failed:
        Debug.Print "  *** FAILED at block " & blockNo & _
                    " (~" & Format$(written / 1073741824#, "0.00") & " GB): " & _
                    Err.Number & " - " & Err.Description
        On Error Resume Next
        If Not ts Is Nothing Then ts.Close
    End Sub
    
    '======================================================================
    ' Phase C - sequential read-back. Only meaningful if A/B produced a correct
    ' size. Deliberately raw Get, positionless: same question, other direction.
    ' Verifies the line counter at the START of each block, which is what proves
    ' nothing was silently dropped or duplicated across the 2GB mark.
    '======================================================================
    Public Sub PhaseC_SequentialReadBack()
        Debug.Print vbCrLf & "--- Phase C: raw Binary Get, sequential read-back ---"

        Dim actual As LongLong
        actual = FileSystemTools.GetFile(RAW_PATH).Size
        If actual < TARGET_BYTES Then
            Debug.Print "  Skipped: Phase A file is only " & actual & " bytes."
            Exit Sub
        End If

        Dim fn As Long, block() As Byte, blockNo As Long
        Dim readBytes As LongLong, expectedLine As LongLong, gotLine As LongLong
        Dim bad As Long
        Dim t0 As Double

        On Error GoTo Failed
        t0 = Timer
        ReDim block(0 To BLOCK_SIZE - 1)
        fn = FreeFile()
        Open RAW_PATH For Binary Access Read As #fn

        expectedLine = 1
        Do While readBytes < actual - BLOCK_SIZE
            Get #fn,, block                                ' POSITIONLESS - the read-side test
            gotLine = LineNoFromBlock(block)
            If gotLine <> expectedLine Then
                bad = bad + 1
                If bad <= 5 Then _
                    Debug.Print "  MISMATCH at ~" & Format$(readBytes / 1073741824#, "0.00") & _
                                " GB: expected line " & expectedLine & ", got " & gotLine
            End If
            expectedLine = expectedLine + LINES_PER_BLOCK
            readBytes = readBytes + BLOCK_SIZE
            blockNo = blockNo + 1
        Loop

        Close #fn
        Debug.Print "  Read " & readBytes & " bytes in " & Format$(Timer - t0, "0.0") & "s"
        If bad = 0 Then
            Debug.Print "  PASS: every block landed where expected, including past 2GB."
        Else
            Debug.Print "  *** " & bad & " mismatched blocks - sequential Get is NOT position-safe past 2GB."
        End If
        Exit Sub

    Failed:
        Debug.Print "  *** FAILED at ~" & Format$(readBytes / 1073741824#, "0.00") & " GB: " & _
                    Err.Number & " - " & Err.Description
        If fn <> 0 Then Close #fn
    End Sub

    '======================================================================
    ' Helpers
    '======================================================================

    ' The verdict. The ONLY trustworthy size here is GetFile().Size (LongLong, via
    ' GetFileAttributesExW); LOF is printed purely to document how it misbehaves.
    Private Sub Report(ByVal phase As String, ByVal path As String, _
                       ByVal expected As LongLong, ByVal secs As Double)
        Dim actual As LongLong
        actual = FileSystemTools.GetFile(path).Size

        Debug.Print "  Elapsed:  " & Format$(secs, "0.0") & "s"
        Debug.Print "  Expected: " & expected
        Debug.Print "  On disk:  " & actual & "   (via GetFile.Size, 64-bit)"

        Dim fn As Long
        fn = FreeFile()
        Open path For Binary Access Read As #fn
        Debug.Print "  LOF says: " & LOF(fn) & "   (Long - expect this to be wrong)"
        Close #fn

        If actual = expected Then
            Debug.Print "  >>> " & phase & " PASS: positionless Put is 64-bit safe."
        Else
            Debug.Print "  >>> " & phase & " FAIL: short by " & (expected - actual) & " bytes."
        End If
    End Sub

    ' One 64KB block of fixed-width lines: 8-digit line number, 54 'x', CRLF = 64
    ' bytes. Fixed width means byte offset N maps to a known line, which is what
    ' makes Phase C able to prove nothing shifted.
    Private Function BuildBlockText(ByVal firstLine As LongLong) As String
        Dim sb() As String
        ReDim sb(0 To LINES_PER_BLOCK - 1)
        Dim i As Long
        For i = 0 To LINES_PER_BLOCK - 1
            sb(i) = Right$("00000000" & CStr(firstLine + i), 8) & String$(54, "x")
        Next
        BuildBlockText = Join(sb, vbCrLf) & vbCrLf       ' Join omits the final one
    End Function

    Private Function BuildBlock(ByVal firstLine As LongLong) As Byte()
        ' ASCII round-trips through the system code page unchanged, so this is an
        ' exact 1 char = 1 byte conversion.
        BuildBlock = TextCodec.EncodeBytes(BuildBlockText(firstLine), encUsAscii)
    End Function

    ' Reads the 8-digit counter from the first line of a block.
    Private Function LineNoFromBlock(ByRef block() As Byte) As LongLong
        Dim s As String, i As Long
        For i = 0 To 7
            s = s & Chr$(block(i))
        Next
        LineNoFromBlock = CLngLng(s)
    End Function

    Private Function CheckFreeSpace(ByVal path As String, ByVal needed As LongLong) As Boolean
        On Error GoTo NoInfo
        Dim dr As Drive
        Set dr = FileSystemTools.GetDrive(path)
        Debug.Print "Free space on " & dr.DriveLetter & ": " & _
                    Format$(dr.FreeSpace / 1073741824#, "0.0") & " GB (need ~" & _
                    Format$(needed / 1073741824#, "0.0") & " GB)"
        CheckFreeSpace = (dr.FreeSpace > needed)
        If Not CheckFreeSpace Then Debug.Print "*** Not enough free space - aborting."
        Exit Function
    NoInfo:
        Debug.Print "(Could not read free space; continuing anyway.)"
        CheckFreeSpace = True
    End Function

    Public Sub CleanUp()
        FileSystemTools.DeleteFile RAW_PATH, True, True
        FileSystemTools.DeleteFile TS_PATH, True, True
        Debug.Print "Probe files deleted."
    End Sub

End Module

' ==========================================================================
' SeekProbe
'
' One question: can tB's Seek position a Binary file past 2^31, given that LOF()
' demonstrably cannot report past it (verified: 2.4GB -> -1894907904)?
'
' This decides how OpenWriteAppend gets fixed. Today it does:
'       Seek #mFile, LOF(mFile) + 1
' which past 2GB seeks to a WRAPPED NEGATIVE offset. If Seek silently accepts
' that, we are overwriting an existing file from a garbage position - silent
' corruption, the worst failure mode in the library.
'
'   Probe 1 - can Seek POSITION past 2GB for a read, and land exactly right?
'   Probe 2 - can Seek POSITION past 2GB for a write (i.e. is append fixable)?
'   Probe 3 - what does the CURRENT buggy expression actually do? (read-only,
'             nothing is written - we are only asking whether Seek rejects it)
'
' Verification is exact, not approximate: LargeFileProbe wrote fixed 64-byte
' lines carrying an 8-digit counter, so byte offset 64*(N-1) MUST contain line N.
' A Seek that truncates will land on the wrong line and we will see it.
'
' PREREQ: run LargeFileProbe.PhaseA_RawBinaryPut first (leaves a ~2.4GB file).
' Probe 2 appends 64 bytes to that file; run Probe 1 before Probe 2, or re-create.
'
' NOTE: if `Seek #fn, <LongLong>` does not COMPILE, that is itself the answer -
' Seek's parameter is Long and Probes 1/2 cannot be written at all. Comment out
' the offending line and skip to Probe 3.
' ==========================================================================

Module SeekProbe
    Option Explicit

    Private Const RAW_PATH As String = "C:\_probe_raw.bin"   ' must match LargeFileProbe
    Private Const LINE_LEN As Long = 64

    Public Sub RunAll()
        Debug.Print "=== SeekProbe ==="
        Debug.Print "2^31 = 2147483648"
        'Probe1_SeekReadPast2GB
        'Probe2_SeekWritePast2GB
        Probe3_WhatTheCurrentCodeDoes
    End Sub

    '======================================================================
    ' Probe 1 - Seek to a >2GB offset and read. Does it land on the right line?
    '======================================================================
    Public Sub Probe1_SeekReadPast2GB()
        Debug.Print vbCrLf & "--- Probe 1: Seek + Get past 2GB ---"

        Dim size As LongLong
        size = FileSize(RAW_PATH)
        If size < 2200000000^ Then
            Debug.Print "  Skipped: " & RAW_PATH & " is only " & size & " bytes. Run LargeFileProbe first."
            Exit Sub
        End If

        ' Pick a line whose byte offset is comfortably past 2^31.
        Dim targetLine As LongLong, offset As LongLong
        targetLine = 35000000^                       ' offset = 64 * 34,999,999 = 2,239,999,936
        offset = LINE_LEN * (targetLine - 1)
        Debug.Print "  Seeking to byte " & offset & " (expecting line " & targetLine & ")"

        Dim fn As Long, buf() As Byte, got As LongLong
        On Error GoTo Failed
        ReDim buf(0 To LINE_LEN - 1)
        fn = FreeFile()
        Open RAW_PATH For Binary Access Read As #fn

        Seek #fn, CLng(offset + 1)                        ' Seek is 1-BASED
        Get #fn,, buf
        Close #fn
        fn = 0

        got = LineNoFromBuf(buf)
        Debug.Print "  Got line:  " & got
        If got = targetLine Then
            Debug.Print "  >>> PASS: Seek is 64-bit for reads and lands exactly."
        Else
            Debug.Print "  >>> FAIL: landed on the WRONG line - Seek truncated the offset."
            Debug.Print "      (offset mod 2^32 = " & (offset - 4294967296^) & ")"
        End If
        Exit Sub

    Failed:
        Debug.Print "  >>> Seek/Get RAISED: " & Err.Number & " - " & Err.Description
        Debug.Print "      Seek cannot express a >2GB offset. Append needs SetFilePointerEx."
        If fn <> 0 Then Close #fn
    End Sub

    '======================================================================
    ' Probe 2 - the one that decides OpenWriteAppend. Seek to true EOF (from
    ' StatPath, not LOF) and append. Size must grow by exactly LINE_LEN.
    '======================================================================
    Public Sub Probe2_SeekWritePast2GB()
        Debug.Print vbCrLf & "--- Probe 2: Seek + Put at >2GB EOF (the append fix) ---"

        Dim before As LongLong, after As LongLong
        before = FileSize(RAW_PATH)
        If before < 2200000000^ Then
            Debug.Print "  Skipped: file too small."
            Exit Sub
        End If
        Debug.Print "  Size before: " & before

        Dim fn As Long, marker() As Byte
        On Error GoTo Failed
        marker = TextCodec.EncodeBytes("ZZZZZZZZ" & String$(54, "z"), encUsAscii)   ' 62 bytes
        marker = TextCodec.ConcatBytes(marker, TextCodec.EncodeBytes(vbCrLf, encUsAscii))  ' -> 64

        fn = FreeFile()
        Open RAW_PATH For Binary Access Write As #fn
        Seek #fn, CLng(before + 1)                         ' true EOF, 64-bit - NOT LOF(fn)+1
        Put #fn,, marker
        Close #fn
        fn = 0

        after = FileSize(RAW_PATH)
        Debug.Print "  Size after:  " & after & "   (delta " & (after - before) & ", want 64)"

        If after = before + LINE_LEN Then
            Debug.Print "  >>> PASS: append past 2GB works. OpenWriteAppend fix is a one-liner:"
            Debug.Print "      replace LOF(mFile)+1 with the StatPath size + 1."
        ElseIf after < before Then
            Debug.Print "  >>> CATASTROPHIC: file SHRANK - the seek landed inside the file and truncated."
        Else
            Debug.Print "  >>> FAIL: unexpected size. The seek did not land at EOF."
        End If
        Exit Sub

    Failed:
        Debug.Print "  >>> Seek/Put RAISED: " & Err.Number & " - " & Err.Description
        Debug.Print "      Append past 2GB is impossible via VB file I/O."
        Debug.Print "      OpenWriteAppend must move to CreateFileW + SetFilePointerEx + WriteFile,"
        Debug.Print "      OR guard and raise when the target file exceeds 2GB."
        If fn <> 0 Then Close #fn
    End Sub

    '======================================================================
    ' Probe 3 - what OpenWriteAppend does TODAY. Read-only: we seek but never
    ' write, so nothing can be corrupted. We only want to know whether Seek
    ' REJECTS the wrapped-negative offset (safe-ish: it would raise) or ACCEPTS
    ' it (dangerous: a Put would then overwrite live data).
    '======================================================================
    Public Sub Probe3_WhatTheCurrentCodeDoes()
        Debug.Print vbCrLf & "--- Probe 3: the current LOF(mFile)+1 expression ---"

        Dim fn As Long, badOffset As Long
        On Error GoTo SeekRejected
        fn = FreeFile()
        Open RAW_PATH For Binary Access Read As #fn      ' READ mode: cannot corrupt

        badOffset = LOF(fn)                              ' wraps negative past 2GB
        Debug.Print "  LOF(fn)       = " & badOffset
        Debug.Print "  LOF(fn) + 1   = " & (badOffset + 1) & "   <- what OpenWriteAppend seeks to"

        Seek #fn, badOffset + 1
        Debug.Print "  Seek ACCEPTED it. Position is now " & Seek(fn) & "."
        Debug.Print "  >>> CONFIRMED HAZARD: in Write mode a Put here would overwrite live"
        Debug.Print "      file data at a garbage offset. Silent corruption. Guard required."
        Close #fn
        Exit Sub

    SeekRejected:
        Debug.Print "  Seek REJECTED it: " & Err.Number & " - " & Err.Description
        Debug.Print "  >>> Append to a >2GB file fails loudly today rather than corrupting."
        Debug.Print "      Still worth a clear guard, but it is not a data-loss bug."
        If fn <> 0 Then Close #fn
    End Sub

    '======================================================================
    ' Helpers
    '======================================================================

    ' 64-bit size via StatPath. LOF is exactly what we cannot trust here.
    Private Function FileSize(ByVal path As String) As LongLong
        Dim attrs As Long, size As LongLong
        Dim cr As Date, mo As Date, ac As Date, leaf As String
        If Not FileSystemTools.FileExists(path) Then Exit Function
        Shared.StatPath path, attrs, size, cr, mo, ac, leaf
        FileSize = size
    End Function

    Private Function LineNoFromBuf(ByRef b() As Byte) As LongLong
        Dim s As String, i As Long
        For i = 0 To 7
            s = s & Chr$(b(i))
        Next
        On Error Resume Next                    ' a wrong landing may not be digits at all
        LineNoFromBuf = CLngLng(s)
        If Err.Number <> 0 Then
            Debug.Print "    (first 8 bytes are not a counter: '" & s & "')"
            LineNoFromBuf = -1
        End If
    End Function

End Module

' ==========================================================================
' AdvancePositionTests
'
' Verifies TextStream's Line/Column bookkeeping after AdvancePosition was
' rewritten from a per-code-unit loop to native InStr/InStrRev scans (a 3.1x
' speedup - see LargeFileProbe Phase B). The rewrite must be behaviourally
' IDENTICAL; this is the regression net.
'
' AdvancePosition is Private, so it is exercised through the public surface:
' Write() passes the string straight to it, and Line/Column report the outcome.
' A fresh stream per case, because the counters accumulate.
'
' The cases that matter are the ones where CR/LF interact:
'   * CRLF must count as ONE break, not two   (the subtraction in the new code)
'   * a lone CR must count as a break          (Mac-style line endings)
'   * LF-then-CR is TWO breaks, not a reversed CRLF
'   * Column resets to whatever follows the LAST break, wherever that is
'   * with no break at all, Column simply advances by Len()
'   * counting is in UTF-16 CODE UNITS, so a surrogate pair is two columns
'
' Every expectation below was derived from the ORIGINAL per-unit loop, not from
' the new implementation - otherwise the test would just be confirming itself.
'
' Run RunAll. Expect: 14 passed, 0 failed.
' ==========================================================================

Module AdvancePositionTests
    Option Explicit

    Private mPassed As Long
    Private mFailed As Long

    Public Sub RunAll()
        mPassed = 0
        mFailed = 0
        Debug.Print "=== AdvancePosition regression tests ==="
        Debug.Print "(start state for every case: Line 1, Column 1)" & vbCrLf

        WriteCases
        ReadCases

        Debug.Print vbCrLf & "=== " & mPassed & " passed, " & mFailed & " failed ==="
        If mFailed > 0 Then Debug.Print "*** AdvancePosition has REGRESSED."
    End Sub

    '======================================================================
    ' Write path - Write() hands the string directly to AdvancePosition.
    '======================================================================
    Private Sub WriteCases()
        Debug.Print "--- Write path ---"

        ' --- The six core cases ---
        CheckWrite "trailing CRLF", "a" & vbCrLf, 2, 1
        CheckWrite "trailing lone CR", "a" & vbCr, 2, 1
        CheckWrite "LF mid-string", "a" & vbLf & "bc", 2, 3
        CheckWrite "two CRLFs", vbCrLf & vbCrLf, 3, 1
        CheckWrite "LF then lone CR", vbLf & vbCr, 3, 1
        CheckWrite "no break at all", "abc", 1, 4

        ' --- Reinforcements around the same seams ---
        CheckWrite "empty string", "", 1, 1
        CheckWrite "bare LF", vbLf, 2, 1
        CheckWrite "bare CR", vbCr, 2, 1

        ' Mixed endings in one buffer: LF then a LONE CR (not a CRLF), then text.
        ' The last break is the CR at position 4, so Column = (6 - 4) + 1 = 3.
        CheckWrite "LF, lone CR, text", "ab" & vbLf & vbCr & "cd", 3, 3

        ' CRLF early, lone CR at the very end: 2 breaks, Column back to 1.
        CheckWrite "CRLF then trailing CR", "a" & vbCrLf & "b" & vbCr, 3, 1

        ' Counting is per UTF-16 CODE UNIT, so one astral character (U+1F600,
        ' a surrogate pair) advances the column by TWO. This is what the old
        ' byte-walking loop did; the new Len()-based code must agree.
        CheckWrite "surrogate pair = 2 cols", ChrW$(&HD83D&) & ChrW$(&HDE00&), 1, 3

        ' KNOWN QUIRK, not a regression: a CRLF split across two Write calls is
        ' counted as TWO breaks, because AdvancePosition has no memory between
        ' calls. The OLD implementation did exactly the same. Pinned here so that
        ' if anyone ever "fixes" it, they do so deliberately.
        CheckWriteTwice "CRLF split across 2 writes (quirk)", vbCr, vbLf, 3, 1
    End Sub

    '======================================================================
    ' Read path - ReadLine feeds AdvancePosition the line PLUS its terminator,
    ' so the line counter must move even though the terminator is not returned.
    '======================================================================
    Private Sub ReadCases()
        Debug.Print vbCrLf & "--- Read path ---"

        ' Three lines, CRLF-terminated. After reading the first line, we should be
        ' on line 2 at column 1 - the terminator was consumed but not returned.
        Dim path As String
        path = TempFile()
        FileSystemTools.StringToTextFile "one" & vbCrLf & "two" & vbCrLf & "three", path, encUtf8

        Dim ts As TextStream
        Set ts = FileSystemTools.OpenTextFile(path, ForReading)
        Dim got As String
        got = ts.ReadLine()
        Check "ReadLine 1 content", (got = "one"), "one", got
        Check "ReadLine 1 -> Line", (ts.Line = 2), "2", CStr(ts.Line)
        Check "ReadLine 1 -> Column", (ts.Column = 1), "1", CStr(ts.Column)

        got = ts.ReadLine()
        Check "ReadLine 2 -> Line", (ts.Line = 3), "3", CStr(ts.Line)

        ' Final line has NO terminator: the line number must NOT advance, but the
        ' column must move across the content.
        got = ts.ReadLine()
        Check "ReadLine 3 content", (got = "three"), "three", got
        Check "unterminated last line -> Line", (ts.Line = 3), "3", CStr(ts.Line)
        Check "unterminated last line -> Column", (ts.Column = 6), "6", CStr(ts.Column)

        ts.Close
        FileSystemTools.DeleteFile path, True, True
    End Sub

    '======================================================================
    ' Harness
    '======================================================================

    ' Writes 'text' to a fresh stream and asserts the resulting Line/Column.
    Private Sub CheckWrite(ByVal name As String, ByVal text As String, _
                           ByVal wantLine As Long, ByVal wantCol As Long)
        Dim path As String, ts As TextStream
        path = TempFile()
        Set ts = FileSystemTools.CreateTextFile(path, True, encUtf8, nlWindows)
        ts.Write text
        Dim gotLine As Long, gotCol As Long
        gotLine = ts.Line
        gotCol = ts.Column
        ts.Close
        FileSystemTools.DeleteFile path, True, True

        Check name, (gotLine = wantLine And gotCol = wantCol), _
              "Line " & wantLine & ", Col " & wantCol, _
              "Line " & gotLine & ", Col " & gotCol
    End Sub

    ' Two separate Write calls - proves what happens when a break straddles them.
    Private Sub CheckWriteTwice(ByVal name As String, ByVal a As String, ByVal b As String, _
                                ByVal wantLine As Long, ByVal wantCol As Long)
        Dim path As String, ts As TextStream
        path = TempFile()
        Set ts = FileSystemTools.CreateTextFile(path, True, encUtf8, nlWindows)
        ts.Write a
        ts.Write b
        Dim gotLine As Long, gotCol As Long
        gotLine = ts.Line
        gotCol = ts.Column
        ts.Close
        FileSystemTools.DeleteFile path, True, True

        Check name, (gotLine = wantLine And gotCol = wantCol), _
              "Line " & wantLine & ", Col " & wantCol, _
              "Line " & gotLine & ", Col " & gotCol
    End Sub

    Private Sub Check(ByVal name As String, ByVal ok As Boolean, _
                      ByVal want As String, ByVal got As String)
        If ok Then
            mPassed = mPassed + 1
            Debug.Print "  PASS  " & name
        Else
            mFailed = mFailed + 1
            Debug.Print "  FAIL  " & name & "   want: " & want & "   got: " & got
        End If
    End Sub

    Private Function TempFile() As String
        Dim tmp As String
        tmp = FileSystemTools.GetSpecialFolder(TemporaryFolder)
        TempFile = FileSystemTools.BuildPath(tmp, FileSystemTools.GetTempName("aptest_", ".txt", tmp))
    End Function

End Module


' ==========================================================================
' AppendProbe (LargeFileProbe Phase D)
'
' Verifies the one claim the earlier phases could not: that TextStream's
' FILE_APPEND_DATA write path appends correctly to a >2GB file - the operation
' that VB file I/O could not perform at all (32-bit Seek -> bare E_FAIL).
'
' A size check alone is NOT sufficient here. The failure mode that matters is
' subtle: if the handle were opened with FILE_APPEND_DATA *OR'd with*
' GENERIC_WRITE, the append-at-EOF semantics would be lost and every write would
' land at position 0 - silently overwriting the head of the file. If you happened
' to write the same number of bytes you clobbered, the size would look perfect.
'
' So all three must hold:
'   1. HEAD INTACT  - the first bytes are byte-for-byte what they were
'   2. SIZE GREW    - by exactly the number of bytes we appended, no more, no less
'   3. TAIL CORRECT - the appended bytes are at the END, and are exactly what we
'                     wrote (no BOM re-emitted, no newline mangling)
'
' D1 runs against the 2.4GB file from LargeFileProbe Phase A (the real test).
' D2 is a fast small-file version of the same three checks - run it first, since
' a failure there means something basic is wrong and D1 will just waste minutes.
'
' PREREQ for D1: LargeFileProbe.PhaseA_RawBinaryPut has left its file in place.
'                D1 APPENDS to that file, so re-create it before re-running
'                LargeFileProbe (Phase C's block math assumes an unmodified file).
' ==========================================================================

Module AppendProbe
    Option Explicit

    Private Const RAW_PATH As String = "C:\Users\waite\AppData\Local\Temp\_probe_raw.bin"
    Private Const SMALL_PATH  As String = "C:\Users\waite\AppData\Local\Temp\_probe_append_small.txt"

    Private Const HEAD_CHECK_BYTES As Long = 4096              ' how much of the head we fingerprint
    Private Const LINE_LEN As Long = 64

    Private mPassed As Long
    Private mFailed As Long

    Public Sub RunAll()
        mPassed = 0
        mFailed = 0
        Debug.Print "=== Phase D: append via FILE_APPEND_DATA ==="

        PhaseD2_SmallFileAppend      ' fast sanity first
        PhaseD1_LargeFileAppend      ' the real test

        Debug.Print vbCrLf & "=== " & mPassed & " passed, " & mFailed & " failed ==="
        If mFailed > 0 Then Debug.Print "*** DO NOT SHIP - inspect before appending to anything you care about."
    End Sub

    '======================================================================
    ' D2 - small file. Same three checks, runs in milliseconds. If the access
    ' right is wrong, this catches it here rather than after a 2.4GB read.
    '======================================================================
    Public Sub PhaseD2_SmallFileAppend()
        Debug.Print vbCrLf & "--- D2: small-file append (sanity) ---"

        On Error GoTo Failed
        FileSystemTools.DeleteFile SMALL_PATH, True, True

        ' Seed a known file. UTF-8 + BOM on purpose: the append must NOT emit a
        ' second BOM into the middle of the stream.
        FileSystemTools.StringToTextFile "alpha" & vbCrLf & "beta" & vbCrLf, _
                                         SMALL_PATH, encUtf8Bom

        Dim before As LongLong, headBefore() As Byte
        before = FileSize(SMALL_PATH)
        FileSystemTools.ReadStream SMALL_PATH, headBefore, HEAD_CHECK_BYTES

        Dim marker As String
        marker = "gamma"

        Dim ts As TextStream
        Set ts = FileSystemTools.OpenTextFile(SMALL_PATH, ForAppending)
        Check "D2 IsStreaming", ts.IsStreaming, "True", CStr(ts.IsStreaming)
        Check "D2 encoding preserved (BOM)", (ts.Encoding = encUtf8Bom), _
              CStr(encUtf8Bom), CStr(ts.Encoding)
        ts.WriteLine marker
        ts.Close

        Dim after As LongLong, headAfter() As Byte
        after = FileSize(SMALL_PATH)
        FileSystemTools.ReadStream SMALL_PATH, headAfter, HEAD_CHECK_BYTES

        ' 1. head intact
        Check "D2 head unchanged", HeadMatches(headBefore, headAfter), _
              "identical", "DIFFERENT - the append overwrote the head!"

        ' 2. size grew by exactly the marker + CRLF (ASCII -> 1 byte per char), no BOM
        Dim wantDelta As LongLong
        wantDelta = Len(marker) + 2
        Check "D2 size delta", (after - before = wantDelta), _
              CStr(wantDelta), CStr(after - before)

        ' 3. content reads back whole and in order
        Dim all As String
        all = FileSystemTools.TextFileToString(SMALL_PATH)
        Check "D2 content", (all = "alpha" & vbCrLf & "beta" & vbCrLf & "gamma" & vbCrLf), _
              "alpha/beta/gamma", "[" & VBA.Replace$(all, vbCrLf, "\r\n") & "]"

        FileSystemTools.DeleteFile SMALL_PATH, True, True
        Exit Sub

    Failed:
        Fail "D2 raised " & Err.Number & " - " & Err.Description
        On Error Resume Next
        If Not ts Is Nothing Then ts.Close
    End Sub

    '======================================================================
    ' D1 - the 2.4GB file. This is the operation that was previously impossible.
    '======================================================================
    Public Sub PhaseD1_LargeFileAppend()
        Debug.Print vbCrLf & "--- D1: append to a >2GB file ---"

        Dim before As LongLong
        before = FileSize(RAW_PATH)
        If before < 2200000000^ Then
            Debug.Print "  Skipped: " & RAW_PATH & " is " & before & " bytes. Run LargeFileProbe Phase A first."
            Exit Sub
        End If
        Debug.Print "  Size before: " & before

        ' Fingerprint the head BEFORE touching anything. This is the check that
        ' catches a write landing at position 0.
        Dim headBefore() As Byte
        FileSystemTools.ReadStream RAW_PATH, headBefore, HEAD_CHECK_BYTES

        Dim marker As String
        marker = "APPENDED" & String$(54, "z")        ' 62 chars, +CRLF = 64: one more fixed-width line

        Dim ts As TextStream
        Dim t0 As Double
        On Error GoTo Failed
        t0 = Timer

        Set ts = FileSystemTools.OpenTextFile(RAW_PATH, ForAppending)
        Check "D1 IsStreaming", ts.IsStreaming, "True", CStr(ts.IsStreaming)
        ts.WriteLine marker
        ts.Close
        Set ts = Nothing

        Debug.Print "  Append took " & Format$(Timer - t0, "0.00") & "s" & _
                    "   (instant = it did not read the file to find the end)"

        ' --- 1. HEAD INTACT ---
        Dim headAfter() As Byte
        FileSystemTools.ReadStream RAW_PATH, headAfter, HEAD_CHECK_BYTES
        Check "D1 head unchanged", HeadMatches(headBefore, headAfter), _
              "identical", "DIFFERENT - writes landed at position 0, NOT at EOF!"

        ' --- 2. SIZE GREW BY EXACTLY 64 ---
        Dim after As LongLong
        after = FileSize(RAW_PATH)
        Debug.Print "  Size after:  " & after
        Check "D1 size delta", (after - before = LINE_LEN), _
              CStr(LINE_LEN), CStr(after - before)

        ' --- 3. TAIL IS OUR MARKER ---
        ' Seek cannot reach past 2GB, so read sequentially and keep the last block.
        Dim tail As String
        tail = ReadTail(RAW_PATH, after, LINE_LEN)
        Check "D1 tail is the appended line", (tail = marker & vbCrLf), _
              marker & "\r\n", "[" & VBA.Replace$(tail, vbCrLf, "\r\n") & "]"

        Debug.Print vbCrLf & "  NOTE: " & RAW_PATH & " now has one extra line. Re-create it"
        Debug.Print "        before re-running LargeFileProbe Phase C."
        Exit Sub

    Failed:
        Fail "D1 raised " & Err.Number & " - " & Err.Description
        On Error Resume Next
        If Not ts Is Nothing Then ts.Close
    End Sub

    '======================================================================
    ' Helpers
    '======================================================================

    ' Reads the last n bytes by streaming the whole file - the only option, since
    ' Seek is 32-bit and cannot position past 2GB. Cheap in practice: the file was
    ' just written, so it comes from the page cache.
    Private Function ReadTail(ByVal path As String, ByVal size As LongLong, ByVal n As Long) As String
        Const BLK As Long = 65536
        Dim fn As Long, buf() As Byte, keep() As Byte
        Dim readSoFar As LongLong, toRead As Long

        ReDim keep(0 To n - 1)
        fn = FreeFile()
        Open path For Binary Access Read As #fn

        Do While readSoFar < size
            toRead = BLK
            If (size - readSoFar) < BLK Then toRead = CLng(size - readSoFar)
            ReDim buf(0 To toRead - 1)
            Get #fn,, buf                       ' positionless: 64-bit safe (verified)
            readSoFar = readSoFar + toRead

            ' Keep a rolling copy of the last n bytes seen.
            If toRead >= n Then
                Dim i As Long
                For i = 0 To n - 1
                    keep(i) = buf(toRead - n + i)
                Next
            End If
        Loop
        Close #fn

        ReadTail = TextCodec.DecodeBytes(keep, encUsAscii, nlNoChange)
    End Function

    ' Compares the head fingerprints. Only the first Len(before) bytes are compared:
    ' on a file smaller than HEAD_CHECK_BYTES the "head" IS the whole file, so the
    ' after-image is legitimately LONGER. Comparing lengths would then report a
    ' clobbered head for every successful append.
    Private Function HeadMatches(ByRef before() As Byte, ByRef after() As Byte) As Boolean
        Dim n As Long, i As Long
        n = TextCodec.SafeCountB(before)
        If n = 0 Then HeadMatches = True: Exit Function
        If TextCodec.SafeCountB(after) < n Then Exit Function      ' file SHRANK - real failure
        For i = 0 To n - 1
            If after(LBound(after) + i) <> before(LBound(before) + i) Then Exit Function
        Next
        HeadMatches = True
    End Function

    ' 64-bit size. LOF is exactly what cannot be trusted here.
    Private Function FileSize(ByVal path As String) As LongLong
        Dim attrs As Long, size As LongLong
        Dim cr As Date, mo As Date, ac As Date, leaf As String
        If Not FileSystemTools.FileExists(path) Then Exit Function
        Shared.StatPath path, attrs, size, cr, mo, ac, leaf
        FileSize = size
    End Function

    Private Sub Check(ByVal name As String, ByVal ok As Boolean, _
                      ByVal want As String, ByVal got As String)
        If ok Then
            mPassed = mPassed + 1
            Debug.Print "  PASS  " & name
        Else
            mFailed = mFailed + 1
            Debug.Print "  FAIL  " & name & "   want: " & want & "   got: " & got
        End If
    End Sub

    Private Sub Fail(ByVal msg As String)
        mFailed = mFailed + 1
        Debug.Print "  FAIL  " & msg
    End Sub

End Module

' ==========================================================================
' MultiByteProbe (Phase E)
'
' The gaps left by LargeFileProbe / AppendProbe, all of which used pure ASCII:
'
'   1. MULTI-BYTE AT SCALE. The carry buffer (mCarry / CompletePrefixLen) is the
'      most intricate machinery in TextStream and has never run on a large file.
'      Here it runs across ~19 MILLION chunk boundaries.
'   2. THE TEXTSTREAM READ PATH PAST 2GB. Phase C read the big file with raw
'      Binary Get. TextStream.ReadLine - and the LongLong mBytesRemaining that
'      feeds it - has never actually been executed past 2^31.
'   3. SURROGATE PAIRS SPLIT BY A CHUNK BOUNDARY. Utf16PrefixLen holds back a
'      lone high surrogate precisely for this, and it has never been provoked.
'
' HOW (3) IS GUARANTEED, not merely hoped for:
'   Each line is 63 UTF-16 code units = 126 bytes. Chunks are 65536 bytes.
'   gcd(126, 65536) = 2, so as the file advances, the chunk boundary lands on
'   EVERY even byte offset within a line - all 63 code-unit positions. The
'   surrogate pair therefore WILL be straddled, many times over. The same holds
'   for the 4-byte UTF-8 form of the same character.
'
' Each line carries an 8-digit counter, so a single dropped, duplicated or
' mis-decoded character shows up immediately as a counter mismatch rather than
' as a vague "file looks wrong".
'
' Runtime: several minutes per encoding (~19M ReadLine calls for UTF-16,
' ~35M for UTF-8). Needs ~5 GB free. Run E1 and E2 separately if you prefer.
' ==========================================================================

Module MultiByteProbe
    Option Explicit

    Private Const TARGET_BYTES As LongLong = 2400000000^        ' comfortably past 2^31
    Private Const LINES_PER_BLOCK As Long = 1000                ' write granularity

    ' Line = 61 content units + CRLF = 63 units.
    ' Content: 8-digit counter | U+1F600 (surrogate pair) | e-acute | CJK | 49 x 'x'
    Private Const CONTENT_UNITS As Long = 61

    Private mPath As String
    Private mPassed As Long
    Private mFailed As Long

    Public Sub RunAll()
        mPassed = 0
        mFailed = 0
        Debug.Print "=== Phase E: multi-byte encodings past 2GB ==="
        E1_Utf16LE
        E2_Utf8
        Debug.Print vbCrLf & "=== " & mPassed & " passed, " & mFailed & " failed ==="
    End Sub

    '======================================================================
    ' E1 - UTF-16LE + BOM. 2 bytes/unit, 4 for the astral char.
    ' The encoding whose chunk boundaries are most likely to split a character.
    '======================================================================
    Public Sub E1_Utf16LE()
        Debug.Print vbCrLf & "--- E1: UTF-16LE + BOM ---"
        RoundTrip TempPath("_probe_u16.txt"), encUtf16Bom, 126   ' 63 units x 2 bytes
    End Sub

    '======================================================================
    ' E2 - UTF-8 + BOM. Variable width: 1/2/3/4 bytes per character in the SAME
    ' line, which is what exercises Utf8PrefixLen's walk-back properly.
    '   8 ASCII + 4 (U+1F600) + 2 (e-acute) + 3 (CJK) + 49 ASCII + 2 (CRLF) = 68
    '======================================================================
    Public Sub E2_Utf8()
        Debug.Print vbCrLf & "--- E2: UTF-8 + BOM ---"
        RoundTrip TempPath("_probe_u8.txt"), encUtf8Bom, 68
    End Sub

    '======================================================================
    ' Write a >2GB file in the given encoding, then read every line back through
    ' TextStream and verify it. bytesPerLine is used only to size the run.
    '======================================================================
    Private Sub RoundTrip(ByVal path As String, ByVal enc As TextEncoding, ByVal bytesPerLine As Long)
        Dim totalLines As LongLong
        totalLines = (TARGET_BYTES \ bytesPerLine) + 1
        Debug.Print "  Target: ~" & totalLines & " lines, ~" & _
                    Format$((totalLines * bytesPerLine) / 1073741824#, "0.00") & " GB"

        If Not WritePhase(path, enc, totalLines) Then Exit Sub
        ReadPhase path, enc, totalLines
        Debug.Print "  (leaving " & path & " in place; call CleanUp when done)"
    End Sub

    Private Function WritePhase(ByVal path As String, ByVal enc As TextEncoding, _
                                ByVal totalLines As LongLong) As Boolean
        Dim ts As TextStream
        Dim t0 As Double, lineNo As LongLong
        On Error GoTo Failed

        t0 = Timer
        FileSystemTools.DeleteFile path, True, True
        Set ts = FileSystemTools.CreateTextFile(path, True, enc, nlWindows)
        Check "E write IsStreaming", ts.IsStreaming, "True", CStr(ts.IsStreaming)

        lineNo = 1
        Do While lineNo <= totalLines
            ts.Write BuildBlock(lineNo, totalLines)
            lineNo = lineNo + LINES_PER_BLOCK
        Loop
        ts.Close
        Set ts = Nothing

        Dim size As LongLong
        size = FileSize(path)
        Debug.Print "  Wrote " & size & " bytes in " & Format$(Timer - t0, "0.0") & "s"
        Check "E file exceeds 2GB", (size > 2147483647^), ">2147483647", CStr(size)

        WritePhase = True
        Exit Function
    Failed:
        Fail "write raised " & Err.Number & " - " & Err.Description
        On Error Resume Next
        If Not ts Is Nothing Then ts.Close
    End Function

    ' The real test. Every line is checked, not sampled: a single character
    ' dropped or duplicated at ANY of the ~19M chunk boundaries shifts the
    ' counter and is caught on the very next line.
    Private Sub ReadPhase(ByVal path As String, ByVal enc As TextEncoding, ByVal totalLines As LongLong)
        Dim ts As TextStream
        Dim t0 As Double
        Dim n As LongLong, bad As LongLong
        Dim s As String
        On Error GoTo Failed

        t0 = Timer
        Set ts = FileSystemTools.OpenTextFile(path, ForReading)   ' encAutoDetect: BOM must win

        Check "E read IsStreaming", ts.IsStreaming, "True", CStr(ts.IsStreaming)
        Check "E encoding auto-detected", (ts.Encoding = enc), CStr(enc), CStr(ts.Encoding)

        ' The BOM must have been skipped at open: if it leaked into the text, the
        ' first line would start with U+FEFF and the counter check would fail here.
        Do While Not ts.AtEndOfStream
            s = ts.ReadLine()
            n = n + 1
            If Not LineIsValid(s, n) Then
                bad = bad + 1
                If bad <= 5 Then
                    Debug.Print "    MISMATCH at line " & n & ": len=" & Len(s) & _
                                " head=[" & Left$(s, 12) & "]"
                End If
                If bad > 100 Then
                    Debug.Print "    (giving up after 100 mismatches)"
                    Exit Do
                End If
            End If
        Loop

        Debug.Print "  Read " & n & " lines in " & Format$(Timer - t0, "0.0") & "s"
        Check "E line count", (n = totalLines), CStr(totalLines), CStr(n)
        Check "E every line intact", (bad = 0), "0 bad", CStr(bad) & " bad"

        ' Line property should have advanced once per terminator.
        Check "E Line property", (CLngLng(ts.Line) = totalLines + 1), _
              CStr(totalLines + 1), CStr(ts.Line)

        ts.Close
        Set ts = Nothing

        ' Bonus: the ReadAll guard should refuse a file this size with a clean 7,
        ' not die inside a ReDim.
        CheckReadAllGuard path
        Exit Sub

    Failed:
        Fail "read raised " & Err.Number & " - " & Err.Description & "  (at line " & n & ")"
        On Error Resume Next
        If Not ts Is Nothing Then ts.Close
    End Sub

    ' ReadAll on a >2GB stream must raise 7 (out of memory / too large) BEFORE
    ' consuming anything, leaving the stream usable.
    Private Sub CheckReadAllGuard(ByVal path As String)
        Dim ts As TextStream
        Dim s As String
        Dim raised As Long
        On Error Resume Next
        Set ts = FileSystemTools.OpenTextFile(path, ForReading)
        s = ts.ReadAll()
        raised = Err.Number
        Err.Clear
        On Error GoTo 0

        Check "E ReadAll refuses >2GB with error 7", (raised = 7), "7", CStr(raised)

        ' And the stream must still be usable after the refusal.
        On Error Resume Next
        Dim first As String
        first = ts.ReadLine()
        On Error GoTo 0
        Check "E stream usable after ReadAll refusal", LineIsValid(first, 1^), _
              "line 1 readable", "[" & Left$(first, 12) & "]"

        On Error Resume Next
        ts.Close
    End Sub

    '======================================================================
    ' Line construction + validation
    '======================================================================

    ' 61 units: 8-digit counter, U+1F600 (a surrogate PAIR - 2 units), U+00E9,
    ' U+4E2D, then 'x' padding. Deliberately spans 1-, 2-, 3- and 4-byte UTF-8
    ' forms so one line exercises every branch of Utf8PrefixLen.
    Private Function BuildLine(ByVal n As LongLong) As String
        BuildLine = Right$("00000000" & CStr(n), 8) & _
                    ChrW$(&HD83D&) & ChrW$(&HDE00&) & _
                    ChrW$(&HE9) & _
                    ChrW$(&H4E2D) & _
                    String$(CONTENT_UNITS - 12, "x")
    End Function

    Private Function BuildBlock(ByVal firstLine As LongLong, ByVal lastLine As LongLong) As String
        Dim sb() As String
        Dim count As Long, i As Long
        count = LINES_PER_BLOCK
        If (firstLine + count - 1) > lastLine Then count = CLng(lastLine - firstLine + 1)
        ReDim sb(0 To count - 1)
        For i = 0 To count - 1
            sb(i) = BuildLine(firstLine + i)
        Next
        BuildBlock = Join(sb, vbCrLf) & vbCrLf      ' Join omits the last separator
    End Function

    ' Checks length, counter AND the non-ASCII payload. Length alone would miss a
    ' surrogate pair decoded as two replacement chars; the payload check would miss
    ' a dropped line. Both together are tight.
    Private Function LineIsValid(ByRef s As String, ByVal n As LongLong) As Boolean
        If Len(s) <> CONTENT_UNITS Then Exit Function
        If Left$(s, 8) <> Right$("00000000" & CStr(n), 8) Then Exit Function
        If AscW(Mid$(s, 9, 1)) <> &HD83D Then Exit Function      ' high surrogate
        If AscW(Mid$(s, 10, 1)) <> &HDE00 Then Exit Function     ' low surrogate
        If AscW(Mid$(s, 11, 1)) <> &HE9 Then Exit Function
        If AscW(Mid$(s, 12, 1)) <> &H4E2D Then Exit Function
        LineIsValid = True
    End Function

    '======================================================================
    ' Helpers
    '======================================================================
    Private Function TempPath(ByVal leaf As String) As String
        TempPath = FileSystemTools.BuildPath( _
            FileSystemTools.GetSpecialFolder(TemporaryFolder), leaf)
    End Function

    Private Function FileSize(ByVal path As String) As LongLong
        Dim attrs As Long, size As LongLong
        Dim cr As Date, mo As Date, ac As Date, leaf As String
        If Not FileSystemTools.FileExists(path) Then Exit Function
        Shared.StatPath path, attrs, size, cr, mo, ac, leaf
        FileSize = size
    End Function

    Private Sub Check(ByVal name As String, ByVal ok As Boolean, _
                      ByVal want As String, ByVal got As String)
        If ok Then
            mPassed = mPassed + 1
            Debug.Print "  PASS  " & name
        Else
            mFailed = mFailed + 1
            Debug.Print "  FAIL  " & name & "   want: " & want & "   got: " & got
        End If
    End Sub

    Private Sub Fail(ByVal msg As String)
        mFailed = mFailed + 1
        Debug.Print "  FAIL  " & msg
    End Sub

    Public Sub CleanUp()
        FileSystemTools.DeleteFile TempPath("_probe_u16.txt"), True, True
        FileSystemTools.DeleteFile TempPath("_probe_u8.txt"), True, True
        Debug.Print "Probe files deleted."
    End Sub
    
    ' Differential test: our Folder.Size vs Scripting.FileSystemObject.
    ' Run each case separately - case 3 may hang or blow the stack under FSO, which
    ' is itself the finding.
    Public Sub SizeOracle()
        Dim fso As Object
        Set fso = CreateObject("Scripting.FileSystemObject")
        Dim root As String
        root = FileSystemTools.BuildPath(FileSystemTools.GetSpecialFolder(TemporaryFolder), "sizeoracle")

        ' --- setup: a folder with a known payload -------------------------------
        FileSystemTools.DeleteFolder root, True, True
        FileSystemTools.CreateFolder root, True
        FileSystemTools.CreateFolder FileSystemTools.BuildPath(root, "real"), True
        FileSystemTools.StringToTextFile String$(1000, "x"), _
            FileSystemTools.BuildPath(root, "real\a.txt"), encUsAscii      ' 1000 bytes
        FileSystemTools.StringToTextFile String$(500, "y"), _
            FileSystemTools.BuildPath(root, "b.txt"), encUsAscii           ' 500 bytes

        Report fso, root, "CASE 1: plain tree (expect 1500 both)"

        ' --- CASE 2: junction to a SIBLING (no loop, but double-counts if followed)
        ' Shell out: mklink /J <link> <target>
        Debug.Print vbCrLf & "Now run:  mklink /J """ & root & "\link"" """ & root & "\real"""
        Debug.Print "then call SizeOracle2."
    End Sub

    Public Sub SizeOracle2()
        Dim fso As Object: Set fso = CreateObject("Scripting.FileSystemObject")
        Dim root As String
        root = FileSystemTools.BuildPath(FileSystemTools.GetSpecialFolder(TemporaryFolder), "sizeoracle")
        Report fso, root, "CASE 2: junction to sibling" & vbCrLf & _
            "        ours = 1500 (skips it)   FSO = 2500 if it FOLLOWS the junction"
    End Sub

    Private Sub Report(ByVal fso As Object, ByVal path As String, ByVal label As String)
        Debug.Print vbCrLf & label
        Debug.Print "  ours: " & FileSystemTools.GetFolder(path).Size
        On Error Resume Next
        Debug.Print "  FSO : " & fso.GetFolder(path).Size
        If Err.Number <> 0 Then Debug.Print "  FSO RAISED: " & Err.Number & " - " & Err.Description
        On Error GoTo 0
    End Sub
    
    ' Differential test: an UNREADABLE subfolder. Ours vs Scripting.FileSystemObject.
    '
    ' Our FolderSize hits INVALID_HANDLE_VALUE on the denied folder and silently
    ' contributes 0 - so the reported total is short, with no indication that a whole
    ' subtree was skipped. FSO is expected to raise 70 (permission denied).
    '
    ' MUST run non-elevated. An explicit deny ACE is honoured by the normal file APIs,
    ' but a process holding SeBackupPrivilege can bypass it - so if you run this
    ' elevated you may see the deny do nothing at all, which looks like a pass and
    ' isn't. If both sizes come back 1500, check your elevation before believing it.
    Public Sub DenyOracle()
        Dim fso As Object: Set fso = CreateObject("Scripting.FileSystemObject")
        Dim sh As Object:  Set sh = CreateObject("WScript.Shell")

        Dim root As String, locked As String, user As String
        root = FileSystemTools.BuildPath(FileSystemTools.GetSpecialFolder(TemporaryFolder), "denyoracle")
        locked = FileSystemTools.BuildPath(root, "locked")
        user = Environ$("USERDOMAIN") & "\" & Environ$("USERNAME")

        On Error GoTo CleanUp

        ' --- setup: 500 bytes readable, 1000 bytes about to become unreadable ---
        FileSystemTools.DeleteFolder root, True, True
        FileSystemTools.CreateFolder root, True
        FileSystemTools.CreateFolder locked, True
        FileSystemTools.StringToTextFile String$(500, "y"), _
            FileSystemTools.BuildPath(root, "visible.txt"), encUsAscii
        FileSystemTools.StringToTextFile String$(1000, "x"), _
            FileSystemTools.BuildPath(locked, "hidden.txt"), encUsAscii

        Debug.Print "--- baseline (nothing denied yet) ---"
        Debug.Print "  ours: " & FileSystemTools.GetFolder(root).Size & "   (expect 1500)"
        Debug.Print "  FSO : " & fso.GetFolder(root).Size & "   (expect 1500)"

        ' --- deny this user read access to the subfolder -----------------------
        ' (OI)(CI) so it inherits; R = read, which includes FILE_LIST_DIRECTORY -
        ' that is the right the enumeration actually needs.
        Debug.Print vbCrLf & "  icacls: denying R on " & locked
        sh.Run "cmd /c icacls """ & locked & """ /inheritance:r /deny """ & user & """:(OI)(CI)R", 0, True

        ' Prove the deny actually took - if this SUCCEEDS, the ACE did nothing and
        ' the rest of the test is meaningless.
        Dim probeWorked As Boolean
        On Error Resume Next
        Dim n As Long
        n = FileSystemTools.GetFilePaths(locked).Count
        probeWorked = (Err.Number = 0)
        Err.Clear
        On Error GoTo CleanUp
        If probeWorked Then
            Debug.Print "  *** DENY DID NOT TAKE (still enumerated " & n & " files)."
            Debug.Print "      Are you running elevated? Re-run non-elevated."
            GoTo CleanUp
        End If
        Debug.Print "  deny confirmed: the folder is not enumerable"

        ' --- the actual comparison --------------------------------------------
        Debug.Print vbCrLf & "--- with 'locked' unreadable ---"

        On Error Resume Next
        Dim oursSize As LongLong
        oursSize = FileSystemTools.GetFolder(root).Size
        If Err.Number <> 0 Then
            Debug.Print "  ours: RAISED " & Err.Number & " - " & Err.Description
        Else
            Debug.Print "  ours: " & oursSize & _
                        IIf(oursSize = 500, "   <- silently dropped the locked subtree", "")
        End If
        Err.Clear

        Dim fsoSize As Variant
        fsoSize = fso.GetFolder(root).Size
        If Err.Number <> 0 Then
            Debug.Print "  FSO : RAISED " & Err.Number & " - " & Err.Description
        Else
            Debug.Print "  FSO : " & fsoSize
        End If
        Err.Clear
        On Error GoTo CleanUp

    CleanUp:
        If Err.Number <> 0 Then Debug.Print "  (setup error " & Err.Number & ": " & Err.Description & ")"
        ' Remove the deny BEFORE deleting, or the delete cannot recurse in either.
        On Error Resume Next
        sh.Run "cmd /c icacls """ & locked & """ /remove:d """ & user & """", 0, True
        sh.Run "cmd /c icacls """ & locked & """ /reset", 0, True
        FileSystemTools.DeleteFolder root, True, True
        Debug.Print vbCrLf & "  cleaned up."
    End Sub

End Module

Private Module GitHubEgs
    Private Sub Normalize_Eg()
        Dim fso As New tbFileSysTools.FileSystemObject
        Dim folderPath As String
        Dim f As tbFileSysTools.File
        folderPath = fso.BuildPath(fso.GetSpecialFolder(Documents), "GitHub\tbFileSysTools\ActiveXDLL\Dev")
        For Each f In fso.GetFolder(folderPath).Files
            f.Normalize toEncoding:=encUtf8, toLineending:=nlWindows
        Next f
        
    End Sub
End Module

